%%
%% cextcc-bytecode.sty — Bytecode / instruction display environments
%%
\ProvidesPackage{cextcc-bytecode}[2026/01/01 Bytecode display for The Tome]

\RequirePackage{xparse}
\RequirePackage{xcolor}
\RequirePackage{tcolorbox}
\RequirePackage{listings}

\providecolor{TomeBg}{HTML}{F7F5F0}
\providecolor{TomeInk}{HTML}{1B2A4A}
\providecolor{TomeRule}{HTML}{4A4A4A}
\providecolor{TomeGold}{HTML}{B8860B}

%% ============================================================
%% Bytecode listing style
%% ============================================================
\lstdefinestyle{bytecodestyle}{
  basicstyle=\ttfamily\small,
  keywordstyle=\bfseries\color{TomeInk},
  commentstyle=\itshape\color{TomeCodeCmt},
  numberstyle=\tiny\color{TomeRule},
  backgroundcolor=\color{TomeBg},
  frame=single,
  rulecolor=\color{TomeRule},
  framerule=0.4pt,
  breaklines=true,
  tabsize=4,
  showstringspaces=false,
  columns=fullflexible,
  numbers=left,
  numbersep=6pt,
  xleftmargin=16pt,
  framexleftmargin=12pt,
  aboveskip=8pt,
  belowskip=8pt,
}

%% ============================================================
%% Bytecode environment
%% ============================================================
\lstnewenvironment{bytecode}[1][]{%
  \lstset{style=bytecodestyle,#1}%
}{}

%% ============================================================
%% JVM-style bytecode
%% ============================================================
\lstdefinelanguage{JVMBytecode}{
  keywords={aload,astore,areturn,iconst,ldc,bipush,sipush,iadd,isub,imul,idiv,irem,ineg,ishl,ishr,iushr,iand,ior,ixor,iload,istore,ireturn,lload,lstore,lreturn,fload,fstore,freturn,dload,dstore,dreturn,return,ifeq,ifne,iflt,ifge,ifgt,ifle,if_icmpeq,if_icmpne,if_icmplt,if_icmpge,if_icmpgt,if_icmple,if_acmpeq,if_acmpne,ifnull,ifnonnull,goto,goto_w,jsr,jsr_w,ret,tableswitch,lookupswitch,invokespecial,invokevirtual,invokestatic,invokeinterface,invokedynamic,getfield,putfield,getstatic,putstatic,new,newarray,anewarray,multianewarray,arraylength,checkcast,instanceof,monitorenter,monitorexit,athrow,nop,dup,dup_x1,dup_x2,dup2,dup2_x1,dup2_x2,swap,pop,pop2,iinc},
  sensitive=false,
  morecomment=[l]{;},
  morecomment=[l]{//},
  morestring=[b]",
}

\lstnewenvironment{jvmcode}[1][]{%
  \lstset{language=JVMBytecode,style=bytecodestyle,#1}%
}{}

%% ============================================================
%% Generic stack machine bytecode
%% ============================================================
\lstdefinelanguage{StackMachine}{
  keywords={PUSH,POP,ADD,SUB,MUL,DIV,MOD,NEG,AND,OR,NOT,XOR,SHL,SHR,LOAD,STORE,ALLOC,FREE,JUMP,JUMP_IF,CALL,RETURN,HALT,DUP,SWAP,NOP,PRINT,READ,WRITE,COMPARE,EQUAL,LESS,GREATER},
  sensitive=true,
  morecomment=[l]{;},
  morecomment=[l]{//},
  morestring=[b]",
}

\lstnewenvironment{stackcode}[1][]{%
  \lstset{language=StackMachine,style=bytecodestyle,#1}%
}{}

%% ============================================================
%% Inline bytecode instruction
%% ============================================================
\newcommand{\bci}[1]{\lstinline[style=bytecodestyle,keywords={}]!#1!}

%% ============================================================
%% Bytecode with hex addresses
%% ============================================================
\NewDocumentEnvironment{bytecodetable}{m}{%
  \begin{tcolorbox}[%
    enhanced,
    arc=1pt,
    boxrule=0.4pt,
    colback=TomeBg,
    colframe=TomeRule,
    title={#1},
    coltitle=TomeInk,
    fonttitle=\small\bfseries,
    before skip=8pt,
    after skip=8pt,
  ]%
  \begin{tabular}{r l l}%
  \textit{Offset} & \textit{Instruction} & \textit{Operands}\\
  \hline%
}{%
  \end{tabular}%
  \end{tcolorbox}%
}

\endinput
