%%
%% cextcc-formal-grammar.sty — Formal grammar notation environments
%%
\ProvidesPackage{\@currpath cextcc-formal-grammar}[2026/11/12 Formal grammar notation for The Tome]

\RequirePackage{\@currpath cextcc-config}
\RequirePackage{amsmath}
\RequirePackage{xparse}
\RequirePackage{xcolor}
\RequirePackage{tcolorbox}

%% ============================================================
%% Grammar notation commands
%% ============================================================
\newcommand{\produces}{\ensuremath{\;\longrightarrow\;}}
\newcommand{\altproduces}{\ensuremath{\;\mid\;}}
\newcommand{\alt}{\altproduces}
\newcommand{\derives}{\ensuremath{\;\Rightarrow\;}}
\newcommand{\mderives}{\ensuremath{\;\stackrel{*}{\Rightarrow}\;}}
\newcommand{\lderives}{\ensuremath{\;\stackrel{l}{\Rightarrow}\;}}
\newcommand{\rderives}{\ensuremath{\;\stackrel{r}{\Rightarrow}\;}}
\newcommand{\first}[1]{\ensuremath{\mathrm{First}(#1)}}
\newcommand{\follow}[1]{\ensuremath{\mathrm{Follow}(#1)}}
\newcommand{\nullable}[1]{\ensuremath{\mathrm{Nullable}(#1)}}

%% ============================================================
%% Grammar environment (boxed, titled)
%% ============================================================
\NewDocumentEnvironment{grammar}{m +b}{%
  \begin{tcolorbox}[tomeformal,title={Grammar: #1}]%
  \TomeDisplayMath{\begin{aligned}#2\end{aligned}}%
  \end{tcolorbox}%
}{}

%% -- BNF-style production
\NewDocumentCommand{\production}{m m}{%
  #1 & \longrightarrow #2%
}

%% -- Alternative productions (multiple RHS)
\NewDocumentCommand{\productions}{m m}{%
  #1 & \longrightarrow #2%
}

%% ============================================================
%% EBNF helpers
%% ============================================================
\newcommand{\opt}[1]{\ensuremath{[#1]}}           %% optional
\newcommand{\rep}[1]{\ensuremath{\{#1\}}}          %% repetition
\newcommand{\repp}[1]{\ensuremath{\{#1\}^+}}       %% one or more
\newcommand{\group}[1]{\ensuremath{( #1 )}}        %% grouping

%% ============================================================
%% Regular expression notation
%% ============================================================
\newcommand{\reAlt}[2]{#1 \mid #2}
\newcommand{\reStar}[1]{#1^*}
\newcommand{\rePlus}[1]{#1^+}
\newcommand{\reOpt}[1]{#1?}
\newcommand{\reRange}[2]{[#1\text{--}#2]}

%% ============================================================
%% Lexer token environment
%% ============================================================
\NewDocumentEnvironment{tokens}{m +b}{%
  \begin{tcolorbox}[tomeformal,title={Token Definitions: #1}]%
  \TomeDisplayMath{\begin{aligned}#2\end{aligned}}%
  \end{tcolorbox}%
}{}

\endinput
