%%
%% cextcc-listing.sty — Code listing environments
%%
\ProvidesPackage{\@currpath cextcc-listing}[2026/11/12 Code listing environments for The Tome]

\RequirePackage{\@currpath cextcc-config}
\RequirePackage{listings}
\RequirePackage{xcolor}
\RequirePackage{xparse}
\RequirePackage{caption}

%% ============================================================
%% Base listing style
%% ============================================================
\lstdefinestyle{tomestyle}{
  basicstyle=\ttfamily\small\linespread{1}\selectfont,
  keywordstyle=\bfseries\color{TomeCodeKw},
  stringstyle=\color{TomeCodeStr},
  commentstyle=\itshape\color{TomeCodeCmt},
  keywordstyle=[2]\color{TomeLink},
  numberstyle=\sffamily\scriptsize\color{TomeRule},
  backgroundcolor=\color{TomeBg},
  frame=l,
  rulecolor=\color{TomeGold},
  framerule=0.8pt,
  framesep=6pt,
  breaklines=true,
  breakatwhitespace=false,
  breakindent=1.5em,
  postbreak=\mbox{\textcolor{TomeRule}{\ensuremath{\hookrightarrow}}\space},
  tabsize=4,
  showstringspaces=false,
  columns=flexible,
  keepspaces=true,
  numbers=left,
  numbersep=9pt,
  xleftmargin=26pt,
  xrightmargin=6pt,
  framexleftmargin=20pt,
  aboveskip=10pt plus 3pt minus 2pt,
  belowskip=10pt plus 3pt minus 2pt,
  captionpos=b,
  abovecaptionskip=7pt,
  belowcaptionskip=0pt,
  upquote=true,
  escapeinside={(*@}{@*)},
  %% Preserve literal operators: readers must be able to copy valid code.
  literate=,
}

\lstset{style=tomestyle}

%% ============================================================
%% Language definitions
%% ============================================================

%% -- Pseudocode / algorithmic
\lstdefinelanguage{Pseudo}{
  keywords={algorithm,procedure,function,return,if,then,else,elseif,fi,while,do,done,for,in,repeat,until,begin,end,var,let,const,type,record,array,of,input,output,assert,assume,require,ensure,invariant,precondition,postcondition,loop,foreach,match,with,case,switch,default,try,catch,throw,raise,yield,await,async,spawn,send,receive,select,guard,emit,class,struct,enum,trait,impl,interface,extends,implements,new,delete,alloc,free,null,nil,true,false,and,or,not,mod,div,skip,sleep,par,atomic,lock,unlock,acquire,release},
  sensitive=false,
  morecomment=[l]{//},
  morecomment=[s]{/*}{*/},
  morecomment=[l]{\#},
  morestring=[b]",
  morestring=[b]',
}

%% -- IR / SSA-like notation
\lstdefinelanguage{IR}{
  keywords={define,declare,ret,br,cond,switch,invoke,resume,unreachable,add,sub,mul,sdiv,udiv,srem,urem,fadd,fsub,fmul,fdiv,shl,lshr,ashr,and,or,xor,alloca,load,store,fence,getelementptr,icmp,fcmp,phi,call,select,trunc,zext,sext,fptrunc,fpext,fptoui,fptosi,uitofp,sitofp,ptrtoint,inttoptr,bitcast,extractelement,insertelement,shufflevector,extractvalue,insertvalue,landingpad,personality,freeze},
  morekeywords=[2]{i1,i8,i16,i32,i64,f16,f32,f64,void,label,token,ptr,opaque},
  sensitive=true,
  morecomment=[l]{;},
  morestring=[b]",
  morestring=[b]',
}

%% -- Type theory notation
\lstdefinelanguage{TypeTheory}{
  keywords={type,kind,term,lambda,forall,exists,let,in,fix,rec,match,with,fun,function,val,fn,type,data,struct,sig,end,open,where,abstract,datatype,of,case,raise,exception,handle,fn,op,infix,infixl,infixr,nonfix,local,abstype,equality,eqtype,include,sharing},
  sensitive=true,
  morecomment=[l]{--},
  morecomment=[s]{(*}{*)},
  morestring=[b]",
}

%% -- Rust-like
\lstdefinelanguage{RustLike}{
  keywords={fn,let,mut,const,static,struct,enum,impl,trait,type,where,match,if,else,loop,while,for,in,return,break,continue,use,mod,crate,pub,ref,as,move,self,super,unsafe,extern,async,await,yield,try,dyn,macro},
  morekeywords=[2]{i8,i16,i32,i64,i128,isize,u8,u16,u32,u64,u128,usize,f32,f64,bool,char,str,Box,Rc,Arc,Vec,Option,Result,Some,None,Ok,Err,true,false,Self},
  sensitive=true,
  morecomment=[l]{//},
  morecomment=[s]{/*}{*/},
  morestring=[b]",
  morestring=[b]',
}

%% ============================================================
%% Custom listing environments
%% ============================================================
\lstnewenvironment{pseudocode}[1][]{%
  \lstset{language=Pseudo,#1}%
}{}

\lstnewenvironment{ircode}[1][]{%
  \lstset{language=IR,#1}%
}{}

\lstnewenvironment{typecode}[1][]{%
  \lstset{language=TypeTheory,#1}%
}{}

\lstnewenvironment{rustcode}[1][]{%
  \lstset{language=RustLike,#1}%
}{}

%% ============================================================
%% Inline code
%% ============================================================
\newcommand{\icode}[1]{\lstinline[style=tomestyle,basicstyle=\ttfamily,keywords={},numbers=none]{#1}}

\endinput
