%%
%% cextcc-pipeline.sty — Compiler pipeline diagrams
%%
\ProvidesPackage{cextcc-pipeline}[2026/01/01 Pipeline diagrams for The Tome]

\RequirePackage{tikz}
\RequirePackage{xparse}
\RequirePackage{xcolor}
\usetikzlibrary{
  arrows.meta,
  positioning,
  shapes.geometric,
  shapes.symbols,
  calc,
  fit,
  backgrounds,
  chains,
  scopes,
}

\providecolor{TomeInk}{HTML}{1B2A4A}
\providecolor{TomeGold}{HTML}{B8860B}
\providecolor{TomeRule}{HTML}{4A4A4A}
\providecolor{TomeBg}{HTML}{F7F5F0}
\providecolor{TomeBgAlt}{HTML}{EDEAE3}

%% ============================================================
%% Pipeline stage styles
%% ============================================================
\tikzset{
  pipeline/.style={
    >=Stealth,
    thick,
    node distance=0.8cm and 1.2cm,
    every node/.style={font=\small},
  },
  stage/.style={
    draw,
    rectangle,
    rounded corners=4pt,
    minimum width=2.5cm,
    minimum height=1cm,
    align=center,
    fill=TomeBg,
    draw=TomeInk,
    font=\small\bfseries,
  },
  stage input/.style={
    stage,
    fill=TomeBgAlt,
    draw=TomeGold,
  },
  stage output/.style={
    stage,
    fill=TomeBgAlt,
    draw=TomeGold,
  },
  stage transform/.style={
    stage,
  },
  stage feedback/.style={
    stage,
    draw=TomeRule,
    dashed,
  },
  pipeline arrow/.style={->, thick, draw=TomeInk},
  pipeline feedback/.style={->, thick, dashed, draw=TomeGold},
  %% Data flow arrow
  data arrow/.style={->, thick, draw=TomeInk},
  control arrow/.style={->, thick, dashed, draw=TomeRule},
}

%% ============================================================
%% Pipeline diagram environment
%% ============================================================
\NewDocumentEnvironment{pipelinediagram}{o}{%
  \begin{figure}[htbp]%
  \centering%
  \begin{tikzpicture}[pipeline,
    \IfValueT{#1}{#1}%
  ]%
}{%
  \end{tikzpicture}%
  \end{figure}%
}

%% ============================================================
%% Inline pipeline (no figure wrapper)
%% ============================================================
\NewDocumentEnvironment{pipelineinline}{o}{%
  \begin{center}%
  \begin{tikzpicture}[pipeline,
    \IfValueT{#1}{#1}%
  ]%
}{%
  \end{tikzpicture}%
  \end{center}%
}

%% ============================================================
%% Phase annotation
%% ============================================================
\NewDocumentCommand{\phasearrow}{m m}{%
  \draw[pipeline arrow] (#1) -- node[above, font=\small\itshape]{#2} (#2);
}

\endinput
