%%
%% cextcc-pipeline.sty — Compiler pipeline diagrams
%%
\ProvidesPackage{\@currpath cextcc-pipeline}[2026/11/12 Pipeline diagrams for The Tome]

\RequirePackage{\@currpath cextcc-diagram}
\RequirePackage{tikz}
\RequirePackage{xparse}
\RequirePackage{xcolor}
\usetikzlibrary{
  arrows.meta,
  positioning,
  shapes.geometric,
  shapes.symbols,
  calc,
  fit,
  backgrounds,
  chains,
  scopes,
}

%% ============================================================
%% Pipeline stage styles
%% ============================================================
\tikzset{
  pipeline/.style={
    tome diagram,
    node distance=0.8cm and 1.2cm,
  },
  stage/.style={
    tome diagram node,
    draw,
    rectangle,
    rounded corners=1.5pt,
    minimum width=2.5cm,
    minimum height=1cm,
    align=center,
    fill=TomeBg,
    draw=TomeInk,
    font=\sffamily\small\bfseries,
  },
  stage input/.style={
    stage,
    fill=TomeBgAlt,
    draw=TomeGold,
  },
  stage output/.style={
    stage,
    fill=TomeBgAlt,
    draw=TomeGold,
  },
  stage transform/.style={
    stage,
  },
  stage feedback/.style={
    stage,
    draw=TomeRule,
    dashed,
  },
  pipeline arrow/.style={->, thick, draw=TomeInk},
  pipeline feedback/.style={->, thick, dashed, draw=TomeGold},
  %% Data flow arrow
  data arrow/.style={->, thick, draw=TomeInk},
  control arrow/.style={->, thick, dashed, draw=TomeRule},
}

%% ============================================================
%% Pipeline diagram environment
%% ============================================================
\NewDocumentEnvironment{pipelinediagram}{O{}}{%
  \begin{figure}[htbp]%
  \centering%
  \begin{tikzpicture}[pipeline,#1]%
}{%
  \end{tikzpicture}%
  \end{figure}%
}

%% ============================================================
%% Inline pipeline (no figure wrapper)
%% ============================================================
\NewDocumentEnvironment{pipelineinline}{O{}}{%
  \begin{center}%
  \begin{tikzpicture}[pipeline,#1]%
}{%
  \end{tikzpicture}%
  \end{center}%
}

%% ============================================================
%% Phase annotation
%% ============================================================
\NewDocumentCommand{\phasearrow}{m m}{%
  \draw[pipeline arrow] (#1) -- node[above, font=\small\itshape]{#2} (#2);
}

\endinput
