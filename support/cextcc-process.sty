%%
%% cextcc-process.sty — Process / concurrency diagrams
%%
\ProvidesPackage{\@currpath cextcc-process}[2026/11/12 Process diagrams for The Tome]

\RequirePackage{\@currpath cextcc-diagram}
\RequirePackage{tikz}
\RequirePackage{xparse}
\RequirePackage{xcolor}
\usetikzlibrary{
  arrows.meta,
  positioning,
  shapes.geometric,
  calc,
  fit,
  backgrounds,
  petri,
}

%% ============================================================
%% Petri net / process styles
%% ============================================================
\tikzset{
  process diagram/.style={
    tome diagram,
    node distance=1.5cm and 2cm,
  },
  %% Petri net elements
  place/.style={
    tome diagram node,
    circle,
    draw=TomeInk,
    fill=TomeBg,
    minimum size=0.6cm,
    thick,
  },
  transition proc/.style={
    tome diagram node,
    rectangle,
    draw=TomeInk,
    fill=TomeBgAlt,
    minimum width=0.4cm,
    minimum height=0.8cm,
    thick,
  },
  token/.style={
    fill=TomeInk,
    circle,
    minimum size=2pt,
    inner sep=0pt,
  },
  %% Process box (CSP-style)
  process box/.style={
    tome diagram node,
    draw,
    rectangle,
    rounded corners=2pt,
    minimum width=2cm,
    minimum height=1cm,
    align=center,
    fill=TomeBg,
    draw=TomeInk,
    font=\ttfamily\small,
  },
  %% Actor
  actor node/.style={
    tome diagram node,
    draw,
    ellipse,
    minimum width=1.5cm,
    minimum height=0.8cm,
    fill=TomeBg,
    draw=TomeInk,
    font=\small,
  },
  %% Message passing
  message arrow/.style={
    ->,
    thick,
    draw=TomeInk,
    -Stealth,
  },
  %% Channel
  channel/.style={
    draw,
    dashed,
    thick,
    draw=TomeRule,
  },
}

%% ============================================================
%% Process diagram environment
%% ============================================================
\NewDocumentEnvironment{processdiagram}{O{}}{%
  \begin{figure}[htbp]%
  \centering%
  \begin{tikzpicture}[process diagram,#1]%
}{%
  \end{tikzpicture}%
  \end{figure}%
}

\endinput
