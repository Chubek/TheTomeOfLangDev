%%
%% cextcc-process.sty — Process / concurrency diagrams
%%
\ProvidesPackage{cextcc-process}[2026/01/01 Process diagrams for The Tome]

\RequirePackage{tikz}
\RequirePackage{xparse}
\RequirePackage{xcolor}
\usetikzlibrary{
  arrows.meta,
  positioning,
  shapes.geometric,
  calc,
  fit,
  backgrounds,
  petri,
}

\providecolor{TomeInk}{HTML}{1B2A4A}
\providecolor{TomeGold}{HTML}{B8860B}
\providecolor{TomeRule}{HTML}{4A4A4A}
\providecolor{TomeBg}{HTML}{F7F5F0}

%% ============================================================
%% Petri net / process styles
%% ============================================================
\tikzset{
  process diagram/.style={
    >=Stealth,
    thick,
    node distance=1.5cm and 2cm,
    every node/.style={font=\small},
  },
  %% Petri net elements
  place/.style={
    circle,
    draw=TomeInk,
    fill=TomeBg,
    minimum size=0.6cm,
    thick,
  },
  transition proc/.style={
    rectangle,
    draw=TomeInk,
    fill=TomeBgAlt,
    minimum width=0.4cm,
    minimum height=0.8cm,
    thick,
  },
  token/.style={
    fill=TomeInk,
    circle,
    minimum size=2pt,
    inner sep=0pt,
  },
  %% Process box (CSP-style)
  process box/.style={
    draw,
    rectangle,
    rounded corners=2pt,
    minimum width=2cm,
    minimum height=1cm,
    align=center,
    fill=TomeBg,
    draw=TomeInk,
    font=\ttfamily\small,
  },
  %% Actor
  actor node/.style={
    draw,
    ellipse,
    minimum width=1.5cm,
    minimum height=0.8cm,
    fill=TomeBg,
    draw=TomeInk,
    font=\small,
  },
  %% Message passing
  message arrow/.style={
    ->,
    thick,
    draw=TomeInk,
    -Stealth,
  },
  %% Channel
  channel/.style={
    draw,
    dashed,
    thick,
    draw=TomeRule,
  },
}

%% ============================================================
%% Process diagram environment
%% ============================================================
\NewDocumentEnvironment{processdiagram}{o}{%
  \begin{figure}[htbp]%
  \centering%
  \begin{tikzpicture}[process diagram,
    \IfValueT{#1}{#1}%
  ]%
}{%
  \end{tikzpicture}%
  \end{figure}%
}

\endinput
