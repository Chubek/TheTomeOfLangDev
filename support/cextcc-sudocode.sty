%%
%% cextcc-sudocode.sty — Pseudocode / algorithmic environments
%%
\ProvidesPackage{cextcc-sudocode}[2026/01/01 Pseudocode environments for The Tome]

\RequirePackage{xparse}
\RequirePackage{xcolor}
\RequirePackage{amsmath}
\RequirePackage{algorithm}
\RequirePackage{algpseudocode}
\RequirePackage{algorithmicx}
\RequirePackage{tcolorbox}

\providecolor{TomeBg}{HTML}{F7F5F0}
\providecolor{TomeInk}{HTML}{1B2A4A}
\providecolor{TomeRule}{HTML}{4A4A4A}
\providecolor{TomeGold}{HTML}{B8860B}

%% ============================================================
%% Algorithm styling
%% ============================================================
\floatname{algorithm}{Algorithm}
\renewcommand{\algorithmicrequire}{\textbf{Requires:}}
\renewcommand{\algorithmicensure}{\textbf{Ensures:}}
\newcommand{\ensure}{\Ensure}
\renewcommand{\algorithmicend}{\textbf{end}}
\renewcommand{\algorithmicif}{\textbf{if}}
\renewcommand{\algorithmicthen}{\textbf{then}}
\renewcommand{\algorithmicelse}{\textbf{else}}
\algrenewtext{ElsIf}[1]{\textbf{elsif}\ #1\ \algorithmicthen}
\renewcommand{\algorithmicfor}{\textbf{for}}
\renewcommand{\algorithmicforall}{\textbf{for all}}
\renewcommand{\algorithmicdo}{\textbf{do}}
\renewcommand{\algorithmicwhile}{\textbf{while}}
\renewcommand{\algorithmicloop}{\textbf{loop}}
\renewcommand{\algorithmicrepeat}{\textbf{repeat}}
\renewcommand{\algorithmicuntil}{\textbf{until}}
\renewcommand{\algorithmicreturn}{\textbf{return}}
\renewcommand{\algorithmicfunction}{\textbf{function}}
\renewcommand{\algorithmicprocedure}{\textbf{procedure}}
\algdef{SE}[SWITCH]{Switch}{EndSwitch}[1]{\textbf{switch} #1}{\textbf{end switch}}
\algdef{SE}[CASE]{Case}{EndCase}[1]{\textbf{case} #1}{\textbf{end case}}

%% ============================================================
%% Algorithm environment with colored background
%% ============================================================
\newenvironment{tomealgorithm}[1][htbp]{%
  \begin{algorithm}[#1]%
  \small%
}{%
  \end{algorithm}%
}

%% ============================================================
%% Pseudocode commands
%% ============================================================
\algnewcommand{\algorithmicinput}{\textbf{Input:}}
\algnewcommand{\algorithmicoutput}{\textbf{Output:}}
\algnewcommand{\Input}{\item[\algorithmicinput]}
\algnewcommand{\Output}{\item[\algorithmicoutput]}
\algnewcommand{\Let}[2]{\State $#1 \gets #2$}
\algnewcommand{\To}[1]{\State $\triangleright$ \textit{#1}}
\algnewcommand{\Invoke}[1]{\State \textsc{#1}}
\algnewcommand{\Class}[1]{\textsc{#1}}
\algnewcommand{\Obj}[1]{\textit{#1}}
\algnewcommand{\Attr}[2]{\Obj{#1}.\Attr{#2}{}}
\algnewcommand{\Proc}[1]{\textsc{#1}}

%% ============================================================
%% Standalone pseudocode block (not floating)
%% ============================================================
\NewDocumentEnvironment{sudocode}{o}{%
  \IfValueT{#1}{\tcbset{title={#1},coltitle=TomeInk,fonttitle=\bfseries\small}}%
  \par\vspace{8pt}%
  \noindent\begin{tcolorbox}[%
    enhanced,
    breakable,
    arc=1pt,
    boxrule=0.4pt,
    colback=TomeBg,
    colframe=TomeRule,
    left=10pt,
    right=10pt,
    top=8pt,
    bottom=8pt,
  ]%
  \small%
  \begin{algorithmic}[1]%
}{%
  \end{algorithmic}%
  \end{tcolorbox}%
  \vspace{8pt}%
}

%% ============================================================
%% Inference-rule-like algorithm step
%% ============================================================
\NewDocumentCommand{\algostep}{m m}{%
  \State \textbf{(#1)}\quad #2%
}

\endinput
