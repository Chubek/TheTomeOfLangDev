%%
%% cextcc-sexpr.sty — S-expression display
%%
\ProvidesPackage{\@currpath cextcc-sexpr}[2026/11/12 S-expression display for The Tome]

\RequirePackage{\@currpath cextcc-listing}
\RequirePackage{listings}
\RequirePackage{xparse}
\RequirePackage{xcolor}

%% ============================================================
%% S-expression / Lisp language definition
%% ============================================================
\lstdefinelanguage{SExpr}{
  keywords={lambda,define,let,letrec,let*,if,cond,else,case,when,unless,begin,set!,quote,quasiquote,unquote,unquote-splicing,define-syntax,let-syntax,letrec-syntax,syntax-rules,syntax-case,and,or,not,eq?,eqv?,equal?,null?,pair?,symbol?,number?,string?,char?,boolean?,vector?,procedure?,cons,car,cdr,caar,cadr,cdar,cddr,list,append,reverse,map,filter,fold,apply,eval,read,write,display,newline,format},
  sensitive=true,
  morecomment=[l]{;},
  morecomment=[s]{\#|}{|\#},
  morestring=[b]",
}

\lstnewenvironment{sexpr}[1][]{%
  \lstset{
    style=tomestyle,
    language=SExpr,
    tabsize=2,
    #1
  }%
}{}

%% Inline s-expression
\newcommand{\sexpinline}[1]{\lstinline[language=SExpr,basicstyle=\ttfamily]!#1!}

\endinput
