%%
%% cextcc-sexpr.sty — S-expression display
%%
\ProvidesPackage{cextcc-sexpr}[2026/01/01 S-expression display for The Tome]

\RequirePackage{listings}
\RequirePackage{xparse}
\RequirePackage{xcolor}

\providecolor{TomeCodeKw}{HTML}{8B0000}
\providecolor{TomeCodeStr}{HTML}{006400}
\providecolor{TomeCodeCmt}{HTML}{708090}

%% ============================================================
%% S-expression / Lisp language definition
%% ============================================================
\lstdefinelanguage{SExpr}{
  keywords={lambda,define,let,letrec,let*,if,cond,else,case,when,unless,begin,set!,quote,quasiquote,unquote,unquote-splicing,define-syntax,let-syntax,letrec-syntax,syntax-rules,syntax-case,and,or,not,eq?,eqv?,equal?,null?,pair?,symbol?,number?,string?,char?,boolean?,vector?,procedure?,cons,car,cdr,caar,cadr,cdar,cddr,list,append,reverse,map,filter,fold,apply,eval,read,write,display,newline,format},
  sensitive=true,
  morecomment=[l]{;},
  morecomment=[s]{\#|}{|\#},
  morestring=[b]",
}

\lstnewenvironment{sexpr}[1][]{%
  \lstset{
    language=SExpr,
    basicstyle=\ttfamily\small,
    keywordstyle=\bfseries\color{TomeCodeKw},
    stringstyle=\color{TomeCodeStr},
    commentstyle=\itshape\color{TomeCodeCmt},
    backgroundcolor=\color{TomeBg},
    frame=single,
    breaklines=true,
    tabsize=2,
    showstringspaces=false,
    numbers=left,
    numbersep=6pt,
    xleftmargin=16pt,
    aboveskip=8pt,
    belowskip=8pt,
    #1
  }%
}{}

%% Inline s-expression
\newcommand{\sexpinline}[1]{\lstinline[language=SExpr,basicstyle=\ttfamily]!#1!}

\endinput
