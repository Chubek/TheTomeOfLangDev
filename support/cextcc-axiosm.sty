%%
%% cextcc-axiosm.sty — Axiom and proof environments
%%
\ProvidesPackage{\@currpath cextcc-axiosm}[2026/11/12 Axiom environments for The Tome]

\RequirePackage{\@currpath cextcc-config}
\RequirePackage{graphicx}
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{amsthm}
\RequirePackage{xparse}
\RequirePackage{xcolor}
\RequirePackage{tcolorbox}

%% ============================================================
%% Axiom environment (numbered, boxed)
%% ============================================================
\NewDocumentEnvironment{axiom}{o}{%
  \tcbset{tome axiom title/.style={title={}}}%
  \IfValueT{#1}{\tcbset{tome axiom title/.style={title={Axiom: #1}}}}%
  \begin{tcolorbox}[%
    tomebase,colback=TomeDefBg,colframe=TomeDefBorder,
    colbacktitle=TomeDefBg,tome axiom title,
  ]%
}{%
  \end{tcolorbox}%
}

%% ============================================================
%% Inference rule (generic)
%% ============================================================
\NewDocumentCommand{\inferruletwo}{m m o}{%
  \dfrac{#1 \quad #2}{\displaystyle #3}%
  \IfValueT{#3}{\;\TomeRuleName{#3}}%
}

\NewDocumentCommand{\inferrulethree}{m m m o}{%
  \dfrac{#1 \quad #2 \quad #3}{\displaystyle #4}%
  \IfValueT{#4}{\;\TomeRuleName{#4}}%
}

%% ============================================================
%% Proof sketch environment
%% ============================================================
\NewDocumentEnvironment{proofsketch}{}{%
  \par\medskip
  \noindent{\sffamily\bfseries\color{TomeInk}Proof sketch.}\enspace\itshape%
}{%
  \par\medskip%
}

%% ============================================================
%% Logical connectives (text mode)
%% ============================================================
\newcommand{\ltrue}{\ensuremath{\top}}
\providecommand{\parr}{\mathbin{\rotatebox[origin=c]{180}{\&}}}
\newcommand{\with}{\mathbin{\&}}
\newcommand{\wand}{\mathbin{-\!\!*}}
\newcommand{\lfalse}{\ensuremath{\bot}}
\newcommand{\landd}{\ensuremath{\wedge}}
\newcommand{\lorr}{\ensuremath{\vee}}
\newcommand{\lneg}{\ensuremath{\neg}}
\newcommand{\limp}{\ensuremath{\Rightarrow}}
\newcommand{\liff}{\ensuremath{\Leftrightarrow}}
\newcommand{\lforall}{\ensuremath{\forall}}
\newcommand{\lexists}{\ensuremath{\exists}}
\newcommand{\lbox}{\ensuremath{\Box}}
\newcommand{\ldiamond}{\ensuremath{\Diamond}}

%% ============================================================
%% Sequent calculus
%% ============================================================
\newcommand{\sequent}[2]{\ensuremath{#1 \vdash #2}}
\newcommand{\seqcut}{\ensuremath{\mid}}

\NewDocumentEnvironment{sequentrules}{m +b}{%
  \begin{tcolorbox}[tomeformal,title={Sequent Calculus: #1}]%
  \TomeDisplayMath{\renewcommand{\arraystretch}{1.2}%
    \begin{array}{@{}l@{}}#2\end{array}}%
  \end{tcolorbox}%
}{}

\endinput
