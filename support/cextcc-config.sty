%%
%% cextcc-config.sty — Global configuration and shared definitions
%%
\ProvidesPackage{cextcc-config}[2026/01/01 Global configuration for The Tome]

\RequirePackage{xcolor}
\RequirePackage{xparse}
\RequirePackage{xspace}
\RequirePackage{etoolbox}

%% ============================================================
%% Shared color aliases (in case class is not loaded)
%% ============================================================
\providecolor{TomeInk}{HTML}{1B2A4A}
\providecolor{TomeGold}{HTML}{B8860B}
\providecolor{TomeRule}{HTML}{4A4A4A}
\providecolor{TomeBg}{HTML}{F7F5F0}
\providecolor{TomeLink}{HTML}{1A5276}

%% ============================================================
%% Commonly used math operators
%% ============================================================
\DeclareMathOperator{\dom}{dom}
\DeclareMathOperator{\ran}{ran}
\DeclareMathOperator{\cod}{cod}
\DeclareMathOperator{\id}{id}
\DeclareMathOperator{\obj}{obj}
%% \hom is already supplied by LaTeX.
\DeclareMathOperator{\FV}{FV}
\DeclareMathOperator{\BV}{BV}
\DeclareMathOperator{\FTV}{FTV}
\DeclareMathOperator{\vars}{vars}
\DeclareMathOperator{\labs}{labs}
\DeclareMathOperator{\types}{types}
\DeclareMathOperator{\effects}{eff}
\DeclareMathOperator{\sizeof}{sizeof}
\DeclareMathOperator{\alignof}{alignof}
\DeclareMathOperator{\typeof}{typeof}
\DeclareMathOperator{\kindof}{kindof}
\DeclareMathOperator{\env}{env}
\DeclareMathOperator{\store}{store}
\DeclareMathOperator{\heap}{heap}
\DeclareMathOperator{\stackframe}{frame}
\DeclareMathOperator{\cont}{cont}

%% ============================================================
%% Text-mode abbreviations
%% ============================================================
\newcommand{\ie}{\textit{i.e.}\xspace}
\newcommand{\eg}{\textit{e.g.}\xspace}
\newcommand{\cf}{\textit{cf.}\xspace}
\newcommand{\ala}{\textit{\`a la}\xspace}
\newcommand{\etal}{\textit{et al.}\xspace}
\newcommand{\opcit}{\textit{op.\ cit.}\xspace}

%% ============================================================
%% Font shortcuts
%% ============================================================
\newcommand{\tsc}[1]{\textsc{#1}}
\newcommand{\tbf}[1]{\textbf{#1}}
\newcommand{\tit}[1]{\textit{#1}}
\newcommand{\tem}[1]{\emph{#1}}

%% ============================================================
%% Nonterminal and terminal styling (for grammars)
%% ============================================================
\newcommand{\nt}[1]{\textit{#1}}       %% nonterminal
\newcommand{\tm}[1]{\texttt{#1}}       %% terminal
\newcommand{\kw}[1]{\textbf{#1}}       %% keyword
\newcommand{\metavar}[1]{\mathit{#1}}  %% metavariable in math

%% ============================================================
%% Todo / draft markers (only in draft mode)
%% ============================================================
\newbool{DraftMode}
\boolfalse{DraftMode}
\DeclareOption{draft}{\booltrue{DraftMode}}
\ProcessOptions\relax

\ifbool{DraftMode}{
  \RequirePackage{todonotes}
  \newcommand{\tomemarker}[1]{\todo[color=yellow!30]{#1}}
}{
  \newcommand{\tomemarker}[1]{}
}

\endinput
