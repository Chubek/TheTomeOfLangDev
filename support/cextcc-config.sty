\providecolor{TomeGold}{HTML}{A77932}
\providecolor{TomeRule}{HTML}{52616B}
\providecolor{TomeBg}{HTML}{F6F5F1}
\providecolor{TomeBgAlt}{HTML}{E8EDEB}
\providecolor{TomeLink}{HTML}{245B70}
\providecolor{TomeCite}{HTML}{385E61}
\providecolor{TomeCodeKw}{HTML}{79413D}
\providecolor{TomeCodeStr}{HTML}{2D6356}
\providecolor{TomeCodeCmt}{HTML}{596875}
\providecolor{TomeChapNum}{HTML}{A77932}
\providecolor{TomePartBg}{HTML}{182D43}
\providecolor{TomePartFg}{HTML}{F6F5F1}
\providecolor{TomeThmBg}{HTML}{F1F4F6}
\providecolor{TomeThmBorder}{HTML}{182D43}
\providecolor{TomeDefBg}{HTML}{F0F5F2}
\providecolor{TomeDefBorder}{HTML}{2D6356}
