%% Emit a pending run-in theorem heading before a display or code block.
%% Otherwise amsthm's deferred heading can overlap the block's first line.
\newcommand{\TomeBlockStart}{%
  \if@inlabel\leavevmode\par\nobreak\fi
}
\BeforeBeginEnvironment{tcolorbox}{\TomeBlockStart}

