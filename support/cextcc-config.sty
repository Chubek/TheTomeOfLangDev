%% Lining numerals belong in navigation and data; prose keeps oldstyle
%% figures. The font test also permits these styles in other classes.
\newcommand{\TomeUseLining}{%
  \ifTUTeX\ifdefined\addfontfeatures
    \addfontfeatures{Numbers={Lining,Tabular}}%
  \fi\fi
}
\DeclareRobustCommand{\TomeLining}[1]{{\TomeUseLining #1}}
\DeclareRobustCommand{\TomeRuleName}[1]{%
  \text{\normalfont\footnotesize\scshape #1}%
}

%% A single visual vocabulary: square corners, a quiet tinted title, and
%% an identifying left rule. No shadows or heavy frames around the text.
\tcbset{
  tomebase/.style={
    enhanced,breakable,sharp corners,
    boxrule=0pt,leftrule=1.2pt,
    colback=TomeBg,colframe=TomeInk,
    colbacktitle=TomeInk!7!white,coltitle=TomeInk,
    fonttitle=\sffamily\bfseries\small,
    left=11pt,right=11pt,top=8pt,bottom=8pt,
    lefttitle=11pt,righttitle=11pt,toptitle=6pt,bottomtitle=6pt,
    before skip=11pt plus 3pt minus 2pt,
    after skip=11pt plus 3pt minus 2pt,
    before upper={\setlength{\parindent}{0pt}},
  },
  tomeformal/.style={
    tomebase,unbreakable,
    colback=TomeThmBg,colframe=TomeThmBorder,
    colbacktitle=TomeInk!7!white,
  },
  tomecode/.style={
    tomebase,colback=TomeBg,colframe=TomeGold,
    colbacktitle=TomeBgAlt,
  },
}

%% Formal displays are indivisible mathematical objects. Fit only those
%% that actually exceed the local measure, never enlarge small formulas.
\newcommand{\TomeDisplayMath}[1]{%
  \par\smallskip\noindent
  \makebox[\linewidth][c]{%
    \setlength{\extrarowheight}{5pt}%
    \begin{adjustbox}{max width=\linewidth}%
      \(\displaystyle #1\)%
    \end{adjustbox}%
  }%
  \par\smallskip
}

