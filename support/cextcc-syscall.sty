%%
%% cextcc-syscall.sty — System call / ABI display
%%
\ProvidesPackage{cextcc-syscall}[2026/01/01 System call display for The Tome]

\RequirePackage{listings}
\RequirePackage{xparse}
\RequirePackage{xcolor}
\RequirePackage{booktabs}
\RequirePackage{array}

\providecolor{TomeBg}{HTML}{F7F5F0}
\providecolor{TomeInk}{HTML}{1B2A4A}
\providecolor{TomeRule}{HTML}{4A4A4A}

%% ============================================================
%% Assembly language definition (x86-like)
%% ============================================================
\lstdefinelanguage{Asm}{
  keywords={mov,movz,movs,push,pop,lea,add,sub,imul,idiv,inc,dec,neg,cmp,test,and,or,xor,not,shl,shr,sar,sal,jmp,je,jne,jz,jnz,jl,jle,jg,jge,ja,jae,jb,jbe,call,ret,nop,syscall,int,cdq,cqo,mul,div,mod,xchg,cmovl,cmovg,cmovle,cmovge,cmove,cmovne,sete,setne,setl,setle,setg,setge},
  morekeywords=[2]{rax,rbx,rcx,rdx,rsi,rdi,rbp,rsp,r8,r9,r10,r11,r12,r13,r14,r15,eax,ebx,ecx,edx,esi,edi,ebp,esp,al,ah,bl,bh,cl,dl},
  sensitive=false,
  morecomment=[l]{;},
  morecomment=[l]{//},
  morestring=[b]",
}

\lstnewenvironment{asmcode}[1][]{%
  \lstset{
    language=Asm,
    basicstyle=\ttfamily\small,
    keywordstyle=\bfseries\color{TomeCodeKw},
    commentstyle=\itshape\color{TomeCodeCmt},
    backgroundcolor=\color{TomeBg},
    frame=single,
    breaklines=true,
    tabsize=4,
    showstringspaces=false,
    numbers=left,
    numbersep=6pt,
    xleftmargin=16pt,
    aboveskip=8pt,
    belowskip=8pt,
    #1
  }%
}{}

%% ============================================================
%% System call table
%% ============================================================
\NewDocumentEnvironment{syscalltable}{m}{%
  \begin{table}[htbp]%
  \centering%
  \renewcommand{\arraystretch}{1.15}%
  \caption{System calls: #1}%
  \begin{tabular}{@{}lllp{5cm}@{}}%
  \toprule%
  \textbf{Number} & \textbf{Name} & \textbf{Arguments} & \textbf{Description}\\
  \midrule%
}{%
  \bottomrule%
  \end{tabular}%
  \end{table}%
}

%% ============================================================
%% ABI convention table
%% ============================================================
\NewDocumentEnvironment{abitable}{m}{%
  \begin{table}[htbp]%
  \centering%
  \renewcommand{\arraystretch}{1.15}%
  \caption{ABI conventions: #1}%
  \begin{tabular}{@{}llll@{}}%
  \toprule%
  \textbf{Register} & \textbf{Usage} & \textbf{Caller/Callee} & \textbf{Notes}\\
  \midrule%
}{%
  \bottomrule%
  \end{tabular}%
  \end{table}%
}

\endinput
