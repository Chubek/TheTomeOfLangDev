%%
%% cextcc-forth.sty — Forth / stack-based language display
%%
\ProvidesPackage{\@currpath cextcc-forth}[2026/11/12 Forth-style display for The Tome]

\RequirePackage{\@currpath cextcc-listing}
\RequirePackage{listings}
\RequirePackage{xparse}
\RequirePackage{xcolor}

%% ============================================================
%% Forth language definition
%% ============================================================
\lstdefinelanguage{ForthLang}{
  keywords={DUP,DROP,SWAP,OVER,ROT,NIP,TUCK,ROLL,PICK,DEPTH,STACK,>R,R>,R@,DOT,EMIT,TYPE,CR,SPACE,SPACES,ACCEPT,KEY,EXPECT,+,-,*,/,MOD,*/,ABS,NEGATE,MIN,MAX,AND,OR,XOR,INVERT,LSHIFT,RSHIFT,=,<,>,<=,>=,<>,0=,0<,IF,THEN,ELSE,ENDIF,BEGIN,UNTIL,AGAIN,WHILE,REPEAT,DO,LOOP,I,J,LEAVE,+LOOP,UNLOOP,CREATE,DOES,ALLOT,VARIABLE,CONSTANT,VALUE,TO,DEFER,IS,:,:,:NONAME,COMPILE,LITERAL,POSTPONE,[,],EVALUATE,HERE,LATEST,FIND,WORD,NUMBER,RECURSE,IMMEDIATE,STATE,DECIMAL,HEX,BASE,CELL,CELLS,CHAR,CHARS,ALIGN,ALIGNED,CELL},
  sensitive=true,
  morecomment=[l]{\\},
  morestring=[b]",
}

\lstnewenvironment{forthcode}[1][]{%
  \lstset{
    style=tomestyle,
    language=ForthLang,
    #1
  }%
}{}

%% Inline Forth word
\newcommand{\forthword}[1]{\texttt{#1}}

\endinput
