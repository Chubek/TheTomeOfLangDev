%%
%% cextcc-graph.sty — Graph and diagram utilities (CFG, call graphs, etc.)
%%
\ProvidesPackage{cextcc-graph}[2026/01/01 Graph utilities for The Tome]

\RequirePackage{tikz}
\RequirePackage{xparse}
\RequirePackage{xcolor}
\usetikzlibrary{
  arrows.meta,
  positioning,
  shapes.geometric,
  shapes.misc,
  calc,
  fit,
  backgrounds,
  decorations.pathreplacing,
  patterns,
  automata,
  matrix,
  graphs,
  quotes
}

\providecolor{TomeInk}{HTML}{1B2A4A}
\providecolor{TomeGold}{HTML}{B8860B}
\providecolor{TomeRule}{HTML}{4A4A4A}
\providecolor{TomeBg}{HTML}{F7F5F0}
\providecolor{TomeBgAlt}{HTML}{EDEAE3}

%% ============================================================
%% Common graph styles
%% ============================================================
\tikzset{
  tome graph/.style={
    >=Stealth,
    thick,
    node distance=1.5cm and 2cm,
    every node/.style={font=\small},
  },
  %% Control-flow graph nodes
  cfg block/.style={
    draw,
    rectangle,
    rounded corners=2pt,
    minimum width=2.5cm,
    minimum height=0.8cm,
    align=center,
    fill=TomeBg,
    draw=TomeInk,
    font=\ttfamily\small,
  },
  cfg entry/.style={
    cfg block,
    fill=TomeBgAlt,
    draw=TomeGold,
    shape=circle,
    minimum size=0.6cm,
  },
  cfg exit/.style={
    cfg block,
    fill=TomeBgAlt,
    draw=TomeGold,
    shape=circle,
    double,
    minimum size=0.6cm,
  },
  %% Data-flow graph nodes
  dfn node/.style={
    draw,
    circle,
    minimum size=0.6cm,
    fill=TomeBg,
    draw=TomeInk,
    font=\small,
  },
  dfn op/.style={
    draw,
    rectangle,
    rounded corners=1pt,
    minimum width=1cm,
    minimum height=0.5cm,
    fill=TomeBg,
    draw=TomeInk,
    font=\ttfamily\small,
  },
  %% Call graph nodes
  call node/.style={
    draw,
    rectangle,
    rounded corners=2pt,
    minimum width=2cm,
    minimum height=0.7cm,
    align=center,
    fill=TomeBg,
    draw=TomeInk,
    font=\ttfamily\small,
  },
  %% Edge styles
  cfg edge/.style={->, draw=TomeRule, thick},
  cfg back edge/.style={->, draw=TomeGold, thick, dashed},
  dfn edge/.style={->, draw=TomeInk},
  def edge/.style={->, draw=TomeInk, thick},
  use edge/.style={->, draw=TomeRule, dashed},
  dom edge/.style={->, draw=TomeInk, dotted},
  call edge/.style={->, draw=TomeInk, thick},
  %% Annotation
  graph annotation/.style={
    draw=TomeGold,
    fill=TomeBg,
    rounded corners=1pt,
    font=\itshape\small,
    text width=3cm,
    align=left,
  },
}

%% ============================================================
%% CFG environment
%% ============================================================
\NewDocumentEnvironment{cfgdiagram}{o}{%
  \begin{figure}[htbp]%
  \centering%
  \begin{tikzpicture}[tome graph,
    \IfValueT{#1}{#1}%
  ]%
}{%
  \end{tikzpicture}%
  \end{figure}%
}

%% ============================================================
%% Inline graph (no figure environment)
%% ============================================================
\NewDocumentEnvironment{cfginline}{o}{%
  \begin{center}%
  \begin{tikzpicture}[tome graph,
    \IfValueT{#1}{#1}%
  ]%
}{%
  \end{tikzpicture}%
  \end{center}%
}

%% ============================================================
%% Dominator tree style
%% ============================================================
\tikzset{
  dom tree node/.style={
    draw,
    circle,
    minimum size=0.8cm,
    fill=TomeBg,
    draw=TomeInk,
    font=\ttfamily\small,
  },
}

%% ============================================================
%% SSA phi-node visualization
%% ============================================================
\tikzset{
  phi node/.style={
    draw,
    rounded rectangle,
    rounded rectangle arc length=90,
    minimum width=1.5cm,
    minimum height=0.6cm,
    fill=TomeBg,
    draw=TomeInk,
    font=\ttfamily\small,
  },
}

\endinput
