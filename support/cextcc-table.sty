%%
%% cextcc-table.sty — Professional table styling
%%
\ProvidesPackage{\@currpath cextcc-table}[2026/11/12 Table styling for The Tome]

\RequirePackage{\@currpath cextcc-config}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{multirow}
\RequirePackage{multicol}
\RequirePackage{longtable}
\RequirePackage{tabularx}
\RequirePackage{dcolumn}
\RequirePackage{colortbl}
\RequirePackage{xcolor}
\RequirePackage{xparse}
\RequirePackage{ragged2e}
\RequirePackage{caption}

%% Captions are navigation, not another heading tier. Keep labels distinct,
%% multi-line captions left aligned, and table captions above their data.
\captionsetup{font=small,labelfont={sf,bf,color=TomeInk},
  textfont={color=TomeRule},labelsep=period,
  justification=raggedright,singlelinecheck=false,skip=8pt}
\captionsetup[table]{position=top}
\captionsetup[figure]{position=bottom}
\newcommand{\TomeTableSetup}{%
  \small\TomeUseLining%
  \renewcommand{\arraystretch}{1.18}%
  \setlength{\tabcolsep}{6pt}%
  \setlength{\extrarowheight}{1pt}%
  \arrayrulecolor{TomeRule!65!white}%
}
\AtBeginEnvironment{table}{\TomeTableSetup}
\AtBeginEnvironment{table*}{\TomeTableSetup}
%% Let long tables continue across pages. Constrain their prose columns
%% rather than scaling an entire multi-page table (and all of its text).
\newlength{\TomeLongTableMaxColumn}
\newcommand{\TomeLongTableSetup}{%
  \TomeTableSetup%
  \setlength{\TomeLongTableMaxColumn}{0.44\linewidth}%
  \let\TomeLongTableStartPbox\@startpbox
  \def\@startpbox##1{%
    \TomeLongTableStartPbox{%
      \ifdim\dimexpr##1\relax>\TomeLongTableMaxColumn
        \TomeLongTableMaxColumn
      \else ##1\fi
    }%
  }%
}
\AtBeginEnvironment{longtable}{\TomeLongTableSetup}
\setlength{\LTpre}{10pt plus 3pt minus 2pt}
\setlength{\LTpost}{10pt plus 3pt minus 2pt}

%% Existing chapters use fixed-width tabulars. Preserve their cells and
%% alignment, but keep oversized tables inside the local text measure.
\BeforeBeginEnvironment{tabular}{\begin{adjustbox}{max width=\linewidth}}
\AfterEndEnvironment{tabular}{\end{adjustbox}}

%% ============================================================
%% Column types
%% ============================================================
\newcolumntype{L}[1]{>{\RaggedRight\arraybackslash}p{#1}}
\newcolumntype{C}[1]{>{\centering\arraybackslash}p{#1}}
\newcolumntype{R}[1]{>{\raggedleft\arraybackslash}p{#1}}
\newcolumntype{Y}{>{\RaggedRight\arraybackslash}X}
\newcolumntype{Z}{>{\centering\arraybackslash}X}

%% ============================================================
%% Table styling commands
%% ============================================================
\newcommand{\tomecaption}[1]{%
  \caption{#1}%
}

%% Shaded table header row
\newcommand{\theader}[1]{%
  \rowcolor{TomeBgAlt}{\sffamily\bfseries\color{TomeInk}#1}%
}

%% ============================================================
%% Professional table environment with consistent spacing
%% ============================================================
\newenvironment{tometable}[1][htbp]{%
  \begin{table}[#1]%
  \centering%
  \TomeTableSetup%
}{%
  \end{table}%
}

%% Long table variant
\newenvironment{tomelongtable}{%
  \TomeTableSetup%
}{%
}

%% ============================================================
%% Comparison table (for comparing languages, tools, etc.)
%% ============================================================
\NewDocumentEnvironment{comparison}{m}{%
  \begin{table}[htbp]%
  \centering%
  \TomeTableSetup%
  \begin{tabular}{@{}l*{\the\numexpr#1-1\relax}{c}@{}}%
  \toprule%
}{%
  \bottomrule%
  \end{tabular}%
  \end{table}%
}

%% ============================================================
%% Feature matrix
%% ============================================================
\NewDocumentCommand{\featureyes}{}{{\color{TomeInk}\ensuremath{\checkmark}}}
\NewDocumentCommand{\featureno}{}{{\color{TomeRule}\textendash}}
\NewDocumentCommand{\featurepartial}{}{{\color{TomeGold}$\sim$}}

\endinput
