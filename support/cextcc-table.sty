%%
%% cextcc-table.sty — Professional table styling
%%
\ProvidesPackage{cextcc-table}[2026/01/01 Table styling for The Tome]

\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{multirow}
\RequirePackage{multicol}
\RequirePackage{longtable}
\RequirePackage{tabularx}
\RequirePackage{dcolumn}
\RequirePackage{colortbl}
\RequirePackage{xcolor}
\RequirePackage{xparse}

%% ============================================================
%% Column types
%% ============================================================
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}}
\newcolumntype{C}[1]{>{\centering\arraybackslash}p{#1}}
\newcolumntype{R}[1]{>{\raggedleft\arraybackslash}p{#1}}
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}
\newcolumntype{Z}{>{\centering\arraybackslash}X}

%% ============================================================
%% Table styling commands
%% ============================================================
\newcommand{\tomecaption}[1]{%
  \caption{\small\color{TomeInk}#1}%
}

%% Shaded table header row
\newcommand{\theader}[1]{%
  \rowcolor{TomeBg}\textbf{#1}%
}

%% ============================================================
%% Professional table environment with consistent spacing
%% ============================================================
\newenvironment{tometable}[1][htbp]{%
  \begin{table}[#1]%
  \centering%
  \renewcommand{\arraystretch}{1.15}%
  \setlength{\tabcolsep}{8pt}%
}{%
  \end{table}%
}

%% Long table variant
\newenvironment{tomelongtable}{%
  \renewcommand{\arraystretch}{1.15}%
  \setlength{\tabcolsep}{8pt}%
}{%
}

%% ============================================================
%% Comparison table (for comparing languages, tools, etc.)
%% ============================================================
\NewDocumentEnvironment{comparison}{m}{%
  \begin{table}[htbp]%
  \centering%
  \renewcommand{\arraystretch}{1.2}%
  \begin{tabular}{@{}l*{\the\numexpr#1-1\relax}{c}@{}}%
  \toprule%
}{%
  \bottomrule%
  \end{tabular}%
  \end{table}%
}

%% ============================================================
%% Feature matrix
%% ============================================================
\NewDocumentCommand{\featureyes}{}{{\color{TomeInk}\ensuremath{\checkmark}}}
\NewDocumentCommand{\featureno}{}{{\color{TomeRule}\textendash}}
\NewDocumentCommand{\featurepartial}{}{{\color{TomeGold}$\sim$}}

\endinput
