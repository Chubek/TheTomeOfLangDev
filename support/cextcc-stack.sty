%%
%% cextcc-stack.sty — Stack visualization
%%
\ProvidesPackage{\@currpath cextcc-stack}[2026/11/12 Stack visualization for The Tome]

\RequirePackage{\@currpath cextcc-diagram}
\RequirePackage{tikz}
\RequirePackage{xparse}
\RequirePackage{xcolor}
\usetikzlibrary{arrows.meta, positioning, calc, fit, backgrounds}

%% ============================================================
%% Stack frame styles
%% ============================================================
\tikzset{
  stack frame/.style={
    tome diagram node,
    draw,
    rectangle,
    minimum width=3cm,
    minimum height=0.5cm,
    fill=TomeBg,
    draw=TomeInk,
    font=\ttfamily\small,
    text width=2.8cm,
    align=center,
  },
  stack frame active/.style={
    stack frame,
    draw=TomeGold,
    very thick,
  },
  stack frame dead/.style={
    stack frame,
    draw=TomeRule,
    fill=TomeBgAlt,
    dashed,
  },
  stack pointer/.style={
    -Stealth,
    thick,
    draw=TomeGold,
  },
  stack grow/.style={
    font=\sffamily\footnotesize,
    draw=TomeRule,
  },
}

%% ============================================================
%% Stack diagram environment
%% ============================================================
\NewDocumentEnvironment{stackdiagram}{O{}}{%
  \begin{figure}[htbp]%
  \centering%
  \begin{tikzpicture}[
    tome diagram,
    node distance=0.1cm,
    #1%
  ]%
}{%
  \end{tikzpicture}%
  \end{figure}%
}

\endinput
