%%
%% cextcc-stack.sty — Stack visualization
%%
\ProvidesPackage{cextcc-stack}[2026/01/01 Stack visualization for The Tome]

\RequirePackage{tikz}
\RequirePackage{xparse}
\RequirePackage{xcolor}
\usetikzlibrary{arrows.meta, positioning, calc, fit, backgrounds}

\providecolor{TomeInk}{HTML}{1B2A4A}
\providecolor{TomeGold}{HTML}{B8860B}
\providecolor{TomeRule}{HTML}{4A4A4A}
\providecolor{TomeBg}{HTML}{F7F5F0}
\providecolor{TomeBgAlt}{HTML}{EDEAE3}

%% ============================================================
%% Stack frame styles
%% ============================================================
\tikzset{
  stack frame/.style={
    draw,
    rectangle,
    minimum width=3cm,
    minimum height=0.5cm,
    fill=TomeBg,
    draw=TomeInk,
    font=\ttfamily\small,
    text width=2.8cm,
    align=center,
  },
  stack frame active/.style={
    stack frame,
    draw=TomeGold,
    very thick,
  },
  stack frame dead/.style={
    stack frame,
    draw=TomeRule,
    fill=TomeBgAlt,
    opacity=0.6,
  },
  stack pointer/.style={
    -Stealth,
    thick,
    draw=TomeGold,
  },
  stack grow/.style={
    font=\small\itshape,
    draw=TomeRule,
  },
}

%% ============================================================
%% Stack diagram environment
%% ============================================================
\NewDocumentEnvironment{stackdiagram}{o}{%
  \begin{figure}[htbp]%
  \centering%
  \begin{tikzpicture}[
    >=Stealth,
    thick,
    node distance=0.1cm,
    \IfValueT{#1}{#1}%
  ]%
}{%
  \end{tikzpicture}%
  \end{figure}%
}

\endinput
