%%
%% cextcc-automta.sty — Automata and state machine diagrams
%%
\ProvidesPackage{\@currpath cextcc-automta}[2026/11/12 Automata diagrams for The Tome]

\RequirePackage{\@currpath cextcc-diagram}
\RequirePackage{\@currpath cextcc-table}
\RequirePackage{tikz}
\RequirePackage{xparse}
\RequirePackage{xcolor}
\usetikzlibrary{automata, positioning, arrows.meta, calc, quotes}

%% ============================================================
%% Automaton styles
%% ============================================================
\tikzset{
  tome automaton/.style={
    tome diagram,
    initial text=$\triangleright$,
    every state/.style={
      tome diagram node,
      draw=TomeInk,
      fill=TomeBg,
      minimum size=0.8cm,
      font=\small,
    },
    every edge/.style={
      draw=TomeRule,
      thick,
    },
    every edge quotes/.style={
      font=\sffamily\footnotesize,
      fill=white,
      inner sep=2pt,
    },
  },
  %% DFA state styles
  dfa accept/.style={
    accepting,
    draw=TomeGold,
    very thick,
  },
  dfa reject/.style={
    draw=TomeRule,
  },
  %% NFA highlighting
  nfa active/.style={
    draw=TomeGold,
    fill=TomeBgAlt,
    very thick,
  },
}

%% ============================================================
%% Automaton figure environment
%% ============================================================
\NewDocumentEnvironment{automatonfig}{O{}}{%
  \begin{figure}[htbp]%
  \centering%
  \begin{tikzpicture}[tome automaton,#1]%
}{%
  \end{tikzpicture}%
  \end{figure}%
}

%% ============================================================
%% Transition table for automata
%% ============================================================
\NewDocumentEnvironment{transitiontable}{m O{10}}{%
  \begin{table}[htbp]%
  \centering%
  \TomeTableSetup%
  \caption{Transition table: #1}%
  \begin{tabular}{@{}l*{#2}{c}@{}}%
  \toprule
}{%
  \bottomrule
  \end{tabular}%
  \end{table}%
}

%% ============================================================
%% Pushdown automaton styles
%% ============================================================
\tikzset{
  pda state/.style={
    tome diagram node,
    draw,
    circle,
    minimum size=0.8cm,
    fill=TomeBg,
    draw=TomeInk,
    font=\small,
  },
  pda stack/.style={
    draw,
    rectangle,
    minimum width=1cm,
    minimum height=0.3cm,
    fill=TomeBg,
    draw=TomeInk,
    font=\ttfamily\footnotesize,
  },
}

%% ============================================================
%% Turing machine tape
%% ============================================================
\tikzset{
  tm cell/.style={
    tome diagram node,
    draw,
    rectangle,
    minimum width=0.6cm,
    minimum height=0.6cm,
    fill=TomeBg,
    draw=TomeInk,
    font=\ttfamily\small,
  },
  tm head/.style={
    draw,
    isosceles triangle,
    isosceles triangle apex angle=60,
    shape border rotate=90,
    fill=TomeGold,
    draw=TomeInk,
    minimum size=0.4cm,
  },
}

\endinput
