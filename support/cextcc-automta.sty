%%
%% cextcc-automta.sty — Automata and state machine diagrams
%%
\ProvidesPackage{cextcc-automta}[2026/01/01 Automata diagrams for The Tome]

\RequirePackage{tikz}
\RequirePackage{xparse}
\RequirePackage{xcolor}
\usetikzlibrary{automata, positioning, arrows.meta, calc, quotes}

\providecolor{TomeInk}{HTML}{1B2A4A}
\providecolor{TomeGold}{HTML}{B8860B}
\providecolor{TomeRule}{HTML}{4A4A4A}
\providecolor{TomeBg}{HTML}{F7F5F0}

%% ============================================================
%% Automaton styles
%% ============================================================
\tikzset{
  tome automaton/.style={
    >=Stealth,
    thick,
    initial text=$\triangleright$,
    every state/.style={
      draw=TomeInk,
      fill=TomeBg,
      minimum size=0.8cm,
      font=\small,
    },
    every edge/.style={
      draw=TomeRule,
      thick,
    },
    every edge quotes/.style={
      font=\small\itshape,
      fill=TomeBg,
      inner sep=2pt,
    },
  },
  %% DFA state styles
  dfa accept/.style={
    accepting,
    draw=TomeGold,
    very thick,
  },
  dfa reject/.style={
    draw=TomeRule,
  },
  %% NFA highlighting
  nfa active/.style={
    draw=TomeGold,
    fill=TomeBgAlt,
    very thick,
  },
}

%% ============================================================
%% Automaton figure environment
%% ============================================================
\NewDocumentEnvironment{automatonfig}{o}{%
  \begin{figure}[htbp]%
  \centering%
  \begin{tikzpicture}[tome automaton,
    \IfValueT{#1}{#1}%
  ]%
}{%
  \end{tikzpicture}%
  \end{figure}%
}

%% ============================================================
%% Transition table for automata
%% ============================================================
\NewDocumentEnvironment{transitiontable}{m}{%
  \begin{table}[htbp]%
  \centering%
  \renewcommand{\arraystretch}{1.2}%
  \caption{Transition table: #1}%
  \begin{tabular}{l|*{10}{c}}%
}{%
  \end{tabular}%
  \end{table}%
}

%% ============================================================
%% Pushdown automaton styles
%% ============================================================
\tikzset{
  pda state/.style={
    draw,
    circle,
    minimum size=0.8cm,
    fill=TomeBg,
    draw=TomeInk,
    font=\small,
  },
  pda stack/.style={
    draw,
    rectangle,
    minimum width=1cm,
    minimum height=0.3cm,
    fill=TomeBg,
    draw=TomeInk,
    font=\ttfamily\tiny,
  },
}

%% ============================================================
%% Turing machine tape
%% ============================================================
\tikzset{
  tm cell/.style={
    draw,
    rectangle,
    minimum width=0.6cm,
    minimum height=0.6cm,
    fill=TomeBg,
    draw=TomeInk,
    font=\ttfamily\small,
  },
  tm head/.style={
    draw,
    isosceles triangle,
    isosceles triangle apex angle=60,
    shape border rotate=90,
    fill=TomeGold,
    draw=TomeInk,
    minimum size=0.4cm,
  },
}

\endinput
