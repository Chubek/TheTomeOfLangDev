%%
%% cextcc-tyepthm.sty — Type theory and type rule environments
%%
\ProvidesPackage{cextcc-tyepthm}[2026/01/01 Type theory environments for The Tome]

\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{xparse}
\RequirePackage{xcolor}
\RequirePackage{tcolorbox}

\providecolor{TomeBg}{HTML}{F7F5F0}
\providecolor{TomeInk}{HTML}{1B2A4A}
\providecolor{TomeRule}{HTML}{4A4A4A}

%% ============================================================
%% Type-theoretic notation
%% ============================================================
\newcommand{\tyjudg}[3]{#1 \vdash #2 : #3}
\newcommand{\tyjudgEq}[4]{#1 \vdash #2 = #3 : #4}
\newcommand{\tywf}[2]{#1 \vdash #2 \;\mathrm{type}}
\newcommand{\subty}[3]{#1 \vdash #2 <: #3}
\newcommand{\tyenv}{\Gamma}
\newcommand{\kindenv}{\Delta}
\newcommand{\kjudg}[2]{#1 \vdash #2 \;\mathrm{kind}}

%% Type constructors
\newcommand{\funTy}[2]{#1 \to #2}
\newcommand{\prodTy}[2]{#1 \times #2}
\newcommand{\sumTy}[2]{#1 + #2}
\newcommand{\forallTy}[2]{\forall #1.\,#2}
\newcommand{\existsTy}[2]{\exists #1.\,#2}
\newcommand{\muTy}[2]{\mu #1.\,#2}
\newcommand{\nuTy}[2]{\nu #1.\,#2}
\newcommand{\depFunTy}[3]{\Pi #1{:}#2.\,#3}
\newcommand{\depSigTy}[3]{\Sigma #1{:}#2.\,#3}
\newcommand{\linFunTy}[2]{#1 \multimap #2}
\newcommand{\bangTy}[1]{\mathord{!}#1}

%% ============================================================
%% Type rule environment
%% ============================================================
\NewDocumentEnvironment{typerules}{m}{%
  \begin{tcolorbox}[%
    enhanced,
    arc=1pt,
    boxrule=0.6pt,
    colback=TomeBg,
    colframe=TomeInk,
    title={Type Rules: #1},
    coltitle=white,
    fonttitle=\bfseries\small,
    before skip=12pt,
    after skip=12pt,
  ]%
  \[\begin{array}{l}%
}{%
  \end{array}\]%
  \end{tcolorbox}%
}

%% -- Single type rule with name
\NewDocumentCommand{\typerule}{m m m}{%
  \textsc{#1}\quad
  \dfrac{\displaystyle #2}{\displaystyle #3}%
  \qquad
}

%% -- Axiom (no premises)
\NewDocumentCommand{\typeaxiom}{m m}{%
  \textsc{#1}\quad
  \overline{\displaystyle #2}%
  \qquad
}

%% ============================================================
%% Kinding rules
%% ============================================================
\NewDocumentEnvironment{kindrules}{m}{%
  \begin{tcolorbox}[%
    enhanced,
    arc=1pt,
    boxrule=0.6pt,
    colback=TomeBg,
    colframe=TomeInk,
    title={Kinding Rules: #1},
    coltitle=white,
    fonttitle=\bfseries\small,
    before skip=12pt,
    after skip=12pt,
  ]%
  \[\begin{array}{l}%
}{%
  \end{array}\]%
  \end{tcolorbox}%
}

%% ============================================================
%% Subtyping rules
%% ============================================================
\NewDocumentEnvironment{subtyrules}{m}{%
  \begin{tcolorbox}[%
    enhanced,
    arc=1pt,
    boxrule=0.6pt,
    colback=TomeBg,
    colframe=TomeInk,
    title={Subtyping Rules: #1},
    coltitle=white,
    fonttitle=\bfseries\small,
    before skip=12pt,
    after skip=12pt,
  ]%
  \[\begin{array}{l}%
}{%
  \end{array}\]%
  \end{tcolorbox}%
}

%% ============================================================
%% Inference rule helpers
%% ============================================================
\newcommand{\inferrule}[3][]{%
  \dfrac{\displaystyle #2}{\displaystyle #3}%
  \IfValueT{#1}{\;\textsc{#1}}%
}

\newcommand{\inferaxiom}[2][]{%
  \overline{\displaystyle #2}%
  \IfValueT{#1}{\;\textsc{#1}}%
}

%% ============================================================
%% Type erasure
%% ============================================================
\newcommand{\erase}[1]{\ensuremath{|#1|}}
\newcommand{\untype}[1]{\ensuremath{\lfloor #1 \rfloor}}

%% ============================================================
%% Principal types and unification
%% ============================================================
\newcommand{\principalTy}[2]{\ensuremath{#1 :: #2}}
\newcommand{\mgu}{\ensuremath{\mathrm{mgu}}}
\newcommand{\unify}[2]{\ensuremath{\mathrm{unify}(#1, #2)}}

\endinput
