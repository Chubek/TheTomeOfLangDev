%%
%% cextcc-semantics.sty — General semantic framework commands
%%
\ProvidesPackage{\@currpath cextcc-semantics}[2026/11/12 General semantics framework for The Tome]

\RequirePackage{\@currpath cextcc-config}
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{xparse}
\RequirePackage{xcolor}

%% ============================================================
%% Domain and value constructors
%% ============================================================
\newcommand{\Val}{\ensuremath{\mathbf{Val}}}
\newcommand{\Var}{\ensuremath{\mathbf{Var}}}
\newcommand{\Name}{\ensuremath{\mathbf{Name}}}
\newcommand{\sig}{\ensuremath{\mathbf{sig}}}
\newcommand{\struct}{\ensuremath{\mathbf{struct}}}
\newcommand{\finfun}{\mathrel{\rightharpoonup_{\mathrm{fin}}}}
\newcommand{\finto}{\finfun}
\newcommand{\Env}{\ensuremath{\mathbf{Env}}}
\newcommand{\StateDomain}{\ensuremath{\mathbf{State}}}
%% Preserve algorithmic's statement command while supporting semantic domains.
\let\TomeAlgorithmState\State
\DeclareRobustCommand{\State}{\ifmmode\StateDomain\else\TomeAlgorithmState\fi}
\newcommand{\Store}{\ensuremath{\mathbf{Store}}}
\newcommand{\Loc}{\ensuremath{\mathbf{Loc}}}
\newcommand{\Addr}{\ensuremath{\mathbf{Addr}}}
\newcommand{\Cont}{\ensuremath{\mathbf{Cont}}}
\newcommand{\Ans}{\ensuremath{\mathbf{Ans}}}
\newcommand{\Error}{\ensuremath{\mathbf{Error}}}
\newcommand{\shift}{\ensuremath{\mathbf{shift}}}
\newcommand{\reset}{\ensuremath{\mathbf{reset}}}
\newcommand{\ProcDomain}{\ensuremath{\mathbf{Proc}}}
\newcommand{\Expr}{\ensuremath{\mathbf{Expr}}}
\newcommand{\Stmt}{\ensuremath{\mathbf{Stmt}}}
\newcommand{\Decl}{\ensuremath{\mathbf{Decl}}}
\newcommand{\Com}{\ensuremath{\mathbf{Com}}}
\newcommand{\Type}{\ensuremath{\mathbf{Type}}}
\newcommand{\Kind}{\ensuremath{\mathbf{Kind}}}
\newcommand{\Prop}{\ensuremath{\mathbf{Prop}}}
\newcommand{\Bool}{\ensuremath{\mathbf{Bool}}}
\newcommand{\unit}{\ensuremath{\mathbf{unit}}}
\newcommand{\Int}{\ensuremath{\mathbf{Int}}}
\newcommand{\Nat}{\ensuremath{\mathbb{N}}}
\newcommand{\Z}{\ensuremath{\mathbb{Z}}}
\newcommand{\Q}{\ensuremath{\mathbb{Q}}}
\newcommand{\R}{\ensuremath{\mathbb{R}}}
\newcommand{\C}{\ensuremath{\mathbb{C}}}

%% ============================================================
%% Semantic function notation
%% ============================================================
%% Robust notation survives captions, running heads, and contents entries.
\DeclareRobustCommand{\semE}{\ensuremath{\mathcal{E}}}   %% expression semantics
\DeclareRobustCommand{\semB}{\ensuremath{\mathcal{B}}}   %% boolean semantics
\newcommand{\semS}{\ensuremath{\mathcal{S}}}   %% statement semantics
\newcommand{\semD}{\ensuremath{\mathcal{D}}}   %% declaration semantics
\newcommand{\semP}{\ensuremath{\mathcal{P}}}   %% program semantics
\DeclareRobustCommand{\semC}{\ensuremath{\mathcal{C}}}   %% continuation semantics
\newcommand{\semK}{\ensuremath{\mathcal{K}}}   %% continuation function
\newcommand{\bind}{\mathbin{>\!\!>\!\!=}}
\newcommand{\concat}{\mathbin{+\!\!+}}
\newcommand{\banana}[1]{\ensuremath{(\!|#1|\!)}}
\newcommand{\ana}[1]{\ensuremath{[\!(#1)\!]}}
\DeclareRobustCommand{\Sat}[1]{\ensuremath{\operatorname{Sat}(#1)}}

%% ============================================================
%% Lattice and order notation
%% ============================================================
%% Lattice symbols are supplied by the math packages.
\newcommand{\bottom}{\ensuremath{\bot}}
\newcommand{\lub}{\ensuremath{\operatorname{lub}}}
\newcommand{\glb}{\ensuremath{\operatorname{glb}}}

%% ============================================================
%% Abstract interpretation notation
%% ============================================================
\newcommand{\abs}[1]{\ensuremath{#1^\sharp}}
\newcommand{\conc}[1]{\ensuremath{#1^\flat}}
\newcommand{\gammaAI}{\ensuremath{\gamma}}
\newcommand{\alphaAI}{\ensuremath{\alpha}}
\newcommand{\absfun}[2]{\ensuremath{#1^\sharp(#2)}}
\newcommand{\concretize}[1]{\ensuremath{\gamma(#1)}}
\newcommand{\abstract}[1]{\ensuremath{\alpha(#1)}}

%% ============================================================
%% Fixpoint notation
%% ============================================================
\newcommand{\lfp}{\ensuremath{\operatorname{lfp}}}
\newcommand{\gfp}{\ensuremath{\operatorname{gfp}}}
\newcommand{\fixpoint}[1]{\ensuremath{\mathrm{fix}(#1)}}
\newcommand{\iterate}[2]{\ensuremath{#1^{#2}}}

\endinput
