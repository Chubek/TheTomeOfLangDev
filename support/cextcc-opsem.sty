%%
%% cextcc-opsem.sty — Operational semantics environments
%%
\ProvidesPackage{cextcc-opsem}[2026/01/01 Operational semantics for The Tome]

\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{xparse}
\RequirePackage{xcolor}
\RequirePackage{tcolorbox}

\providecolor{TomeBg}{HTML}{F7F5F0}
\providecolor{TomeInk}{HTML}{1B2A4A}
\providecolor{TomeRule}{HTML}{4A4A4A}

%% ============================================================
%% Semantic brackets
%% ============================================================
\newcommand{\SemBrack}[1]{\ensuremath{\llbracket #1 \rrbracket}}
\newcommand{\bigSemBrack}[1]{\ensuremath{\bigl\llbracket #1 \bigr\rrbracket}}
\newcommand{\BigSemBrack}[1]{\ensuremath{\Bigl\llbracket #1 \Bigr\rrbracket}}

%% ============================================================
%% Transition relations
%% ============================================================
\newcommand{\step}[3]{#1 \longrightarrow #2 \quad #3}
\newcommand{\bigstep}[3]{#1 \Downarrow #2 \quad #3}
\newcommand{\smallstep}[3]{#1 \xrightarrow{#3} #2}
\newcommand{\labelstep}[2]{\xrightarrow{#1}_{#2}}

%% Multi-step
\newcommand{\mstep}{\longrightarrow^*}
\newcommand{\nstep}[1]{\longrightarrow^{#1}}

%% ============================================================
%% Inference rule for semantic rules
%% ============================================================
\NewDocumentCommand{\semrule}{m m m}{%
  \frac{\displaystyle #1}{\displaystyle #2}
  \quad \text{#3}%
}

\NewDocumentCommand{\semruleaxiom}{m m}{%
  \overline{#1}
  \quad \text{#2}%
}

%% Named rule with premises over line and conclusion
\NewDocumentCommand{\namedrule}{m m m}{%
  \textsc{#1}\quad
  \frac{\displaystyle #2}{\displaystyle #3}%
}

%% ============================================================
%% Semantic rule environment (numbered, in a box)
%% ============================================================
\NewDocumentEnvironment{semrules}{m}{%
  \begin{tcolorbox}[%
    enhanced,
    arc=1pt,
    boxrule=0.6pt,
    colback=TomeBg,
    colframe=TomeInk,
    title={#1},
    coltitle=white,
    fonttitle=\bfseries\small,
    before skip=12pt,
    after skip=12pt,
  ]%
  \[\begin{array}{r@{}ll}%
}{%
  \end{array}\]%
  \end{tcolorbox}%
}

%% ============================================================
%% Evaluation contexts
%% ============================================================
\newcommand{\evalctx}[1]{\ensuremath{\mathcal{E}[#1]}}
\newcommand{\hole}{\ensuremath{[\,]}}
\newcommand{\fillctx}[2]{\ensuremath{#1\{#2\}}}

%% ============================================================
%% Configuration notation
%% ============================================================
\NewDocumentCommand{\config}{m g g g}{%
  \ensuremath{\langle #1\IfValueT{#2}{, #2}\IfValueT{#3}{, #3}\IfValueT{#4}{, #4}\rangle}%
}
\newcommand{\bconfig}[1]{\ensuremath{\langle #1 \rangle}}
\newcommand{\tconfig}[1]{\ensuremath{\langle #1 \rangle}}

%% ============================================================
%% Store / environment notation
%% ============================================================
\newcommand{\storemap}[2]{\ensuremath{#1 \mapsto #2}}
\newcommand{\storeupdate}[3]{\ensuremath{#1[#2 \mapsto #3]}}
\newcommand{\envlookup}[2]{\ensuremath{#1(#2)}}
\newcommand{\envextend}[3]{\ensuremath{#1[#2 \mapsto #3]}}

%% ============================================================
%% Big-step evaluation
%% ============================================================
\NewDocumentEnvironment{bigstepsem}{m}{%
  \begin{tcolorbox}[%
    enhanced,
    arc=1pt,
    boxrule=0.6pt,
    colback=TomeBg,
    colframe=TomeInk,
    title={Big-Step Semantics: #1},
    coltitle=white,
    fonttitle=\bfseries\small,
    before skip=12pt,
    after skip=12pt,
  ]%
  \begin{align*}%
}{%
  \end{align*}%
  \end{tcolorbox}%
}

%% Small-step semantics
\NewDocumentEnvironment{smallstepsem}{m}{%
  \begin{tcolorbox}[%
    enhanced,
    arc=1pt,
    boxrule=0.6pt,
    colback=TomeBg,
    colframe=TomeInk,
    title={Small-Step Semantics: #1},
    coltitle=white,
    fonttitle=\bfseries\small,
    before skip=12pt,
    after skip=12pt,
  ]%
  \begin{align*}%
}{%
  \end{align*}%
  \end{tcolorbox}%
}

\endinput
