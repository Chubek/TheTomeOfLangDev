%%
%% cextcc-threded-code.sty — Threaded code display
%%
\ProvidesPackage{\@currpath cextcc-threded-code}[2026/11/12 Threaded code display for The Tome]

\RequirePackage{\@currpath cextcc-listing}
\RequirePackage{\@currpath cextcc-diagram}
\RequirePackage{listings}
\RequirePackage{tikz}
\RequirePackage{xparse}
\RequirePackage{xcolor}
\usetikzlibrary{arrows.meta, positioning, calc}

%% ============================================================
%% Threaded code listing style
%% ============================================================
\lstdefinestyle{threadedstyle}{
  style=tomestyle,
  keywordstyle=\bfseries\color{TomeInk},
}

\lstnewenvironment{threadedcode}[1][]{%
  \lstset{style=threadedstyle,#1}%
}{}

%% ============================================================
%% Threaded code visualization (next-code-pointer diagram)
%% ============================================================
\tikzset{
  threaded cell/.style={
    tome diagram node,
    draw,
    rectangle,
    minimum width=1.5cm,
    minimum height=0.6cm,
    fill=TomeBg,
    draw=TomeInk,
    font=\ttfamily\small,
    align=center,
  },
  threaded ip/.style={
    -Stealth,
    thick,
    draw=TomeGold,
  },
  threaded link/.style={
    ->,
    dashed,
    draw=TomeRule,
  },
}

\NewDocumentEnvironment{threadeddiagram}{O{}}{%
  \begin{center}%
  \begin{tikzpicture}[
    tome diagram,
    node distance=0.3cm,
    #1%
  ]%
}{%
  \end{tikzpicture}%
  \end{center}%
}

\endinput
