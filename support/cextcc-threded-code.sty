%%
%% cextcc-threded-code.sty — Threaded code display
%%
\ProvidesPackage{cextcc-threded-code}[2026/01/01 Threaded code display for The Tome]

\RequirePackage{listings}
\RequirePackage{tikz}
\RequirePackage{xparse}
\RequirePackage{xcolor}
\usetikzlibrary{arrows.meta, positioning, calc}

\providecolor{TomeBg}{HTML}{F7F5F0}
\providecolor{TomeInk}{HTML}{1B2A4A}
\providecolor{TomeRule}{HTML}{4A4A4A}
\providecolor{TomeGold}{HTML}{B8860B}

%% ============================================================
%% Threaded code listing style
%% ============================================================
\lstdefinestyle{threadedstyle}{
  basicstyle=\ttfamily\small,
  keywordstyle=\bfseries\color{TomeInk},
  commentstyle=\itshape\color{TomeCodeCmt},
  backgroundcolor=\color{TomeBg},
  frame=single,
  rulecolor=\color{TomeRule},
  framerule=0.4pt,
  breaklines=true,
  tabsize=4,
  showstringspaces=false,
  columns=fullflexible,
  numbers=left,
  numbersep=6pt,
  xleftmargin=16pt,
  aboveskip=8pt,
  belowskip=8pt,
}

\lstnewenvironment{threadedcode}[1][]{%
  \lstset{style=threadedstyle,#1}%
}{}

%% ============================================================
%% Threaded code visualization (next-code-pointer diagram)
%% ============================================================
\tikzset{
  threaded cell/.style={
    draw,
    rectangle,
    minimum width=1.5cm,
    minimum height=0.6cm,
    fill=TomeBg,
    draw=TomeInk,
    font=\ttfamily\small,
    align=center,
  },
  threaded ip/.style={
    -Stealth,
    thick,
    draw=TomeGold,
  },
  threaded link/.style={
    ->,
    dashed,
    draw=TomeRule,
  },
}

\NewDocumentEnvironment{threadeddiagram}{o}{%
  \begin{center}%
  \begin{tikzpicture}[
    >=Stealth,
    thick,
    node distance=0.3cm,
    \IfValueT{#1}{#1}%
  ]%
}{%
  \end{tikzpicture}%
  \end{center}%
}

\endinput
