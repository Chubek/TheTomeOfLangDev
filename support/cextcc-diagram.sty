%%
%% cextcc-diagram.sty — General TikZ diagram utilities
%%
\ProvidesPackage{cextcc-diagram}[2026/01/01 General diagram utilities for The Tome]

\RequirePackage{tikz}
\RequirePackage{xparse}
\RequirePackage{xcolor}
\usetikzlibrary{
  arrows.meta,
  positioning,
  shapes.geometric,
  shapes.multipart,
  shapes.symbols,
  calc,
  fit,
  backgrounds,
  decorations.pathreplacing,
  decorations.markings,
  patterns,
  matrix,
  trees,
  scopes,
  chains,
  mindmap,
}

\providecolor{TomeInk}{HTML}{1B2A4A}
\providecolor{TomeGold}{HTML}{B8860B}
\providecolor{TomeRule}{HTML}{4A4A4A}
\providecolor{TomeBg}{HTML}{F7F5F0}
\providecolor{TomeBgAlt}{HTML}{EDEAE3}

%% ============================================================
%% General diagram styles
%% ============================================================
\tikzset{
  tome diagram/.style={
    >=Stealth,
    thick,
    every node/.style={font=\small},
  },
  %% Box styles
  tome box/.style={
    draw,
    rectangle,
    rounded corners=2pt,
    minimum width=2cm,
    minimum height=0.8cm,
    align=center,
    fill=TomeBg,
    draw=TomeInk,
  },
  tome box accent/.style={
    tome box,
    draw=TomeGold,
  },
  tome box dark/.style={
    tome box,
    fill=TomeInk,
    text=white,
    draw=TomeInk,
  },
  %% Pipeline stage
    pipeline stage/.style={
    draw,
    rectangle,
    rounded corners=4pt,
    minimum width=2.5cm,
    minimum height=1cm,
    align=center,
    fill=TomeBg,
    draw=TomeInk,
    font=\small\bfseries,
  },
  %% Arrow styles
  tome arrow/.style={->, thick, draw=TomeInk},
  tome dashed/.style={->, thick, dashed, draw=TomeRule},
  tome double/.style={<->, thick, draw=TomeInk},
  %% Grouping
  tome group/.style={
    draw,
    rounded corners=4pt,
    dashed,
    draw=TomeRule,
    fill=TomeBg,
    fill opacity=0.3,
    inner sep=8pt,
  },
  %% Annotation
  tome note/.style={
    draw=TomeGold,
    fill=TomeBg,
    rounded corners=2pt,
    font=\itshape\small,
    text width=3cm,
    align=left,
    inner sep=6pt,
  },
}

%% ============================================================
%% Figure-wrapped diagram
%% ============================================================
\NewDocumentEnvironment{tomefigure}{o}{%
  \begin{figure}[htbp]%
  \centering%
}{%
  \end{figure}%
}

%% ============================================================
%% Standalone centered diagram
%% ============================================================
\NewDocumentEnvironment{tomediagram}{o}{%
  \begin{center}%
  \begin{tikzpicture}[tome diagram,
    \IfValueT{#1}{#1}%
  ]%
}{%
  \end{tikzpicture}%
  \end{center}%
}

%% ============================================================
%% AST tree styles
%% ============================================================
\tikzset{
  ast node/.style={
    draw,
    circle,
    minimum size=0.6cm,
    fill=TomeBg,
    draw=TomeInk,
    font=\ttfamily\footnotesize,
  },
  ast leaf/.style={
    draw,
    rectangle,
    rounded corners=1pt,
    minimum width=0.8cm,
    minimum height=0.4cm,
    fill=TomeBgAlt,
    draw=TomeRule,
    font=\ttfamily\footnotesize,
  },
  ast tree/.style={
    tome diagram,
    level 1/.style={sibling distance=3cm, level distance=1.2cm},
    level 2/.style={sibling distance=1.5cm, level distance=1.2cm},
    level 3/.style={sibling distance=1cm, level distance=1cm},
    edge from parent/.style={draw, thick, -Stealth},
  },
}

%% ============================================================
%% Memory layout diagram
%% ============================================================
\tikzset{
  mem cell/.style={
    draw,
    rectangle,
    minimum width=1cm,
    minimum height=0.5cm,
    fill=TomeBg,
    draw=TomeInk,
    font=\ttfamily\tiny,
  },
  mem word/.style={
    draw,
    rectangle,
    minimum width=2cm,
    minimum height=0.5cm,
    fill=TomeBg,
    draw=TomeInk,
    font=\ttfamily\small,
  },
  mem stack frame/.style={
    draw,
    rectangle,
    minimum width=4cm,
    minimum height=0.6cm,
    fill=TomeBg,
    draw=TomeInk,
    font=\ttfamily\small,
    text width=3.5cm,
    align=center,
  },
}

\endinput
