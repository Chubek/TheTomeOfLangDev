%%
%% cextcc-diagram.sty — General TikZ diagram utilities
%%
\ProvidesPackage{\@currpath cextcc-diagram}[2026/11/12 General diagram utilities for The Tome]

\RequirePackage{\@currpath cextcc-config}
\RequirePackage{tikz}
\RequirePackage{xparse}
\RequirePackage{xcolor}
\usetikzlibrary{
  arrows.meta,
  positioning,
  shapes.geometric,
  shapes.multipart,
  shapes.symbols,
  calc,
  fit,
  backgrounds,
  decorations.pathreplacing,
  decorations.markings,
  patterns,
  matrix,
  trees,
  scopes,
  chains,
  mindmap,
}

%% Apply the width guard to raw chapter pictures as well as the wrappers.
%% It respects minipages and box widths and never enlarges a small figure.
\BeforeBeginEnvironment{tikzpicture}{\begin{adjustbox}{max width=\linewidth}}
\AfterEndEnvironment{tikzpicture}{\end{adjustbox}}

%% ============================================================
%% General diagram styles
%% ============================================================
\tikzset{
  tome diagram/.style={
    >={Stealth[length=5pt,width=4pt]},
    line width=0.65pt,line cap=round,line join=round,
    every node/.append style={font=\sffamily\small,text=TomeInk},
    every edge quotes/.append style={font=\sffamily\footnotesize,
      text=TomeRule,fill=white,inner sep=2pt},
  },
  tome diagram node/.style={
    line width=0.65pt,text=TomeInk,
    inner xsep=6pt,inner ysep=4pt,
    font=\sffamily\small,
  },
  %% Box styles
  tome box/.style={
    tome diagram node,
    draw,
    rectangle,
    rounded corners=1.5pt,
    minimum width=2cm,
    minimum height=0.8cm,
    align=center,
    fill=TomeBg,
    draw=TomeInk,
  },
  tome box accent/.style={
    tome box,
    draw=TomeGold,
  },
  tome box dark/.style={
    tome box,
    fill=TomeInk,
    text=white,
    draw=TomeInk,
  },
  %% Pipeline stage
  pipeline stage/.style={
    tome diagram node,
    draw,
    rectangle,
    rounded corners=1.5pt,
    minimum width=2.5cm,
    minimum height=1cm,
    align=center,
    fill=TomeBg,
    draw=TomeInk,
    font=\sffamily\small\bfseries,
  },
  %% Arrow styles
  tome arrow/.style={->, thick, draw=TomeInk},
  tome dashed/.style={->, thick, dashed, draw=TomeRule},
  tome double/.style={<->, thick, draw=TomeInk},
  %% Grouping
  tome group/.style={
    draw,
    rounded corners=4pt,
    dashed,
    draw=TomeRule,
    fill=TomeBg,
    fill opacity=0.3,text opacity=1,
    inner sep=8pt,
  },
  %% Annotation
  tome note/.style={
    draw=TomeGold,
    fill=TomeBg,
    rounded corners=2pt,
    font=\sffamily\footnotesize,
    text width=3cm,
    align=left,
    inner sep=6pt,
  },
}

%% ============================================================
%% Figure-wrapped diagram
%% ============================================================
\NewDocumentEnvironment{tomefigure}{O{htbp}}{%
  \begin{figure}[#1]%
  \centering%
}{%
  \end{figure}%
}

%% ============================================================
%% Standalone centered diagram
%% ============================================================
\NewDocumentEnvironment{tomediagram}{O{}}{%
  \begin{center}%
  \begin{tikzpicture}[tome diagram,#1]%
}{%
  \end{tikzpicture}%
  \end{center}%
}

%% ============================================================
%% AST tree styles
%% ============================================================
\tikzset{
  ast node/.style={
    tome diagram node,
    draw,
    circle,
    minimum size=0.6cm,
    fill=TomeBg,
    draw=TomeInk,
    font=\ttfamily\small,
  },
  ast leaf/.style={
    tome diagram node,
    draw,
    rectangle,
    rounded corners=1pt,
    minimum width=0.8cm,
    minimum height=0.4cm,
    fill=TomeBgAlt,
    draw=TomeRule,
    font=\ttfamily\small,
  },
  ast tree/.style={
    tome diagram,
    level 1/.style={sibling distance=3cm, level distance=1.2cm},
    level 2/.style={sibling distance=1.5cm, level distance=1.2cm},
    level 3/.style={sibling distance=1cm, level distance=1cm},
    edge from parent/.style={draw, thick, -Stealth},
  },
}

%% ============================================================
%% Memory layout diagram
%% ============================================================
\tikzset{
  mem cell/.style={
    tome diagram node,
    draw,
    rectangle,
    minimum width=1cm,
    minimum height=0.5cm,
    fill=TomeBg,
    draw=TomeInk,
    font=\ttfamily\footnotesize,
  },
  mem word/.style={
    tome diagram node,
    draw,
    rectangle,
    minimum width=2cm,
    minimum height=0.5cm,
    fill=TomeBg,
    draw=TomeInk,
    font=\ttfamily\small,
  },
  mem stack frame/.style={
    tome diagram node,
    draw,
    rectangle,
    minimum width=4cm,
    minimum height=0.6cm,
    fill=TomeBg,
    draw=TomeInk,
    font=\ttfamily\small,
    text width=3.5cm,
    align=center,
  },
}

\endinput
