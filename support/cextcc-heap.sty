%%
%% cextcc-heap.sty — Heap / memory visualization
%%
\ProvidesPackage{\@currpath cextcc-heap}[2026/11/12 Heap visualization for The Tome]

\RequirePackage{\@currpath cextcc-diagram}
\RequirePackage{tikz}
\RequirePackage{xparse}
\RequirePackage{xcolor}
\usetikzlibrary{
  arrows.meta,
  positioning,
  shapes.geometric,
  fit,
  backgrounds,
  calc,
  decorations.pathreplacing,
}

%% ============================================================
%% Heap object styles
%% ============================================================
\tikzset{
  heap object/.style={
    tome diagram node,
    draw,
    rectangle,
    rounded corners=2pt,
    minimum width=1.5cm,
    minimum height=0.6cm,
    fill=TomeBg,
    draw=TomeInk,
    font=\ttfamily\small,
    align=center,
  },
  heap pointer/.style={
    ->,
    thick,
    draw=TomeInk,
    -Stealth,
  },
  heap free/.style={
    heap object,
    fill=TomeBgAlt,
    draw=TomeRule,
    pattern=north east lines,
    pattern color=TomeRule!45!white,
  },
  heap allocated/.style={
    heap object,
    fill=TomeBg,
    draw=TomeInk,
  },
  heap marked/.style={
    heap object,
    fill=TomeBgAlt,
    draw=TomeGold,
    very thick,
  },
  heap root/.style={
    tome diagram node,
    draw,
    rectangle,
    rounded corners=2pt,
    minimum width=1cm,
    minimum height=0.5cm,
    fill=TomeBg,
    draw=TomeGold,
    font=\ttfamily\small,
  },
}

%% ============================================================
%% Heap diagram environment
%% ============================================================
\NewDocumentEnvironment{heapdiagram}{O{}}{%
  \begin{figure}[htbp]%
  \centering%
  \begin{tikzpicture}[
    tome diagram,#1%
  ]%
}{%
  \end{tikzpicture}%
  \end{figure}%
}

%% ============================================================
%% Memory layout (linear)
%% ============================================================
\tikzset{
  mem block/.style={
    tome diagram node,
    draw,
    rectangle,
    minimum height=0.5cm,
    fill=TomeBg,
    draw=TomeInk,
    font=\ttfamily\small,
    inner sep=2pt,
  },
  mem label/.style={
    font=\sffamily\footnotesize,
    above,
    pos=0,
    xshift=2pt,
  },
}

\endinput
