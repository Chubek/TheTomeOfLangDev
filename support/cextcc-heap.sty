%%
%% cextcc-heap.sty — Heap / memory visualization
%%
\ProvidesPackage{cextcc-heap}[2026/01/01 Heap visualization for The Tome]

\RequirePackage{tikz}
\RequirePackage{xparse}
\RequirePackage{xcolor}
\usetikzlibrary{
  arrows.meta,
  positioning,
  shapes.geometric,
  fit,
  backgrounds,
  calc,
  decorations.pathreplacing,
}

\providecolor{TomeInk}{HTML}{1B2A4A}
\providecolor{TomeGold}{HTML}{B8860B}
\providecolor{TomeRule}{HTML}{4A4A4A}
\providecolor{TomeBg}{HTML}{F7F5F0}
\providecolor{TomeBgAlt}{HTML}{EDEAE3}

%% ============================================================
%% Heap object styles
%% ============================================================
\tikzset{
  heap object/.style={
    draw,
    rectangle,
    rounded corners=2pt,
    minimum width=1.5cm,
    minimum height=0.6cm,
    fill=TomeBg,
    draw=TomeInk,
    font=\ttfamily\small,
    align=center,
  },
  heap pointer/.style={
    ->,
    thick,
    draw=TomeInk,
    -Stealth,
  },
  heap free/.style={
    heap object,
    fill=TomeBgAlt,
    draw=TomeRule,
    pattern=north east lines,
    pattern color=TomeRule,
  },
  heap allocated/.style={
    heap object,
    fill=TomeBg,
    draw=TomeInk,
  },
  heap marked/.style={
    heap object,
    fill=TomeBgAlt,
    draw=TomeGold,
    very thick,
  },
  heap root/.style={
    draw,
    rectangle,
    rounded corners=2pt,
    minimum width=1cm,
    minimum height=0.5cm,
    fill=TomeBg,
    draw=TomeGold,
    font=\ttfamily\small,
  },
}

%% ============================================================
%% Heap diagram environment
%% ============================================================
\NewDocumentEnvironment{heapdiagram}{o}{%
  \begin{figure}[htbp]%
  \centering%
  \begin{tikzpicture}[
    >=Stealth,
    thick,
    every node/.style={font=\small},
    \IfValueT{#1}{#1}%
  ]%
}{%
  \end{tikzpicture}%
  \end{figure}%
}

%% ============================================================
%% Memory layout (linear)
%% ============================================================
\tikzset{
  mem block/.style={
    draw,
    rectangle,
    minimum height=0.5cm,
    fill=TomeBg,
    draw=TomeInk,
    font=\ttfamily\small,
    inner sep=2pt,
  },
  mem label/.style={
    font=\tiny,
    above,
    pos=0,
    xshift=2pt,
  },
}

\endinput
