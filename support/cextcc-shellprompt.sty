%%
%% cextcc-shellprompt.sty — Shell prompt / terminal display
%%
\ProvidesPackage{\@currpath cextcc-shellprompt}[2026/11/12 Shell prompt display for The Tome]

\RequirePackage{\@currpath cextcc-listing}
\RequirePackage{listings}
\RequirePackage{xparse}
\RequirePackage{xcolor}
\RequirePackage{tcolorbox}

%% ============================================================
%% Shell prompt listing style
%% ============================================================
\lstdefinestyle{shellstyle}{
  style=tomestyle,
  language={},
  numbers=none,
  xleftmargin=9pt,
  framexleftmargin=3pt,
  %% Keep prompts visible; the old invisible delimiters removed them.
  moredelim=[l][\color{TomeInk}\bfseries]{\$},
  moredelim=[l][\color{TomeInk}\bfseries]{>},
  moredelim=[l][\color{TomeInk}\bfseries]{\#},
}

\lstnewenvironment{shellprompt}[1][]{%
  \lstset{style=shellstyle,#1}%
}{}

%% ============================================================
%% REPL session
%% ============================================================
\lstdefinestyle{replstyle}{
  style=tomestyle,
  language={},
  tabsize=2,
  numbers=none,
  xleftmargin=9pt,
  framexleftmargin=3pt,
}

\lstnewenvironment{replsession}[1][]{%
  \lstset{style=replstyle,#1}%
}{}

%% ============================================================
%% Inline shell command
%% ============================================================
\newcommand{\shellcmd}[1]{\texttt{\$\,#1}}

\endinput
