%%
%% cextcc-shellprompt.sty — Shell prompt / terminal display
%%
\ProvidesPackage{cextcc-shellprompt}[2026/01/01 Shell prompt display for The Tome]

\RequirePackage{listings}
\RequirePackage{xparse}
\RequirePackage{xcolor}
\RequirePackage{tcolorbox}

\providecolor{TomeBg}{HTML}{F7F5F0}
\providecolor{TomeInk}{HTML}{1B2A4A}
\providecolor{TomeRule}{HTML}{4A4A4A}

%% ============================================================
%% Shell prompt listing style
%% ============================================================
\lstdefinestyle{shellstyle}{
  basicstyle=\ttfamily\small,
  backgroundcolor=\color{TomeBg},
  frame=single,
  rulecolor=\color{TomeRule},
  framerule=0.4pt,
  breaklines=true,
  tabsize=4,
  showstringspaces=false,
  columns=fullflexible,
  keepspaces=true,
  numbers=none,
  xleftmargin=12pt,
  xrightmargin=8pt,
  aboveskip=8pt,
  belowskip=8pt,
  moredelim=[il][\color{TomeInk}\bfseries]{\$},
  moredelim=[il][\color{TomeInk}\bfseries]{>},
  moredelim=[il][\color{TomeInk}\bfseries]{\#},
}

\lstnewenvironment{shellprompt}[1][]{%
  \lstset{style=shellstyle,#1}%
}{}

%% ============================================================
%% REPL session
%% ============================================================
\lstdefinestyle{replstyle}{
  basicstyle=\ttfamily\small,
  backgroundcolor=\color{TomeBg},
  frame=single,
  rulecolor=\color{TomeRule},
  framerule=0.4pt,
  breaklines=true,
  tabsize=2,
  showstringspaces=false,
  columns=fullflexible,
  keepspaces=true,
  numbers=none,
  xleftmargin=12pt,
  xrightmargin=8pt,
  aboveskip=8pt,
  belowskip=8pt,
}

\lstnewenvironment{replsession}[1][]{%
  \lstset{style=replstyle,#1}%
}{}

%% ============================================================
%% Inline shell command
%% ============================================================
\newcommand{\shellcmd}[1]{\texttt{\$\,#1}}

\endinput
