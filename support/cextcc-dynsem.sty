%%
%% cextcc-dynsem.sty — Dynamic semantics environments
%%
\ProvidesPackage{cextcc-dynsem}[2026/01/01 Dynamic semantics for The Tome]

\RequirePackage{amsmath}
\RequirePackage{xparse}
\RequirePackage{xcolor}
\RequirePackage{tcolorbox}

\providecolor{TomeBg}{HTML}{F7F5F0}
\providecolor{TomeInk}{HTML}{1B2A4A}
\providecolor{TomeRule}{HTML}{4A4A4A}

%% ============================================================
%% Dynamic semantic rule environments
%% ============================================================

%% -- Structural operational semantics
\NewDocumentEnvironment{sosrules}{m}{%
  \begin{tcolorbox}[%
    enhanced,
    arc=1pt,
    boxrule=0.6pt,
    colback=TomeBg,
    colframe=TomeInk,
    title={Structural Operational Semantics: #1},
    coltitle=white,
    fonttitle=\bfseries\small,
    before skip=12pt,
    after skip=12pt,
  ]%
  \begin{alignat*}{2}%
}{%
  \end{alignat*}%
  \end{tcolorbox}%
}

%% -- Natural semantics (big-step)
\NewDocumentEnvironment{natsemrules}{m}{%
  \begin{tcolorbox}[%
    enhanced,
    arc=1pt,
    boxrule=0.6pt,
    colback=TomeBg,
    colframe=TomeInk,
    title={Natural Semantics: #1},
    coltitle=white,
    fonttitle=\bfseries\small,
    before skip=12pt,
    after skip=12pt,
  ]%
  \begin{align*}%
}{%
  \end{align*}%
  \end{tcolorbox}%
}

