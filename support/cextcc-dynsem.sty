%% ============================================================
%% Axiomatic semantics (Hoare logic)
%% ============================================================
\newcommand{\hoare}[3]{\ensuremath{\{#1\}\;#2\;\{#3\}}}
\newcommand{\wlp}[2]{\ensuremath{\mathrm{wlp}(#1, #2)}}
\newcommand{\strongestpost}[2]{\ensuremath{\mathrm{sp}(#1, #2)}}

\NewDocumentEnvironment{hoarerules}{m}{%
  \begin{tcolorbox}[%
    enhanced,
    arc=1pt,
    boxrule=0.6pt,
    colback=TomeBg,
    colframe=TomeInk,
    title={Axiomatic Semantics: #1},
    coltitle=white,
    fonttitle=\bfseries\small,
    before skip=12pt,
    after skip=12pt,
  ]%
  \begin{align*}%
}{%
  \end{align*}%
  \end{tcolorbox}%
}

%% ============================================================
%% Abstract machine configuration
%% ============================================================
\newcommand{\machineState}[3]{\ensuremath{\mathcal{M} = \langle #1, #2, #3 \rangle}}
\newcommand{\machineStep}{\longrightarrow_{\mathcal{M}}}
\newcommand{\machineRun}{\Downarrow_{\mathcal{M}}}

\endinput
