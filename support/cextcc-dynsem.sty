%%
%% cextcc-dynsem.sty — Dynamic semantics environments
%%
\ProvidesPackage{\@currpath cextcc-dynsem}[2026/11/12 Dynamic semantics for The Tome]

\RequirePackage{\@currpath cextcc-config}
\RequirePackage{amsmath}
\RequirePackage{xparse}
\RequirePackage{xcolor}
\RequirePackage{tcolorbox}

%% ============================================================
%% Dynamic semantic rule environments
%% ============================================================

%% -- Structural operational semantics
\NewDocumentEnvironment{sosrules}{m +b}{%
  \begin{tcolorbox}[tomeformal,title={Structural Operational Semantics: #1}]%
  \TomeDisplayMath{\begin{alignedat}{2}#2\end{alignedat}}%
  \end{tcolorbox}%
}{}

%% -- Natural semantics (big-step)
\NewDocumentEnvironment{natsemrules}{m +b}{%
  \begin{tcolorbox}[tomeformal,title={Natural Semantics: #1}]%
  \TomeDisplayMath{\begin{aligned}#2\end{aligned}}%
  \end{tcolorbox}%
}{}

%% -- Reduction semantics
\NewDocumentEnvironment{redrules}{m +b}{%
  \begin{tcolorbox}[tomeformal,title={Reduction Semantics: #1}]%
  \TomeDisplayMath{\begin{aligned}#2\end{aligned}}%
  \end{tcolorbox}%
}{}

%% -- Continuation semantics
\NewDocumentEnvironment{contsemrules}{m +b}{%
  \begin{tcolorbox}[tomeformal,title={Continuation Semantics: #1}]%
  \TomeDisplayMath{\begin{aligned}#2\end{aligned}}%
  \end{tcolorbox}%
}{}

%% ============================================================
%% Denotational semantics
%% ============================================================
\NewDocumentEnvironment{denotsem}{m +b}{%
  \begin{tcolorbox}[tomeformal,title={Denotational Semantics: #1}]%
  \TomeDisplayMath{\begin{aligned}#2\end{aligned}}%
  \end{tcolorbox}%
}{}

%% ============================================================
%% Axiomatic semantics (Hoare logic)
%% ============================================================
\newcommand{\hoare}[3]{\ensuremath{\{#1\}\;#2\;\{#3\}}}
\newcommand{\wlp}[2]{\ensuremath{\mathrm{wlp}(#1, #2)}}
\newcommand{\strongestpost}[2]{\ensuremath{\mathrm{sp}(#1, #2)}}

\NewDocumentEnvironment{hoarerules}{m +b}{%
  \begin{tcolorbox}[tomeformal,title={Axiomatic Semantics: #1}]%
  \TomeDisplayMath{\begin{aligned}#2\end{aligned}}%
  \end{tcolorbox}%
}{}

%% ============================================================
%% Abstract machine configuration
%% ============================================================
\newcommand{\machineState}[3]{\ensuremath{\mathcal{M} = \langle #1, #2, #3 \rangle}}
\newcommand{\machineStep}{\longrightarrow_{\mathcal{M}}}
\newcommand{\machineRun}{\Downarrow_{\mathcal{M}}}

\endinput
