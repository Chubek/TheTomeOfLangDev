%%
%% cextcc-listing-color.sty — Colored code listing environments
%%
\ProvidesPackage{cextcc-listing-color}[2026/01/01 Colored code listings for The Tome]

\RequirePackage{listings}
\RequirePackage{xcolor}
\RequirePackage{tcolorbox}
\RequirePackage{xparse}

\tcbuselibrary{listings,skins,breakable}

\providecolor{TomeBg}{HTML}{F7F5F0}
\providecolor{TomeInk}{HTML}{1B2A4A}
\providecolor{TomeRule}{HTML}{4A4A4A}
\providecolor{TomeCodeKw}{HTML}{8B0000}
\providecolor{TomeCodeStr}{HTML}{006400}
\providecolor{TomeCodeCmt}{HTML}{708090}

%% ============================================================
%% tcolorbox-based colored listings
%% ============================================================
\tcbset{
  tomelisting/.style={
    enhanced,
    breakable,
    arc=1pt,
    boxrule=0.4pt,
    colback=TomeBg,
    colframe=TomeRule,
    coltitle=TomeInk,
    fonttitle=\small\bfseries,
    listing only,
    listing options={
      style=tomestyle,
      numbers=left,
      numbersep=8pt,
    },
    before skip=12pt,
    after skip=12pt,
  }
}

%% -- Colored listing with caption
\NewDocumentEnvironment{colorlisting}{m O{}}{%
  \begin{tcolorbox}[tomelisting,title=#1,#2]%
  \lstset{style=tomestyle}%
}{%
  \end{tcolorbox}%
}

%% -- Side-by-side code comparison
\NewDocumentEnvironment{codecompare}{m m O{}}{%
  \begin{tcolorbox}[
    enhanced,
    breakable,
    arc=1pt,
    boxrule=0.4pt,
    colback=TomeBg,
    colframe=TomeRule,
    title=#3,
    before skip=12pt,
    after skip=12pt,
  ]
  \begin{minipage}[t]{0.48\textwidth}
    \textbf{\small #1}\par\medbreak
}{%
  \end{minipage}\hfill
  \begin{minipage}[t]{0.48\textwidth}
    \textbf{\small #2}\par\medbreak
  \end{minipage}
  \end{tcolorbox}
}

\endinput
