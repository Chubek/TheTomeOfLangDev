%%
%% cextcc-listing-color.sty — Colored code listing environments
%%
\ProvidesPackage{\@currpath cextcc-listing-color}[2026/11/12 Colored code listings for The Tome]

\RequirePackage{\@currpath cextcc-listing}
\RequirePackage{listings}
\RequirePackage{xcolor}
\RequirePackage{tcolorbox}
\RequirePackage{xparse}

\tcbuselibrary{listings,skins,breakable}

%% ============================================================
%% tcolorbox-based colored listings
%% ============================================================
\tcbset{
  tomelisting/.style={
    tomecode,
    listing only,
    listing options={
      style=tomestyle,
      frame=none,
      backgroundcolor={},
      numbers=left,
      numbersep=8pt,
      xleftmargin=20pt,
      xrightmargin=0pt,
      aboveskip=0pt,
      belowskip=0pt,
    },
  }
}

%% -- Colored listing with caption
%% A real verbatim listing, rather than ordinary TeX inside a styled box.
\NewTCBListing{colorlisting}{m O{}}{tomelisting,title={#1},#2}

%% -- Side-by-side code comparison
\NewDocumentEnvironment{codecompare}{m m O{}}{%
  \begin{tcolorbox}[
    tomecode,unbreakable,sidebyside,sidebyside align=top,
    sidebyside gap=8mm,title={#3},
    before upper={\noindent{\sffamily\small\bfseries\color{TomeInk}#1}\par\medskip},
    before lower={\noindent{\sffamily\small\bfseries\color{TomeInk}#2}\par\medskip},
  ]
}{%
  \end{tcolorbox}
}
%% Switch from the first comparison column to the second in the body.
\newcommand{\codecomparesep}{\tcblower}

\endinput
