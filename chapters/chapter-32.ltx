\section{Advanced Powerdomain Theory}
\label{sec:advanced-powerdomains}

\subsection{Universal Property of Powerdomains}
\label{sec:powerdomain-universal}

Each powerdomain construction satisfies a \emph{universal property} that characterizes it categorically:

\begin{theorem}[Universal Property of the Smyth Powerdomain]
\label{thm:smyth-universal}
The Smyth powerdomain $\mathcal{P}_S(D)$ is the \textbf{free deflationary semilattice} over $D$. That is, for every continuous function $f : D \to E$ where $E$ is a deflationary semilattice (a CPO with a continuous, commutative, idempotent operation $\sqcup$ satisfying $x \sqcup y \sqsubseteq x$), there exists a unique continuous semilattice homomorphism $\hat{f} : \mathcal{P}_S(D) \to E$ extending $f$.
\end{theorem}

\begin{theorem}[Universal Property of the Hoare Powerdomain]
\label{thm:hoare-universal}
The Hoare powerdomain $\mathcal{P}_H(D)$ is the \textbf{free inflationary semilattice} over $D$. For every continuous function $f : D \to E$ where $E$ is an inflationary semilattice ($x \sqsubseteq x \sqcup y$), there exists a unique continuous semilattice homomorphism $\hat{f} : \mathcal{P}_H(D) \to E$ extending $f$.
\end{theorem}

\begin{theorem}[Universal Property of the Plotkin Powerdomain]
\label{thm:plotkin-universal}
The Plotkin powerdomain $\mathcal{P}_P(D)$ is the \textbf{free convex semilattice} over $D$. A convex semilattice combines the properties of both deflationary and inflationary semilattices, capturing the mixed nondeterminism of the Egli--Milner ordering.
\end{theorem}

\subsection{Powerdomain and Nondeterministic Programs}
\label{sec:powerdomain-programs}

The semantic function for a nondeterministic program maps states to elements of a powerdomain:

\begin{definition}[Nondeterministic Semantics]
\label{def:nd-semantics}
The semantics of a nondeterministic command $C$ is a continuous function:
\[
\semS \sembrack{C} : \Store \to \mathcal{P}(V_\bot)
\]
where $\mathcal{P}$ is the appropriate powerdomain. For \emph{demonic} semantics (total correctness), use the Smyth powerdomain; for \emph{angelic} semantics (partial correctness), use the Hoare powerdomain.
\end{definition}

\begin{example}[Demonic vs.\ Angelic Semantics]
\label{ex:demonic-angelic}
Consider the nondeterministic assignment:
\[
x := 0 \;\sqcap\; x := 1
\]
Under demonic semantics, the meaning is $\{0, 1\}$ ordered by reverse inclusion---the ``worst case'' is that either value might result. Under angelic semantics, the meaning is $\{0, 1\}$ ordered by inclusion---the ``best case'' is that the most useful value results.

For a program that tests the result:
\begin{verbatim}
  x := 0 [] x := 1;
  if x = 0 then diverge else skip
\end{verbatim}
Demonic semantics: the result is $\bot$ (the demon chooses $x = 0$, causing divergence).
Angelic semantics: the result is $\text{skip}$ (the angel chooses $x = 1$, allowing termination).
\end{example}

\subsection{Powerdomain of a Powerdomain}
\label{sec:powerdomain-iteration}

Iterating the powerdomain construction yields richer structures:

\begin{theorem}[Powerdomain Iteration]
\label{thm:powerdomain-iteration}
For a flat domain $D$:
\begin{itemize}
  \item $\mathcal{P}_S(\mathcal{P}_S(D)) \cong \mathcal{P}_S(D)$ (idempotent for Smyth)
  \item $\mathcal{P}_H(\mathcal{P}_H(D)) \cong \mathcal{P}_H(D)$ (idempotent for Hoare)
  \item $\mathcal{P}_P(\mathcal{P}_P(D)) \not\cong \mathcal{P}_P(D)$ in general (Plotkin is not idempotent)
\end{itemize}
\end{theorem}

\section{Recursive Domain Equations: Advanced Topics}
\label{sec:recursive-domains-advanced}

\subsection{Variance and Mixed Functors}
\label{sec:variance}

When solving domain equations $D \cong F(D)$, the \emph{variance} of $F$ matters. Functors can be:
\begin{itemize}
  \item \textbf{Covariant}: $F$ preserves the direction of morphisms (e.g., $F(X) = 1 + A \times X$)
  \item \textbf{Contravariant}: $F$ reverses the direction of morphisms (e.g., $F(X) = [X \to A]$)
  \item \textbf{Mixed}: $F$ is covariant in some arguments and contravariant in others (e.g., $F(X) = [X \to X]$)
\end{itemize}

The equation $D \cong [D \to D]$ involves a mixed functor, making it the most challenging case.

\begin{definition}[Locally Continuous Functor]
\label{def:locally-continuous}
A functor $F$ on $\mathbf{CPO}$ is \textbf{locally continuous} if for every pair of objects $A, B$, the map $F_{A,B} : [A \to B] \to [F(A) \to F(B)]$ is continuous (preserves directed suprema of functions).
\end{definition}

\begin{theorem}[Existence for Mixed Functors]
\label{thm:mixed-existence}
If $F$ is a locally continuous functor on $\mathbf{CPO}$, then the domain equation $D \cong F(D)$ has a solution, even when $F$ is mixed (both covariant and contravariant in different arguments). The solution is constructed using \emph{embedding-projection pairs} rather than simple embeddings.
\end{theorem}

\subsection{Bilimits and the Inverse Limit Construction}
\label{sec:bilimits}

The solution of $D \cong [D \to D]$ uses an \emph{inverse limit} construction with embedding--projection pairs:

\begin{definition}[Embedding--Projection Pair]
\label{def:ep-pair}
An \textbf{embedding--projection pair} $(e, p)$ between CPOs $D$ and $E$ consists of continuous functions $e : D \to E$ (embedding) and $p : E \to D$ (projection) such that:
\begin{itemize}
  \item $p \circ e = \text{id}_D$ (projection after embedding is identity)
  \item $e \circ p \sqsubseteq \text{id}_E$ (embedding after projection is deflationary)
\end{itemize}
\end{definition}

\begin{definition}[Inverse Limit]
\label{def:inverse-limit}
Given a chain of embedding--projection pairs:
\[
D_0 \underset{p_0}{\overset{e_0}{\rightleftarrows}} D_1 \underset{p_1}{\overset{e_1}{\rightleftarrows}} D_2 \underset{p_2}{\overset{e_2}{\rightleftarrows}} \cdots
\]
The \textbf{inverse limit} $D_\infty$ consists of all sequences $(x_0, x_1, x_2, \ldots)$ where $x_n \in D_n$ and $p_n(x_{n+1}) = x_n$ for all $n$.
\end{definition}

\begin{theorem}[Scott's $D_\infty$ Construction]
\label{thm:d-infinity-construction}
Define $D_0 = \{*\}$ (a one-point domain) and $D_{n+1} = [D_n \to D_n]$. The embedding--projection pairs are:
\begin{align*}
  e_0(d) &= \lambda x.\, d \quad &p_0(f) &= f(*) \\
  e_{n+1}(f) &= e_n \circ f \circ p_n \quad &p_{n+1}(g) &= p_n \circ g \circ e_n
\end{align*}
The inverse limit $D_\infty$ satisfies $D_\infty \cong [D_\infty \to D_\infty]$.
\end{theorem}

% Annotated walkthrough
\subsection{Validating an Embedding--Projection Pair on Finite Domains}

Finite stages of a domain construction can be represented by
order matrices and tables of functions. A checker can then
verify that a proposed projection forgets information without
inventing it. Assume finite pointed posets $D,E$ with already
validated order relations and total tables $e:D\to E$ and
$p:E\to D$. On a finite poset every nonempty directed subset
has a greatest element, so monotone maps preserve directed
suprema. Thus the checker needs only order comparisons and
the two embedding--projection laws. It reports a failed law
with the input element or ordered pair that exposes it.

\begin{sudocode}[Check finite-stage maps]
\Function{CheckPair}{$D,E,e,p$}
  \ForAll{$x\sqsubseteq_D y$}
    \State Require $e(x)\sqsubseteq_E e(y)$
  \EndFor
  \ForAll{$a\sqsubseteq_E b$}
    \State Require $p(a)\sqsubseteq_D p(b)$
  \EndFor
  \ForAll{$x\in D$}
    \State Require $p(e(x))=x$ \Comment{Retain embedded information}
  \EndFor
  \ForAll{$a\in E$}
    \State Require $e(p(a))\sqsubseteq_E a$ \Comment{Add nothing}
  \EndFor
  \State \Return valid
\EndFunction
\end{sudocode}

\paragraph{Worked trace.}
Take flat domains $D=\{\bot,a\}$ and $E=\{\bot,a,b\}$.
Embed by inclusion. Project $\bot$ and $a$ to themselves,
and send $b$ to $\bot$. The nontrivial order comparisons in
$E$ are $\bot\sqsubseteq a$ and $\bot\sqsubseteq b$;
their images are $\bot\sqsubseteq a$ and $\bot\sqsubseteq\bot$.
Projection after embedding returns both elements of $D$ unchanged.
The last loop reaches $b$ and checks
$e(p(b))=\bot\sqsubseteq b$. Modify the table to send $b$ to
$a$. Monotonicity and the first composite still pass, but the
last loop now compares $a$ with incomparable $b$ and fails.

\Cref{fig:visual-32} locates the failed comparison in the order on $E$,
not in the round trip through $D$.

