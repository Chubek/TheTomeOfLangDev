  \node[eff, below left=1.2cm and 0.5cm of all] (io) {IO};
  \node[eff, below right=1.2cm and 0.5cm of all] (mem) {Memory};
  \node[eff, below left=1.2cm and 0cm of mem] (write) {Write};
