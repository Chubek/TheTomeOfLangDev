%% chapter-6.ltx — Functors, Natural Transformations, and Adjunctions
%%

The previous chapter introduced categories as the basic setting for categorical reasoning. This chapter develops the mappings \emph{between} categories: functors, natural transformations, and adjunctions. These concepts are not merely abstract mathematics; they are the tools that connect different levels of abstraction in programming language theory. Functors model type constructors, natural transformations model polymorphic functions, and adjunctions model the relationship between syntax and semantics, between free and forgetful constructions, and between concrete and abstract domains.

\section{Functors}\label{sec:functors}

\begin{definition}[Functor]\label{def:functor}
A \emph{functor} $F : \mathcal{C} \to \mathcal{D}$ between categories $\mathcal{C}$ and $\mathcal{D}$ is a mapping that:
\begin{itemize}
  \item Assigns to each object $A \in \mathrm{Ob}(\mathcal{C})$ an object $F(A) \in \mathrm{Ob}(\mathcal{D})$
  \item Assigns to each morphism $f : A \to B$ in $\mathcal{C}$ a morphism $F(f) : F(A) \to F(B)$ in $\mathcal{D}$
\end{itemize}
such that:
\begin{itemize}
  \item $F(\mathrm{id}_A) = \mathrm{id}_{F(A)}$ for all objects $A$
  \item $F(g \circ f) = F(g) \circ F(f)$ for all composable morphisms $f, g$
\end{itemize}
\end{definition}

\begin{definition}[Covariant and Contravariant Functors]\label{def:covariant-contravariant}
A functor as defined above is \emph{covariant}. A \emph{contravariant} functor $F : \mathcal{C} \to \mathcal{D}$ reverses arrows: it maps $f : A \to B$ to $F(f) : F(B) \to F(A)$, satisfying $F(g \circ f) = F(f) \circ F(g)$. Equivalently, a contravariant functor from $\mathcal{C}$ to $\mathcal{D}$ is a covariant functor from $\mathcal{C}^{\mathrm{op}}$ to $\mathcal{D}$.
\end{definition}

\subsection{Examples of Functors}

\begin{example}[Powerset Functor]\label{ex:powerset-functor}
The powerset construction $\mathcal{P} : \mathbf{Set} \to \mathbf{Set}$ is a covariant functor:
\begin{itemize}
  \item On objects: $\mathcal{P}(A)$ is the powerset of $A$
  \item On morphisms: for $f : A \to B$, $\mathcal{P}(f) : \mathcal{P}(A) \to \mathcal{P}(B)$ is the direct image: $\mathcal{P}(f)(S) = \{f(x) \mid x \in S\}$
\end{itemize}
\end{example}

\begin{example}[Hom Functor]\label{ex:hom-functor}
For any category $\mathcal{C}$ and object $A$, the \emph{representable functor} $\mathrm{Hom}(A, -) : \mathcal{C} \to \mathbf{Set}$ maps:
\begin{itemize}
  \item Object $B$ to the set $\mathrm{Hom}(A, B)$
  \item Morphism $f : B \to C$ to the function $\mathrm{Hom}(A, f) : \mathrm{Hom}(A, B) \to \mathrm{Hom}(A, C)$ defined by $g \mapsto f \circ g$ (post-composition)
\end{itemize}
\end{example}

\begin{example}[List Functor]\label{ex:list-functor}
The list type constructor $\mathrm{List} : \mathbf{Set} \to \mathbf{Set}$ is a functor:
\begin{itemize}
  \item On objects: $\mathrm{List}(A)$ is the set of finite lists of elements of $A$
  \item On morphisms: for $f : A \to B$, $\mathrm{List}(f)$ applies $f$ to each element of a list (the \texttt{map} operation)
\end{itemize}
\end{example}

\begin{example}[Maybe/Option Functor]\label{ex:maybe-functor}
The $\mathrm{Maybe}$ (or $\mathrm{Option}$) functor maps $A$ to $A + 1$ (adding a ``null'' value). On morphisms:
\[\mathrm{Maybe}(f)(\mathrm{Just}(a)) = \mathrm{Just}(f(a)), \quad \mathrm{Maybe}(f)(\mathrm{Nothing}) = \mathrm{Nothing}\]
\end{example}

\begin{example}[Function Functor (Reader)]\label{ex:reader-functor}
For a fixed type $R$, the functor $(-)^R : \mathbf{Set} \to \mathbf{Set}$ maps $A$ to $A^R$ (functions from $R$ to $A$). On morphisms, it post-composes: $f \mapsto f \circ -$. This is the ``reader'' functor, representing computations that read from an environment of type $R$.
\end{example}

\begin{example}[Contravariant Functor: Predicates]\label{ex:pred-functor}
The predicate functor $\mathrm{Pred} : \mathbf{Set}^{\mathrm{op}} \to \mathbf{Set}$ maps $A$ to $\mathcal{P}(A)$ (the set of predicates on $A$). For $f : A \to B$, $\mathrm{Pred}(f) : \mathcal{P}(B) \to \mathcal{P}(A)$ is the inverse image: $\mathrm{Pred}(f)(Q) = \{a \in A \mid f(a) \in Q\}$. This is contravariant: predicates are pulled back along functions.
\end{example}

\section{Natural Transformations}\label{sec:natural}

\begin{definition}[Natural Transformation]\label{def:natural-transformation}
Given functors $F, G : \mathcal{C} \to \mathcal{D}$, a \emph{natural transformation} $\eta : F \Rightarrow G$ is a family of morphisms $\{\eta_A : F(A) \to G(A)\}_{A \in \mathrm{Ob}(\mathcal{C})}$ such that for every morphism $f : A \to B$ in $\mathcal{C}$, the following diagram commutes:

\begin{center}
\begin{tikzpicture}[node distance=3cm]
  \node (FA) {$F(A)$};
  \node[right=of FA] (FB) {$F(B)$};
  \node[below=of FA] (GA) {$G(A)$};
  \node[below=of FB] (GB) {$G(B)$};
  
  \draw[->, thick] (FA) -- node[above]{$F(f)$} (FB);
  \draw[->, thick] (GA) -- node[below]{$G(f)$} (GB);
  \draw[->, thick] (FA) -- node[left]{$\eta_A$} (GA);
  \draw[->, thick] (FB) -- node[right]{$\eta_B$} (GB);
\end{tikzpicture}
\end{center}

That is: $\eta_B \circ F(f) = G(f) \circ \eta_A$.
\end{definition}

\begin{insight}
Natural transformations are the ``morphisms between functors.'' The naturality condition says that the transformation $\eta$ does not depend on the internal structure of the objects---it works uniformly for all objects. In programming, natural transformations correspond to \emph{parametrically polymorphic functions}.
\end{insight}

\begin{example}[List Reverse]\label{ex:list-reverse}
The reverse operation $\mathrm{reverse}_A : \mathrm{List}(A) \to \mathrm{List}(A)$ is a natural transformation from $\mathrm{List}$ to itself. Naturality says: for any $f : A \to B$,
\[\mathrm{map}(f)(\mathrm{reverse}(xs)) = \mathrm{reverse}(\mathrm{map}(f)(xs))\]
This is a familiar property: mapping a function and then reversing is the same as reversing and then mapping.
\end{example}

\begin{example}[Safe Head]\label{ex:list-head}
The $\mathrm{head}$ function is \emph{not} a natural transformation from $\mathrm{List}$ to $\mathrm{Maybe}$, because it is not defined for empty lists. However, $\mathrm{safeHead} : \mathrm{List}(A) \to \mathrm{Maybe}(A)$ (returning $\mathrm{Nothing}$ for empty lists) \emph{is} a natural transformation.
\end{example}

\begin{example}[Free Theorems]\label{ex:free-theorems}
Reynolds' abstraction theorem (``free theorems'') states that every parametrically polymorphic function is a natural transformation. For example, a polymorphic function $\mathrm{f} : \forall A.\,\mathrm{List}(A) \to \mathrm{List}(A)$ must satisfy $\mathrm{map}(f) \circ \mathrm{f} = \mathrm{f} \circ \mathrm{map}(f)$ for all $f$. This constrains the possible implementations of $\mathrm{f}$---it must be a function like $\mathrm{reverse}$, $\mathrm{sort}$, or $\mathrm{id}$, but not one that inspects elements.
\end{example}

\section{Adjunctions}\label{sec:adjunctions}

Adjunctions are among the most important concepts in category theory. They formalize the notion of ``optimal approximation'' and appear throughout programming language theory.

\begin{definition}[Adjunction]\label{def:adjunction}
An \emph{adjunction} between functors $F : \mathcal{C} \to \mathcal{D}$ and $G : \mathcal{D} \to \mathcal{C}$ is a natural isomorphism:
\[\mathrm{Hom}_{\mathcal{D}}(F(A), B) \cong \mathrm{Hom}_{\mathcal{C}}(A, G(B))\]
natural in both $A$ and $B$. We write $F \dashv G$ and say $F$ is the \emph{left adjoint} and $G$ is the \emph{right adjoint}.
\end{definition}

Equivalently, an adjunction can be defined in terms of the \emph{unit} $\eta : \mathrm{Id}_{\mathcal{C}} \Rightarrow G \circ F$ and \emph{counit} $\varepsilon : F \circ G \Rightarrow \mathrm{Id}_{\mathcal{D}}$ satisfying the \emph{triangle identities}:
\begin{align*}
  F \xrightarrow{F\eta} FGF \xrightarrow{\varepsilon F} F &= F \\
  G \xrightarrow{\eta G} GFG \xrightarrow{G\varepsilon} G &= G
\end{align*}

\begin{example}[Product-Exponential Adjunction]\label{ex:prod-exp-adj}
In a CCC, the product functor $- \times A$ is left adjoint to the exponential functor $(-)^A$:
\[\mathrm{Hom}(C \times A, B) \cong \mathrm{Hom}(C, B^A)\]
This is exactly currying: a function $C \times A \to B$ corresponds to a function $C \to (A \to B)$.
\end{example}

\begin{example}[Free-Forgetful Adjunction]\label{ex:free-forgetful}
The \emph{free group} functor $F : \mathbf{Set} \to \mathbf{Grp}$ is left adjoint to the \emph{forgetful} functor $U : \mathbf{Grp} \to \mathbf{Set}$:
\[\mathrm{Hom}_{\mathbf{Grp}}(F(X), G) \cong \mathrm{Hom}_{\mathbf{Set}}(X, U(G))\]
A group homomorphism from the free group on $X$ to $G$ is determined by where it sends the generators, i.e., by a function from $X$ to the underlying set of $G$.
\end{example}

\begin{example}[Galois Connections as Adjunctions]\label{ex:galois-adj}
A Galois connection between posets $(C, \leq)$ and $(A, \leq)$ is exactly an adjunction between the corresponding categories. The abstraction function $\alpha$ is the left adjoint and the concretization function $\gamma$ is the right adjoint:
\[\alpha(c) \leq a \iff c \leq \gamma(a)\]
\end{example}

\begin{insight}
The connection between Galois connections and adjunctions is one of the most important insights in abstract interpretation~\cite{cousot1977abstract}. The abstraction function $\alpha$ (left adjoint) maps concrete properties to their best abstract approximation, and the concretization function $\gamma$ (right adjoint) maps abstract properties back to their concrete meaning. The adjunction ensures that the abstraction is optimal: $\alpha(c)$ is the best abstract approximation of $c$.
\end{insight}

\section{Free and Forgetful Functors}\label{sec:free-forgetful}

\begin{definition}[Free Functor]\label{def:free-functor}
Given a forgetful functor $U : \mathcal{D} \to \mathcal{C}$ that ``forgets'' structure, the \emph{free functor} $F : \mathcal{C} \to \mathcal{D}$ is its left adjoint. It constructs the ``freest'' object in $\mathcal{D}$ generated by an object in $\mathcal{C}$.
\end{definition}

\begin{example}[Free Monoid]\label{ex:free-monoid}
The forgetful functor $U : \mathbf{Mon} \to \mathbf{Set}$ maps a monoid to its underlying set. The free functor $F : \mathbf{Set} \to \mathbf{Mon}$ maps a set $X$ to the free monoid on $X$, which is the set of finite lists $\mathrm{List}(X)$ with concatenation as the monoid operation and the empty list as the identity.
\end{example}

\begin{example}[Free Category]\label{ex:free-category}
Given a directed graph $G$, the free category $F(G)$ has the vertices of $G$ as objects and paths in $G$ as morphisms. Composition is path concatenation.
\end{example}

\begin{example}[Free Monad]\label{ex:free-monad}
Given a functor $F$, the \emph{free monad} over $F$ is the initial algebra of the functor $X \mapsto A + F(X)$. It represents computations with effects described by $F$, without specifying how those effects are interpreted.
\end{example}

\section{Monads from Adjunctions}\label{sec:monads-from-adj}

Every adjunction gives rise to a monad:

\begin{theorem}[Monad from Adjunction]\label{thm:monad-from-adj}
If $F \dashv G$ is an adjunction with unit $\eta$ and counit $\varepsilon$, then $T = G \circ F$ is a monad with:
\begin{itemize}
  \item Return: $\eta_A : A \to T(A)$
  \item Bind: defined via $\varepsilon$
\end{itemize}
\end{theorem}

\begin{example}[State Monad from Adjunction]\label{ex:state-adj}
The state monad $T(A) = (A \times S)^S$ arises from the adjunction between the categories of sets and sets-with-a-state-action.
\end{example}

\begin{example}[Powerset Monad]\label{ex:powerset-monad-adj}
The powerset monad $\mathcal{P}$ on $\mathbf{Set}$ arises from the adjunction between $\mathbf{Set}$ and $\mathbf{Sup}$ (complete lattices and sup-preserving maps). The free complete lattice on a set $X$ is $\mathcal{P}(X)$.
\end{example}

\section{Applications to Type Theory}\label{sec:functors-type-theory}

\subsection{Type Constructors as Functors}

Every type constructor of kind $* \to *$ (taking a type and producing a type) can be viewed as a functor on the category of types. The functorial action is the \texttt{map} operation:

\begin{table}[htbp]
\centering
\caption{Type constructors as functors}
\label{tab:type-functors}
\begin{tabular}{lll}
\hline
\textbf{Constructor} & \textbf{Functor} & \textbf{map} \\
\hline
$\mathrm{List}$ & $\mathrm{List}(A)$ & $\mathrm{map} : (A \to B) \to \mathrm{List}(A) \to \mathrm{List}(B)$ \\
$\mathrm{Maybe}$ & $A + 1$ & $\mathrm{fmap} : (A \to B) \to \mathrm{Maybe}(A) \to \mathrm{Maybe}(B)$ \\
$\mathrm{Tree}$ & $\mathrm{Tree}(A)$ & $\mathrm{fmap} : (A \to B) \to \mathrm{Tree}(A) \to \mathrm{Tree}(B)$ \\
$R \to -$ & $A^R$ & $\mathrm{compose} : (A \to B) \to (R \to A) \to (R \to B)$ \\
\hline
\end{tabular}
\end{table}

\subsection{Polymorphic Functions as Natural Transformations}

A parametrically polymorphic function $\forall A.\,F(A) \to G(A)$ is a natural transformation from $F$ to $G$. This is the content of Reynolds' abstraction theorem.

\begin{example}[Natural Transformations in Haskell]\label{ex:haskell-natural}
\begin{itemize}
  \item $\mathrm{safeHead} : \forall A.\,\mathrm{List}(A) \to \mathrm{Maybe}(A)$ is a natural transformation
  \item $\mathrm{sort} : \forall A.\,\mathrm{Ord}(A) \Rightarrow \mathrm{List}(A) \to \mathrm{List}(A)$ is \emph{not} a natural transformation in the strict sense (it requires an ordering)
  \item $\mathrm{length} : \forall A.\,\mathrm{List}(A) \to \mathrm{Int}$ is a natural transformation (from $\mathrm{List}$ to the constant functor $\mathrm{Int}$)
\end{itemize}
\end{example}

\section{Applications to Semantics}\label{sec:functors-semantics}

\subsection{Denotational Semantics via Adjunctions}

The semantics of a programming language can be defined as an adjunction between a syntactic category (terms and proofs) and a semantic category (domains and continuous functions). The left adjoint maps syntax to semantics (interpretation), and the right adjoint maps semantics back to syntax (reification).

\subsection{Abstract Interpretation via Adjunctions}

As noted above, the Galois connection between concrete and abstract domains is an adjunction. The left adjoint $\alpha$ computes the best abstract approximation, and the right adjoint $\gamma$ gives the concrete meaning of an abstract property.

\begin{semrules}{Abstract Interpretation as Adjunction}
\alpha : C \to A \quad \text{(abstraction)} \\
\gamma : A \to C \quad \text{(concretization)} \\
\alpha(c) \sqsubseteq_A a \iff c \sqsubseteq_C \gamma(a) \quad \text{(Galois connection)}
\end{semrules}

\section{Limits and Colimits}\label{sec:limits-colimits}

\begin{definition}[Diagram]\label{def:diagram}
A \emph{diagram} in a category $\mathcal{C}$ is a functor $D : \mathcal{J} \to \mathcal{C}$ from a small category $\mathcal{J}$ (the \emph{index category}).
\end{definition}

\begin{definition}[Limit]\label{def:limit}
A \emph{limit} of a diagram $D : \mathcal{J} \to \mathcal{C}$ is a universal cone over $D$: an object $L$ with morphisms $\pi_j : L \to D(j)$ for each $j \in \mathcal{J}$ such that for every morphism $f : j \to k$ in $\mathcal{J}$, $D(f) \circ \pi_j = \pi_k$, and $L$ is universal with this property.
\end{definition}

\begin{definition}[Colimit]\label{def:colimit}
A \emph{colimit} is a limit in the opposite category: a universal cocone under $D$.
\end{definition}

\begin{example}[Limits in Set]\label{ex:limits-set}
\begin{itemize}
  \item The limit of the empty diagram is the terminal object $1$ (a singleton set)
  \item The limit of a discrete diagram (no non-identity morphisms) is the product $\prod D(j)$
  \item The limit of a parallel pair $A \rightrightarrows B$ is the equalizer
  \item The limit of a chain $A_0 \leftarrow A_1 \leftarrow A_2 \leftarrow \cdots$ is the inverse limit
\end{itemize}
\end{example}

\section{The Yoneda Lemma}\label{sec:yoneda}

The Yoneda lemma is one of the most fundamental results in category theory. It states that an object is completely determined by its relationships to all other objects.

\begin{theorem}[Yoneda Lemma]\label{thm:yoneda}
For any functor $F : \mathcal{C}^{\mathrm{op}} \to \mathbf{Set}$ and any object $A \in \mathcal{C}$, there is a natural bijection:
\[\mathrm{Nat}(\mathrm{Hom}(-, A), F) \cong F(A)\]
where $\mathrm{Nat}$ denotes the set of natural transformations.
\end{theorem}

\begin{proof}[Proof sketch]
Given a natural transformation $\eta : \mathrm{Hom}(-, A) \Rightarrow F$, we obtain an element of $F(A)$ by evaluating $\eta_A(\mathrm{id}_A)$. Conversely, given $x \in F(A)$, we define $\eta_B(f) = F(f)(x)$ for $f : B \to A$. Naturality of $\eta$ follows from functoriality of $F$.
\end{proof}

\begin{corollary}[Yoneda Embedding]\label{cor:yoneda-embedding}
The functor $Y : \mathcal{C} \to [\mathcal{C}^{\mathrm{op}}, \mathbf{Set}]$ defined by $Y(A) = \mathrm{Hom}(-, A)$ is fully faithful. That is, $\mathrm{Hom}_{\mathcal{C}}(A, B) \cong \mathrm{Nat}(Y(A), Y(B))$.
\end{corollary}

\begin{insight}
The Yoneda lemma tells us that an object $A$ is completely determined by the set of morphisms into it from all other objects. In programming, this corresponds to the principle that a data type is determined by the operations it supports. The Yoneda embedding is the categorical version of ``representing'' objects by their observers.
\end{insight}

\begin{example}[Yoneda for Types]\label{ex:yoneda-types}
In the category of types, the Yoneda lemma says:
\[(\forall R.\,(A \to R) \to F(R)) \cong F(A)\]
for any functor $F$. This is a ``free theorem'': any polymorphic function of type $\forall R.\,(A \to R) \to F(R)$ is uniquely determined by an element of $F(A)$.
\end{example}

\section{Kan Extensions}\label{sec:kan-extensions}

\begin{definition}[Kan Extension]\label{def:kan-extension}
Given functors $F : \mathcal{C} \to \mathcal{E}$ and $K : \mathcal{C} \to \mathcal{D}$, the \emph{left Kan extension} of $F$ along $K$ is a functor $\mathrm{Lan}_K F : \mathcal{D} \to \mathcal{E}$ equipped with a natural transformation $\eta : F \Rightarrow (\mathrm{Lan}_K F) \circ K$ that is universal among such pairs.
\end{definition}

Kan extensions generalize many familiar constructions:
\begin{itemize}
  \item Left Kan extension along the inclusion of a subcategory is \emph{extension by colimits}
  \item Left Kan extension of the identity along $K$ gives the \emph{left adjoint} of $K$ (if it exists)
  \item In Haskell, $\mathrm{Lan}_K F$ is implemented as a \emph{day convolution}
\end{itemize}

\section{Monoidal Categories}\label{sec:monoidal}

\begin{definition}[Monoidal Category]\label{def:monoidal-category}
A \emph{monoidal category} is a category $\mathcal{C}$ equipped with:
\begin{itemize}
  \item A bifunctor $\otimes : \mathcal{C} \times \mathcal{C} \to \mathcal{C}$ (the \emph{tensor product})
  \item A unit object $I$
  \item Natural isomorphisms for associativity and unit laws, satisfying coherence conditions
\end{itemize}
\end{definition}

\begin{example}[Monoidal Categories in Programming]\label{ex:monoidal-prog}
\begin{itemize}
  \item $(\mathbf{Set}, \times, 1)$ --- sets with Cartesian product (the category of types with pair types)
  \item $(\mathbf{Set}, +, 0)$ --- sets with disjoint union (the category of types with sum types)
  \item $(\mathbf{Set}, \otimes, I)$ for any monoidal structure gives a notion of ``combining'' computations
\end{itemize}
\end{example}

\begin{definition}[Monoid in a Monoidal Category]\label{def:monoid-monoidal}
A \emph{monoid} in a monoidal category $(\mathcal{C}, \otimes, I)$ is an object $M$ equipped with morphisms $\mu : M \otimes M \to M$ and $\eta : I \to M$ satisfying associativity and unit laws.
\end{definition}

\begin{theorem}[Monads are Monoids]\label{thm:monads-monoids}
A monad on $\mathcal{C}$ is exactly a monoid in the monoidal category of endofunctors $[\mathcal{C}, \mathcal{C}]$ with composition as the tensor product and the identity functor as the unit.
\end{theorem}

\begin{proof}
The tensor product of endofunctors is composition: $(F \otimes G)(X) = F(G(X))$. The unit is the identity functor $\mathrm{Id}$. A monoid in this category is an endofunctor $T$ with $\mu : T \circ T \to T$ and $\eta : \mathrm{Id} \to T$ satisfying associativity and unit laws---exactly the definition of a monad.
\end{proof}

\section{Representable Functors}\label{sec:representable}

\begin{definition}[Representable Functor]\label{def:representable}
A functor $F : \mathcal{C}^{\mathrm{op}} \to \mathbf{Set}$ is \emph{representable} if it is naturally isomorphic to $\mathrm{Hom}(-, A)$ for some object $A$. The object $A$ is called the \emph{representing object}.
\end{definition}

\begin{example}[State as Representable]\label{ex:state-representable}
The state functor $T(A) = S \to A$ is representable: it is $\mathrm{Hom}(S, A)$, represented by the object $S$.
\end{example}

\begin{example}[Continuations as Representable]\label{ex:cont-representable}
The continuation functor $T(A) = (A \to R) \to R$ is representable: it is $\mathrm{Hom}(A \to R, R)$, represented by $A \to R$.
\end{example}

\section{Comonads}\label{sec:comonads}

\begin{definition}[Comonad]\label{def:comonad}
A \emph{comonad} on a category $\mathcal{C}$ is a triple $(W, \varepsilon, \delta)$ where:
\begin{itemize}
  \item $W : \mathcal{C} \to \mathcal{C}$ is an endofunctor
  \item $\varepsilon : W \Rightarrow \mathrm{Id}$ is the \emph{counit} (natural transformation)
  \item $\delta : W \Rightarrow W^2$ is the \emph{comultiplication} (natural transformation)
\end{itemize}
satisfying co-associativity and co-unit laws (dual to the monad laws).
\end{definition}

\begin{example}[Store Comonad]\label{ex:store-comonad}
The \emph{store comonad} $W(A) = S \times (S \to A)$ models a computation with access to a store of type $S$. The counit extracts the value at the current position; the comultiplication provides access to the entire store.
\end{example}

\begin{example}[Stream Comonad]\label{ex:stream-comonad}
The type of infinite streams $\mathrm{Stream}(A)$ is a comonad. The counit returns the head of the stream; the comultiplication returns the stream of all tails. This models \emph{reactive programming}: computations that observe an infinite stream of inputs.
\end{example}

\begin{table}[htbp]
\centering
\caption{Monads vs.\ Comonads}
\label{tab:monad-comonad}
\begin{tabular}{lll}
\hline
\textbf{Concept} & \textbf{Monad} & \textbf{Comonad} \\
\hline
Direction & $A \to W(A)$ (inject effects) & $W(A) \to A$ (extract values) \\
Unit/Counit & $\eta : A \to W(A)$ & $\varepsilon : W(A) \to A$ \\
Multiplication & $\mu : W^2(A) \to W(A)$ & $\delta : W(A) \to W^2(A)$ \\
Programming & Effectful computation & Contextual observation \\
Examples & State, Maybe, List, IO & Store, Stream, Zipper \\
\hline
\end{tabular}
\end{table}

\section{Exercises}\label{sec:functors-exercises}

\begin{enumerate}
  \item Prove that the composition of two functors is a functor.
  
  \item Show that the identity functor $\mathrm{Id} : \mathcal{C} \to \mathcal{C}$ (mapping every object and morphism to itself) is a functor.
  
  \item Prove that $\mathrm{reverse}$ is a natural transformation from $\mathrm{List}$ to $\mathrm{List}$.
  
  \item Show that the product-exponential adjunction holds in $\mathbf{Set}$: $\mathrm{Hom}(C \times A, B) \cong \mathrm{Hom}(C, B^A)$.
  
  \item Prove that every adjunction gives rise to a monad (Theorem~\ref{thm:monad-from-adj}).
  
  \item Show that the Galois connection between $\mathcal{P}(\mathbb{Z})$ and the interval lattice is an adjunction.
  
  \item Define the free monoid on a set $X$ and prove that it satisfies the universal property of free constructions.
  
  \item Show that a parametrically polymorphic function $\forall A.\,A \to A$ must be the identity function.
\end{enumerate}

\section{Chapter Summary}\label{sec:functors-summary}

This chapter has developed the key categorical concepts beyond the basic notion of a category:
\begin{itemize}
  \item Functors map between categories, preserving structure. Type constructors are functors.
  \item Natural transformations are uniform mappings between functors. Parametrically polymorphic functions are natural transformations.
  \item Adjunctions formalize optimal approximation. Galois connections are adjunctions between posets.
  \item Free and forgetful functors arise in adjunctions and provide the foundation for algebraic constructions.
  \item Every adjunction gives rise to a monad, connecting categorical structure to computational effects.
\end{itemize}

In the next chapter, we study monads in detail---their definition, laws, examples, and applications to programming language semantics.
