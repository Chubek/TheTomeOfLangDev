\section{Intermediate Code Generation: Detailed Treatment}
\label{sec:icg-detailed}

\subsection{Representing Three-Address Code}
\label{sec:tac-representation}

Three-address code (TAC) can be represented in several ways:

\begin{definition}[TAC Instruction Formats]
\label{def:tac-formats}
Common TAC instruction formats include:
\begin{align*}
  x &= y \;\textbf{op}\; z & &\text{(binary operation)} \\
  x &= \textbf{op}\; y & &\text{(unary operation)} \\
  x &= y & &\text{(copy)} \\
  \textbf{goto } L & & &\text{(unconditional jump)} \\
  \textbf{if } x \;\textbf{op}\; y \;\textbf{goto } L & & &\text{(conditional jump)} \\
  \textbf{param } x & & &\text{(parameter passing)} \\
  x &= \textbf{call } f, n & &\text{(procedure call with } n \text{ args)} \\
  \textbf{return } x & & &\text{(return value)}
\end{align*}
\end{definition}

\begin{example}[TAC for a Simple Program]
\label{ex:tac-simple}
Source program:
\begin{verbatim}
  int i;
  int sum = 0;
  for (i = 1; i <= 10; i = i + 1) {
    sum = sum + i;
  }
\end{verbatim}
Generated TAC:
\begin{verbatim}
  sum = 0
  i = 1
L1:
  t1 = i <= 10
  if not t1 goto L2
  t2 = sum + i
  sum = t2
  t3 = i + 1
  i = t3
  goto L1
L2:
\end{verbatim}
\end{example}

\subsection{TAC Generation for Declarations}
\label{sec:tac-declarations}

Variable declarations must allocate storage and record type information:

\begin{grammar}{TAC for Declarations}
  D & \longrightarrow \textbf{int } \textbf{id} \qquad & \begin{array}{l} \textbf{addr} = \texttt{newaddr}() \\ \texttt{enter}(\textbf{id}.\textbf{name}, \textbf{addr}, \textbf{int}) \end{array} \\
    & \mid \textbf{float } \textbf{id} \qquad & \begin{array}{l} \textbf{addr} = \texttt{newaddr}() \\ \texttt{enter}(\textbf{id}.\textbf{name}, \textbf{addr}, \textbf{float}) \end{array} \\
    & \mid \textbf{array } \textbf{id} [ \textbf{num} ] \textbf{ of } T \qquad & \begin{array}{l} \textbf{addr} = \texttt{newaddr}() \\ \textbf{width} = \textbf{num}.\textbf{val} \times T.\textbf{width} \\ \texttt{enterarray}(\textbf{id}.\textbf{name}, \textbf{addr}, T.\textbf{type}, \textbf{num}.\textbf{val}) \end{array}
\end{grammar}

\subsection{TAC Generation for Array Access}
\label{sec:tac-arrays}

Array element access requires computing the address of the element:

\begin{grammar}{TAC for Array Access}
  E & \longrightarrow \textbf{id} [ E_1 ] \qquad & \begin{array}{l} E.\textbf{addr} = \texttt{newtemp}() \\ t_1 = E_1.\textbf{addr} \times \textbf{width} \\ E.\textbf{addr} = \texttt{gen}(\textbf{id}.\textbf{addr} [ t_1 ]) \end{array}
\end{grammar}

For multi-dimensional arrays, the address computation is more complex:
\[
\text{addr} = \text{base} + ((i_1 \times d_2 + i_2) \times d_3 + i_3) \times \text{width}
\]
where $d_i$ are the dimension sizes.

\subsection{TAC for Records and Objects}
\label{sec:tac-records}

Record field access generates offset computations:

\begin{grammar}{TAC for Record Access}
  E & \longrightarrow E_1 \textbf{.} \textbf{id} \qquad & \begin{array}{l} E.\textbf{addr} = \texttt{newtemp}() \\ \textbf{offset} = \texttt{field\_offset}(E_1.\textbf{type}, \textbf{id}) \\ \texttt{gen}(E.\textbf{addr} \texttt{=} E_1.\textbf{addr} + \textbf{offset}) \end{array}
\end{grammar}

\section{Control Flow Translation: Complete Treatment}
\label{sec:control-flow-complete}

\subsection{While Loop Translation}
\label{sec:while-translation}

\begin{grammar}{Backpatching for While Loops}
  S & \longrightarrow \textbf{while } M_1 \; ( B ) \; M_2 \; S_1 \\
  M_1 & \longrightarrow \epsilon \qquad & M_1.\textbf{quad} = \texttt{nextquad} \\
  M_2 & \longrightarrow \epsilon \qquad & \begin{array}{l} \texttt{gen}(\texttt{goto } M_1.\textbf{quad}) \\ \texttt{backpatch}(S_1.\textbf{nextlist}, \texttt{nextquad}) \end{array}
\end{grammar}

The semantic actions:
\begin{itemize}
  \item $B.\textbf{true}$ is set to $\texttt{nextquad}$ after $M_2$ (the loop body)
  \item $B.\textbf{false}$ is backpatched to the instruction after $S_1$ (loop exit)
  \item $M_2$ generates a \texttt{goto} back to the condition test
\end{itemize}

\subsection{Switch Statement Translation}
\label{sec:switch-translation}

Switch statements can be translated to TAC using a jump table or a sequence of conditional branches:

\begin{example}[Switch Translation]
\label{ex:switch-tac}
Source:
\begin{verbatim}
  switch (x) {
    case 1: stmt1; break;
    case 2: stmt2; break;
    default: stmt3;
  }
\end{verbatim}
TAC (jump table approach):
\begin{verbatim}
  t1 = x - 1
  if t1 > 1 goto Ldefault
  goto jump_table[t1]
L1:
  stmt1
  goto Lend
L2:
  stmt2
  goto Lend
Ldefault:
  stmt3
Lend:
\end{verbatim}
\end{example}

\subsection{Function Call Translation}
\label{sec:call-translation}

\begin{grammar}{TAC for Function Calls}
  S & \longrightarrow \textbf{id} ( \textbf{args} ) \\
  \textbf{args} & \longrightarrow E \qquad & \texttt{gen}(\texttt{param } E.\textbf{addr}) \\
    & \mid \textbf{args}_1 , E \qquad & \begin{array}{l} \textbf{args}_1.\textbf{code} \\ \texttt{gen}(\texttt{param } E.\textbf{addr}) \end{array}
\end{grammar}

The call itself is generated after all parameters:
\[
S.\textbf{code} = \textbf{args}.\textbf{code} \concat \texttt{gen}(t = \texttt{call } \textbf{id}, n)
\]

\section{Type Translation and Coercion}
\label{sec:type-translation}

\subsection{Type Translation Rules}
\label{sec:type-rules}

Complete type translation rules for a simple language:

\begin{grammar}{Complete Type Checking}
  E & \longrightarrow E_1 + E_2 \qquad & \begin{array}{l}
    \textbf{if } E_1.\textbf{type} = \textbf{int} \land E_2.\textbf{type} = \textbf{int} \textbf{ then} \\
    \quad E.\textbf{type} = \textbf{int}; \; E.\textbf{code} = E_1.\textbf{code} \concat E_2.\textbf{code} \concat \texttt{gen}(t = E_1.\textbf{addr} + E_2.\textbf{addr}) \\
    \textbf{else if } E_1.\textbf{type} = \textbf{float} \land E_2.\textbf{type} = \textbf{int} \textbf{ then} \\
    \quad E.\textbf{type} = \textbf{float}; \; E.\textbf{code} = E_1.\textbf{code} \concat E_2.\textbf{code} \concat \texttt{gen}(t_1 = \texttt{inttofloat } E_2.\textbf{addr}) \concat \texttt{gen}(t = E_1.\textbf{addr} + t_1) \\
    \textbf{else if } E_1.\textbf{type} = \textbf{int} \land E_2.\textbf{type} = \textbf{float} \textbf{ then} \\
    \quad E.\textbf{type} = \textbf{float}; \; E.\textbf{code} = E_1.\textbf{code} \concat E_2.\textbf{code} \concat \texttt{gen}(t_1 = \texttt{inttofloat } E_1.\textbf{addr}) \concat \texttt{gen}(t = t_1 + E_2.\textbf{addr}) \\
    \textbf{else} \\
    \quad E.\textbf{type} = \textbf{type\_error}
  \end{array}
\end{grammar}

\subsection{Type Equivalence}
\label{sec:type-equivalence}

\begin{definition}[Type Equivalence]
\label{def:type-equiv}
Two types are \textbf{equivalent} if:
\begin{itemize}
  \item \textbf{Structural equivalence}: They have the same structure (same constructors applied to equivalent types).
  \item \textbf{Name equivalence}: They have the same type name (declared in the same type declaration).
\end{itemize}
\end{definition}

\begin{example}[Structural vs.\ Name Equivalence]
\label{ex:type-equiv}
\begin{verbatim}
  type T1 = record { int x; int y; };
  type T2 = record { int x; int y; };
  var a: T1;
  var b: T2;
\end{verbatim}
Under structural equivalence, $a$ and $b$ have the same type (both are records with two integer fields).
Under name equivalence, $a$ and $b$ have different types ($T_1 \neq T_2$).
\end{example}

\section{Symbol Table Implementation}
\label{sec:symbol-table-impl}

\subsection{Data Structures for Symbol Tables}
\label{sec:symbol-table-ds}

\begin{definition}[Symbol Table Operations]
\label{def:symtab-ops}
A symbol table supports the following operations:
\begin{itemize}
  \item $\texttt{mktable}(\text{previous})$: Create a new symbol table with \text{previous} as its parent scope.
  \item $\texttt{enter}(table, name, type, offset)$: Add a binding to the symbol table.
  \item $\texttt{lookup}(table, name)$: Search for a name, starting from the given table and following parent links.
  \item $\texttt{addwidth}(table, width)$: Record the total width of all fields in the table.
\end{itemize}
\end{definition}

\begin{algorithm}[htbp]
\caption{Symbol table implementation using a tree of hash tables}
\begin{algorithmic}[1]
\Function{MkTable}{$prev$}
  \State $t \gets \text{new HashTable}()$
  \State $t.\text{parent} \gets prev$
  \State \textbf{return} $t$
\EndFunction
\Function{Enter}{$table, name, type, offset$}
  \State $table[name] \gets (type, offset)$
\EndFunction
\Function{Lookup}{$table, name$}
  \State $t \gets table$
  \While{$t \neq \texttt{null}$}
    \If{$name \in t$}
      \State \textbf{return} $t[name]$
    \EndIf
    \State $t \gets t.\text{parent}$
  \EndWhile
  \State \textbf{return} \texttt{null}
\EndFunction
\end{algorithmic}
\end{algorithm}

\subsection{Layout of Local Variables}
\label{sec:local-layout}

The symbol table tracks the offset of each local variable in the activation record:

\begin{grammar}{Layout Computation}
  P & \longrightarrow \{ \texttt{offset} = 0 \} \; D \; S \\
  D & \longrightarrow D_1 ; D_2 \qquad & \begin{array}{l} D_1 \text{ processed first} \\ D_2 \text{ processed next} \end{array} \\
    & \longrightarrow \textbf{int } \textbf{id} \qquad & \begin{array}{l} \texttt{enter}(\text{table}, \textbf{id}.\textbf{name}, \textbf{int}, \texttt{offset}) \\ \texttt{offset} = \texttt{offset} + 4 \end{array} \\
    & \longrightarrow \textbf{float } \textbf{id} \qquad & \begin{array}{l} \texttt{enter}(\text{table}, \textbf{id}.\textbf{name}, \textbf{float}, \texttt{offset}) \\ \texttt{offset} = \texttt{offset} + 8 \end{array} \\
    & \longrightarrow \textbf{array } \textbf{id} [ n ] \textbf{ of } T \qquad & \begin{array}{l} \texttt{enter}(\text{table}, \textbf{id}.\textbf{name}, T.\textbf{type}, \texttt{offset}) \\ \texttt{offset} = \texttt{offset} + n \times T.\textbf{width} \end{array}
\end{grammar}

\section{AST-Based Translation}
\label{sec:ast-translation}

\subsection{Two-Pass Translation}
\label{sec:two-pass}

In modern compilers, translation is typically split into two passes:
\begin{enumerate}
  \item \textbf{Parsing}: Build an Abstract Syntax Tree (AST) from the source code.
  \item \textbf{Semantic analysis}: Traverse the AST to perform type checking, name resolution, and code generation.
\end{enumerate}

\begin{definition}[AST Node]
\label{def:ast-node}
An \textbf{AST node} represents a syntactic construct and carries:
\begin{itemize}
  \item The kind of construct (e.g., \texttt{BinaryOp}, \texttt{IfStmt}, \texttt{VarDecl})
  \item Child nodes (sub-constructs)
  \item Attributes (type, symbol table entry, etc.)
\end{itemize}
\end{definition}

\begin{example}[AST for Arithmetic Expression]
\label{ex:ast-expr}
The expression \texttt{3 + x * 2} produces the AST:
\begin{verbatim}
  BinaryOp(+)
  ├── Literal(3)
  └── BinaryOp(*)
      ├── VarRef(x)
      └── Literal(2)
\end{verbatim}
\end{example}

\subsection{The Visitor Pattern}
\label{sec:visitor-pattern}

The visitor pattern provides a clean way to traverse the AST and perform translation:

\begin{definition}[Visitor Interface]
\label{def:visitor}
\begin{verbatim}
  interface Visitor<R> {
    R visitBinaryOp(BinaryOp node);
    R visitLiteral(Literal node);
    R visitVarRef(VarRef node);
    R visitIfStmt(IfStmt node);
    // ... one method per AST node type
  }
\end{verbatim}
\end{definition}

\begin{example}[Type-Checking Visitor]
\label{ex:type-visitor}
\begin{verbatim}
  class TypeChecker implements Visitor<Type> {
    Type visitBinaryOp(BinaryOp node) {
      Type left = node.left.accept(this);
      Type right = node.right.accept(this);
      if (left == Type.INT && right == Type.INT)
        return Type.INT;
      else if (left == Type.FLOAT || right == Type.FLOAT)
        return Type.FLOAT;
      else
        throw new TypeError("incompatible types");
    }
  }
\end{verbatim}
\end{example}

\subsection{Attribute Grammar Tools for Translation}
\label{sec:ag-tools-translation}

Tools like JastAdd and Kiama allow translation to be specified as attribute grammars, separate from the grammar:

\begin{example}[JastAdd Type Checking]
\label{ex:jastadd-type}
\begin{verbatim}
  aspect TypeChecking {
    syn int BinaryExpr.type() {
      if (left().type() == int && right().type() == int)
        return int;
      else
        return type_error;
    }
    
    inh Environment Expr.env();
    
    syn int VarExpr.type() {
      return env().lookup(name());
    }
  }
\end{verbatim}
The attribute grammar tool automatically determines evaluation order and handles dependencies.
\end{example}
