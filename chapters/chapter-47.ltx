\section{Advanced Inductive Families and Universe Management}\label{sec:inductive-families-advanced}

\subsection{Well-Founded Recursion and Termination}\label{sec:well-founded}

Dependent type systems require all functions to terminate (to maintain logical consistency). This is ensured by restricting recursion to \emph{structurally recursive} calls or by requiring explicit \emph{well-founded} recursion.

\begin{definition}[Structural Recursion]\label{def:structural-rec}
A recursive function is \emph{structurally recursive} if each recursive call is made on a strict structural subterm of the original argument. That is, the argument to the recursive call is obtained by applying one or more destructors (pattern matching) to the original argument.
\end{definition}

\begin{example}[Structural recursion on natural numbers]\label{ex:structural-rec}
\begin{verbatim}
  factorial : Nat -> Nat
  factorial zero = 1
  factorial (suc n) = (suc n) * factorial n
  -- Recursive call is on n, which is a subterm of (suc n)
\end{verbatim}
\end{example}

\begin{definition}[Well-Founded Recursion]\label{def:well-founded-rec}
A function defined by recursion on a well-founded relation $(A, <)$ is total if each recursive call is made on an argument $y$ such that $y < x$ (where $x$ is the current argument).
\end{definition}

\begin{verbatim}
  -- Well-founded recursion using accessibility:
  ackermann : Nat -> Nat -> Nat
  ackermann zero n = suc n
  ackermann (suc m) zero = ackermann m 1
  ackermann (suc m) (suc n) = ackermann m (ackermann (suc m) n)
  -- Termination: uses lexicographic ordering on (m, n)
\end{verbatim}

\subsection{Higher Inductive Types}\label{sec:higher-inductive}

\emph{Higher inductive types} (HITs) generalize inductive types by allowing constructors that produce \emph{paths} (equalities) as well as points.

\begin{definition}[Higher Inductive Type]\label{def:hit}
A \emph{higher inductive type} is defined by:
\begin{itemize}
  \item \textbf{Point constructors.} Produce elements of the type (as in ordinary inductive types).
  \item \textbf{Path constructors.} Produce equalities between elements of the type.
\end{itemize}
\end{definition}

\begin{example}[The circle as a HIT]\label{ex:circle-hit}
\begin{verbatim}
  data Circle : Type where
    base : Circle                        -- point constructor
    loop : base == base                  -- path constructor
\end{verbatim}
The circle has one point (\texttt{base}) and one loop (a path from \texttt{base} to itself). Functions out of the circle must respect the loop: $f : \mathrm{Circle} \to A$ requires $f(\mathrm{base}) = f(\mathrm{base})$ via $\mathrm{ap}\; f\; \mathrm{loop}$.
\end{example}

\begin{example}[The integers as a HIT]\label{ex:int-hit}
\begin{verbatim}
  data Int : Type where
    zero : Int
    suc  : Int -> Int
    pred : Int -> Int
    suc-pred : (n : Int) -> suc (pred n) == n
    pred-suc : (n : Int) -> pred (suc n) == n
\end{verbatim}
The integers are defined with two inverse operations and proofs that they cancel. This is a more abstract definition than the usual inductive definition (as $\mathbb{N} + \mathbb{N}$ modulo equivalence).
\end{example}

\subsection{Universe Constraints and Cumulativity}\label{sec:universe-constraints}

Modern proof assistants manage universe levels through constraint solving.

\begin{algorithm}[H]
\caption{Universe Constraint Solving}\label{alg:universe-solve}
\begin{algorithmic}[1]
\Function{SolveUniverseConstraints}{$C$}
  \State $C \gets \{u_i \leq u_j \mid \text{from typing judgments}\}$
  \State \Comment{Build constraint graph}
  \State $G \gets \text{directed graph with nodes } u_i \text{ and edges } u_i \to u_j$
  \State \Comment{Compute strongly connected components}
  \State $\mathrm{SCC} \gets \mathrm{Tarjan}(G)$
  \State \Comment{All universes in an SCC must be equal}
  \For{each SCC $S$}
    \State Assign all $u_i \in S$ the same level variable $u_S$
  \EndFor
  \State \Comment{Topological sort gives ordering constraints}
  \State \Return assignment satisfying all constraints
\EndFunction
\end{algorithmic}
\end{algorithm}

