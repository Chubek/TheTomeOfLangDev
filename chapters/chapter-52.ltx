\section{Advanced Boxed/Unboxed Representations and RTTI}\label{sec:boxed-unboxed-advanced}

\subsection{Escape Analysis for Unboxing}\label{sec:escape-analysis}

\emph{Escape analysis} determines whether an object allocated in one scope can be observed outside that scope. If an object does not escape, it can be stack-allocated or even unboxed.

\begin{algorithm}[H]
\caption{Escape Analysis}\label{alg:escape-analysis}
\begin{algorithmic}[1]
\Function{AnalyzeEscapes}{$\mathrm{IR}$}
  \State $\mathrm{escapes} \gets \{\}$
  \For{each allocation $a$ in $\mathrm{IR}$}
    \State $\mathrm{points\_to}(a) \gets \{a\}$
  \EndFor
  \State \Comment{Compute points-to information}
  \Repeat
    \For{each assignment $x = y$}
      \State $\mathrm{points\_to}(x) \gets \mathrm{points\_to}(x) \cup \mathrm{points\_to}(y)$
    \EndFor
    \For{each store $\mathtt{*}p = v$}
      \State $\mathrm{points\_to}(p) \gets \mathrm{points\_to}(p) \cup \mathrm{points\_to}(v)$
    \EndFor
    \For{each return $x$}
      \State $\mathrm{escapes} \gets \mathrm{escapes} \cup \mathrm{points\_to}(x)$
    \EndFor
    \For{each call $f(x)$}
      \State $\mathrm{escapes} \gets \mathrm{escapes} \cup \mathrm{points\_to}(x)$
    \EndFor
  \Until{no changes}
  \State \Return $\mathrm{escapes}$
\EndFunction
\end{algorithmic}
\end{algorithm}

\begin{example}[Escape analysis for unboxing]\label{ex:escape-unbox}
\begin{verbatim}
  // Source:
  fn compute() -> i32 {
    let pair = (42, 17);  // heap-allocated pair
    let (a, b) = pair;    // destructure
    a + b                  // return sum
  }

  // After escape analysis:
  // 'pair' does not escape the function
  // -> allocate on stack, or unbox entirely:
  fn compute() -> i32 {
    42 + 17  // pair eliminated, constants folded
  }
\end{verbatim}
\end{example}

\subsection{Boxed vs. Unboxed: Detailed Comparison}\label{sec:boxed-unboxed-detail}

\begin{table}[htbp]
\centering
\caption{Detailed comparison of boxed and unboxed representations}\label{tab:boxed-unboxed-detail}
\begin{tabular}{p{3.5cm}p{4.5cm}p{4.5cm}}
\hline
\textbf{Aspect} & \textbf{Boxed} & \textbf{Unboxed} \\
\hline
Memory layout & Pointer to heap object & Direct value in register \\
Allocation & Heap allocation required & Stack/register allocation \\
Size & Uniform (1 word) & Variable (type-dependent) \\
GC traversal & Uniform (follow pointers) & Requires type info \\
Polymorphism & Natural (all values are pointers) & Requires specialization \\
Cache behavior & Poor (pointer chasing) & Good (contiguous data) \\
Pattern matching & Tag check + field access & Direct field access \\
Function call & Pass pointer & Pass value(s) \\
\hline
\end{tabular}
\end{table}

\subsection{Runtime Type Information: Implementation Strategies}\label{sec:rtti-strategies}

Runtime type information can be implemented in several ways:

\begin{verbatim}
  // Strategy 1: Type tag in object header
  struct Object {
    uint32_t type_tag;    // unique identifier for the type
    uint32_t gc_info;     // garbage collection metadata
    // ... fields ...
  };

  // Strategy 2: Method table pointer (vtable)
  struct Object {
    void* vtable;         // pointer to virtual method table
    // The vtable also serves as a type identifier
    // ... fields ...
  };

  // Strategy 3: Cohen's display
  struct Object {
    void* class_display[4];  // fixed-size array of ancestor pointers
    // Type test: check if display[i] == expected_class
    // ... fields ...
  };
\end{verbatim}

\subsection{Type Tests: Performance Comparison}\label{sec:type-test-perf}

