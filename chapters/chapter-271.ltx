  \node[split op] (s) at (0,-1.12) {Rotate\\\(s=\texttt{0x67}\)};
  \node[split op] (l) at (0,-2.62) {Low nibble\\\(l=7\)};
  \node[split op] (h) at (5.25,-2.62) {High nibble\\\(h=6\)};
  \node[split op] (r) at (2.6,-4.45) {XOR\\Result \(=1\)};
  \begin{scope}[on background layer]
    \node[tome group,fit=(s)(l)] (pair) {};
  \end{scope}
  \draw[tome arrow] (in)--(s);
  \draw[tome arrow] (s)--(l);
  \draw[tome arrow] (s.east)-|node[pos=0.25,above,font=\footnotesize]{export \(s\)} (h.north);
  \draw[tome arrow] (l.south)--(r.north west);
  \draw[tome arrow] (h.south)--(r.north east);
