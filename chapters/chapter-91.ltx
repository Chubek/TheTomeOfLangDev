  \node[node, fill=TomeExBg] (add1) at (-2, 0) {add};
  \node[node, fill=TomeExBg] (add2) at (2, 0) {add};
  \node[node, fill=TomeDefBg] (load1) at (-3, -2) {load};
  \node[node, fill=TomeDefBg] (const) at (-1, -2) {const};
  \node[node, fill=TomeDefBg] (load2) at (1, -2) {load};
