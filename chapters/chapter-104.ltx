% Counterexample-Guided Inductive Synthesis (CEGIS)
% ============================================================
\section{Counterexample-Guided Inductive Synthesis (CEGIS)}\label{sec:synth-cegis}

\subsection{The CEGIS Loop}\label{sec:synth-cegis-loop}

CEGIS~\cite{solar2008context,gulwani2011automating} is the dominant algorithm
for sketch-based synthesis.  It reduces the synthesis problem to a sequence of
constraint-solving queries, using counterexamples to iteratively refine the
search.

\begin{algorithm}[htbp]
\caption{CEGIS Algorithm}\label{alg:cegis}
\begin{algorithmic}[1]
\Require Sketch $S(h)$, specification $\varphi$, initial test set $T_0$
\Ensure Completed sketch $S(v)$ satisfying $\varphi$, or \textsc{None}
\State $T \gets T_0$
\Loop
  \State \Comment{\textbf{Synthesis phase:} find $v$ consistent with $T$}
  \State $\phi_{\mathit{synth}} \gets \bigwedge_{t \in T} \varphi(S(h), t)$
  \If{$\mathrm{SMT.Solve}(\phi_{\mathit{synth}}) = \mathit{unsat}$}
    \State \Return \textsc{None} \Comment{No solution exists}
  \EndIf
  \State $v \gets \mathrm{SMT.Solve}(\phi_{\mathit{synth}})$ \Comment{Get satisfying assignment}
  \State \Comment{\textbf{Verification phase:} check if $S(v)$ satisfies $\varphi$}
  \State $\phi_{\mathit{verify}} \gets \exists x.\; \neg\varphi(S(v), x)$
  \If{$\mathrm{SMT.Solve}(\phi_{\mathit{verify}}) = \mathit{unsat}$}
    \State \Return $S(v)$ \Comment{Solution is correct!}
  \EndIf
  \State $t_{\mathit{ce}} \gets \mathrm{SMT.Solve}(\phi_{\mathit{verify}})$ \Comment{Get counterexample}
  \State $T \gets T \cup \{t_{\mathit{ce}}\}$
\EndLoop
\end{algorithmic}
\end{algorithm}

\subsection{Soundness and Completeness}\label{sec:synth-cegis-correctness}

\begin{theorem}[CEGIS Soundness]\label{thm:cegis-sound}
If CEGIS returns $S(v)$, then $S(v)$ satisfies the specification $\varphi$ for
all inputs.
\end{theorem}

\begin{proof}
CEGIS returns $S(v)$ only when the verification phase determines that
$\exists x.\; \neg\varphi(S(v), x)$ is unsatisfiable, meaning there is no input
$x$ for which $S(v)$ violates $\varphi$.  Hence $S(v)$ satisfies $\varphi$ for
all inputs.
\end{proof}

\begin{theorem}[CEGIS Completeness]\label{thm:cegis-complete}
If a solution exists and the specification $\varphi$ is decidable, then CEGIS
terminates and returns a solution.
\end{theorem}

\begin{proof}
Each iteration of CEGIS adds a counterexample to $T$.  Since the specification
is decidable, the synthesis phase either finds a solution or correctly reports
that none is consistent with $T$.  If a solution $S(v^*)$ exists, it is
consistent with all possible counterexamples.  Since the space of possible
behaviors is finite (for finite-domain programs), the set of counterexamples
must eventually be sufficient to uniquely determine a correct solution.
\end{proof}

\begin{caution}
In practice, CEGIS may not terminate in reasonable time even when a solution
exists, because the number of counterexamples needed may be very large, or
because the SMT queries become too complex.  The practical efficiency of CEGIS
depends heavily on the quality of the initial test set and the effectiveness of
the SMT solver.
\end{caution}

\subsection{CEGIS Variants}\label{sec:synth-cegis-variants}

Several variants of CEGIS improve practical performance:

\begin{itemize}
\item \textbf{CEGIS with synthesis from examples:} Replace the SMT-based
      synthesis phase with enumerative synthesis, using the counterexamples as
      the example set.
\item \textbf{CEGIS with component mining:} Analyze the reference
      implementation to identify useful components, reducing the search space.
\item \textbf{Incremental CEGIS:} Reuse information from previous iterations
      (e.g., partial assignments, learned lemmas) to speed up subsequent queries.
\item \textbf{Parallel CEGIS:} Run multiple synthesis instances with different
      initial test sets in parallel.
\end{itemize}

