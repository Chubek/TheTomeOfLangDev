\label{ch:finite-automata}

\section{Introduction to Finite Automata}
\label{sec:finite-automata-intro}

Finite automata are the simplest computational model capable of recognizing patterns in strings. They form the theoretical foundation for lexical analysis---the first phase of compilation, where the source text is divided into tokens. Despite their simplicity, finite automata capture an important class of languages---the \emph{regular languages}---that are precisely characterized by regular expressions.

The theory of finite automata was developed in the 1950s and 1960s by Kleene, Rabin, Scott, Myhill, Nerode, and others. The equivalence between finite automata and regular expressions (Kleene's theorem) is one of the foundational results of theoretical computer science.

\begin{historical}
Finite automata were first studied by Michael Rabin and Dana Scott in their 1959 paper ``Finite Automata and Their Decision Problem,'' which introduced nondeterministic automata and proved their equivalence to deterministic automata. Stephen Kleene had earlier (1951) studied the kind of events that nerve nets can recognize, introducing regular expressions. The equivalence between regular expressions and finite automata (Kleene's theorem) was established by Kleene (1956). The minimization algorithm for DFAs was developed by Huffman (1954) and Moore (1956), and later improved by Hopcroft (1971).
\end{historical}

\section{Deterministic Finite Automata}
\label{sec:dfa}

\begin{definition}[Deterministic Finite Automaton]
\label{def:dfa}
A \textbf{deterministic finite automaton} (DFA) is a 5-tuple $M = (Q, \Sigma, \delta, q_0, F)$ where:
\begin{itemize}
  \item $Q$ is a finite set of \textbf{states}
  \item $\Sigma$ is a finite \textbf{alphabet}
  \item $\delta : Q \times \Sigma \to Q$ is the \textbf{transition function}
  \item $q_0 \in Q$ is the \textbf{start state}
  \item $F \subseteq Q$ is the set of \textbf{accept states} (or \textbf{final states})
\end{itemize}
\end{definition}

The DFA reads an input string one symbol at a time, transitioning between states according to $\delta$. After reading the entire string, the DFA accepts if it is in an accept state and rejects otherwise.

\begin{definition}[Extended Transition Function]
\label{def:extended-delta}
The \textbf{extended transition function} $\hat{\delta} : Q \times \Sigma^* \to Q$ is defined recursively:
\begin{align*}
  \hat{\delta}(q, \epsilon) &= q \\
  \hat{\delta}(q, wa) &= \delta(\hat{\delta}(q, w), a)
\end{align*}
\end{definition}

\begin{definition}[Language of a DFA]
\label{def:dfa-language}
The \textbf{language} of a DFA $M$ is:
\[
L(M) = \{w \in \Sigma^* \mid \hat{\delta}(q_0, w) \in F\}
\]
\end{definition}

\begin{example}[A Simple DFA]
\label{ex:dfa-simple}
Consider the DFA over $\Sigma = \{a, b\}$ that accepts strings containing an even number of $a$'s:
\begin{itemize}
  \item $Q = \{q_0, q_1\}$
  \item $\delta(q_0, a) = q_1$, $\delta(q_0, b) = q_0$
  \item $\delta(q_1, a) = q_0$, $\delta(q_1, b) = q_1$
  \item $F = \{q_0\}$
\end{itemize}
\end{example}

\section{Nondeterministic Finite Automata}
\label{sec:nfa}

\begin{definition}[Nondeterministic Finite Automaton]
\label{def:nfa}
A \textbf{nondeterministic finite automaton} (NFA) is a 5-tuple $M = (Q, \Sigma, \delta, q_0, F)$ where:
\begin{itemize}
  \item $Q$, $\Sigma$, $q_0$, $F$ are as for DFAs
  \item $\delta : Q \times (\Sigma \cup \{\epsilon\}) \to \mathcal{P}(Q)$ is the \textbf{transition function}, mapping to \emph{sets} of states
\end{itemize}
\end{definition}

An NFA can be in multiple states simultaneously. It accepts a string if there exists \emph{some} sequence of transitions that leads to an accept state. Equivalently, we can think of the NFA as ``guessing'' the right path.

\begin{definition}[Language of an NFA]
\label{def:nfa-language}
The \textbf{language} of an NFA $M$ is:
\[
L(M) = \{w \in \Sigma^* \mid \hat{\delta}(q_0, w) \cap F \neq \emptyset\}
\]
where $\hat{\delta}(q, w)$ is the set of all states reachable from $q$ by reading $w$.
\end{definition}

\begin{theorem}[DFA--NFA Equivalence]
\label{thm:dfa-nfa-equiv}
For every NFA $N$, there exists a DFA $D$ such that $L(D) = L(N)$.
\end{theorem}

\begin{proof}
By the \emph{subset construction} (or \emph{powerset construction}). Given an NFA $N = (Q_N, \Sigma, \delta_N, q_0, F_N)$, construct a DFA $D = (Q_D, \Sigma, \delta_D, q_0', F_D)$ where:
\begin{itemize}
  \item $Q_D = \mathcal{P}(Q_N)$ (states of $D$ are sets of states of $N$)
  \item $q_0' = \epsilon\text{-closure}(\{q_0\})$
  \item $\delta_D(S, a) = \epsilon\text{-closure}\left(\bigcup_{q \in S} \delta_N(q, a)\right)$
  \item $F_D = \{S \in Q_D \mid S \cap F_N \neq \emptyset\}$
\end{itemize}
The DFA simulates all possible computations of the NFA simultaneously.
\end{proof}

\begin{caution}
The subset construction can produce a DFA with up to $2^{|Q_N|}$ states. In the worst case, this exponential blowup is unavoidable: there exist NFAs with $n$ states for which every equivalent DFA has $2^n$ states.
\end{caution}

\section{Regular Expressions}
\label{sec:regular-expressions}

\begin{definition}[Regular Expression]
\label{def:regex}
A \textbf{regular expression} over an alphabet $\Sigma$ is defined recursively:
\begin{itemize}
  \item $\emptyset$ is a regular expression (denoting the empty language)
  \item $\epsilon$ is a regular expression (denoting $\{\epsilon\}$)
  \item For each $a \in \Sigma$, $a$ is a regular expression (denoting $\{a\}$)
  \item If $r$ and $s$ are regular expressions, then so are:
    \begin{itemize}
      \item $r \mid s$ (union/alternation)
      \item $r \cdot s$ (concatenation)
      \item $r^*$ (Kleene star/repetition)
    \end{itemize}
\end{itemize}
\end{definition}

\begin{theorem}[Kleene's Theorem]
\label{thm:kleene}
A language is regular if and only if it can be described by a regular expression. Equivalently, the following are equivalent:
\begin{enumerate}
  \item $L$ is accepted by a DFA
  \item $L$ is accepted by an NFA
  \item $L$ is described by a regular expression
\end{enumerate}
\end{theorem}

\subsection{Regular Expression to NFA: Thompson's Construction}
\label{sec:thompson}

Thompson's construction converts a regular expression to an NFA recursively:

\begin{definition}[Thompson's Construction]
\label{def:thompson}
Given a regular expression $r$, the NFA $N(r)$ is constructed as follows:
\begin{itemize}
  \item $N(\emptyset)$: a single non-accepting state with no transitions
  \item $N(\epsilon)$: a single accept state
  \item $N(a)$: two states with an $a$-transition
  \item $N(r \mid s)$: new start state with $\epsilon$-transitions to the start states of $N(r)$ and $N(s)$; the accept states of $N(r)$ and $N(s)$ have $\epsilon$-transitions to a new accept state
  \item $N(r \cdot s)$: the accept state of $N(r)$ is connected by an $\epsilon$-transition to the start state of $N(s)$
  \item $N(r^*)$: new start/accept state with $\epsilon$-transitions to the start state of $N(r)$ and from the accept state of $N(r)$ back to the start state
\end{itemize}
\end{definition}

\section{Minimization of DFAs}
\label{sec:dfa-minimization}

\subsection{State Equivalence}
\label{sec:state-equivalence}

\begin{definition}[Equivalent States]
\label{def:equivalent-states}
Two states $p$ and $q$ of a DFA are \textbf{equivalent} (written $p \equiv q$) if for every string $w \in \Sigma^*$:
\[
\hat{\delta}(p, w) \in F \iff \hat{\delta}(q, w) \in F
\]
\end{definition}

\begin{theorem}[Minimal DFA]
\label{thm:minimal-dfa}
For every regular language $L$, there is a unique (up to isomorphism) minimal DFA that recognizes $L$. The minimal DFA has exactly as many states as there are equivalence classes of the Myhill--Nerode relation.
\end{theorem}

\subsection{Hopcroft's Minimization Algorithm}
\label{sec:hopcroft}

Hopcroft's algorithm (1971) minimizes a DFA in $O(n \log n)$ time:

\begin{algorithm}[htbp]
\caption{Minimize DFA $M = (Q, \Sigma, \delta, q_0, F)$}
\begin{algorithmic}[1]
\State Initialize partition $P = \{F, Q \setminus F\}$
\State Initialize worklist $W = \{(F, a) \mid a \in \Sigma\} \cup \{(Q \setminus F, a) \mid a \in \Sigma\}$
\While{$W$ is not empty}
  \State Remove $(A, a)$ from $W$
  \State Let $X = \{q \in Q \mid \delta(q, a) \in A\}$
  \For{each block $B$ of $P$ that $X$ splits}
    \State Split $B$ into $B_1 = B \cap X$ and $B_2 = B \setminus X$
    \State Replace $B$ in $P$ with $B_1$ and $B_2$
    \For{each $c \in \Sigma$}
      \If{$(B, c) \in W$}
        \State Replace $(B, c)$ in $W$ with $(B_1, c)$ and $(B_2, c)$
      \Else
        \State Add the smaller of $(B_1, c)$ and $(B_2, c)$ to $W$
      \EndIf
    \EndFor
  \EndFor
\EndWhile
\State Construct minimal DFA from partition $P$
\end{algorithmic}
\end{algorithm}

\section{Properties of Regular Languages}
\label{sec:regular-properties}

\subsection{Closure Properties}
\label{sec:closure-properties}

\begin{theorem}[Closure Properties of Regular Languages]
\label{thm:closure}
Regular languages are closed under:
\begin{itemize}
  \item Union: if $L_1$ and $L_2$ are regular, then $L_1 \cup L_2$ is regular
  \item Concatenation: if $L_1$ and $L_2$ are regular, then $L_1 \cdot L_2$ is regular
  \item Kleene star: if $L$ is regular, then $L^*$ is regular
  \item Complement: if $L$ is regular, then $\overline{L}$ is regular
  \item Intersection: if $L_1$ and $L_2$ are regular, then $L_1 \cap L_2$ is regular
  \item Reversal: if $L$ is regular, then $L^R$ is regular
  \item Homomorphism: if $L$ is regular and $h$ is a homomorphism, then $h(L)$ is regular
  \item Inverse homomorphism: if $L$ is regular and $h$ is a homomorphism, then $h^{-1}(L)$ is regular
\end{itemize}
\end{theorem}

