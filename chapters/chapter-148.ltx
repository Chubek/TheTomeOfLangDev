  \node[pack] (two) at (-2.95,0) {True edge: pack \( (2,[4,5]) \)};
  \node[pack,rounded corners=7pt,draw=TomeGold] (one) at (2.95,0)
    {False edge: pack \( (1,[8]) \)};
  \node[tome box dark] (join) at (0,-1.6)
