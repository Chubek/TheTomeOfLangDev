  \node[box] (ast) {Abstract Syntax Tree \\ (Canonical Representation)};
  \node[box, left=4cm of ast] (text) {Textual Projection \\ (What the user sees)};
  \node[box, right=4cm of ast] (diagram) {Diagram Projection \\ (Alternative view)};
  \node[box, below=2cm of ast] (table) {Table Projection \\ (Another view)};

  \draw[->] (ast) -- node[above] {render} (text);
  \draw[->] (text) -- node[above] {edit} (ast);
  \draw[->] (ast) -- node[above] {render} (diagram);
  \draw[->] (ast) -- node[right] {render} (table);
\end{tikzpicture}
\caption{Projectional editing: the AST is the canonical representation; text and other views are projections}
\label{fig:projectional-editing}
\end{figure}

\subsection{Advantages of Projectional Editing}

\begin{enumerate}
  \item \textbf{No parsing ambiguities}: Since the AST is the canonical representation, there is no need to parse text into an AST.
  \item \textbf{Multiple concrete syntaxes}: The same program can be displayed in different notations for different purposes.
  \item \textbf{Non-textual elements}: Tables, diagrams, mathematical formulas, and other non-textual constructs can be embedded directly.
  \item \textbf{Language composition}: Languages can be composed at the AST level without grammar conflicts.
  \item \textbf{Guaranteed well-formedness}: The editor can prevent the user from creating ill-formed ASTs.
\end{enumerate}

\subsection{Challenges of Projectional Editing}

\begin{enumerate}
  \item \textbf{Familiarity}: Programmers are accustomed to text-based editing.
  \item \textbf{Tooling}: Standard tools (diff, merge, grep) work on text, not ASTs.
  \item \textbf{Navigation}: Moving around a projectional editor requires different mental models than a text editor.
  \item \textbf{Formatting}: The editor must handle layout and formatting automatically.
\end{enumerate}

\section{DSL Design Principles}\label{sec:dsl-design}

\subsection{Internal vs.\ External DSLs}

\begin{definition}[Internal vs.\ External DSL]\label{def:dsl-types}
\begin{itemize}
  \item An \emph{internal DSL} (embedded DSL) is implemented within a host language, using the host language's syntax and semantics. The DSL is a library or a set of conventions in the host language.
  \item An \emph{external DSL} has its own syntax, parser, and tooling, independent of any host language.
\end{itemize}
\end{definition}

\subsection{Design Principles for DSLs}

\begin{enumerate}
  \item \textbf{Domain focus}: A DSL should express concepts from its target domain directly, using domain-specific terminology.
  \item \textbf{Declarative style}: DSLs should emphasize \emph{what} to compute rather than \emph{how} to compute it.
  \item \textbf{Appropriate abstraction}: The DSL should provide the right level of abstraction---not too low-level (that's a GPL), not too high-level (that's a configuration file).
  \item \textbf{Composability}: DSL constructs should be composable, allowing complex expressions to be built from simple ones.
  \item \textbf{Error messages}: Error messages should be in domain terms, not implementation terms.
  \item \textbf{Tooling}: A DSL should have appropriate tooling: editors, validators, debuggers, and documentation generators.
\end{enumerate}

