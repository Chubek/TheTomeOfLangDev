\section{Introduction}\label{sec:math-appendix-intro}

This appendix collects the mathematical background needed for the rest of the book. It is not a substitute for a proper course in each area, but it provides the definitions, theorems, and proof techniques that are used throughout the text. The reader who is comfortable with these topics can skim or skip this appendix; the reader who needs a refresher will find the essential facts collected here.

\section{Set Theory Recap}\label{sec:set-theory-recap}

\subsection{Basic Definitions}

\begin{definition}[Set Operations]\label{def:set-ops}
Given sets $A$ and $B$:
\begin{align}
A \cup B &= \{x \mid x \in A \text{ or } x \in B\} \\
A \cap B &= \{x \mid x \in A \text{ and } x \in B\} \\
A \setminus B &= \{x \mid x \in A \text{ and } x \notin B\} \\
\mathcal{P}(A) &= \{S \mid S \subseteq A\} \quad \text{(power set)} \\
A \times B &= \{(a, b) \mid a \in A, b \in B\} \quad \text{(Cartesian product)}
\end{align}
\end{definition}

\subsection{Relations and Functions}

\begin{definition}[Relations]\label{def:relations}
A \emph{relation} $R$ on a set $A$ is a subset $R \subseteq A \times A$. We write $a\,R\,b$ for $(a, b) \in R$.

A relation $R$ is:
\begin{itemize}
  \item \emph{Reflexive} if $a\,R\,a$ for all $a \in A$.
  \item \emph{Symmetric} if $a\,R\,b \implies b\,R\,a$.
  \item \emph{Transitive} if $a\,R\,b \land b\,R\,c \implies a\,R\,c$.
  \item \emph{Antisymmetric} if $a\,R\,b \land b\,R\,a \implies a = b$.
\end{itemize}

An \emph{equivalence relation} is reflexive, symmetric, and transitive. A \emph{partial order} is reflexive, antisymmetric, and transitive.
\end{definition}

\begin{definition}[Functions]\label{def:functions}
A \emph{function} $f : A \to B$ is a relation $f \subseteq A \times B$ such that for every $a \in A$, there is exactly one $b \in B$ with $(a, b) \in f$. We write $f(a) = b$.

A function is:
\begin{itemize}
  \item \emph{Injective} (one-to-one) if $f(a_1) = f(a_2) \implies a_1 = a_2$.
  \item \emph{Surjective} (onto) if for every $b \in B$, there exists $a \in A$ with $f(a) = b$.
  \item \emph{Bijective} if it is both injective and surjective.
\end{itemize}
\end{definition}

\subsection{Cardinality}

\begin{definition}[Cardinality]\label{def:cardinality}
Two sets $A$ and $B$ have the same \emph{cardinality} ($|A| = |B|$) if there exists a bijection between them. A set is:
\begin{itemize}
  \item \emph{Finite} if it has the same cardinality as $\{1, 2, \ldots, n\}$ for some $n$.
  \item \emph{Countably infinite} if it has the same cardinality as $\mathbb{N}$.
  \item \emph{Uncountable} if it is infinite but not countably infinite.
\end{itemize}
\end{definition}

\section{Order Theory and Lattices Recap}\label{sec:order-theory-recap}

\subsection{Partial Orders}

\begin{definition}[Partial Order]\label{def:partial-order}
A \emph{partially ordered set} (poset) is a pair $(P, \leq)$ where $P$ is a set and $\leq$ is a partial order on $P$ (reflexive, antisymmetric, transitive).

An element $u \in P$ is an \emph{upper bound} of $S \subseteq P$ if $s \leq u$ for all $s \in S$. The \emph{least upper bound} (supremum, $\bigsqcup S$) is the smallest upper bound. Dually for \emph{lower bounds} and \emph{greatest lower bound} (infimum, $\bigsqcap S$).
\end{definition}

\subsection{Lattices}

\begin{definition}[Lattice]\label{def:lattice}
A \emph{lattice} is a poset $(L, \leq)$ in which every pair of elements has a least upper bound ($a \sqcup b$) and a greatest lower bound ($a \sqcap b$).

A lattice is:
\begin{itemize}
  \item \emph{Complete} if every subset has a supremum and infimum.
  \item \emph{Distributive} if $a \sqcap (b \sqcup c) = (a \sqcap b) \sqcup (a \sqcap c)$.
  \item \emph{Bounded} if it has a least element $\bot$ and a greatest element $\top$.
\end{itemize}
\end{definition}

\subsection{Fixed-Point Theorems}

\begin{theorem}[Knaster--Tarski]\label{thm:knaster-tarski}
Let $(L, \leq)$ be a complete lattice and $f : L \to L$ a monotone function. Then the set of fixed points of $f$ is also a complete lattice. In particular, $f$ has a least fixed point:
\[
\mathit{lfp}(f) = \bigsqcap \{x \in L \mid f(x) \leq x\}
\]
\end{theorem}

\begin{theorem}[Kleene's Fixed-Point Theorem]\label{thm:kleene-fixed}
Let $(L, \leq)$ be a complete lattice with a least element $\bot$, and let $f : L \to L$ be a \emph{continuous} function (preserves directed suprema). Then:
\[
\mathit{lfp}(f) = \bigsqcup_{n \geq 0} f^n(\bot)
\]
\end{theorem}

\section{Category Theory Recap}\label{sec:category-theory-recap}

\subsection{Categories}

\begin{definition}[Category]\label{def:category}
A \emph{category} $\mathcal{C}$ consists of:
\begin{itemize}
  \item A collection of \emph{objects} $\mathrm{Ob}(\mathcal{C})$.
  \item For each pair of objects $A, B$, a set of \emph{morphisms} $\mathrm{Hom}(A, B)$.
  \item For each triple $A, B, C$, a \emph{composition} function $\circ : \mathrm{Hom}(B, C) \times \mathrm{Hom}(A, B) \to \mathrm{Hom}(A, C)$.
  \item For each object $A$, an \emph{identity} morphism $\mathrm{id}_A \in \mathrm{Hom}(A, A)$.
\end{itemize}
satisfying:
\begin{itemize}
  \item Associativity: $h \circ (g \circ f) = (h \circ g) \circ f$.
  \item Identity: $f \circ \mathrm{id}_A = f = \mathrm{id}_B \circ f$ for $f \in \mathrm{Hom}(A, B)$.
\end{itemize}
\end{definition}

\subsection{Functors}

\begin{definition}[Functor]\label{def:functor}
A \emph{functor} $F : \mathcal{C} \to \mathcal{D}$ maps objects to objects and morphisms to morphisms, preserving composition and identities:
\begin{align}
F(\mathrm{id}_A) &= \mathrm{id}_{F(A)} \\
F(g \circ f) &= F(g) \circ F(f)
\end{align}
\end{definition}

\subsection{Natural Transformations}

\begin{definition}[Natural Transformation]\label{def:natural-transformation}
A \emph{natural transformation} $\alpha : F \Rightarrow G$ between functors $F, G : \mathcal{C} \to \mathcal{D}$ is a family of morphisms $\alpha_A : F(A) \to G(A)$ such that for every $f : A \to B$:
\[
\alpha_B \circ F(f) = G(f) \circ \alpha_A
\]
\end{definition}

\subsection{Adjunctions}

\begin{definition}[Adjunction]\label{def:adjunction}
An \emph{adjunction} $F \dashv G$ between functors $F : \mathcal{C} \to \mathcal{D}$ and $G : \mathcal{D} \to \mathcal{C}$ is a natural isomorphism:
\[
\mathrm{Hom}_{\mathcal{D}}(F(A), B) \cong \mathrm{Hom}_{\mathcal{C}}(A, G(B))
\]
$F$ is the \emph{left adjoint} and $G$ is the \emph{right adjoint}.
\end{definition}

\section{Domain Theory}\label{sec:domain-theory}

\subsection{Directed Complete Partial Orders}

\begin{definition}[DCPO]\label{def:dcpo}
A \emph{directed complete partial order} (dcpo) is a poset $(D, \leq)$ in which every directed subset has a supremum. A subset $S$ is \emph{directed} if it is non-empty and every finite subset has an upper bound in $S$.
\end{definition}

\subsection{Continuous Functions}

\begin{definition}[Scott Continuity]\label{def:scott-continuous}
A function $f : D \to E$ between dcpos is \emph{Scott continuous} if it preserves directed suprema:
\[
f\left(\bigsqcup S\right) = \bigsqcup f(S) \quad \text{for all directed } S \subseteq D
\]
\end{definition}

\subsection{Domains and Approximation}

\begin{definition}[Domain]\label{def:domain}
A \emph{domain} is a dcpo with a least element $\bot$ (a pointed dcpo, or cppo). Domains model the idea of \emph{partial information}: $\bot$ represents ``no information,'' and $x \leq y$ means ``$y$ contains at least as much information as $x$.''
\end{definition}

\subsection{The Way-Below Relation}

\begin{definition}[Way-Below]\label{def:way-below}
In a dcpo $D$, $x$ is \emph{way below} $y$ (written $x \ll y$) if for every directed set $S$ with $y \leq \bigsqcup S$, there exists $s \in S$ with $x \leq s$.

An element $x$ is \emph{compact} (or \emph{finite}) if $x \ll x$. A dcpo is \emph{algebraic} if every element is the directed supremum of compact elements below it.
\end{definition}

\section{Fixed-Point Theorems}\label{sec:fixed-point-theorems}

\subsection{The Banach Fixed-Point Theorem}

\begin{theorem}[Banach Fixed-Point Theorem]\label{thm:banach}
Let $(X, d)$ be a complete metric space and $f : X \to X$ a contraction mapping (there exists $k < 1$ such that $d(f(x), f(y)) \leq k \cdot d(x, y)$ for all $x, y$). Then $f$ has a unique fixed point.
\end{theorem}

\subsection{The Bourbaki--Witt Theorem}

\begin{theorem}[Bourbaki--Witt]\label{thm:bourbaki-witt}
Let $(P, \leq)$ be a chain-complete poset (every chain has a supremum) with a least element, and let $f : P \to P$ be an inflationary function ($f(x) \geq x$ for all $x$). Then $f$ has a fixed point.
\end{theorem}

\subsection{Applications to Semantics}

The fixed-point theorems are fundamental to denotational semantics:

\begin{itemize}
  \item The \emph{meaning} of a recursive definition $x = f(x)$ is the least fixed point of $f$.
  \item The \emph{meaning} of a while loop $\mathit{while}\;b\;\mathit{do}\;c$ is the least fixed point of the functional $F(g) = \lambda s.\,\text{if } b(s) \text{ then } g(c(s)) \text{ else } s$.
  \item The \emph{meaning} of a recursive type $\mu X.\,F(X)$ is the fixed point of the type constructor $F$.
\end{itemize}

\section{Proof Techniques: Induction, Coinduction}\label{sec:proof-techniques}

\subsection{Structural Induction}

\begin{definition}[Structural Induction]\label{def:structural-induction}
To prove a property $P$ holds for all elements of an inductively defined set $S$:
\begin{enumerate}
  \item \textbf{Base case}: Prove $P$ for each base element of $S$.
  \item \textbf{Inductive step}: For each constructor $c(x_1, \ldots, x_n)$ of $S$, assume $P(x_1), \ldots, P(x_n)$ and prove $P(c(x_1, \ldots, x_n))$.
\end{enumerate}
\end{definition}

\subsection{Rule Induction}

\begin{definition}[Rule Induction]\label{def:rule-induction}
To prove a property $P$ holds for all derivable judgments $\mathcal{J}$:
\begin{enumerate}
  \item For each inference rule with conclusion $\mathcal{J}$ and premises $\mathcal{J}_1, \ldots, \mathcal{J}_n$:
  \item Assume $P(\mathcal{J}_1), \ldots, P(\mathcal{J}_n)$ (induction hypothesis).
  \item Prove $P(\mathcal{J})$.
\end{enumerate}
\end{definition}

\subsection{Coinduction}

\begin{definition}[Coinduction]\label{def:coinduction}
To prove that two elements $x, y$ of a coinductively defined set are \emph{bisimilar} ($x \sim y$):
\begin{enumerate}
  \item Find a \emph{bisimulation} relation $R$ such that $x\,R\,y$.
  \item Show that $R$ is a bisimulation: for every $a\,R\,b$, the observations of $a$ and $b$ match, and their successors are related by $R$.
\end{enumerate}
\end{definition}

\subsection{Logical Relations}

\begin{definition}[Logical Relation]\label{def:logical-relation}
A \emph{logical relation} is a relation on terms defined by induction on types. To prove a property $P$ of all well-typed terms:
\begin{enumerate}
  \item Define a relation $R_\tau$ for each type $\tau$.
  \item Prove that $R_\tau$ is a \emph{logical relation}: it is preserved by all term formers.
  \item Prove that every well-typed term is related to itself by $R_\tau$.
\end{enumerate}
\end{definition}

