%% chapter-21.ltx — Polymorphism: Parametric, Ad Hoc, and Subtype
%% Part II: Programming Language Design

%% ============================================================
%% 21.1 Introduction
%% ============================================================
\section{Introduction}\label{sec:polymorphism-intro}

Polymorphism---the ability of a single piece of code to operate on values
of multiple types---is one of the most powerful abstractions in programming
language design.  It enables generic algorithms, reusable data structures,
and flexible interfaces.  Without polymorphism, every algorithm would need
to be duplicated for each type it operates on.

Three fundamentally different forms of polymorphism are distinguished:

\begin{enumerate}
  \item \textbf{Parametric polymorphism}: Functions are parameterized by
    types; the same code works uniformly for all types.
  \item \textbf{Ad hoc polymorphism}: Functions have different
    implementations for different types (overloading, type classes).
  \item \textbf{Subtype polymorphism}: Functions operate on a type and all
    its subtypes (object-oriented inheritance).
\end{enumerate}

In this chapter, we develop the theory of each form, starting with
parametric polymorphism and System~F, then type inference, ad hoc
polymorphism and type classes, subtype polymorphism, bounded
quantification, and row polymorphism.

\begin{definition}[Polymorphism]\label{def:polymorphism}
  A function or data type is \emph{polymorphic} if it can be used with
  values of multiple types.  The specific form of polymorphism determines
  how the different types are related and how the implementation is
  selected.
\end{definition}

%% ============================================================
%% 21.2 Parametric Polymorphism and System F
%% ============================================================
\section{Parametric Polymorphism and System F}\label{sec:system-f}

\subsection{The Idea of Parametric Polymorphism}\label{sec:parametric-idea}

\begin{definition}[Parametric Polymorphism]\label{def:parametric-poly}
  \emph{Parametric polymorphism} allows a function or data type to be
  parameterized by a type variable.  The function behaves uniformly for all
  instantiations of the type variable---it cannot inspect or depend on the
  specific type.
\end{definition}

\begin{example}[Parametric Polymorphism]\label{ex:parametric-poly}
  The polymorphic identity function:
  \[
    \texttt{id} = \Lambda \alpha.\, \lambda x:\alpha.\, x \;:\; \forall \alpha.\, \alpha \to \alpha
  \]
  This function works for \emph{any} type $\alpha$.  It cannot inspect its
  argument (since it doesn't know what type it is); it can only return it
  unchanged.
\end{example}

\subsection{System F: The Polymorphic Lambda Calculus}\label{sec:system-f-detail}

System~F, introduced by Girard~\cite{girard1972interpretation} and
Reynolds~\cite{reynolds1974towards}, is the foundational calculus of
parametric polymorphism.

\begin{grammar}{System F Types}
  \production{\tau}{\alpha \alt \tau_1 \to \tau_2 \alt \forall \alpha.\, \tau}
\end{grammar}

\begin{grammar}{System F Terms}
  \production{e}{x \alt \lambda x:\tau.\, e \alt e_1\ e_2 \alt \Lambda \alpha.\, e \alt e\,[\tau]}
\end{grammar}

The key constructs are:
\begin{itemize}
  \item $\Lambda \alpha.\, e$: \emph{Type abstraction}---binds a type variable.
  \item $e\,[\tau]$: \emph{Type application}---instantiates a type variable.
  \item $\forall \alpha.\, \tau$: \emph{Universal type}---a type that works
    for all $\alpha$.
\end{itemize}

\subsection{Typing Rules for System F}\label{sec:system-f-typing}

\begin{typerules}{System F}
  \typeaxiom{\textsc{Var}}{
    \dfrac{}{\Gamma, x:\tau \vdash x : \tau}
  } \\[8pt]
  \typerule{\textsc{Abs}}{
    \Gamma, x:\tau_1 \vdash e : \tau_2
  }{
    \Gamma \vdash \lambda x:\tau_1.\, e : \tau_1 \to \tau_2
  } \\[8pt]
  \typerule{\textsc{App}}{
    \Gamma \vdash e_1 : \tau_2 \to \tau \quad
    \Gamma \vdash e_2 : \tau_2
  }{
    \Gamma \vdash e_1\ e_2 : \tau
  } \\[8pt]
  \typerule{\textsc{TAbs}}{
    \Gamma \vdash e : \tau \quad \alpha \notin \mathrm{dom}(\Gamma)
  }{
    \Gamma \vdash \Lambda \alpha.\, e : \forall \alpha.\, \tau
  } \\[8pt]
  \typerule{\textsc{TApp}}{
    \Gamma \vdash e : \forall \alpha.\, \tau
  }{
    \Gamma \vdash e\,[\sigma] : \tau[\sigma/\alpha]
  }
\end{typerules}

\subsection{Type Erasure}\label{sec:type-erasure}

\begin{definition}[Type Erasure]\label{def:type-erasure}
  \emph{Type erasure} is the process of removing type annotations and type
  abstractions/applications from a System~F term, producing an untyped
  lambda calculus term.
\end{definition}

\begin{semrules}{Type Erasure}
  \semruleaxiom{
    \erase{x} = x
  }{} \\[4pt]
  \semrule{
    \erase{e} = e'
  }{
    \erase{\lambda x:\tau.\, e} = \lambda x.\, e'
  }{} \\[4pt]
  \semrule{
    \erase{e_1} = e_1' \quad \erase{e_2} = e_2'
  }{
    \erase{e_1\ e_2} = e_1'\ e_2'
  }{} \\[4pt]
  \semrule{
    \erase{e} = e'
  }{
    \erase{\Lambda \alpha.\, e} = e'
  }{} \\[4pt]
  \semrule{
    \erase{e} = e'
  }{
    \erase{e\,[\tau]} = e'
  }{}
\end{semrules}

\begin{theorem}[Erasure Commutes with Reduction]\label{thm:erasure}
  If $e \stepsto e'$ in System~F, then $\erase{e} \stepsto \erase{e'}$ in
  the untyped lambda calculus.
\end{theorem}

\subsection{Parametricity}\label{sec:parametricity}

\begin{theorem}[Reynolds' Parametricity Theorem]\label{thm:parametricity-detail}
  Every well-typed term of type $\forall \alpha.\, \tau$ in System~F is
  \emph{parametrically polymorphic}: it behaves uniformly for all type
  instantiations.  Formally, it is related to itself by the logical
  relation induced by any relation $R$ on types.
\end{theorem}

\begin{corollary}[Free Theorems]\label{cor:free-theorems}
  From parametricity, we can derive ``free theorems''---properties that
  hold for all parametrically polymorphic functions:
  \begin{itemize}
    \item $f : \forall \alpha.\, \alpha \to \alpha$ must be the identity.
    \item $f : \forall \alpha.\, [\alpha] \to [\alpha]$ must be of the form
      $\lambda xs.\, xs$ or $\lambda xs.\, []$ (for total functions).
    \item $f : \forall \alpha\,\beta.\, (\alpha \to \beta) \to [\alpha] \to [\beta]$
      must be \texttt{map}.
  \end{itemize}
\end{corollary}

%% ============================================================
%% 21.3 Type Inference for Polymorphism
%% ============================================================
\section{Type Inference for Polymorphism}\label{sec:type-inference}

\subsection{The Hindley--Milner Type System}\label{sec:hm-system}

The Hindley--Milner (HM) type system~\cite{hindley1969principal,
milner1978theory} is the basis for type inference in ML, Haskell (without
advanced features), and many other languages.

\begin{definition}[HM Type System]\label{def:hm}
  The HM type system extends the simply-typed lambda calculus with:
  \begin{itemize}
    \item \textbf{Let-polymorphism}: The bound variable in a \texttt{let}
      binding can be instantiated at different types at each use site.
    \item \textbf{No type annotations}: Types are inferred completely.
  \end{itemize}
\end{definition}

\begin{typerules}{Hindley--Milner}
  \typerule{\textsc{Let}}{
    \Gamma \vdash e_1 : \sigma \quad
    \Gamma, x:\sigma \vdash e_2 : \tau
  }{
    \Gamma \vdash \mathbf{let}\ x = e_1\ \mathbf{in}\ e_2 : \tau
  } \\[8pt]
  \typerule{\textsc{Gen}}{
    \Gamma \vdash e : \tau \quad
    \alpha \notin \mathrm{fv}(\Gamma)
  }{
    \Gamma \vdash e : \forall \alpha.\, \tau
  } \\[8pt]
  \typerule{\textsc{Inst}}{
    \Gamma \vdash e : \forall \alpha.\, \tau
  }{
    \Gamma \vdash e : \tau[\sigma/\alpha]
  }
\end{typerules}

\subsection{The Algorithm W}\label{sec:algorithm-w}

Algorithm~W~\cite{damas1982principal} is the classic type inference
algorithm for HM:

\begin{algorithm}[H]
  \caption{Algorithm W (Simplified)}
  \label{alg:algorithm-w}
  \begin{algorithmic}[1]
    \Function{W}{$\Gamma, e$}
      \Switch{$e$}
        \Case{$x$}
          \State $\sigma \gets \Gamma(x)$
          \State $\tau \gets \Call{Instantiate}{\sigma}$
          \State \Return $(\texttt{id}, \tau)$
        \EndCase
        \Case{$\lambda x.\, e'$}
          \State $\alpha \gets \Call{FreshTypeVar}{}$
          \State $(S, \tau) \gets \Call{W}{\Gamma[x:\alpha], e'}$
          \State \Return $(S, S(\alpha) \to \tau)$
        \EndCase
        \Case{$e_1\ e_2$}
          \State $(S_1, \tau_1) \gets \Call{W}{\Gamma, e_1}$
          \State $(S_2, \tau_2) \gets \Call{W}{S_1(\Gamma), e_2}$
          \State $\alpha \gets \Call{FreshTypeVar}{}$
          \State $S_3 \gets \Call{Unify}{S_2(\tau_1), \tau_2 \to \alpha}$
          \State \Return $(S_3 \circ S_2 \circ S_1, S_3(\alpha))$
        \EndCase
        \Case{$\mathbf{let}\ x = e_1\ \mathbf{in}\ e_2$}
          \State $(S_1, \tau_1) \gets \Call{W}{\Gamma, e_1}$
          \State $\sigma \gets \Call{Generalize}{S_1(\Gamma), \tau_1}$
          \State $(S_2, \tau_2) \gets \Call{W}{S_1(\Gamma)[x:\sigma], e_2}$
          \State \Return $(S_2 \circ S_1, \tau_2)$
        \EndCase
      \EndSwitch
    \EndFunction
  \end{algorithmic}
\end{algorithm}

\subsection{Unification}\label{sec:unification-poly}

\begin{definition}[Unification]\label{def:unification-poly}
  A \emph{unifier} for a set of type equations $\{ \tau_i = \sigma_i \}$ is
  a substitution $S$ such that $S(\tau_i) = S(\sigma_i)$ for all $i$.  The
  \emph{most general unifier} (mgu) is a unifier that is more general than
  any other unifier.
\end{definition}

\begin{theorem}[Existence of MGU]\label{thm:mgu}
  If a set of type equations has a unifier, then it has a most general
  unifier, which is unique up to renaming of type variables.
\end{theorem}

\subsection{Principal Types}\label{sec:principal-types}

\begin{definition}[Principal Type]\label{def:principal-type}
  A type $\tau$ is the \emph{principal type} of an expression $e$ if:
  \begin{enumerate}
    \item $\vdash e : \tau$ (it is a valid type for $e$).
    \item For any other type $\sigma$ such that $\vdash e : \sigma$, there
      exists a substitution $S$ such that $S(\tau) = \sigma$.
  \end{enumerate}
\end{definition}

\begin{theorem}[Principal Type Property]\label{thm:principal-type}
  Algorithm~W computes the principal type: if $\vdash e : \tau$ for some
  $\tau$, then $\Call{W}{\emptyset, e}$ returns $(S, \sigma)$ where $\sigma$
  is the principal type of $e$.
\end{theorem}

\subsection{Limitations of HM}\label{sec:hm-limitations}

HM has several limitations:
\begin{itemize}
  \item \textbf{No higher-rank polymorphism}: Types like
    $(\forall \alpha.\, \alpha \to \alpha) \to \Int$ cannot be expressed.
  \item \textbf{No subtyping}: HM does not support subtyping.
  \item \textbf{Let-polymorphism only}: Polymorphism is restricted to
    \texttt{let} bindings; function parameters are monomorphic.
  \item \textbf{No type classes}: Ad hoc polymorphism requires extensions.
\end{itemize}

%% ============================================================
%% 21.4 Ad Hoc Polymorphism: Overloading and Type Classes
%% ============================================================
\section{Ad Hoc Polymorphism: Overloading and Type Classes}\label{sec:ad-hoc-poly}

\subsection{Overloading}\label{sec:overloading}

\begin{definition}[Ad Hoc Polymorphism]\label{def:ad-hoc-poly}
  \emph{Ad hoc polymorphism} (also called \emph{overloading}) allows a
  function name to have different implementations for different types.
  Unlike parametric polymorphism, the behavior depends on the specific
  type.
\end{definition}

\begin{example}[Overloaded Addition]\label{ex:overloaded-add}
  The $+$ operator is overloaded:
  \begin{align*}
    + & : \Int \to \Int \to \Int \\
    + & : \texttt{Float} \to \texttt{Float} \to \texttt{Float} \\
    + & : \texttt{String} \to \texttt{String} \to \texttt{String}
  \end{align*}
  Each type has a different implementation of addition.
\end{example}

\subsection{Type Classes}\label{sec:type-classes}

\begin{definition}[Type Class]\label{def:type-class}
  A \emph{type class} is a mechanism for ad hoc polymorphism that defines a
  set of operations (methods) that types can implement.  It consists of:
  \begin{enumerate}
    \item A \emph{class declaration}: specifies the operations.
    \item \emph{Instance declarations}: provide implementations for
      specific types.
  \end{enumerate}
\end{definition}

\begin{example}[Type Class in Haskell]\label{ex:type-class}
  \begin{verbatim}
  class Show a where
    show :: a -> String
  
  instance Show Int where
    show n = ...  -- convert int to string
  
  instance Show Bool where
    show True = "True"
    show False = "False"
  
  -- Polymorphic function with class constraint
  printAll :: Show a => [a] -> [String]
  printAll xs = map show xs
  \end{verbatim}
\end{example}

\subsection{Dictionary Translation}\label{sec:dictionary-translation}

Type classes are implemented by \emph{dictionary passing}: each type class
constraint is translated to an explicit dictionary parameter.

\begin{example}[Dictionary Translation]\label{ex:dict-translation}
  Before translation:
  \begin{verbatim}
  printAll :: Show a => [a] -> [String]
  printAll xs = map show xs
  \end{verbatim}
  After translation:
  \begin{verbatim}
  printAll :: ShowDict a -> [a] -> [String]
  printAll dict xs = map (show dict) xs
  
  -- where ShowDict a = { show :: a -> String }
  \end{verbatim}
\end{example}

\subsection{Multi-Parameter Type Classes}\label{sec:multi-param-classes}

Some languages support type classes with multiple type parameters:

\begin{example}[Multi-Parameter Type Class]\label{ex:multi-param}
  \begin{verbatim}
  class Convert a b where
    convert :: a -> b
  
  instance Convert Int String where
    convert n = show n
  
  instance Convert String Int where
    convert s = read s
  \end{verbatim}
\end{example}

Multi-parameter type classes require additional mechanisms to ensure
decidability:
\begin{itemize}
  \item \textbf{Functional dependencies}: \texttt{class Coll c a | c -> a}
    says that $c$ determines $a$.
  \item \textbf{Associated types}: Type families linked to class instances.
\end{itemize}

%% ============================================================
%% 21.5 Subtype Polymorphism
%% ============================================================
\section{Subtype Polymorphism}\label{sec:subtype-poly}

\subsection{Subtyping}\label{sec:subtyping-detail}

\begin{definition}[Subtype Polymorphism]\label{def:subtype-poly-detail}
  \emph{Subtype polymorphism} allows a value of type $\tau_1$ to be used
  where a value of type $\tau_2$ is expected, provided $\tau_1 <: \tau_2$.
  The function operates on the interface provided by $\tau_2$; the actual
  behavior depends on the concrete type $\tau_1$.
\end{definition}

\begin{example}[Subtype Polymorphism in Java]\label{ex:subtype-java}
  \begin{verbatim}
  class Animal { void speak() { ... } }
  class Dog extends Animal { void speak() { bark(); } }
  class Cat extends Animal { void speak() { meow(); } }
  
  void makeSpeak(Animal a) { a.speak(); }
  
  makeSpeak(new Dog());  // barks
  makeSpeak(new Cat());  // meows
  \end{verbatim}
\end{example}

\subsection{Subtyping Rules}\label{sec:subtyping-rules}

\begin{subtyrules}{Nominal Subtyping (Java-like)}
  \textsc{Refl}\quad \overline{\tau <: \tau} \\[6pt]
  \textsc{Trans}\quad \dfrac{\tau_1 <: \tau_2 \quad \tau_2 <: \tau_3}{\tau_1 <: \tau_3} \\[6pt]
  \textsc{Class}\quad \dfrac{C \texttt{ extends } D}{C <: D} \\[6pt]
  \textsc{Fun}\quad \dfrac{\tau_1' <: \tau_1 \quad \tau_2 <: \tau_2'}{\tau_1 \to \tau_2 <: \tau_1' \to \tau_2'}
\end{subtyrules}

Note that function subtyping is \emph{contravariant} in the argument and
\emph{covariant} in the result.

\subsection{Variance}\label{sec:variance}

\begin{definition}[Variance]\label{def:variance}
  The \emph{variance} of a type parameter determines how subtyping of the
  parameter affects subtyping of the constructed type:
  \begin{itemize}
    \item \textbf{Covariant}: $A <: B \implies F(A) <: F(B)$.
    \item \textbf{Contravariant}: $A <: B \implies F(B) <: F(A)$.
    \item \textbf{Invariant}: No subtyping relationship.
  \end{itemize}
\end{definition}

\begin{table}[htbp]
  \centering
  \caption{Variance of Common Type Constructors}
  \label{tab:variance}
  \begin{tabular}{lll}
    \hline
    \textbf{Constructor} & \textbf{Variance} & \textbf{Reason} \\
    \hline
    $\tau \to \sigma$ & Contravariant in $\tau$, covariant in $\sigma$ & Function \\
    $\texttt{List}\langle \tau \rangle$ & Covariant (immutable) / Invariant (mutable) & Read/write \\
    $\texttt{Consumer}\langle \tau \rangle$ & Contravariant & Input \\
    $\texttt{Producer}\langle \tau \rangle$ & Covariant & Output \\
    \hline
  \end{tabular}
\end{table}

\subsection{Subtyping and Type Inference}\label{sec:subtyping-inference}

Type inference with subtyping is significantly harder than without:

\begin{itemize}
  \item \textbf{Local inference}: Types can be inferred locally if
    annotations are provided at function boundaries (Scala, Kotlin).
  \item \textbf{Constraint-based}: Type inference generates subtyping
    constraints and solves them.
  \item \textbf{Undecidability}: In some configurations, type inference
    with subtyping is undecidable.
\end{itemize}

%% ============================================================
%% 21.6 Bounded Quantification
%% ============================================================
\section{Bounded Quantification}\label{sec:bounded-quantification}

\subsection{The Need for Bounds}\label{sec:need-for-bounds}

Parametric polymorphism is too restrictive for some patterns.  Consider a
function that operates on objects with a \texttt{compareTo} method:

\begin{example}[Need for Bounds]\label{ex:need-bounds}
  \begin{verbatim}
  max :: forall a. a -> a -> a   -- WRONG: can't compare
  max :: forall a <: Comparable. a -> a -> a  -- RIGHT
  \end{verbatim}
  Without bounds, the type variable $a$ could be any type, and we cannot
  assume it has a \texttt{compareTo} method.
\end{example}

\subsection{System F$_{<:}$}\label{sec:f-sub}

\begin{definition}[System F$_{<:}$]\label{def:f-sub}
  System~F$_{<:}$ (F-sub) extends System~F with bounded quantification:
  \[
    \forall \alpha <: \tau.\, \sigma
  \]
  This quantifies over all types $\alpha$ that are subtypes of $\tau$.
\end{definition}

\begin{typerules}{System F$_{<:}$ (Selected)}
  \typerule{\textsc{TAbs}}{
    \Gamma, \alpha <: \tau_1 \vdash e : \tau_2
  }{
    \Gamma \vdash \Lambda \alpha <: \tau_1.\, e : \forall \alpha <: \tau_1.\, \tau_2
  } \\[8pt]
  \typerule{\textsc{TApp}}{
    \Gamma \vdash e : \forall \alpha <: \tau_1.\, \tau_2 \quad
    \Gamma \vdash \sigma <: \tau_1
  }{
    \Gamma \vdash e\,[\sigma] : \tau_2[\sigma/\alpha]
  } \\[8pt]
  \typerule{\textsc{Sub}}{
    \Gamma \vdash e : \tau_1 \quad \tau_1 <: \tau_2
  }{
    \Gamma \vdash e : \tau_2
  }
\end{typerules}

\subsection{Decidability Issues}\label{sec:f-sub-decidability}

\begin{theorem}[F$_{<:}$ Subtyping is Decidable]\label{thm:f-sub-decidable}
  The subtyping relation in System~F$_{<:}$ is decidable.
\end{theorem}

However, \emph{type checking} for System~F$_{<:}$ (with type application)
was shown to be undecidable by Pierce~\cite{pierce1994bounded} in the
general case.  This has practical implications for languages like Scala,
which use restricted variants.

%% ============================================================
%% 21.7 Row Polymorphism
%% ============================================================
\section{Row Polymorphism}\label{sec:row-polymorphism}

\subsection{Records and Rows}\label{sec:records-rows}

\begin{definition}[Row Type]\label{def:row-type}
  A \emph{row type} is a type that describes a record (or variant) as a
  collection of labeled fields.  Row polymorphism allows functions to
  operate on records with at least certain fields, without requiring an
  exact match.
\end{definition}

\begin{example}[Row Polymorphism]\label{ex:row-poly}
  \begin{verbatim}
  getName :: { name :: String | r } -> String
  getName record = record.name
  
  -- Works for any record with a "name" field:
  getName { name = "Alice", age = 30 }  -- OK
  getName { name = "Bob" }              -- OK
  \end{verbatim}
  The type $\{ \texttt{name} :: \texttt{String} \mid r \}$ means ``a record
  with at least a \texttt{name} field of type \texttt{String}, and possibly
  other fields described by $r$.''
\end{example}

\subsection{Row Polymorphism in Practice}\label{sec:row-poly-practice}

Row polymorphism is used in:
\begin{itemize}
  \item \textbf{OCaml}: Object types are row-polymorphic.
  \item \textbf{PureScript}: Record types support row polymorphism.
  \item \textbf{Row TypeScript}: Libraries like \texttt{row-polymorphism}
    provide row types.
  \item \textbf{Extensible records}: Elm, Row-Typed Haskell.
\end{itemize}

\subsection{Formal Rules}\label{sec:row-formal}

\begin{typerules}{Row Polymorphism}
  \typerule{\textsc{Record}}{
    \Gamma \vdash e_i : \tau_i \quad (i \in 1..n)
  }{
    \Gamma \vdash \{ l_1 = e_1, \ldots, l_n = e_n \} : \{ l_1 : \tau_1, \ldots, l_n : \tau_n \}
  } \\[8pt]
  \typerule{\textsc{Proj}}{
    \Gamma \vdash e : \{ l : \tau \mid r \}
  }{
    \Gamma \vdash e.l : \tau
  } \\[8pt]
  \typerule{\textsc{RowSub}}{
    \Gamma \vdash e : \{ l_i : \tau_i^{i \in 1..n} \}
  }{
    \Gamma \vdash e : \{ l_j : \tau_j^{j \in 1..m} \mid r \}
  }{\text{if } \{l_1, \ldots, l_m\} \subseteq \{l_1, \ldots, l_n\}}
\end{typerules}

