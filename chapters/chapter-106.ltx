\section{Abstract Model Checking}\label{sec:mc-abstract}

\subsection{Abstraction}\label{sec:mc-abstraction}

\emph{Abstract model checking}~\cite{clarke2000abstraction} reduces the state
space by constructing an \emph{abstract model} that is smaller than the concrete
model but preserves the properties of interest.

\begin{definition}[Abstraction]\label{def:abstraction}
An \emph{abstraction} of a transition system $M = (S, S_0, R, L)$ is a
transition system $\hat{M} = (\hat{S}, \hat{S}_0, \hat{R}, \hat{L})$ together
with an abstraction function $\alpha : S \to \hat{S}$ such that:
\begin{enumerate}
\item $\alpha(S_0) \subseteq \hat{S}_0$.
\item If $(s, s') \in R$ then $(\alpha(s), \alpha(s')) \in \hat{R}$.
\item $\hat{L}(\alpha(s)) \supseteq L(s)$ (over-approximation of labels).
\end{enumerate}
\end{definition}

\begin{theorem}[Preservation of Universal Properties]\label{thm:abstraction}
If $\hat{M} \models \varphi$ for a universal property $\varphi$ (one built from
$\mathbf{A}$, $\mathbf{G}$, $\mathbf{X}$, $\land$, $\lor$), then $M \models \varphi$.
\end{theorem}

The contrapositive is the basis of \emph{counterexample-guided abstraction
refinement} (CEGAR): if the abstract model violates a property, the
counterexample may be \emph{spurious} (an artifact of the abstraction).  If so,
the abstraction is refined to eliminate the spurious counterexample.

\subsection{CEGAR}\label{sec:mc-cegar}

\begin{algorithm}[htbp]
\caption{CEGAR Loop}\label{alg:cegar}
\begin{algorithmic}[1]
\Require Concrete model $M$, property $\varphi$
\Ensure ``Verified'' or counterexample trace
\State $\hat{M} \gets \text{initial abstraction of } M$
\Loop
  \State $\hat{M} \models \varphi$?
  \If{yes}
    \State \Return ``Verified''
  \EndIf
  \State $\hat{\pi} \gets$ counterexample from $\hat{M}$
  \State $\pi \gets \text{simulate } \hat{\pi} \text{ in } M$
  \If{$\pi$ is a real counterexample}
    \State \Return $\pi$
  \Else
    \State Refine $\hat{M}$ to eliminate $\hat{\pi}$
  \EndIf
\EndLoop
\end{algorithmic}
\end{algorithm}

