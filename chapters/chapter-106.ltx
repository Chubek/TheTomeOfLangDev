\section{Temporal Logics: LTL, CTL, CTL*}\label{sec:mc-temporal}

\subsection{Linear Temporal Logic (LTL)}\label{sec:mc-ltl}

LTL~\cite{pnueli1977temporal} reasons about \emph{linear} time---individual
paths through the system.

\begin{definition}[LTL Syntax]\label{def:ltl-syntax}
LTL formulae over a set of atomic propositions $AP$ are defined by:
\[
\varphi ::= p \mid \neg\varphi \mid \varphi_1 \land \varphi_2 \mid \mathbf{X}\varphi \mid \varphi_1\ \mathbf{U}\ \varphi_2 \mid \mathbf{F}\varphi \mid \mathbf{G}\varphi
\]
where $p \in AP$, $\mathbf{X}$ is ``next,'' $\mathbf{U}$ is ``until,''
$\mathbf{F}$ is ``eventually'' ($\mathbf{F}\varphi \equiv \top\ \mathbf{U}\ \varphi$),
and $\mathbf{G}$ is ``globally'' ($\mathbf{G}\varphi \equiv \neg\mathbf{F}\neg\varphi$).
\end{definition}

The semantics of LTL is defined over paths:
\begin{align*}
  \pi, i &\models p &&\iff p \in L(\pi(i)) \\
  \pi, i &\models \mathbf{X}\varphi &&\iff \pi, i+1 \models \varphi \\
  \pi, i &\models \varphi_1\ \mathbf{U}\ \varphi_2 &&\iff \exists j \geq i.\; \pi, j \models \varphi_2 \land \forall k.\; i \leq k < j \implies \pi, k \models \varphi_1 \\
  \pi, i &\models \mathbf{G}\varphi &&\iff \forall j \geq i.\; \pi, j \models \varphi \\
  \pi, i &\models \mathbf{F}\varphi &&\iff \exists j \geq i.\; \pi, j \models \varphi
\end{align*}

\begin{example}[LTL Properties]\label{ex:ltl-props}
Common properties expressed in LTL:
\begin{itemize}
\item \textbf{Safety:} $\mathbf{G}\neg\mathit{error}$ (``error never occurs'').
\item \textbf{Liveness:} $\mathbf{F}\ \mathit{done}$ (``eventually done'').
\item \textbf{Fairness:} $\mathbf{G}\mathbf{F}\ \mathit{enabled} \implies \mathbf{G}\mathbf{F}\ \mathit{executed}$
      (``if enabled infinitely often, then executed infinitely often'').
\item \textbf{Response:} $\mathbf{G}(\mathit{request} \implies \mathbf{F}\ \mathit{response})$
      (``every request is eventually followed by a response'').
\end{itemize}
\end{example}

\subsection{Computation Tree Logic (CTL)}\label{sec:mc-ctl}

CTL~\cite{clarke1981design} reasons about \emph{branching} time---the tree of
all possible futures from each state.

\begin{definition}[CTL Syntax]\label{def:ctl-syntax}
CTL formulae are defined by:
\[
\varphi ::= p \mid \neg\varphi \mid \varphi_1 \land \varphi_2 \mid \mathbf{EX}\varphi \mid \mathbf{E}[\varphi_1\ \mathbf{U}\ \varphi_2] \mid \mathbf{AX}\varphi \mid \mathbf{A}[\varphi_1\ \mathbf{U}\ \varphi_2]
\]
where every temporal operator is paired with a path quantifier ($\mathbf{E}$ for
``exists a path'' or $\mathbf{A}$ for ``for all paths'').
\end{definition}

Derived CTL operators include:
\begin{align*}
  \mathbf{EF}\ \varphi &\equiv \mathbf{E}[\top\ \mathbf{U}\ \varphi] && \text{(possibly eventually)} \\
  \mathbf{AF}\ \varphi &\equiv \mathbf{A}[\top\ \mathbf{U}\ \varphi] && \text{(inevitably eventually)} \\
  \mathbf{EG}\ \varphi &\equiv \neg\mathbf{AF}\neg\varphi && \text{(possibly always)} \\
  \mathbf{AG}\ \varphi &\equiv \neg\mathbf{EF}\neg\varphi && \text{(invariant)}
\end{align*}

\subsection{CTL*}\label{sec:mc-ctlstar}

CTL*~\cite{emerson1986real} is the most expressive of the three logics,
combining the path quantifiers of CTL with the temporal operators of LTL.  In
CTL*, temporal operators need not be paired with path quantifiers; the pairing
is only required at the top level.

\begin{definition}[CTL* Syntax]\label{def:ctlstar-syntax}
CTL* distinguishes \emph{state formulae} and \emph{path formulae}:
\begin{align*}
  \text{State:}\quad \Phi &::= p \mid \neg\Phi \mid \Phi_1 \land \Phi_2 \mid \mathbf{E}\varphi \mid \mathbf{A}\varphi \\
  \text{Path:}\quad \varphi &::= \Phi \mid \neg\varphi \mid \varphi_1 \land \varphi_2 \mid \mathbf{X}\varphi \mid \varphi_1\ \mathbf{U}\ \varphi_2
\end{align*}
\end{definition}

\begin{theorem}[Expressiveness Hierarchy]\label{thm:expressiveness}
\[
\text{CTL} \subsetneq \text{CTL}^* \supsetneq \text{LTL}
\]
CTL and LTL are \emph{incomparable}: there are properties expressible in CTL
but not in LTL (e.g., $\mathbf{AG}\mathbf{EF}\ p$), and vice versa (e.g.,
$\mathbf{F}\mathbf{G}\ p$).
\end{theorem}

