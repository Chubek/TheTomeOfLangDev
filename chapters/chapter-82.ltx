\begin{historical}
E-graphs were introduced by Nelson and Oppen~\cite{nelson1980fast} (1980) for use in theorem proving. The application to compiler optimization was pioneered by Tate et al.~\cite{tate2009equality} (2009) with the ``equality saturation'' framework in the Joule compiler. The \texttt{egg} library of Willsey et al.~\cite{willsey2021egg} (2021) brought e-graphs to a wider audience with a fast, practical implementation. Ruler~\cite{nandi2021ruler} (2021) demonstrated automatic rule discovery. The field is rapidly evolving, with applications in quantum compilation, program synthesis, and verified compilation.
\end{historical}

\section{Summary}\label{sec:egraph-summary}

Equality saturation and e-graphs provide a powerful new approach to compiler optimization. E-graphs compactly represent equivalence classes of expressions, supporting efficient merge and rebuild operations. Equality saturation applies rewrite rules to explore all equivalent forms simultaneously, avoiding the phase ordering problem. Extraction selects the optimal form based on a cost model. Modern tools like \texttt{egg} and \texttt{Ruler} make e-graphs practical and accessible. The approach has applications beyond compilers, including program synthesis, theorem proving, and computer algebra. Equality saturation represents a paradigm shift in how we think about program optimization: rather than applying transformations sequentially, we explore the space of equivalent programs and select the best.

\section{The \texttt{egg} Library}\label{sec:egg-detail}

The \texttt{egg} library (Willsey et al., 2021) provides a fast, practical implementation of e-graphs and equality saturation.

\begin{definition}[E-Graph Core Operations]\label{def:egg-ops}
The \texttt{egg} library provides three core operations:
\begin{itemize}
  \item \textbf{add}: Add an expression (e-node) to the e-graph, returning its e-class ID.
  \item \textbf{merge}: Merge two e-classes, making them equivalent. This triggers \emph{rebuilding} to restore invariants.
  \item \textbf{rebuild}: After merges, restore the e-graph invariants:
  \begin{enumerate}
    \item \textbf{Uniqueness}: No two e-nodes in the same e-class have the same operator and children.
    \item \textbf{Consistency}: All e-nodes with equivalent children are in the same e-class.
  \end{enumerate}
\end{itemize}
\end{definition}

\begin{algorithm}[H]
\caption{E-Graph Rebuild Algorithm}
\label{alg:egg-rebuild}
\begin{algorithmic}[1]
\Require E-graph with pending merges
\ensure E-graph with restored invariants
\State \textbf{Phase 1: Union-Find normalization}
\ForAll{pending merges $(c_1, c_2)$}
  \State Union $c_1$ and $c_2$ in the union-find structure
  \State Merge e-class data (analysis information)
\EndFor
\State \textbf{Phase 2: Canonicalization}
\ForAll{e-nodes $n$ in the e-graph}
  \State Update $n$'s children to their canonical e-class representatives
\EndFor
\State \textbf{Phase 3: Hash consing}
\ForAll{e-nodes $n$}
  \State Look up $n$ in the hash cons table
  \If{equivalent e-node $n'$ exists}
    \State Merge $n$'s e-class with $n'$'s e-class
  \Else
    \State Insert $n$ into hash cons table
  \EndIf
\EndFor
\end{algorithmic}
\end{algorithm}

\begin{definition}[E-Graph Analysis]\label{def:egg-analysis}
An \textbf{e-graph analysis} associates abstract data with each e-class, updated during rebuilding. Examples:
\begin{itemize}
  \item \textbf{Constant folding}: Track whether an e-class represents a known constant.
  \item \textbf{Type inference}: Track the type of expressions in each e-class.
  \item \textbf{Cost estimation}: Track the minimum cost of any expression in the e-class.
\end{itemize}
\end{definition}

\section{Extraction from E-Graphs}\label{sec:extraction-detail}

\emph{Extraction} selects the best concrete expression from each e-class, based on a cost model.

\begin{definition}[Optimal Extraction]\label{def:optimal-extraction}
\textbf{Optimal extraction} finds, for each e-class, the expression tree with minimum cost among all equivalent expressions in the e-graph. This is solved by bottom-up dynamic programming on the e-graph.
\end{definition}

\begin{algorithm}[H]
\caption{E-Graph Extraction (Bottom-Up)}
\label{alg:egg-extract}
\begin{algorithmic}[1]
\Require E-graph $G$, cost function $cost$
\ensure Minimum-cost expression for each e-class
\State Initialize: $best(c) \gets \infty$ for all e-classes $c$
\State Initialize: $bestExpr(c) \gets \text{null}$ for all e-classes $c$
\Repeat
  \State changed $\gets$ false
  \ForAll{e-nodes $n = op(c_1, \ldots, c_k)$}
    \State $c \gets$ e-class of $n$
    \State $candidate \gets cost(op) + \sum_{i=1}^{k} best(c_i)$
    \If{$candidate < best(c)$}
      \State $best(c) \gets candidate$
      \State $bestExpr(c) \gets op(bestExpr(c_1), \ldots, bestExpr(c_k))$
      \State changed $\gets$ true
    \EndIf
  \EndFor
\Until{$\neg$ changed}
\end{algorithmic}
\end{algorithm}

\begin{theorem}[Extraction Complexity]\label{thm:extraction-complexity}
Extraction runs in $O(|E| \cdot d)$ time where $|E|$ is the number of e-nodes and $d$ is the maximum number of iterations (bounded by the e-graph depth). For most practical e-graphs, extraction is very fast.
\end{theorem}

\begin{example}[Extraction Example]\label{ex:extraction}
\begin{verbatim}
  // E-graph contains:
  //   e-class c1: {x + 0, x, x * 1}
  //   e-class c2: {x * 0, 0}
  
  // Cost model: add=1, mul=3, var=0, const=0
  // Extraction:
  //   best(c1) = x        (cost 0, vs x+0 cost 1, vs x*1 cost 3)
  //   best(c2) = 0        (cost 0, vs x*0 cost 3)
\end{verbatim}
\end{example}

\section{Equality Saturation for Compiler Optimization}\label{sec:eqsat-compiler}

\subsection{Integrating Equality Saturation with Traditional Compilation}\label{sec:eqsat-integration}

\begin{definition}[Equality Saturation Pipeline]\label{def:eqsat-pipeline}
The \textbf{equality saturation pipeline} for compiler optimization:
\begin{enumerate}
  \item Build an e-graph from the program's expressions.
  \item Apply rewrite rules to saturation (or until a resource limit is reached).
  \item Extract the optimal program from the e-graph.
  \item Continue with the rest of the compilation pipeline.
\end{enumerate}
\end{definition}

\begin{algorithm}[H]
\caption{Equality Saturation Optimization Pass}
\label{alg:eqsat-pass}
\begin{algorithmic}[1]
\Require Program $P$, rewrite rules $R$, resource limit $L$
\ensure Optimized program $P'$
\State $G \gets$ build e-graph from $P$
\State $iter \gets 0$
\Repeat
  \ForAll{rules $r \in R$}
    \State Find all matches of $r.lhs$ in $G$
    \ForAll{matches $m$}
      \State Instantiate $r.rhs$ with matched variables
      \State Merge $m$ with the new expression in $G$
    \EndFor
  \EndFor
  \State $G.rebuild()$
  \State $iter \gets iter + 1$
\Until{$iter \geq L$ or $G$ unchanged}
\State $P' \gets$ extract optimal program from $G$
\State \Return $P'$
\end{algorithmic}
\end{algorithm}

\subsection{Rewrite Rule Design}\label{sec:rewrite-design}

\begin{definition}[Rewrite Rule Categories]\label{def:rewrite-categories}
Rewrite rules for compiler optimization fall into several categories:
\begin{itemize}
  \item \textbf{Algebraic simplification}: $x + 0 \to x$, $x * 1 \to x$, $x * 0 \to 0$
  \item \textbf{Strength reduction}: $x * 2 \to x + x$, $x^2 \to x * x$
  \item \textbf{Canonicalization}: $a + b \to b + a$ (sort operands), $a - b \to a + (-1 * b)$
  \item \textbf{Bit manipulation}: $x \& (x - 1) \to$ clear lowest set bit
  \item \textbf{Domain-specific}: Architecture-specific instruction combinations
\end{itemize}
\end{definition}

\section{Ruler: Automatic Rule Discovery}\label{sec:ruler-detail}

\emph{Ruler} (Nandi et al., 2021) automatically discovers rewrite rules from a set of equality assertions.

\begin{definition}[Ruler Algorithm]\label{def:ruler}
\textbf{Ruler} takes:
\begin{itemize}
  \item A set of \emph{equality assertions} (pairs of equivalent expressions)
  \item A set of \emph{operators} and their arities
  \item A \emph{maximum rule size}
\end{itemize}
And produces a minimal set of rewrite rules that can derive all the equalities.
\end{definition}

\begin{algorithm}[H]
\caption{Ruler Rule Discovery (Simplified)}
\label{alg:ruler}
\begin{algorithmic}[1]
\Require Equality assertions $E$, operators $O$, max size $k$
\ensure Rewrite rules $R$
\State $R \gets \emptyset$
\For{size $s = 1$ to $k$}
  \State Generate candidate rules of size $s$
  \ForAll{candidates $c = (lhs \to rhs)$}
    \State Check if $c$ is \emph{valid}: for all assertions in $E$, $lhs$ and $rhs$ evaluate to the same value
    \State Check if $c$ is \emph{useful}: it derives equalities not derivable by $R$
    \If{$c$ is valid and useful}
      \State Add $c$ to $R$
    \EndIf
  \EndFor
\EndFor
\State Minimize $R$: remove redundant rules
\State \Return $R$
\end{algorithmic}
\end{algorithm}

\begin{example}[Ruler Discovery]\label{ex:ruler}
\begin{verbatim}
  // Input: operators {+, *, 0, 1, -}, equalities like:
  //   x + 0 = x, x * 1 = x, x * 0 = 0, x + x = x * 2
  
  // Ruler discovers:
  //   Rule 1: ?a + 0 → ?a
  //   Rule 2: ?a * 1 → ?a
  //   Rule 3: ?a * 0 → 0
  //   Rule 4: ?a + ?a → ?a * 2
  // These rules are minimal and complete for the given equalities.
\end{verbatim}
\end{example}

