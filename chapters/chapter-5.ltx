%% chapter-5.ltx — Category Theory for Language Scientists
%%

Category theory, introduced by Eilenberg and Mac Lane in the 1940s, is often described as ``the mathematics of mathematics''---a framework that abstracts the common patterns found across different branches of mathematics. For the programming language scientist, category theory is not merely an elegant abstraction; it is a practical tool. It provides the language for understanding type constructors, the framework for denotational semantics, and the foundation for understanding monads, which have become central to the management of computational effects.

This chapter introduces the basic concepts of category theory: categories, morphisms, products, coproducts, exponentials, and universal properties. We emphasize the connections to programming language concepts throughout.

\section{Categories: Definition and Examples}\label{sec:cat-categories}

\begin{definition}[Category]\label{def:category}
A \emph{category} $\mathcal{C}$ consists of:
\begin{itemize}
  \item A collection $\mathrm{Ob}(\mathcal{C})$ of \emph{objects}
  \item For each pair of objects $A, B$, a set $\mathrm{Hom}_{\mathcal{C}}(A, B)$ of \emph{morphisms} (or \emph{arrows}) from $A$ to $B$
  \item For each triple of objects $A, B, C$, a \emph{composition} operation:
  \[\circ : \mathrm{Hom}(B, C) \times \mathrm{Hom}(A, B) \to \mathrm{Hom}(A, C)\]
  \item For each object $A$, an \emph{identity morphism} $\mathrm{id}_A \in \mathrm{Hom}(A, A)$
\end{itemize}
satisfying:
\begin{itemize}
  \item \textbf{Associativity}: $h \circ (g \circ f) = (h \circ g) \circ f$ for all composable $f, g, h$
  \item \textbf{Identity}: $f \circ \mathrm{id}_A = f = \mathrm{id}_B \circ f$ for all $f \in \mathrm{Hom}(A, B)$
\end{itemize}
\end{definition}

\begin{notation}
We write $f : A \to B$ (or $f \in \mathrm{Hom}(A, B)$) to indicate that $f$ is a morphism from $A$ to $B$. The \emph{domain} of $f$ is $\mathrm{dom}(f) = A$ and the \emph{codomain} is $\mathrm{cod}(f) = B$.
\end{notation}

\subsection{Examples of Categories}

\begin{example}[The Category Set]\label{ex:cat-set}
$\mathbf{Set}$ is the category of sets and functions:
\begin{itemize}
  \item Objects: all sets
  \item Morphisms: total functions between sets
  \item Composition: ordinary function composition
  \item Identity: the identity function $\mathrm{id}_A(x) = x$
\end{itemize}
\end{example}

\begin{example}[The Category Poset]\label{ex:cat-poset}
$\mathbf{Poset}$ is the category of partially ordered sets and monotone functions:
\begin{itemize}
  \item Objects: posets $(P, \leq)$
  \item Morphisms: monotone (order-preserving) functions
  \item Composition and identity: as in $\mathbf{Set}$
\end{itemize}
\end{example}

\begin{example}[The Category CPO]\label{ex:cat-cpo}
$\mathbf{CPO}$ is the category of complete partial orders and continuous functions. This category is fundamental to denotational semantics~\cite{winskel1993semantics}.
\end{example}

\begin{example}[Preorders as Categories]\label{ex:cat-preorder}
Every preorder $(P, \leq)$ can be viewed as a category:
\begin{itemize}
  \item Objects: elements of $P$
  \item $\mathrm{Hom}(a, b)$ is a singleton if $a \leq b$, and empty otherwise
  \item Composition: transitivity of $\leq$
  \item Identity: reflexivity of $\leq$
\end{itemize}
In this view, a morphism $a \to b$ is a \emph{proof} that $a \leq b$. The uniqueness of morphisms reflects the fact that in a preorder, there is at most one ``proof'' of $a \leq b$.
\end{example}

\begin{insight}
The view of preorders as categories reveals a deep connection between order theory and category theory. In a preorder viewed as a category, the categorical product is the meet (greatest lower bound), the coproduct is the join (least upper bound), and the terminal object is the top element. This connection generalizes: category theory subsumes order theory.
\end{insight}

\begin{example}[Types as a Category]\label{ex:cat-types}
In a programming language, we can form a category where:
\begin{itemize}
  \item Objects: types (e.g., $\mathrm{Int}$, $\mathrm{Bool}$, $\mathrm{Int} \to \mathrm{Int}$)
  \item Morphisms: functions (programs) of the corresponding type
  \item Composition: function composition
  \item Identity: the identity function
\end{itemize}
This is the categorical semantics of types: types are objects, programs are morphisms.
\end{example}

\begin{example}[The Category Rel]\label{ex:cat-rel}
$\mathbf{Rel}$ is the category of sets and relations:
\begin{itemize}
  \item Objects: sets
  \item Morphisms $R : A \to B$: binary relations $R \subseteq A \times B$
  \item Composition: relational composition
  \item Identity: the identity relation $\{(a, a) \mid a \in A\}$
\end{itemize}
\end{example}

\section{Morphisms}\label{sec:cat-morphisms}

\begin{definition}[Special Morphisms]\label{def:special-morphisms}
A morphism $f : A \to B$ in a category $\mathcal{C}$ is:
\begin{itemize}
  \item An \emph{isomorphism} if there exists $g : B \to A$ such that $g \circ f = \mathrm{id}_A$ and $f \circ g = \mathrm{id}_B$. We write $A \cong B$ if there is an isomorphism between $A$ and $B$.
  \item A \emph{monomorphism} if $f \circ g = f \circ h \implies g = h$ for all $g, h$ with appropriate domain. (Left-cancellable.)
  \item An \emph{epimorphism} if $g \circ f = h \circ f \implies g = h$ for all $g, h$ with appropriate codomain. (Right-cancellable.)
  \item An \emph{endomorphism} if $A = B$ (a morphism from an object to itself).
  \item An \emph{automorphism} if it is an isomorphism and an endomorphism.
\end{itemize}
\end{definition}

\begin{example}[Isomorphisms in Set]\label{ex:iso-set}
In $\mathbf{Set}$, the isomorphisms are exactly the bijections.
\end{example}

\begin{example}[Isomorphisms in Preorders]\label{ex:iso-preorder}
In a preorder viewed as a category, $a \cong b$ iff $a \leq b$ and $b \leq a$. This is exactly the equivalence relation induced by the preorder.
\end{example}

\section{Products and Coproducts}\label{sec:cat-products}

\begin{definition}[Product]\label{def:product}
The \emph{product} of objects $A$ and $B$ in a category $\mathcal{C}$ is an object $A \times B$ together with morphisms $\pi_1 : A \times B \to A$ and $\pi_2 : A \times B \to B$ such that for any object $C$ and morphisms $f : C \to A$, $g : C \to B$, there exists a unique morphism $\langle f, g \rangle : C \to A \times B$ making the following diagram commute:

\begin{center}
\begin{tikzpicture}[node distance=2.5cm]
  \node (C) {$C$};
  \node[right=of C] (P) {$A \times B$};
  \node[above right=of P] (A) {$A$};
  \node[below right=of P] (B) {$B$};
  
  \draw[->, thick] (C) -- node[above]{$f$} (A);
  \draw[->, thick] (C) -- node[below]{$g$} (B);
  \draw[->, thick] (C) -- node[above]{$\langle f, g \rangle$} (P);
  \draw[->, thick] (P) -- node[above]{$\pi_1$} (A);
  \draw[->, thick] (P) -- node[below]{$\pi_2$} (B);
\end{tikzpicture}
\end{center}

That is: $\pi_1 \circ \langle f, g \rangle = f$ and $\pi_2 \circ \langle f, g \rangle = g$.
\end{definition}

\begin{example}[Products in Set]\label{ex:prod-set}
In $\mathbf{Set}$, the product of $A$ and $B$ is the Cartesian product $A \times B = \{(a, b) \mid a \in A, b \in B\}$ with projections $\pi_1(a, b) = a$ and $\pi_2(a, b) = b$. The pairing $\langle f, g \rangle(c) = (f(c), g(c))$.
\end{example}

\begin{example}[Products as Conjunction]\label{ex:prod-conjunction}
In a preorder viewed as a category, the product of $a$ and $b$ is their meet $a \sqcap b$. The universal property says: $c \leq a \sqcap b$ iff $c \leq a$ and $c \leq b$. This is exactly the introduction rule for conjunction in logic.
\end{example}

\begin{definition}[Coproduct]\label{def:coproduct}
The \emph{coproduct} of objects $A$ and $B$ is an object $A + B$ together with morphisms $\iota_1 : A \to A + B$ and $\iota_2 : B \to A + B$ such that for any object $C$ and morphisms $f : A \to C$, $g : B \to C$, there exists a unique morphism $[f, g] : A + B \to C$ such that $[f, g] \circ \iota_1 = f$ and $[f, g] \circ \iota_2 = g$.
\end{definition}

\begin{example}[Coproducts in Set]\label{ex:coprod-set}
In $\mathbf{Set}$, the coproduct is the disjoint union $A + B = (\{0\} \times A) \cup (\{1\} \times B)$ with injections $\iota_1(a) = (0, a)$ and $\iota_2(b) = (1, b)$. The case analysis $[f, g]$ is defined by $[f, g](0, a) = f(a)$ and $[f, g](1, b) = g(b)$.
\end{example}

\begin{example}[Coproducts as Disjunction]\label{ex:coprod-disjunction}
In a preorder viewed as a category, the coproduct of $a$ and $b$ is their join $a \sqcup b$. The universal property says: $a \sqcup b \leq c$ iff $a \leq c$ and $b \leq c$. This is the elimination rule for disjunction.
\end{example}

\begin{insight}
Products and coproducts are \emph{dual} concepts: the definition of coproduct is obtained from the definition of product by reversing all arrows. This duality is a central theme in category theory: every concept has a dual, and every theorem has a dual theorem. In programming, products correspond to pairs (tuples, records) and coproducts correspond to tagged unions (variants, sum types).
\end{insight}

\section{Exponentials}\label{sec:cat-exponentials}

\begin{definition}[Exponential]\label{def:exponential}
An \emph{exponential} $B^A$ in a category $\mathcal{C}$ with products is an object together with a morphism $\mathrm{eval} : B^A \times A \to B$ such that for any morphism $g : C \times A \to B$, there exists a unique morphism $\lambda g : C \to B^A$ (the \emph{currying} of $g$) such that $\mathrm{eval} \circ (\lambda g \times \mathrm{id}_A) = g$:

\begin{center}
\begin{tikzpicture}[node distance=2.5cm]
  \node (CxA) {$C \times A$};
  \node[right=of CxA] (B) {$B$};
  \node[above=of CxA] (C) {$C$};
  \node[above right=of CxA] (BA) {$B^A$};
  
  \draw[->, thick] (CxA) -- node[below]{$g$} (B);
  \draw[->, thick] (C) -- node[left]{$\lambda g$} (BA);
  \draw[->, thick] (BA) -- node[right]{$\mathrm{eval}$} (B);
\end{tikzpicture}
\end{center}
\end{definition}

\begin{example}[Exponentials in Set]\label{ex:exp-set}
In $\mathbf{Set}$, the exponential $B^A$ is the set of all functions from $A$ to $B$. The evaluation map is $\mathrm{eval}(f, a) = f(a)$, and currying transforms $g : C \times A \to B$ into $\lambda g : C \to (A \to B)$ defined by $(\lambda g)(c)(a) = g(c, a)$.
\end{example}

\begin{example}[Exponentials as Implication]\label{ex:exp-implication}
In a preorder viewed as a category, the exponential $b^a$ is the implication $a \to b$. The universal property says: $c \leq a \to b$ iff $c \sqcap a \leq b$. This is exactly the deduction theorem: $c \vdash a \to b$ iff $c, a \vdash b$.
\end{example}

\section{Cartesian Closed Categories}\label{sec:cat-ccc}

\begin{definition}[Cartesian Closed Category]\label{def:ccc}
A \emph{cartesian closed category} (CCC) is a category with:
\begin{itemize}
  \item A terminal object $1$
  \item Products $A \times B$ for all objects $A, B$
  \item Exponentials $B^A$ for all objects $A, B$
\end{itemize}
\end{definition}

\begin{theorem}[Types Form a CCC]\label{thm:types-ccc}
The category of types and functions in the simply-typed lambda calculus (with products and function types) is a cartesian closed category.
\end{theorem}

\begin{proof}
The terminal object is the unit type $\mathbf{1}$. Products are pair types $A \times B$. Exponentials are function types $A \to B$. The evaluation map is function application, and currying is lambda abstraction.
\end{proof}

\begin{insight}
The correspondence between CCCs and the simply-typed lambda calculus is an instance of the Curry--Howard correspondence: types are objects, programs are morphisms, and the categorical structure (products, exponentials) corresponds to the logical connectives (conjunction, implication). This connection is explored in depth in \chref{proof-theory}.
\end{insight}

\section{Universal Properties}\label{sec:cat-universal}

Products, coproducts, and exponentials are all instances of a single meta-concept: the \emph{universal property}.

\begin{definition}[Universal Property]\label{def:universal}
A \emph{universal property} characterizes an object by its relationship to all other objects, rather than by its internal structure. An object $U$ satisfying a universal property is unique up to isomorphism.
\end{definition}

\begin{definition}[Initial and Terminal Objects]\label{def:initial-terminal}
In a category $\mathcal{C}$:
\begin{itemize}
  \item An object $0$ is \emph{initial} if for every object $A$, there is exactly one morphism $0 \to A$.
  \item An object $1$ is \emph{terminal} if for every object $A$, there is exactly one morphism $A \to 1$.
\end{itemize}
\end{definition}

\begin{example}[Initial and Terminal Objects]\label{ex:initial-terminal}
\begin{itemize}
  \item In $\mathbf{Set}$: $\emptyset$ is initial, any singleton $\{*\}$ is terminal.
  \item In $\mathbf{Poset}$: the empty poset is initial, the one-element poset is terminal.
  \item In a preorder: the least element (if it exists) is initial, the greatest element is terminal.
\end{itemize}
\end{example}

\begin{theorem}[Uniqueness up to Isomorphism]\label{thm:universal-unique}
Initial objects, terminal objects, products, coproducts, and exponentials are unique up to unique isomorphism.
\end{theorem}

\begin{proof}
Suppose $I_1$ and $I_2$ are both initial. Then there is a unique $f : I_1 \to I_2$ and a unique $g : I_2 \to I_1$. The composition $g \circ f : I_1 \to I_1$ must be $\mathrm{id}_{I_1}$ (by uniqueness). Similarly $f \circ g = \mathrm{id}_{I_2}$. So $f$ is an isomorphism.
\end{proof}

\section{Initial Algebras and Final Coalgebras}\label{sec:cat-algebras}

\begin{definition}[F-Algebra]\label{def:f-algebra}
Given an endofunctor $F : \mathcal{C} \to \mathcal{C}$, an \emph{$F$-algebra} is a pair $(A, \alpha)$ where $A$ is an object and $\alpha : F(A) \to A$ is a morphism.
\end{definition}

\begin{definition}[Initial F-Algebra]\label{def:initial-algebra}
An \emph{initial $F$-algebra} is an initial object in the category of $F$-algebras. By Lambek's lemma, if $(\mu F, \mathrm{in})$ is an initial $F$-algebra, then $\mathrm{in} : F(\mu F) \to \mu F$ is an isomorphism.
\end{definition}

\begin{example}[Natural Numbers as Initial Algebra]\label{ex:nat-initial}
Let $F(X) = 1 + X$. An $F$-algebra is a set $A$ with a function $1 + A \to A$, i.e., a distinguished element $z : 1 \to A$ (zero) and a function $s : A \to A$ (successor). The initial $F$-algebra is $(\mathbb{N}, [\mathrm{zero}, \mathrm{succ}])$. The unique homomorphism from $\mathbb{N}$ to any other $F$-algebra $(A, z, s)$ is the iterator: $f(0) = z$, $f(n+1) = s(f(n))$.
\end{example}

\begin{example}[Lists as Initial Algebra]\label{ex:list-initial}
Let $F_A(X) = 1 + A \times X$. The initial $F_A$-algebra is the type of lists $\mathrm{List}(A)$, with $\mathrm{nil} : 1 \to \mathrm{List}(A)$ and $\mathrm{cons} : A \times \mathrm{List}(A) \to \mathrm{List}(A)$.
\end{example}

\section{Why Category Theory Matters for Programming Languages}\label{sec:cat-why}

\subsection{Types as Objects, Programs as Morphisms}

The most fundamental insight of category theory for programming languages is that types can be viewed as objects and programs as morphisms. This perspective unifies:
\begin{itemize}
  \item Function composition with program composition
  \item Product types with categorical products
  \item Sum types with categorical coproducts
  \item Function types with categorical exponentials
\end{itemize}

\subsection{Functorial Semantics}

Lawvere's ``functorial semantics'' views a theory as a category and a model as a functor from that category to $\mathbf{Set}$. This provides a uniform framework for understanding different models of the same theory.

\subsection{Monads and Effects}

Moggi's seminal insight~\cite{} was that computational effects (state, exceptions, I/O, nondeterminism) can be modeled uniformly using monads. This idea has profoundly influenced the design of Haskell, Scala, and many other languages. We develop this connection in \chref{monads}.

\subsection{Denotational Semantics}

Category theory provides the natural setting for denotational semantics. The category $\mathbf{CPO}$ of complete partial orders and continuous functions is the standard category of semantic domains~\cite{winskel1993semantics}. The category $\mathbf{Set}$ is too restrictive (it does not support recursive types), while more structured categories (toposes, realizability categories) provide richer semantic models.

\section{Isomorphisms and Equivalence of Categories}\label{sec:cat-iso}

\begin{definition}[Equivalence of Categories]\label{def:cat-equivalence}
Categories $\mathcal{C}$ and $\mathcal{D}$ are \emph{equivalent} if there exist functors $F : \mathcal{C} \to \mathcal{D}$ and $G : \mathcal{D} \to \mathcal{C}$ such that $G \circ F \cong \mathrm{Id}_{\mathcal{C}}$ and $F \circ G \cong \mathrm{Id}_{\mathcal{D}}$ (natural isomorphisms).
\end{definition}

\begin{definition}[Full and Faithful Functor]\label{def:full-faithful}
A functor $F : \mathcal{C} \to \mathcal{D}$ is:
\begin{itemize}
  \item \emph{Faithful} if for all $A, B$, the map $\mathrm{Hom}(A, B) \to \mathrm{Hom}(F(A), F(B))$ is injective
  \item \emph{Full} if for all $A, B$, the map is surjective
  \item \emph{Fully faithful} if the map is bijective
  \item \emph{Essentially surjective} if for every $D \in \mathcal{D}$, there exists $C \in \mathcal{C}$ with $F(C) \cong D$
\end{itemize}
\end{definition}

\begin{theorem}[Characterization of Equivalence]\label{thm:cat-equiv-char}
A functor $F : \mathcal{C} \to \mathcal{D}$ is an equivalence if and only if it is fully faithful and essentially surjective.
\end{theorem}

\section{Duality}\label{sec:cat-duality}

\begin{definition}[Opposite Category]\label{def:opposite-category}
Given a category $\mathcal{C}$, the \emph{opposite category} $\mathcal{C}^{\mathrm{op}}$ has:
\begin{itemize}
  \item The same objects as $\mathcal{C}$
  \item $\mathrm{Hom}_{\mathcal{C}^{\mathrm{op}}}(A, B) = \mathrm{Hom}_{\mathcal{C}}(B, A)$
  \item Composition in $\mathcal{C}^{\mathrm{op}}$ is reversed composition in $\mathcal{C}$
\end{itemize}
\end{definition}

\begin{definition}[Dual Concept]\label{def:dual-concept}
The \emph{dual} of a categorical concept is obtained by reversing all arrows. For example:
\begin{itemize}
  \item The dual of a product is a coproduct
  \item The dual of an initial object is a terminal object
  \item The dual of a monomorphism is an epimorphism
  \item The dual of an adjunction $F \dashv G$ is an adjunction $G^{\mathrm{op}} \dashv F^{\mathrm{op}}$
\end{itemize}
\end{definition}

\begin{theorem}[Duality Principle]\label{thm:duality}
If a statement is true in all categories, then its dual is also true in all categories.
\end{theorem}

\begin{proof}
If a statement $S$ is true in all categories, then $S$ is true in $\mathcal{C}^{\mathrm{op}}$ for any category $\mathcal{C}$. But $S$ in $\mathcal{C}^{\mathrm{op}}$ is the same as the dual of $S$ in $\mathcal{C}$.
\end{proof}

\section{Slice Categories}\label{sec:cat-slice}

\begin{definition}[Slice Category]\label{def:slice-category}
Given a category $\mathcal{C}$ and an object $A \in \mathcal{C}$, the \emph{slice category} $\mathcal{C}/A$ has:
\begin{itemize}
  \item Objects: morphisms $f : B \to A$ in $\mathcal{C}$
  \item Morphisms from $f : B \to A$ to $g : C \to A$: morphisms $h : B \to C$ in $\mathcal{C}$ such that $g \circ h = f$
\end{itemize}
\end{definition}

\begin{example}[Types over a Context]\label{ex:slice-types}
In the category of types, the slice category $\mathbf{Type}/\Gamma$ represents types in context $\Gamma$. An object is a type $A$ equipped with a function $A \to \Gamma$ (a ``type depending on the context''). This is the categorical foundation for dependent types.
\end{example}

\section{String Diagrams}\label{sec:cat-string}

String diagrams provide a graphical calculus for reasoning about morphisms in categories. They are particularly useful for reasoning about monoidal categories and monads.

\begin{definition}[String Diagram]\label{def:string-diagram}
In a string diagram:
\begin{itemize}
  \item Objects are represented by \emph{wires} (lines)
  \item Morphisms $f : A \to B$ are represented by \emph{boxes} with an input wire of type $A$ and an output wire of type $B$
  \item Composition is represented by connecting wires
  \item Identity is represented by a straight wire
  \item Products are represented by parallel wires
\end{itemize}
\end{definition}

\begin{insight}
String diagrams make the associativity and identity laws of categories trivial: they are simply the fact that wires can be stretched and straightened. This graphical calculus is not merely a convenience; it reveals the essential structure of categorical reasoning, free from the clutter of variable names and parentheses.
\end{insight}

\section{Exercises}\label{sec:cat-exercises}

\begin{enumerate}
  \item Prove that in any category, the identity morphism on an object is unique.
  
  \item Show that in $\mathbf{Set}$, monomorphisms are exactly the injective functions and epimorphisms are exactly the surjective functions.
  
  \item Prove that the product of $A$ and $B$ in a preorder category is the meet $a \sqcap b$.
  
  \item Show that in $\mathbf{Set}$, the coproduct is the disjoint union.
  
  \item Prove that the category of preorders and monotone functions has products and coproducts.
  
  \item Show that $\mathbf{Set}$ is a cartesian closed category by verifying the universal properties of products and exponentials.
  
  \item Define the category $\mathbf{Vect}$ of vector spaces and linear maps. Show that it has products and coproducts.
  
  \item Prove Lambek's lemma: if $(\mu F, \mathrm{in})$ is an initial $F$-algebra, then $\mathrm{in}$ is an isomorphism.
\end{enumerate}

\section{Chapter Summary}\label{sec:cat-summary}

We have introduced the basic concepts of category theory:
\begin{itemize}
  \item Categories abstract the notion of ``objects and structure-preserving maps''
  \item Products, coproducts, and exponentials correspond to pairs, tagged unions, and function types
  \item Cartesian closed categories capture the structure of the simply-typed lambda calculus
  \item Universal properties characterize objects by their relationships, not their internal structure
  \item Initial algebras provide a categorical foundation for inductive data types
\end{itemize}

In the next chapter, we deepen our categorical toolkit with functors, natural transformations, and adjunctions---the concepts needed to understand monads and their applications to programming language semantics.

\section{Universal Properties in Depth}\label{sec:universal-properties}

\subsection{The Yoneda Lemma}

\begin{theorem}[Yoneda Lemma]\label{thm:yoneda}
For any functor $F : \mathcal{C}^{op} \to \mathbf{Set}$ and any object $A \in \mathcal{C}$:
\[\mathrm{Nat}(\mathrm{Hom}(-, A), F) \cong F(A)\]
That is, natural transformations from the representable functor $\mathrm{Hom}(-, A)$ to $F$ are in bijection with elements of $F(A)$.
\end{theorem}

\begin{proof}
Given a natural transformation $\eta : \mathrm{Hom}(-, A) \Rightarrow F$, we obtain an element of $F(A)$ by evaluating $\eta_A(\mathrm{id}_A)$. Conversely, given $x \in F(A)$, we define $\eta_B(f) = F(f)(x)$ for $f : B \to A$. Naturality of $\eta$ follows from functoriality of $F$.
\end{proof}

\begin{corollary}[Yoneda Embedding]\label{cor:yoneda-embedding}
The Yoneda embedding $Y : \mathcal{C} \to \mathbf{Set}^{\mathcal{C}^{op}}$ defined by $Y(A) = \mathrm{Hom}(-, A)$ is fully faithful. This means that $\mathcal{C}$ embeds into its presheaf category, and objects of $\mathcal{C}$ can be studied through their ``probes'' from all other objects.
\end{corollary}

\begin{insight}
The Yoneda lemma is one of the most powerful ideas in category theory. In programming, it tells us that a polymorphic function of type $\forall r.\;(a \to r) \to r$ is isomorphic to $a$ itself. This is the basis for the \emph{continuation-passing style} (CPS) transformation and the \emph{codensity monad}.
\end{insight}

\subsection{Kan Extensions}

\begin{definition}[Kan Extension]\label{def:kan-extension}
Given functors $F : \mathcal{C} \to \mathcal{E}$ and $K : \mathcal{C} \to \mathcal{D}$, the \emph{left Kan extension} of $F$ along $K$ is a functor $\mathrm{Lan}_K F : \mathcal{D} \to \mathcal{E}$ with a natural transformation $\eta : F \Rightarrow (\mathrm{Lan}_K F) \circ K$ that is universal among such pairs.
\end{definition}

\begin{example}[Kan Extensions in Haskell]
In Haskell, the left Kan extension can be expressed as:
\begin{verbatim}
  data Lan k f a where
    Lan :: (k b -> a) -> f b -> Lan k f a
\end{verbatim}
The \emph{codensity monad} of a functor $f$ is $\mathrm{Ran}_f f$, which is always a monad even when $f$ is not. This provides a way to ``monadify'' any functor.
\end{example}

\subsection{Limits and Colimits as Universal Properties}

\begin{definition}[Limit]\label{def:limit}
Given a diagram $D : \mathcal{J} \to \mathcal{C}$, a \emph{limit} of $D$ is a cone $(L, \{\lambda_j : L \to D(j)\}_{j \in \mathcal{J}})$ such that for every cone $(X, \{x_j : X \to D(j)\})$, there is a unique morphism $u : X \to L$ with $\lambda_j \circ u = x_j$ for all $j$.
\end{definition}

\begin{example}[Common Limits]\label{ex:limits}
\begin{itemize}
  \item \textbf{Product}: limit of a discrete diagram (no arrows).
  \item \textbf{Equalizer}: limit of a parallel pair $f, g : A \rightrightarrows B$.
  \item \textbf{Pullback}: limit of a cospan $A \to C \leftarrow B$.
  \item \textbf{Terminal object}: limit of the empty diagram.
\end{itemize}
\end{example}

\begin{example}[Pullbacks in Programming]\label{ex:pullback-prog}
In the category of types, a pullback of $f : A \to C$ and $g : B \to C$ is the type:
\[\{(a, b) \mid f(a) = g(b)\}\]
This is the type of \emph{compatible pairs}: pairs of values that agree on their ``interface'' $C$. Pullbacks are used in the semantics of dependent types: the dependent sum $\Sigma x : A.\,B(x)$ can be understood as a pullback.
\end{example}

\subsection{Monads from Adjunctions}

\begin{theorem}[Every Monad Arises from an Adjunction]\label{thm:monad-adjunction}
Every monad $(T, \eta, \mu)$ on $\mathcal{C}$ arises from an adjunction $F \dashv G$ where $T = G \circ F$, $\eta$ is the unit, and $\mu = G \varepsilon F$ (where $\varepsilon$ is the counit).
\end{theorem}

\begin{example}[The State Monad]\label{ex:state-monad}
The state monad $T(A) = (A \times S)^S$ arises from the adjunction:
\begin{center}
$- \times S \dashv (-)^S$
\end{center}
between the functors $- \times S : \mathbf{Set} \to \mathbf{Set}$ (product with $S$) and $(-)^S : \mathbf{Set} \to \mathbf{Set}$ (exponentiation by $S$). The unit is $\eta(a)(s) = (a, s)$ and the multiplication is $\mu(f)(s) = f(f(s)_2)(f(s)_1)$... wait, more precisely $\mu(\Phi)(s) = \text{let } (a, s') = \Phi(s)\;\text{in}\;a$... 

Actually, the state monad arises more naturally from the adjunction between $\mathbf{Set}/S$ and $\mathbf{Set}$ via the Grothendieck construction.
\end{example}

\begin{example}[The Continuation Monad]\label{ex:cont-monad}
The continuation monad $T(A) = R^{R^A}$ (double dualization) arises from the adjunction:
\begin{center}
$(-)^A \dashv (-)^A$ (self-adjunction on $\mathbf{Set}^{op}$)
\end{center}
This is a \emph{contravariant} adjunction: the functor $(-)^A : \mathbf{Set}^{op} \to \mathbf{Set}$ is adjoint to itself. The continuation monad is the monad induced by this adjunction.
\end{example}
