\section{Reductions and Completeness}\label{sec:comp-reductions}

\subsection{Many-One Reductions}

\begin{definition}[Many-One Reduction]\label{def:many-one}
A language $A$ is \emph{many-one reducible} to a language $B$ (written $A \leq_m B$) if there exists a computable function $f$ such that $x \in A \iff f(x) \in B$.
\end{definition}

\begin{definition}[Hardness and Completeness]\label{def:hardness}
A language $B$ is \emph{hard} for a class $\mathcal{C}$ (under many-one reductions) if every $A \in \mathcal{C}$ reduces to $B$. $B$ is \emph{complete} for $\mathcal{C}$ if it is hard for $\mathcal{C}$ and $B \in \mathcal{C}$.
\end{definition}

\begin{theorem}[Cook--Levin Theorem]\label{thm:cook-levin}
SAT (Boolean satisfiability) is NP-complete.
\end{theorem}

\begin{proof}[Proof sketch]
SAT is in NP (a satisfying assignment is a polynomial-time verifiable certificate). For NP-hardness, given any nondeterministic Turing machine $M$ running in polynomial time $p(n)$, we construct a Boolean formula $\varphi_{M,x}$ of size polynomial in $|x|$ that is satisfiable iff $M$ accepts $x$. The formula encodes the computation tableau of $M$ on $x$.
\end{proof}

\subsection{Polynomial-Time Reductions}

\begin{definition}[Polynomial-Time Reduction]\label{def:poly-reduction}
$A \leq_p B$ if there exists a polynomial-time computable function $f$ such that $x \in A \iff f(x) \in B$.
\end{definition}

\begin{definition}[NP-Complete under Poly-Time Reductions]\label{def:np-complete-poly}
$B$ is NP-complete if $B \in \mathbf{NP}$ and for all $A \in \mathbf{NP}$, $A \leq_p B$.
\end{definition}

\section{Space Complexity}\label{sec:comp-space}

\begin{definition}[Space Complexity]\label{def:space-complexity}
The \emph{space complexity} of a Turing machine $M$ is the function $S_M(n)$ where $S_M(n)$ is the maximum number of tape cells used by $M$ on any input of length $n$.
\end{definition}

\begin{definition}[Complexity Classes L and PSPACE]\label{def:l-pspace}
\begin{itemize}
  \item $\mathbf{L} = \mathbf{SPACE}(\log n)$ --- languages decidable in logarithmic space
  \item $\mathbf{PSPACE} = \bigcup_k \mathbf{SPACE}(n^k)$ --- languages decidable in polynomial space
\end{itemize}
\end{definition}

\begin{theorem}[Space Complexity Hierarchy]\label{thm:space-hierarchy}
\[\mathbf{L} \subseteq \mathbf{NP} \subseteq \mathbf{PSPACE} \subseteq \mathbf{EXPTIME}\]
\end{theorem}

\begin{theorem}[Savitch's Theorem]\label{thm:savitch}
$\mathbf{NPSPACE} = \mathbf{PSPACE}$: nondeterministic polynomial space equals deterministic polynomial space.
\end{theorem}

\begin{proof}[Proof sketch]
By a recursive algorithm that searches the configuration graph of the nondeterministic machine using $O(\log^2 n)$ space per level of recursion, with $O(\log n)$ levels.
\end{proof}

