The theory of computability and complexity addresses the most fundamental questions in computer science: What can be computed? What cannot? And of the things that can be computed, how efficiently can they be computed? These questions are not merely academic---they have profound implications for programming language theory, compiler design, and program analysis.

This chapter develops the foundations of computability theory (Turing machines, decidability, the halting problem, Rice's theorem) and complexity theory (P, NP, EXPTIME), and explores their implications for program analysis and compiler optimization.

\section{Turing Machines}\label{sec:comp-turing}

\begin{definition}[Turing Machine]\label{def:turing-machine}
A (deterministic) \emph{Turing machine} is a tuple $M = (Q, \Sigma, \Gamma, \delta, q_0, q_{\mathrm{accept}}, q_{\mathrm{reject}})$ where:
\begin{itemize}
  \item $Q$ is a finite set of \emph{states}
  \item $\Sigma$ is the \emph{input alphabet} (not containing the blank symbol $\sqcup$)
  \item $\Gamma \supseteq \Sigma \cup \{\sqcup\}$ is the \emph{tape alphabet}
  \item $\delta : Q \times \Gamma \to Q \times \Gamma \times \{L, R\}$ is the \emph{transition function}
  \item $q_0 \in Q$ is the \emph{start state}
  \item $q_{\mathrm{accept}}, q_{\mathrm{reject}} \in Q$ are the \emph{accept} and \emph{reject} states
\end{itemize}
\end{definition}

A Turing machine consists of:
\begin{itemize}
  \item An infinite tape, initially containing the input followed by blanks
  \item A read/write head that can move left or right
  \item A finite control that determines the next action based on the current state and the symbol under the head
\end{itemize}

\begin{definition}[Computation of a Turing Machine]\label{def:tm-computation}
A Turing machine $M$ \emph{accepts} input $w$ if the computation starting in state $q_0$ with $w$ on the tape eventually reaches $q_{\mathrm{accept}}$. The \emph{language} of $M$ is $L(M) = \{w \mid M \text{ accepts } w\}$.
\end{definition}

\begin{definition}[Turing-Computable Function]\label{def:tm-computable}
A function $f : \Sigma^* \to \Sigma^*$ is \emph{Turing-computable} if there exists a Turing machine $M$ such that for every input $w$, $M$ halts with $f(w)$ on the tape.
\end{definition}

\section{Church--Turing Thesis}\label{sec:comp-church-turing}

\begin{definition}[Church--Turing Thesis]\label{def:church-turing}
The \emph{Church--Turing thesis} states that every ``effectively computable'' function is Turing-computable.
\end{definition}

The Church--Turing thesis is not a mathematical theorem (it cannot be, since ``effectively computable'' is an informal notion). It is a thesis about the correspondence between a formal model and an informal concept. Its acceptance is based on the fact that every reasonable model of computation proposed---Turing machines, lambda calculus, recursive functions, register machines, modern programming languages---has been shown to compute exactly the same class of functions.

\begin{theorem}[Equivalence of Models]\label{thm:model-equivalence}
The following models of computation compute exactly the same class of functions:
\begin{itemize}
  \item Turing machines
  \item The untyped lambda calculus
  \item General recursive functions (Kleene)
  \item Register machines (Minsky)
  \item WHILE programs
  \item Any general-purpose programming language (C, Java, Python, etc.)
\end{itemize}
\end{theorem}

\begin{insight}
The Church--Turing thesis has a profound implication for programming language design: no programming language can compute more than a Turing machine. Every general-purpose programming language is \emph{Turing-complete}---it can express the same computations as any other. The differences between languages are not in what they can compute, but in how conveniently, safely, and efficiently they allow computations to be expressed.
\end{insight}

\section{Decidability and Semi-Decidability}\label{sec:comp-decidability}

\begin{definition}[Decidable]\label{def:decidable}
A language $L$ is \emph{decidable} (or \emph{recursive}) if there exists a Turing machine that halts on every input and accepts exactly the strings in $L$.
\end{definition}

\begin{definition}[Semi-Decidable]\label{def:semi-decidable}
A language $L$ is \emph{semi-decidable} (or \emph{recursively enumerable}, or \emph{Turing-recognizable}) if there exists a Turing machine that accepts exactly the strings in $L$ (but may not halt on strings not in $L$).
\end{definition}

\begin{theorem}[Relationship Between Decidable and Semi-Decidable]\label{thm:decidable-semi}
\begin{enumerate}
  \item Every decidable language is semi-decidable.
  \item A language $L$ is decidable if and only if both $L$ and $\overline{L}$ are semi-decidable.
\end{enumerate}
\end{theorem}

\begin{proof}
(1) If $M$ decides $L$, then $M$ accepts $L$ and halts on all inputs, so $L$ is semi-decidable.

(2) If $L$ is decidable, both $L$ and $\overline{L}$ are decidable, hence semi-decidable. Conversely, if $L$ is semi-decidable (by $M_1$) and $\overline{L}$ is semi-decidable (by $M_2$), we can decide $L$ by running $M_1$ and $M_2$ in parallel (interleaving steps). One of them must halt, and we accept or reject accordingly.
\end{proof}

\section{The Halting Problem}\label{sec:comp-halting}

\begin{theorem}[Undecidability of the Halting Problem (Turing, 1936)]\label{thm:halting}
The language $H = \{\langle M, w \rangle \mid M \text{ halts on input } w\}$ is not decidable.
\end{theorem}

\begin{proof}
By diagonalization. Suppose $H$ is decidable by a Turing machine $D$. Define a new Turing machine $P$:
\begin{align*}
  P(\langle M \rangle) &= \text{if } D(\langle M, \langle M \rangle \rangle) \text{ accepts then loop forever else halt}
\end{align*}
Now consider $P(\langle P \rangle)$. If $P$ halts on $\langle P \rangle$, then $D$ accepts $\langle P, \langle P \rangle \rangle$, so $P$ loops forever---contradiction. If $P$ loops forever on $\langle P \rangle$, then $D$ rejects $\langle P, \langle P \rangle \rangle$, so $P$ halts---contradiction. In either case, we reach a contradiction, so $D$ cannot exist.
\end{proof}

\begin{corollary}[Undecidability of Totality]\label{cor:totality}
The language $\mathrm{Tot} = \{\langle M \rangle \mid M \text{ halts on all inputs}\}$ is not decidable.
\end{corollary}

\begin{proof}
By reduction from the halting problem. Given $\langle M, w \rangle$, construct $M'$ that ignores its input and simulates $M$ on $w$. Then $M'$ halts on all inputs iff $M$ halts on $w$.
\end{proof}

\section{Rice's Theorem}\label{sec:comp-rice}

\begin{theorem}[Rice's Theorem (1953)]\label{thm:rice}
Every non-trivial semantic property of Turing machines is undecidable.
\end{theorem}

More precisely:

\begin{definition}[Semantic Property]\label{def:semantic-property}
A \emph{semantic property} is a property of the language recognized by a Turing machine (i.e., a property of $L(M)$), as opposed to a syntactic property (a property of the description of $M$).
\end{definition}

\begin{theorem}[Rice's Theorem (Formal)]\label{thm:rice-formal}
Let $\mathcal{P}$ be a set of Turing-recognizable languages such that $\mathcal{P} \neq \emptyset$ and $\mathcal{P} \neq \{\text{all Turing-recognizable languages}\}$. Then the language $L_{\mathcal{P}} = \{\langle M \rangle \mid L(M) \in \mathcal{P}\}$ is undecidable.
\end{theorem}

\begin{proof}
By reduction from the halting problem. Since $\mathcal{P}$ is non-trivial, there exist languages $L_{\mathrm{yes}} \in \mathcal{P}$ and $L_{\mathrm{no}} \notin \mathcal{P}$. Given $\langle M, w \rangle$, construct $M'$ that on input $x$: first simulates $M$ on $w$; if $M$ halts, simulate the machine for $L_{\mathrm{yes}}$ on $x$. Then $L(M') = L_{\mathrm{yes}} \in \mathcal{P}$ if $M$ halts on $w$, and $L(M') = \emptyset \notin \mathcal{P}$ (or $L(M') = L_{\mathrm{no}} \notin \mathcal{P}$) if $M$ does not halt on $w$.
\end{proof}

\begin{example}[Applications of Rice's Theorem]\label{ex:rice-applications}
The following properties of programs are undecidable:
\begin{itemize}
  \item Does the program halt on all inputs? (Totality)
  \item Does the program ever output 0?
  \item Does the program compute the constant function?
  \item Is the program's output always positive?
  \item Does the program ever modify a given variable?
  \item Does the program ever access an array out of bounds?
\end{itemize}
\end{example}

\begin{insight}
Rice's theorem is the fundamental limitation of program analysis. It tells us that \emph{no algorithm can decide any non-trivial property of programs}. This does not mean that program analysis is impossible---it means that program analysis must be \emph{approximate}. Sound analysis may report false positives (warning about safe programs); complete analysis may miss real bugs. The art of program analysis is finding the right trade-off between precision and tractability.
\end{insight}

\section{Complexity Classes}\label{sec:comp-complexity}

While computability theory asks \emph{whether} a problem can be solved, complexity theory asks \emph{how efficiently} it can be solved.

\begin{definition}[Time Complexity]\label{def:time-complexity}
The \emph{time complexity} of a Turing machine $M$ is the function $T_M : \mathbb{N} \to \mathbb{N}$ where $T_M(n)$ is the maximum number of steps $M$ takes on any input of length $n$.
\end{definition}

\begin{definition}[Complexity Class $\mathbf{TIME}(t(n))$]\label{def:time-class}
$\mathbf{TIME}(t(n))$ is the class of languages decidable by a Turing machine in time $O(t(n))$.
\end{definition}

\begin{definition}[Complexity Classes P and NP]\label{def:p-np}
\begin{itemize}
  \item $\mathbf{P} = \bigcup_k \mathbf{TIME}(n^k)$ --- languages decidable in polynomial time
  \item $\mathbf{NP}$ --- languages decidable by a \emph{nondeterministic} Turing machine in polynomial time. Equivalently, languages for which a ``yes'' answer can be \emph{verified} in polynomial time given a suitable certificate.
\end{itemize}
\end{definition}

\begin{definition}[Complexity Class EXPTIME]\label{def:exptime}
$\mathbf{EXPTIME} = \bigcup_k \mathbf{TIME}(2^{n^k})$ --- languages decidable in exponential time.
\end{definition}

\begin{theorem}[Complexity Hierarchy]\label{thm:complexity-hierarchy}
\[\mathbf{P} \subseteq \mathbf{NP} \subseteq \mathbf{EXPTIME}\]
Moreover, by the time hierarchy theorem, $\mathbf{P} \subsetneq \mathbf{EXPTIME}$.
\end{theorem}

\begin{definition}[NP-Completeness]\label{def:np-complete}
A language $L$ is \emph{NP-hard} if every language in $\mathbf{NP}$ can be reduced to $L$ in polynomial time. $L$ is \emph{NP-complete} if it is NP-hard and $L \in \mathbf{NP}$.
\end{definition}

\begin{example}[NP-Complete Problems]\label{ex:np-complete}
\begin{itemize}
  \item Boolean satisfiability (SAT)
  \item 3-SAT
  \item Graph coloring
  \item Traveling salesperson (decision version)
  \item Subset sum
  \item Type inference for some type systems
\end{itemize}
\end{example}

