    \node[anchor=east,align=right] at (-1.6,\y) {\ver};
    \node[token] (decl) at (0,\y) {\texttt{\name} \(=4\)};
    \node[token] at (2.9,\y) {\texttt{stage\_} \(=9\)};
    \node[token,minimum width=3.5cm] (use) at (6.3,\y)
      {\texttt{print(\name, "stage")}};
