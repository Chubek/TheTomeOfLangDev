%% chapter-10.ltx — Dependent Types and Martin-Löf Type Theory
%%

Dependent type theory represents one of the most profound achievements in the foundations of mathematics and computer science. Introduced by Per Martin-Löf in the 1970s, it generalizes the simply-typed lambda calculus by allowing \emph{types to depend on values}. This seemingly small generalization has enormous consequences: it unifies logic and computation, provides a foundation for constructive mathematics, and enables the expression of rich program specifications directly in the type system.

Today, dependent types are the foundation of proof assistants like Coq, Agda, and Lean, and they are increasingly influencing the design of mainstream programming languages. This chapter develops Martin-Löf type theory from the ground up.

\section{Dependent Products (\texorpdfstring{$\Pi$}{Pi}-Types)}\label{sec:dep-pi}

In the simply-typed lambda calculus, the function type $\tau_1 \to \tau_2$ has a fixed return type $\tau_2$. In dependent type theory, the return type can depend on the \emph{value} of the argument.

\begin{definition}[Dependent Product Type]\label{def:dep-pi}
The \emph{dependent product type} $\depFunTy{x}{A}{B}$ (also written $\Pi(x:A).B$ or $(x:A) \to B$) is the type of functions that take an argument $x$ of type $A$ and return a result of type $B$, where $B$ may depend on $x$.
\end{definition}

When $B$ does not depend on $x$, the dependent product reduces to the simple function type:
\[\depFunTy{x}{A}{B} = A \to B \quad \text{when } x \notin \mathrm{fv}(B)\]

\begin{typerules}{Dependent Product}
\typerule{$\Pi$-Form}{\Gamma \turns A : \mathcal{U}_i \quad \Gamma, x:A \turns B : \mathcal{U}_i}{\Gamma \turns \depFunTy{x}{A}{B} : \mathcal{U}_i} \\[8pt]
\typerule{$\Pi$-Intro}{\Gamma, x:A \turns e : B}{\Gamma \turns \lambda x.\,e : \depFunTy{x}{A}{B}} \\[8pt]
\typerule{$\Pi$-Elim}{\Gamma \turns f : \depFunTy{x}{A}{B} \quad \Gamma \turns a : A}{\Gamma \turns f\;a : \subst{B}{x}{a}}
\end{typerules}

\begin{example}[Vector Type]\label{ex:vector-type}
The type of vectors of length $n$ with elements of type $A$ can be expressed as a dependent function:
\[\mathrm{Vec} : \mathbb{N} \to \mathcal{U}\]
where $\mathrm{Vec}(n)$ is the type of vectors of length $n$. A function that prepends an element to a vector has type:
\[\depFunTy{n}{\mathbb{N}}{\mathrm{Vec}(n) \to A \to \mathrm{Vec}(n+1)}\]
\end{example}

\begin{example}[Length-Preserving Append]\label{ex:append-dep}
The type of list append that tracks lengths:
\[\depFunTy{m}{\mathbb{N}}{\depFunTy{n}{\mathbb{N}}{\mathrm{Vec}(m) \to \mathrm{Vec}(n) \to \mathrm{Vec}(m+n)}}\]
This type guarantees that the result has length $m + n$.
\end{example}

\section{Dependent Sums (\texorpdfstring{$\Sigma$}{Sigma}-Types)}\label{sec:dep-sigma}

\begin{definition}[Dependent Sum Type]\label{def:dep-sigma}
The \emph{dependent sum type} $\depSigTy{x}{A}{B}$ (also written $\Sigma(x:A).B$) is the type of pairs $(a, b)$ where $a : A$ and $b : B[a/x]$. It generalizes the product type $A \times B$ by allowing the type of the second component to depend on the value of the first.
\end{definition}

\begin{typerules}{Dependent Sum}
\typerule{$\Sigma$-Form}{\Gamma \turns A : \mathcal{U}_i \quad \Gamma, x:A \turns B : \mathcal{U}_i}{\Gamma \turns \depSigTy{x}{A}{B} : \mathcal{U}_i} \\[8pt]
\typerule{$\Sigma$-Intro}{\Gamma \turns a : A \quad \Gamma \turns b : \subst{B}{x}{a}}{\Gamma \turns (a, b) : \depSigTy{x}{A}{B}} \\[8pt]
\typerule{$\Sigma$-Elim}{\Gamma \turns p : \depSigTy{x}{A}{B} \quad \Gamma, x:A, y:B \turns c : C}{\Gamma \turns \mathrm{let}\;(x,y) = p\;\mathrm{in}\;c : C}
\end{typerules}

\begin{example}[Existential Quantification]\label{ex:sigma-exists}
The dependent sum type $\depSigTy{x}{A}{P(x)}$ corresponds to existential quantification $\exists x:A.\,P(x)$. A value of this type is a pair $(a, p)$ where $a$ is a \emph{witness} and $p$ is a \emph{proof} that $P(a)$ holds.
\end{example}

\begin{example}[Subtypes]\label{ex:sigma-subtype}
The type of even natural numbers can be expressed as:
\[\depSigTy{n}{\mathbb{N}}{\mathrm{isEven}(n)}\]
where $\mathrm{isEven}(n)$ is the type of proofs that $n$ is even. A value of this type is a pair $(n, p)$ where $n$ is a natural number and $p$ is a proof that $n$ is even.
\end{example}

\section{Identity Types}\label{sec:dep-identity}

\begin{definition}[Identity Type]\label{def:identity-type}
The \emph{identity type} $\mathrm{Id}_A(a, b)$ (also written $a =_A b$ or $a \equiv b$) is the type of proofs that $a$ and $b$ are equal elements of type $A$.
\end{definition}

\begin{typerules}{Identity Type}
\typerule{Id-Form}{\Gamma \turns A : \mathcal{U}_i \quad \Gamma \turns a : A \quad \Gamma \turns b : A}{\Gamma \turns \mathrm{Id}_A(a, b) : \mathcal{U}_i} \\[8pt]
\typeaxiom{Id-Intro (refl)}{\Gamma \turns a : A \quad \Gamma \turns \mathrm{refl}(a) : \mathrm{Id}_A(a, a)} \\[8pt]
\typerule{Id-Elim (J)}{\Gamma \turns p : \mathrm{Id}_A(a, b) \quad \Gamma, x:A, y:A, z:\mathrm{Id}_A(x,y) \turns C : \mathcal{U}_i \quad \Gamma, x:A \turns c : C[x,x,\mathrm{refl}(x)]}{\Gamma \turns J(C, c, p) : C[a,b,p]}
\end{typerules}

The $J$ rule (also called \emph{path induction} or \emph{identity elimination}) states that to define a function on all identity proofs, it suffices to define it on reflexivity.

\begin{insight}
The identity type is one of the most subtle and profound concepts in type theory. In Martin-Löf's original formulation, $\mathrm{Id}_A(a, b)$ represents \emph{definitional equality}: $a$ and $b$ are interchangeable. In homotopy type theory~\cite{hottbook}, identity types are interpreted as \emph{paths} in a topological space, and the $J$ rule corresponds to path induction. This connection has led to a revolution in the foundations of mathematics.
\end{insight}

\section{Inductive Types and Universes}\label{sec:dep-inductive}

\subsection{Inductive Types}

\begin{definition}[Inductive Type]\label{def:inductive-type}
An \emph{inductive type} is a type defined by its \emph{constructors}. Each constructor specifies how to build elements of the type.
\end{definition}

\begin{example}[Natural Numbers]\label{ex:nat-inductive}
The natural numbers are defined inductively:
\begin{align*}
  \mathrm{data}\;\mathbb{N}\;\mathrm{where} \\
  \quad \mathrm{zero} &: \mathbb{N} \\
  \quad \mathrm{succ} &: \mathbb{N} \to \mathbb{N}
\end{align*}
The elimination rule (recursor) is:
\[\mathrm{rec}_{\mathbb{N}} : \depFunTy{P}{\mathbb{N} \to \mathcal{U}}{P(\mathrm{zero}) \to (\depFunTy{n}{\mathbb{N}}{P(n) \to P(\mathrm{succ}(n))}) \to \depFunTy{n}{\mathbb{N}}{P(n)}}\]
\end{example}

\begin{example}[Lists]\label{ex:list-inductive}
\begin{align*}
  \mathrm{data}\;\mathrm{List}(A : \mathcal{U})\;\mathrm{where} \\
  \quad \mathrm{nil} &: \mathrm{List}(A) \\
  \quad \mathrm{cons} &: A \to \mathrm{List}(A) \to \mathrm{List}(A)
\end{align*}
\end{example}

\begin{example}[Vectors (Indexed Inductive Type)]\label{ex:vec-inductive}
\begin{align*}
  \mathrm{data}\;\mathrm{Vec}(A : \mathcal{U}) : \mathbb{N} \to \mathcal{U}\;\mathrm{where} \\
  \quad \mathrm{vnil} &: \mathrm{Vec}(A, 0) \\
  \quad \mathrm{vcons} &: \depFunTy{n}{\mathbb{N}}{A \to \mathrm{Vec}(A, n) \to \mathrm{Vec}(A, \mathrm{succ}(n))}
\end{align*}
Vectors are an \emph{indexed} inductive type: the index $n$ tracks the length.
\end{example}

\subsection{Universes}

\begin{definition}[Universe Hierarchy]\label{def:universe}
To avoid paradoxes (like Russell's paradox), types are organized in a hierarchy of \emph{universes}:
\[\mathcal{U}_0 : \mathcal{U}_1 : \mathcal{U}_2 : \cdots\]
Each universe $\mathcal{U}_i$ contains the codes for types of ``size'' $i$. If $A : \mathcal{U}_i$, then $A$ is a type in universe $i$.
\end{definition}

\begin{definition}[Universe Polymorphism]\label{def:universe-poly}
In practice, we use \emph{universe polymorphism}: rules are stated for an arbitrary universe level $i$, avoiding the need to repeat rules for each level.
\end{definition}

\section{Martin-Löf's Meaning Explanations}\label{sec:ml-meaning}

Martin-Löf provided a \emph{meaning explanation} (or \emph{verificationist semantics}) for type theory, based on the notion of \emph{judgmental evidence}.

\begin{definition}[Judgments]\label{def:ml-judgments}
Martin-Löf type theory has four forms of categorical judgment:
\begin{itemize}
  \item $A\;\mathrm{type}$ --- $A$ is a type
  \item $a : A$ --- $a$ is an element (canonical proof) of type $A$
  \item $A = B\;\mathrm{type}$ --- $A$ and $B$ are definitionally equal types
  \item $a = b : A$ --- $a$ and $b$ are definitionally equal elements of type $A$
\end{itemize}
\end{definition}

\begin{definition}[Meaning of Judgments]\label{def:ml-meaning}
The meaning of the judgments is given by what it means to \emph{know} them:
\begin{itemize}
  \item To know $A\;\mathrm{type}$ is to know what counts as a canonical element of $A$ and when two canonical elements are equal.
  \item To know $a : A$ is to have produced a canonical element of $A$.
  \item To know $A = B\;\mathrm{type}$ is to know that $A$ and $B$ have the same canonical elements.
  \item To know $a = b : A$ is to know that $a$ and $b$ evaluate to the same canonical element.
\end{itemize}
\end{definition}

\begin{insight}
Martin-Löf's meaning explanations provide a \emph{computational} interpretation of type theory: a type is understood by knowing its canonical forms (values), and a proof is understood by knowing how to compute it. This is in contrast to model-theoretic semantics, where types are interpreted as sets in a model. The computational interpretation is what makes type theory suitable for implementation in proof assistants and programming languages.
\end{insight}

\section{Normalization and Canonicity}\label{sec:dep-normalization}

\begin{definition}[Normalization]\label{def:dep-normalization}
A type theory has the \emph{normalization property} if every well-typed term reduces to a normal form (a term with no reducible expressions).
\end{definition}

\begin{definition}[Canonicity]\label{def:canonicity}
A type theory has the \emph{canonicity property} if every closed term of a base type (e.g., $\mathbb{N}$) reduces to a \emph{canonical form} (e.g., a numeral $\mathrm{succ}^n(\mathrm{zero})$).
\end{definition}

\begin{theorem}[Canonicity of Martin-Löf Type Theory]\label{thm:canonicity}
Martin-Löf type theory (without universes) satisfies canonicity: every closed term of type $\mathbb{N}$ evaluates to a numeral.
\end{theorem}

\begin{proof}[Proof sketch]
By a computability argument (Tait's method adapted to dependent types). Define a computability predicate for each type, and show that every well-typed term is computable. For $\mathbb{N}$, computability means reducing to a canonical numeral.
\end{proof}

\begin{insight}
Canonicity is a crucial property for a proof assistant: it ensures that computations have concrete results. If you prove $\exists n.\,P(n)$ by constructing a term of type $\depSigTy{n}{\mathbb{N}}{P(n)}$, canonicity ensures that the first component evaluates to a concrete numeral---you can \emph{extract} the witness.
\end{insight}

\section{Applications: Agda, Coq, Lean}\label{sec:dep-applications}

\subsection{Agda}

Agda is a dependently typed programming language and proof assistant based on Martin-Löf type theory. It features:
\begin{itemize}
  \item Dependent function types ($\Pi$) and dependent pair types ($\Sigma$)
  \item Inductive and coinductive types
  \item Pattern matching with coverage checking
  \item Universe polymorphism
  \item Implicit arguments and type inference
\end{itemize}

\begin{example}[Addition in Agda]\label{ex:agda-add}
\begin{verbatim}
  data Nat : Set where
    zero : Nat
    succ : Nat -> Nat

  _+_ : Nat -> Nat -> Nat
  zero  + n = n
  succ m + n = succ (m + n)
\end{verbatim}
\end{example}

\subsection{Coq}

Coq is based on the \emph{Calculus of Inductive Constructions} (CIC), which extends the Calculus of Constructions with inductive types. It features:
\begin{itemize}
  \item A rich type system with dependent types, inductive types, and a universe hierarchy
  \item A powerful tactic language for interactive proof development
  \item Program extraction: certified programs can be extracted to OCaml, Haskell, or C
\end{itemize}

\subsection{Lean}

Lean is a modern proof assistant developed at Microsoft Research. It features:
\begin{itemize}
  \item A type theory based on the Calculus of Inductive Constructions with quotient types
  \item An elaborator that performs sophisticated type inference
  \item A tactic framework based on monadic programming
  \item The \texttt{mathlib} library, one of the largest formalized mathematics libraries
\end{itemize}

\section{The Lambda Cube}\label{sec:dep-lambda-cube}

Barendregt's \emph{lambda cube} organizes eight type systems along three axes of generalization:

\begin{definition}[The Three Axes]\label{def:lambda-cube-axes}
\begin{itemize}
  \item \textbf{Polymorphism}: types depending on types ($\forall \alpha : *.\,T$)
  \item \textbf{Type operators}: type constructors taking types to types ($\lambda \alpha : *.\,T$)
  \item \textbf{Dependent types}: types depending on terms ($\Pi x : A.\,B$)
\end{itemize}
\end{definition}

\begin{table}[htbp]
\centering
\caption{The Lambda Cube}
\label{tab:lambda-cube}
\begin{tabular}{lll}
\hline
\textbf{System} & \textbf{Features} & \textbf{Example Language} \\
\hline
$\lambda \to$ & Functions only & STLC \\
$\lambda\underline{\omega}$ & + Type operators & System F$_\omega$ \\
$\lambda 2$ & + Polymorphism & System F \\
$\lambda P$ & + Dependent types & LF (Logical Framework) \\
$\lambda \omega$ & + Type operators + Polymorphism & System F$_\omega$ \\
$\lambda P\underline{\omega}$ & + Type operators + Dependent types & Calculus of Constructions \\
$\lambda C$ & All three & Calculus of Constructions + Inductive types (Coq) \\
\hline
\end{tabular}
\end{table}

\begin{insight}
The lambda cube reveals that the simply-typed lambda calculus is just one corner of a rich space of type systems. Each axis of generalization adds expressive power at the cost of increased complexity. The Calculus of Constructions ($\lambda C$), which combines all three features, is the basis of the Coq proof assistant.
\end{insight}

\section{Program Extraction}\label{sec:dep-extraction}

One of the most powerful features of dependent type theory is \emph{program extraction}: extracting executable programs from constructive proofs.

\begin{definition}[Proof Irrelevance for Extraction]\label{def:extraction}
When extracting a program from a proof, we distinguish between:
\begin{itemize}
  \item \emph{Computational content}: the data and algorithms (extracted)
  \item \emph{Proof content}: the proofs of correctness (erased)
\end{itemize}
\end{definition}

\begin{definition}[Erasure]\label{def:erasure}
The \emph{erasure} function $|{-}|$ maps dependent types to simple types by removing proof content:
\begin{align*}
  |x| &= x \\
  |\lambda x.\,e| &= \lambda x.\,|e| \\
  |e_1\;e_2| &= |e_1|\;|e_2| \\
  |\depFunTy{x}{A}{B}| &= |A| \to |B| \quad \text{if } B \text{ depends on } x \\
  |\depFunTy{x}{A}{B}| &= |A| \to |B| \quad \text{if } B \text{ does not depend on } x \\
  |\depSigTy{x}{A}{B}| &= |A| \quad \text{(proof component erased)}
\end{align*}
\end{definition}

\begin{example}[Extracting GCD]\label{ex:extract-gcd}
Suppose we prove in Coq:
\[\forall m\;n : \mathbb{N}.\;n > 0 \to \exists d.\;\mathrm{divides}(d, m) \land \mathrm{divides}(d, n) \land \forall e.\;\mathrm{divides}(e, m) \land \mathrm{divides}(e, n) \to \mathrm{divides}(e, d)\]
Extracting the computational content gives a program that computes the greatest common divisor of $m$ and $n$. The proof that it is correct is erased.
\end{example}

\section{Homotopy Type Theory (Brief Introduction)}\label{sec:dep-hott}

\begin{definition}[Univalence Axiom]\label{def:univalence}
The \emph{univalence axiom} states that equivalence of types is equivalent to equality of types:
\[(A \simeq B) \simeq (A =_{\mathcal{U}} B)\]
where $A \simeq B$ means there is an equivalence (bi-invertible map) between $A$ and $B$.
\end{definition}

\begin{insight}
The univalence axiom, proposed by Voevodsky, is a revolutionary principle: isomorphic types are equal. This means that if two types have the same structure, they are interchangeable in all contexts. This has profound implications for mathematics: structures that are ``the same'' can be identified, eliminating the need for tedious transport lemmas.
\end{insight}

\begin{historical}
Homotopy type theory (HoTT) emerged around 2010 from the observation that Martin-Löf type theory has a natural interpretation in homotopy theory: types are spaces, terms are points, identity types are path spaces, and dependent types are fibrations. The univalence axiom corresponds to a principle from homotopy theory. The HoTT book~\cite{hottbook} provides a comprehensive introduction.
\end{historical}

\section{Propositions as Types (Encoding Logic)}\label{sec:dep-logic}

\begin{definition}[Encoding Propositional Logic]\label{def:encode-logic}
In dependent type theory, propositions can be encoded as types:
\begin{align*}
  P \land Q &\defeq P \times Q \\
  P \lor Q &\defeq P + Q \\
  P \to Q &\defeq P \to Q \quad \text{(same as function type)} \\
  \neg P &\defeq P \to \mathbf{0} \\
  \top &\defeq \mathbf{1} \\
  \bot &\defeq \mathbf{0}
\end{align*}
\end{definition}

\begin{definition}[Encoding Predicate Logic]\label{def:encode-pred-logic}
Quantifiers are encoded using dependent types:
\begin{align*}
  \forall x : A.\,P(x) &\defeq \depFunTy{x}{A}{P(x)} \quad (\Pi\text{-type}) \\
  \exists x : A.\,P(x) &\defeq \depSigTy{x}{A}{P(x)} \quad (\Sigma\text{-type})
\end{align*}
\end{definition}

\begin{example}[De Morgan's Laws]\label{ex:de-morgan}
One direction of De Morgan's law is provable:
\[\neg(P \lor Q) \to \neg P \land \neg Q\]
is inhabited by $\lambda f.\,(\lambda p.\,f(\mathrm{inl}(p)), \lambda q.\,f(\mathrm{inr}(q)))$.

The converse $\neg P \land \neg Q \to \neg(P \lor Q)$ is also provable. However, $\neg(P \land Q) \to \neg P \lor \neg Q$ is \emph{not} provable in intuitionistic logic.
\end{example}

\section{Universe Polymorphism and Cumulativity}\label{sec:dep-universe-poly}

\begin{definition}[Cumulative Universes]\label{def:cumulative}
A universe hierarchy is \emph{cumulative} if $\mathcal{U}_i \subseteq \mathcal{U}_{i+1}$: every type in $\mathcal{U}_i$ is also a type in $\mathcal{U}_{i+1}$. This allows subsumption: if $A : \mathcal{U}_i$, then $A : \mathcal{U}_{i+1}$.
\end{definition}

\begin{definition}[Universe Polymorphism]\label{def:universe-poly-2}
In \emph{universe polymorphic} definitions, the universe level is a parameter:
\[\mathrm{id} : \forall \{i\} \to (A : \mathcal{U}_i) \to A \to A\]
This single definition works at all universe levels, avoiding the need to write separate definitions for each level.
\end{definition}

\section{Pattern Matching and Dependent Types}\label{sec:dep-pattern}

\begin{definition}[Dependent Pattern Matching]\label{def:dep-pattern}
In dependent type theory, pattern matching must respect type dependencies. When matching on a value of an indexed inductive type, the type of the result may be refined based on the constructor matched.
\end{definition}

\begin{example}[Vector Head]\label{ex:vec-head}
The function that takes the head of a non-empty vector:
\begin{verbatim}
  head : {n : Nat} -> Vec A (succ n) -> A
  head (vcons x xs) = x
\end{verbatim}
The type \texttt{Vec A (succ n)} ensures that the vector is non-empty, so the pattern match is exhaustive.
\end{example}

\begin{definition}[Coverage Checking]\label{def:coverage}
A pattern match is \emph{exhaustive} if every possible value of the matched type is covered by some pattern. In dependent type theory, coverage checking must account for type-level constraints: some patterns may be impossible due to type indices.
\end{definition}

