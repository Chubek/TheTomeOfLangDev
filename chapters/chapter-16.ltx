%% chapter-16.ltx — Lexical Structure
%% Part II: Programming Language Design

%% ============================================================
%% 16.1 Introduction
%% ============================================================
\section{Introduction}\label{sec:lexical-intro}

Before a program can be parsed, it must be decomposed into \emph{tokens}---
the atomic units of the language's syntax.  This decomposition is performed
by the \emph{lexical analyzer} (lexer, scanner), the first phase of every
compiler and interpreter.

Lexical analysis transforms a flat sequence of characters into a sequence of
tokens, each annotated with its kind (keyword, identifier, operator,
literal) and its attributes (the identifier's name, the literal's value).
This transformation is governed by the language's \emph{lexical grammar},
which is typically a regular grammar specified using regular expressions.

In this chapter, we develop the theory and practice of lexical analysis.
We begin with the fundamental concepts of tokens, lexemes, and patterns.
We then develop the theory of regular expressions and finite automata, which
underlies all lexical analysis.  We survey lexer generators (Lex, Flex,
re2c), discuss Unicode and internationalization, examine
whitespace-sensitive languages, and explore implementation techniques.

\begin{definition}[Lexical Analysis]\label{def:lexical-analysis}
  \emph{Lexical analysis} is the process of converting a sequence of
  characters (the source program) into a sequence of tokens.  Formally, it
  is a function:
  \[
    \texttt{lex} : \Sigma^* \to \texttt{Token}^*
  \]
  where $\Sigma$ is the character alphabet and $\texttt{Token}$ is the set
  of token types.
\end{definition}

%% ============================================================
%% 16.2 Tokens, Lexemes, and Patterns
%% ============================================================
\section{Tokens, Lexemes, and Patterns}\label{sec:tokens-lexemes-patterns}

\subsection{Fundamental Concepts}\label{sec:fundamental-concepts}

\begin{definition}[Token, Lexeme, Pattern]\label{def:token-lexeme-pattern}
  \begin{itemize}
    \item A \emph{token} is a category (type) of lexical unit: identifier,
      keyword, number, operator, etc.
    \item A \emph{lexeme} is the actual character sequence that matches a
      token: \texttt{x}, \texttt{while}, \texttt{42}, \texttt{+}.
    \item A \emph{pattern} is the rule that describes the set of lexemes
      that belong to a token: the regular expression that defines what
      counts as an identifier, a number, etc.
  \end{itemize}
\end{definition}

\begin{example}[Tokens in C]\label{ex:tokens-c}
  For the C source text \texttt{int x = 42;}:
  \begin{table}[H]
    \centering
    \begin{tabular}{lll}
      \hline
      \textbf{Token} & \textbf{Lexeme} & \textbf{Pattern} \\
      \hline
      \texttt{KEYWORD} & \texttt{int} & \texttt{"int"} \\
      \texttt{IDENTIFIER} & \texttt{x} & \texttt{[a-zA-Z\_][a-zA-Z0-9\_]*} \\
      \texttt{ASSIGN} & \texttt{=} & \texttt{"="} \\
      \texttt{NUMBER} & \texttt{42} & \texttt{[0-9]+} \\
      \texttt{SEMICOLON} & \texttt{;} & \texttt{";"} \\
      \hline
    \end{tabular}
  \end{table}
\end{example}

\subsection{Token Classification}\label{sec:token-classification}

Tokens are typically classified into the following categories:

\begin{enumerate}
  \item \textbf{Keywords}: Reserved words with special meaning
    (\texttt{if}, \texttt{while}, \texttt{return}).
  \item \textbf{Identifiers}: User-defined names for variables, functions,
    types, etc.
  \item \textbf{Literals}: Constant values (integer, floating-point,
    string, character, boolean).
  \item \textbf{Operators}: Symbols that denote operations (\texttt{+},
    \texttt{*}, \texttt{==}, \texttt{!}).
  \item \textbf{Punctuation}: Structural symbols (\texttt{(}, \texttt{)},
    \texttt{\{}, \texttt{\}}, \texttt{;}, \texttt{,}).
  \item \textbf{Whitespace}: Spaces, tabs, newlines (usually discarded, but
    significant in some languages).
  \item \textbf{Comments}: Text ignored by the compiler (line comments,
    block comments).
\end{enumerate}

\subsection{The Maximal Munch Principle}\label{sec:maximal-munch}

\begin{definition}[Maximal Munch]\label{def:maximal-munch}
  The \emph{maximal munch} (longest match) principle states that the lexer
  should always consume the longest possible lexeme at each position.  If
  two patterns match the same length, the one listed first (or with higher
  priority) wins.
\end{definition}

\begin{example}[Maximal Munch]\label{ex:maximal-munch}
  Given the source text \texttt{>=}, the lexer should produce a single
  \texttt{GEQ} token, not two tokens \texttt{GT} and \texttt{EQ}.  Given
  \texttt{intx}, the lexer should produce a single \texttt{IDENTIFIER}
  token \texttt{intx}, not \texttt{KEYWORD(int)} followed by
  \texttt{IDENTIFIER(x)}.
\end{example}

\Cref{fig:visual-16} shows the competing token boundaries for
\texttt{intx}.

