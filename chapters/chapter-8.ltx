%% chapter-8.ltx — The Untyped Lambda Calculus
%%

The lambda calculus, invented by Alonzo Church in the 1930s, is the oldest and most fundamental model of computation. Despite its extreme simplicity---it has only variables, abstraction, and application---it is Turing-complete: it can express every computable function. The lambda calculus is the theoretical foundation of all functional programming languages, and its concepts (binding, substitution, reduction) pervade the theory of programming languages.

This chapter develops the untyped lambda calculus in full: its syntax, alpha-equivalence, beta-reduction, Church encodings of data, fixed-point combinators, the Church--Rosser theorem, undecidability results, and implementation techniques using De Bruijn indices.

\section{Syntax}\label{sec:lambda-syntax}

\begin{definition}[Lambda Terms]\label{def:lambda-terms}
The set $\Lambda$ of \emph{lambda terms} (or $\lambda$-terms) is defined inductively by the grammar:
\begin{grammar}{Lambda Terms}
e & \longrightarrow x \mid \lambda x.\,e \mid e_1\;e_2
\end{grammar}
where $x$ ranges over a countably infinite set of \emph{variables} $\mathrm{Var} = \{x, y, z, \ldots\}$.
\end{definition}

The three forms of terms are:
\begin{itemize}
  \item $x$ --- a \emph{variable} (reference to a bound parameter)
  \item $\lambda x.\,e$ --- an \emph{abstraction} (anonymous function with parameter $x$ and body $e$)
  \item $e_1\;e_2$ --- an \emph{application} (applying function $e_1$ to argument $e_2$)
\end{itemize}

\begin{definition}[Free and Bound Variables]\label{def:lambda-free-bound}
The set of \emph{free variables} $\freeset{e}$ of a term $e$ is defined recursively:
\begin{align*}
  \freeset{x} &= \{x\} \\
  \freeset{\lambda x.\,e} &= \freeset{e} \setminus \{x\} \\
  \freeset{e_1\;e_2} &= \freeset{e_1} \cup \freeset{e_2}
\end{align*}
A variable is \emph{bound} in $e$ if it occurs in $e$ but is not free. The set of all variables occurring in $e$ is $\mathrm{var}(e) = \freeset{e} \cup \boundset{e}$.
\end{definition}

\begin{definition}[Closed Terms]\label{def:closed-terms}
A lambda term is \emph{closed} (or a \emph{combinator}) if it has no free variables: $\freeset{e} = \emptyset$.
\end{definition}

\begin{example}[Example Terms]\label{ex:lambda-examples}
\begin{itemize}
  \item $\lambda x.\,x$ --- the identity function (closed)
  \item $\lambda x.\,\lambda y.\,x$ --- the constant function (closed)
  \item $\lambda x.\,x\;y$ --- a function that applies its argument to $y$ (free variable: $y$)
  \item $(\lambda x.\,x\;x)(\lambda x.\,x\;x)$ --- the self-application combinator $\Omega$ (closed)
\end{itemize}
\end{example}

\section{Alpha-Equivalence}\label{sec:lambda-alpha}

The names of bound variables are irrelevant: $\lambda x.\,x$ and $\lambda y.\,y$ denote the same function. This is formalized by $\alpha$-equivalence.

\begin{definition}[Alpha-Equivalence]\label{def:alpha-equiv}
$\alpha$-equivalence is the least equivalence relation $\equiv_\alpha$ on lambda terms such that:
\begin{itemize}
  \item $x \equiv_\alpha x$
  \item If $e_1 \equiv_\alpha e_1'$ and $e_2 \equiv_\alpha e_2'$, then $e_1\;e_2 \equiv_\alpha e_1'\;e_2'$
  \item $\lambda x.\,e_1 \equiv_\alpha \lambda y.\,e_2$ if $e_1[z/x] \equiv_\alpha e_2[z/y]$ for some fresh $z$ (not free in $e_1$ or $e_2$)
\end{itemize}
\end{definition}

\begin{definition}[Barendregt Convention]\label{def:barendregt}
We adopt the \emph{Barendregt convention}: bound variables are chosen to be distinct from each other and from all free variables. This avoids the need for explicit $\alpha$-conversion during substitution.
\end{definition}

From now on, we identify terms up to $\alpha$-equivalence and write $=$ instead of $\equiv_\alpha$.

\section{Substitution}\label{sec:lambda-substitution}

\begin{definition}[Capture-Avoiding Substitution]\label{def:substitution}
The \emph{capture-avoiding substitution} $\subst{e_1}{x}{e_2}$ (replace free occurrences of $x$ in $e_1$ with $e_2$) is defined recursively:
\begin{align*}
  \subst{x}{x}{e_2} &= e_2 \\
  \subst{y}{x}{e_2} &= y \quad \text{if } y \neq x \\
  \subst{e_1\;e_2}{x}{e_3} &= \subst{e_1}{x}{e_3}\;\subst{e_2}{x}{e_3} \\
  \subst{\lambda x.\,e_1}{x}{e_2} &= \lambda x.\,e_1 \quad \text{(}x\text{ is bound)} \\
  \subst{\lambda y.\,e_1}{x}{e_2} &= \lambda y.\,\subst{e_1}{x}{e_2} \quad \text{if } y \neq x \text{ and } y \notin \freeset{e_2} \\
  \subst{\lambda y.\,e_1}{x}{e_2} &= \lambda z.\,\subst{\subst{e_1}{y}{z}}{x}{e_2} \quad \text{if } y \neq x \text{ and } y \in \freeset{e_2}
\end{align*}
where $z$ is fresh in the last clause.
\end{definition}

\begin{caution}
The last clause of the substitution definition handles \emph{variable capture}. Without renaming, substituting $y$ for $x$ in $\lambda y.\,x$ would yield $\lambda y.\,y$, which changes the meaning of the term (the $y$ in the body becomes bound). The renaming to a fresh variable $z$ avoids this.
\end{caution}

\section{Beta-Reduction}\label{sec:lambda-beta}

\begin{definition}[Beta-Reduction]\label{def:beta-reduction}
\emph{Beta-reduction} is the fundamental computation rule of the lambda calculus:
\[(\lambda x.\,e_1)\;e_2 \longrightarrow_\beta \subst{e_1}{x}{e_2}\]
The term $(\lambda x.\,e_1)\;e_2$ is called a \emph{beta-redex} (reducible expression), and $\subst{e_1}{x}{e_2}$ is its \emph{contractum}.
\end{definition}

\begin{definition}[Reduction Relations]\label{def:reduction-relations}
We define several reduction relations:
\begin{itemize}
  \item \emph{One-step beta-reduction} $e \stepsto e'$: reduce one beta-redex anywhere in $e$
  \item \emph{Multi-step beta-reduction} $e \multistepsto e'$: zero or more beta-reductions
  \item \emph{Beta-conversion} $e =_\beta e'$: $e \multistepsto e''$ and $e' \multistepsto e''$ for some $e''$ (joinability)
\end{itemize}
\end{definition}

\begin{definition}[Reduction Strategies]\label{def:reduction-strategies}
Different strategies choose which redex to reduce:
\begin{itemize}
  \item \emph{Normal order}: reduce the leftmost-outermost redex first
  \item \emph{Applicative order}: reduce the leftmost-innermost redex first (call-by-value)
  \item \emph{Call-by-name}: reduce the leftmost-outermost redex, but do not reduce under lambdas
\end{itemize}
\end{definition}

\begin{example}[Beta-Reduction Examples]\label{ex:beta-examples}
\begin{align*}
  (\lambda x.\,x)\;y &\stepsto y \\
  (\lambda x.\,\lambda y.\,x)\;a\;b &\stepsto (\lambda y.\,a)\;b \stepsto a \\
  (\lambda x.\,x\;x)(\lambda x.\,x\;x) &\stepsto (\lambda x.\,x\;x)(\lambda x.\,x\;x) \stepsto \cdots \quad \text{(diverges!)}
\end{align*}
The last example is $\Omega$, the simplest divergent term.
\end{example}

\section{Church Numerals and Data Encoding}\label{sec:lambda-church}

The lambda calculus has no built-in data types. Instead, data is \emph{encoded} using functions. This remarkable idea, due to Church, shows that functions are sufficient to represent all data.

\begin{definition}[Church Numerals]\label{def:church-numerals}
The \emph{Church numeral} for $n \in \mathbb{N}$ is:
\[\overline{n} = \lambda f.\,\lambda x.\,f^n(x)\]
That is:
\begin{align*}
  \overline{0} &= \lambda f.\,\lambda x.\,x \\
  \overline{1} &= \lambda f.\,\lambda x.\,f(x) \\
  \overline{2} &= \lambda f.\,\lambda x.\,f(f(x)) \\
  \overline{3} &= \lambda f.\,\lambda x.\,f(f(f(x)))
\end{align*}
\end{definition}

\begin{definition}[Arithmetic on Church Numerals]\label{def:church-arith}
\begin{align*}
  \mathrm{succ} &= \lambda n.\,\lambda f.\,\lambda x.\,f\;(n\;f\;x) \\
  \mathrm{plus} &= \lambda m.\,\lambda n.\,\lambda f.\,\lambda x.\,m\;f\;(n\;f\;x) \\
  \mathrm{mult} &= \lambda m.\,\lambda n.\,\lambda f.\,m\;(n\;f) \\
  \mathrm{exp} &= \lambda m.\,\lambda n.\,n\;m
\end{align*}
\end{definition}

\begin{example}[Verifying Addition]\label{ex:church-plus}
$\mathrm{plus}\;\overline{2}\;\overline{3} = (\lambda m.\,\lambda n.\,\lambda f.\,\lambda x.\,m\;f\;(n\;f\;x))\;\overline{2}\;\overline{3}$
$\multistepsto \lambda f.\,\lambda x.\,\overline{2}\;f\;(\overline{3}\;f\;x)$
$\multistepsto \lambda f.\,\lambda x.\,f(f(f(f(f(x)))))$
$= \overline{5}$
\end{example}

\begin{definition}[Church Booleans]\label{def:church-booleans}
\begin{align*}
  \mathrm{true} &= \lambda x.\,\lambda y.\,x \\
  \mathrm{false} &= \lambda x.\,\lambda y.\,y \\
  \mathrm{and} &= \lambda p.\,\lambda q.\,p\;q\;p \\
  \mathrm{or} &= \lambda p.\,\lambda q.\,p\;p\;q \\
  \mathrm{not} &= \lambda p.\,p\;\mathrm{false}\;\mathrm{true} \\
  \mathrm{iszero} &= \lambda n.\,n\;(\lambda x.\,\mathrm{false})\;\mathrm{true}
\end{align*}
\end{definition}

\begin{definition}[Church Pairs]\label{def:church-pairs}
\begin{align*}
  \mathrm{pair} &= \lambda x.\,\lambda y.\,\lambda f.\,f\;x\;y \\
  \mathrm{fst} &= \lambda p.\,p\;(\lambda x.\,\lambda y.\,x) \\
  \mathrm{snd} &= \lambda p.\,p\;(\lambda x.\,\lambda y.\,y)
\end{align*}
\end{definition}

\begin{definition}[Church Lists]\label{def:church-lists}
Lists can be encoded as right folds:
\begin{align*}
  \mathrm{nil} &= \lambda c.\,\lambda n.\,n \\
  \mathrm{cons} &= \lambda h.\,\lambda t.\,\lambda c.\,\lambda n.\,c\;h\;(t\;c\;n)
\end{align*}
\end{definition}

\section{Fixed-Point Combinators}\label{sec:lambda-fixed-points}

\begin{definition}[Fixed-Point Combinator]\label{def:fixed-point-combinator}
A \emph{fixed-point combinator} is a closed term $Y$ such that for every term $F$:
\[Y\;F =_\beta F\;(Y\;F)\]
\end{definition}

\begin{definition}[Curry's Fixed-Point Combinator]\label{def:curry-Y}
\[Y = \lambda f.\,(\lambda x.\,f\;(x\;x))\;(\lambda x.\,f\;(x\;x))\]
\end{definition}

\begin{proof}[Proof that $Y$ is a fixed-point combinator]
\begin{align*}
  Y\;F &= (\lambda f.\,(\lambda x.\,f\;(x\;x))\;(\lambda x.\,f\;(x\;x)))\;F \\
  &\stepsto (\lambda x.\,F\;(x\;x))\;(\lambda x.\,F\;(x\;x)) \\
  &\stepsto F\;((\lambda x.\,F\;(x\;x))\;(\lambda x.\,F\;(x\;x))) \\
  &= F\;(Y\;F)
\end{align*}
\end{proof}

\begin{definition}[Turing's Fixed-Point Combinator]\label{def:turing-Theta}
\[\Theta = (\lambda x.\,\lambda y.\,y\;(x\;x\;y))\;(\lambda x.\,\lambda y.\,y\;(x\;x\;y))\]
\end{definition}

\begin{insight}
The existence of fixed-point combinators means that the untyped lambda calculus supports \emph{recursion} without any built-in recursion construct. Any recursive function $f(x) = F(f, x)$ can be expressed as $Y\;F$, where $F$ is a term that takes the function itself as an argument. This is how recursive functions are defined in the pure lambda calculus.
\end{insight}

\begin{example}[Factorial via Fixed Point]\label{ex:factorial-Y}
The factorial function can be defined as:
\[\mathrm{fact} = Y\;(\lambda f.\,\lambda n.\,\mathrm{iszero}\;n\;\overline{1}\;(\mathrm{mult}\;n\;(f\;(\mathrm{pred}\;n))))\]
\end{example}

\section{The Church--Rosser Theorem}\label{sec:lambda-church-rosser}

\begin{definition}[Confluence]\label{def:confluence}
A reduction relation $\longrightarrow$ is \emph{confluent} (has the \emph{Church--Rosser property}) if whenever $e \multistepsto e_1$ and $e \multistepsto e_2$, there exists $e_3$ such that $e_1 \multistepsto e_3$ and $e_2 \multistepsto e_3$.

\begin{center}
\begin{tikzpicture}[node distance=2cm]
  \node (e) {$e$};
  \node[below left=of e] (e1) {$e_1$};
  \node[below right=of e] (e2) {$e_2$};
  \node[below=2.5cm of e] (e3) {$e_3$};
  
  \draw[->, thick] (e) -- node[left]{$\multistepsto$} (e1);
  \draw[->, thick] (e) -- node[right]{$\multistepsto$} (e2);
  \draw[->, thick, dashed] (e1) -- node[left]{$\multistepsto$} (e3);
  \draw[->, thick, dashed] (e2) -- node[right]{$\multistepsto$} (e3);
\end{tikzpicture}
\end{center}
\end{definition}

\begin{theorem}[Church--Rosser Theorem]\label{thm:church-rosser}
Beta-reduction in the untyped lambda calculus is confluent.
\end{theorem}

\begin{proof}[Proof sketch]
The standard proof uses the method of \emph{parallel reduction}. Define a parallel reduction relation $\Longrightarrow$ that allows reducing multiple non-overlapping redexes simultaneously. Prove that $\Longrightarrow$ satisfies the \emph{diamond property}: if $e \Longrightarrow e_1$ and $e \Longrightarrow e_2$, there exists $e_3$ with $e_1 \Longrightarrow e_3$ and $e_2 \Longrightarrow e_3$. Then show that the transitive closure of $\Longrightarrow$ equals $\multistepsto$, and that the diamond property lifts to confluence.
\end{proof}

\begin{corollary}[Uniqueness of Normal Forms]\label{cor:unique-nf}
If a lambda term has a normal form, it is unique (up to $\alpha$-equivalence).
\end{corollary}

\begin{proof}
If $e \multistepsto n_1$ and $e \multistepsto n_2$ where $n_1$ and $n_2$ are normal forms, then by confluence there exists $n_3$ with $n_1 \multistepsto n_3$ and $n_2 \multistepsto n_3$. Since $n_1$ and $n_2$ are normal forms, $n_1 = n_3 = n_2$.
\end{proof}

\begin{definition}[Normalizing Terms]\label{def:normalizing}
\begin{itemize}
  \item A term is \emph{strongly normalizing} (SN) if every reduction sequence from it terminates.
  \item A term is \emph{weakly normalizing} (WN) if there exists at least one terminating reduction sequence.
  \item A term is in \emph{normal form} if it contains no beta-redexes.
\end{itemize}
\end{definition}

\section{Undecidability of Normalization}\label{sec:lambda-undecidability}

\begin{theorem}[Undecidability of Normalization]\label{thm:undecidable-norm}
There is no algorithm that, given an arbitrary lambda term $e$, determines whether $e$ has a normal form.
\end{theorem}

\begin{proof}[Proof sketch]
By reduction from the halting problem. Given a Turing machine $M$ and input $w$, one can construct a lambda term $e_{M,w}$ such that $e_{M,w}$ has a normal form if and only if $M$ halts on $w$. Since the halting problem is undecidable, so is normalization.
\end{proof}

\begin{theorem}[Undecidability of Equivalence]\label{thm:undecidable-equiv}
There is no algorithm that, given lambda terms $e_1$ and $e_2$, determines whether $e_1 =_\beta e_2$.
\end{theorem}

\begin{proof}
If $e_1 =_\beta e_2$ were decidable, we could decide whether $e$ has a normal form by checking $e =_\beta \Omega$ (where $\Omega$ has no normal form). But normalization is undecidable.
\end{proof}

\section{De Bruijn Indices}\label{sec:lambda-debruijn}

Implementation of the lambda calculus requires handling variable names and $\alpha$-conversion. De Bruijn indices eliminate names entirely.

\begin{definition}[De Bruijn Indices]\label{def:debruijn}
In the \emph{De Bruijn representation}, variables are replaced by natural numbers indicating the number of enclosing lambdas between the variable and its binder:
\begin{grammar}{De Bruijn Terms}
e & \longrightarrow n \mid \lambda\,e \mid e_1\;e_2
\end{grammar}
where $n \in \mathbb{N}$ (with $0$ referring to the innermost enclosing lambda).
\end{definition}

\begin{example}[Named vs. De Bruijn]\label{ex:debruijn-example}
\begin{align*}
  \lambda x.\,\lambda y.\,x &= \lambda\,\lambda\,1 \\
  \lambda x.\,\lambda y.\,y &= \lambda\,\lambda\,0 \\
  \lambda x.\,(\lambda y.\,x\;y)\;x &= \lambda\,(\lambda\,1\;0)\;0
\end{align*}
\end{example}

\begin{definition}[Substitution with De Bruijn Indices]\label{def:debruijn-subst}
Substitution $\subst{e_1}{n}{e_2}$ with De Bruijn indices requires \emph{shifting} to adjust indices when moving under lambdas:
\begin{align*}
  \subst{k}{n}{e_2} &= \begin{cases} e_2 & \text{if } k = n \\ k & \text{if } k < n \\ k - 1 & \text{if } k > n \end{cases} \\
  \subst{e_1\;e_2}{n}{e_3} &= \subst{e_1}{n}{e_3}\;\subst{e_2}{n}{e_3} \\
  \subst{\lambda\,e_1}{n}{e_2} &= \lambda\,\subst{e_1}{n+1}{\Uparrow^1_0(e_2)}
\end{align*}
where $\Uparrow^k_c$ shifts free variables $\geq c$ up by $k$.
\end{definition}

\begin{insight}
De Bruijn indices eliminate $\alpha$-equivalence entirely: two terms are $\alpha$-equivalent if and only if they are syntactically identical in De Bruijn form. This makes implementation simpler and more efficient. The trade-off is that terms become harder to read and substitution requires index shifting.
\end{insight}

\section{Implementing the Lambda Calculus}\label{sec:lambda-impl}

\subsection{Nameless Representation}\label{sec:lambda-nameless}

Beyond De Bruijn indices, several other nameless representations exist:

\begin{definition}[Locally Nameless Representation]\label{def:locally-nameless}
In the \emph{locally nameless} representation, bound variables are represented by De Bruijn indices, but free variables retain their names. This combines the advantages of both approaches:
\begin{itemize}
  \item $\alpha$-equivalence is syntactic equality for bound variables
  \item Free variables are readable and easy to work with
  \item Substitution only needs to handle free variables (no shifting needed for them)
\end{itemize}
\end{definition}

\begin{definition}[Higher-Order Abstract Syntax]\label{def:hoas}
In \emph{higher-order abstract syntax} (HOAS), binders are represented using the binding constructs of the meta-language. For example, in a logical framework:
\[\mathrm{lam} : (\mathrm{term} \to \mathrm{term}) \to \mathrm{term}\]
A lambda term $\lambda x.\,e$ is represented as $\mathrm{lam}(\lambda x.\,\sembrack{e})$, where the meta-language lambda handles variable binding.
\end{definition}

\begin{insight}
HOAS elegantly handles $\alpha$-equivalence and substitution ``for free'' by delegating to the meta-language. However, it makes certain operations (like examining the body of a lambda) difficult or impossible. The locally nameless representation offers a practical middle ground.
\end{insight}

\section{Extensions of the Lambda Calculus}\label{sec:lambda-extensions}

\subsection{Call-by-Value Lambda Calculus}\label{sec:lambda-cbv}

In the call-by-value lambda calculus, beta-reduction only applies when the argument is a value:

\begin{definition}[Values and CBV Reduction]\label{def:cbv}
The \emph{values} are variables and abstractions: $v ::= x \mid \lambda x.\,e$. The reduction rule is:
\[(\lambda x.\,e)\;v \longrightarrow \subst{e}{x}{v} \quad \text{only when the argument is a value}\]
\end{definition}

\begin{definition}[Evaluation Contexts for CBV]\label{def:cbv-contexts}
The evaluation contexts for call-by-value are:
\[\mathcal{E} ::= \hole \mid \mathcal{E}\;e \mid v\;\mathcal{E}\]
This specifies a left-to-right, call-by-value evaluation order.
\end{definition}

\subsection{Call-by-Name Lambda Calculus}\label{sec:lambda-cbn}

In call-by-name, beta-reduction applies regardless of whether the argument is a value:
\[(\lambda x.\,e)\;e' \longrightarrow \subst{e}{x}{e'} \quad \text{for any } e'\]

\begin{theorem}[Standardization]\label{thm:standardization}
If a lambda term has a normal form, then normal-order reduction (leftmost-outermost) will find it.
\end{theorem}

\subsection{Let Expressions}\label{sec:lambda-let}

\emph{Let expressions} provide named bindings:
\[\mathrm{let}\;x = e_1\;\mathrm{in}\;e_2 \equiv (\lambda x.\,e_2)\;e_1\]

Let expressions can be given two different semantics:
\begin{itemize}
  \item \textbf{Let as abbreviation}: $\mathrm{let}\;x = e_1\;\mathrm{in}\;e_2$ reduces by substituting $e_1$ for $x$ in $e_2$ (call-by-name)
  \item \textbf{Let as sequencing}: $\mathrm{let}\;x = e_1\;\mathrm{in}\;e_2$ evaluates $e_1$ first, then substitutes the result (call-by-value)
\end{itemize}

\section{The Böhm Tree}\label{sec:lambda-bohm}

\begin{definition}[Böhm Tree]\label{def:bohm-tree}
The \emph{Böhm tree} of a lambda term $M$ is a (possibly infinite) tree that represents the ``observable behavior'' of $M$:
\begin{itemize}
  \item If $M$ has a head normal form $\lambda x_1 \ldots x_n.\,y\;M_1 \ldots M_m$, the Böhm tree has root labeled $y$ with children being the Böhm trees of $M_1, \ldots, M_m$
  \item If $M$ has no head normal form, the Böhm tree is $\bot$
\end{itemize}
\end{definition}

\begin{example}[Böhm Trees]\label{ex:bohm-trees}
\begin{itemize}
  \item The Böhm tree of $\lambda x.\,x$ is $\lambda x.\,x$
  \item The Böhm tree of $\Omega$ is $\bot$ (it has no head normal form)
  \item The Böhm tree of $Y = \lambda f.\,(\lambda x.\,f(x\;x))(\lambda x.\,f(x\;x))$ is $\lambda f.\,f(f(f(\cdots)))$ (an infinite tree)
\end{itemize}
\end{example}

\section{Exercises}\label{sec:lambda-exercises}

\begin{enumerate}
  \item Compute the normal form of $(\lambda x.\,\lambda y.\,x)\;(\lambda z.\,z)\;(\lambda z.\,z\;z)$.
  
  \item Show that $\mathrm{plus}\;\overline{m}\;\overline{n} =_\beta \overline{m+n}$ for arbitrary $m, n$.
  
  \item Define a predecessor function $\mathrm{pred}$ on Church numerals.
  
  \item Prove that $Y\;F =_\beta F\;(Y\;F)$ for any term $F$.
  
  \item Show that $\Omega = (\lambda x.\,x\;x)(\lambda x.\,x\;x)$ has no normal form.
  
  \item Convert $\lambda x.\,(\lambda y.\,x\;y)\;(\lambda z.\,z)$ to De Bruijn form.
  
  \item Define a Church encoding of natural number comparison ($\leq$).
  
  \item Prove the Church--Rosser theorem for parallel reduction.
\end{enumerate}

\section{Chapter Summary}\label{sec:lambda-summary}

We have developed the untyped lambda calculus:
\begin{itemize}
  \item The syntax consists of variables, abstractions, and applications.
  \item Alpha-equivalence identifies terms that differ only in bound variable names.
  \item Beta-reduction is the fundamental computation rule.
  \item Church encodings represent all data (numbers, booleans, pairs, lists) as functions.
  \item Fixed-point combinators enable recursion.
  \item The Church--Rosser theorem guarantees that normal forms are unique.
  \item Normalization is undecidable: there is no algorithm to determine if a term has a normal form.
  \item De Bruijn indices provide a nameless representation that simplifies implementation.
\end{itemize}

The untyped lambda calculus is Turing-complete but lacks type safety. In the next chapter, we introduce types, which restrict the terms we can write but guarantee termination (strong normalization) and prevent runtime errors.
