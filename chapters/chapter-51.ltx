\hline
\end{tabular}
\end{table}

\subsection{Coercion Erasure}\label{sec:coercion-erasure}

Some coercions are \emph{erasable}: they do not change the runtime representation and can be compiled to no-ops.

\begin{example}[Erasure of structural coercions]\label{ex:coercion-erasure}
\begin{verbatim}
  // If Dog and Animal have the same memory layout:
  // (Dog is Animal with extra fields at the end)
  let a : Animal = dog  // width subtyping
  // No coercion needed: the Dog layout is compatible with Animal
  // The coercion is erased (compiled to nothing)
\end{verbatim}
\end{example}

\begin{definition}[Erasure Coercion]\label{def:erasure-coercion}
A coercion $c : \tau_1 \to \tau_2$ is \emph{erasable} if $\tau_1$ and $\tau_2$ have the same runtime representation. Erasure coercions are compiled to no-ops.
\end{definition}

