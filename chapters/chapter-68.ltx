\section{Introduction}\label{sec:ai-theory-intro}

Abstract interpretation, introduced by Cousot and Cousot~\cite{cousot1977abstract} in 1977, is a general theory of sound approximation of program semantics. It provides a rigorous mathematical framework for designing, implementing, and reasoning about program analyses. Where dataflow analysis (Chapter~\ref{sec:dataflow-intro}) provides a practical framework for specific analyses, abstract interpretation provides the theoretical foundation that explains \emph{why} these analyses work and \emph{how} to design new ones.

The central idea is simple yet profound: to analyze a program, we replace its concrete semantics (the actual set of possible behaviors) with an \emph{abstract semantics} that over-approximates the concrete one. The abstract semantics operates on an \emph{abstract domain} that is simpler than the concrete domain, making the analysis tractable while preserving soundness.

\section{Concrete and Abstract Semantics}\label{sec:concrete-abstract}

\subsection{The Concrete Semantics}\label{sec:concrete-semantics}

The \emph{concrete semantics} of a program describes its actual behavior---the set of all possible executions, the states reached at each program point, the values computed.

\begin{definition}[Collecting Semantics]\label{def:collecting}
The \textbf{collecting semantics} of a program assigns to each program point $p$ the set of all concrete states that can arise at $p$ during any execution:
\[
\mathit{CS}(p) = \{\sigma \mid \exists \text{ execution reaching } p \text{ in state } \sigma\}
\]
\end{definition}

The collecting semantics is the \emph{complete} information about the program's behavior. It is generally uncomputable (it subsumes the halting problem), but it serves as the reference point for all approximations.

\begin{definition}[Concrete Domain]\label{def:concrete-domain}
The \textbf{concrete domain} is the complete lattice $(\mathcal{P}(\Sigma), \subseteq)$ where $\Sigma$ is the set of all concrete states (variable valuations, heap configurations, etc.) and $\mathcal{P}(\Sigma)$ is its powerset.
\end{definition}

\subsection{The Abstract Semantics}\label{sec:abstract-semantics}

The \emph{abstract semantics} replaces concrete states with \emph{abstract elements} from a simpler domain.

\begin{definition}[Abstract Domain]\label{def:abstract-domain}
An \textbf{abstract domain} is a complete lattice $(\mathcal{A}, \sqsubseteq)$ whose elements represent sets of concrete states. Each abstract element $a \in \mathcal{A}$ is an \emph{abstraction} of some set of concrete states $\gamma(a) \subseteq \Sigma$.
\end{definition}

\begin{example}[Sign Domain]\label{ex:sign-domain}
The \textbf{sign domain} abstracts integers to their sign:
\[
\mathcal{A}_{\mathit{sign}} = \{\bot, -, 0, +, \top\}
\]
with the ordering $\bot \sqsubseteq -, 0 \sqsubseteq +$ ... wait, actually:
\[
\bot \sqsubseteq - \sqsubseteq \top, \quad \bot \sqsubseteq 0 \sqsubseteq \top, \quad \bot \sqsubseteq + \sqsubseteq \top
\]
where $-, 0, +$ are pairwise incomparable. The concretization function maps:
\begin{itemize}
  \item $\gamma(-) = \{n \in \mathbb{Z} \mid n < 0\}$
  \item $\gamma(0) = \{0\}$
  \item $\gamma(+) = \{n \in \mathbb{Z} \mid n > 0\}$
  \item $\gamma(\top) = \mathbb{Z}$
  \item $\gamma(\bot) = \emptyset$
\end{itemize}
\end{example}

\section{Galois Connections}\label{sec:galois}

The relationship between the concrete and abstract domains is formalized through a \emph{Galois connection}.

\begin{definition}[Galois Connection]\label{def:galois}
A \textbf{Galois connection} between two complete lattices $(C, \leq_C)$ and $(A, \leq_A)$ is a pair of functions $\alpha : C \to A$ (the \textbf{abstraction function}) and $\gamma : A \to C$ (the \textbf{concretization function}) such that for all $c \in C$ and $a \in A$:
\[
\alpha(c) \leq_A a \iff c \leq_C \gamma(a)
\]
We write this as $(\alpha, \gamma) : C \rightleftarrows A$.
\end{definition}

The Galois connection ensures that:
\begin{itemize}
  \item $\alpha$ and $\gamma$ are \emph{monotone}: $c_1 \leq_C c_2 \implies \alpha(c_1) \leq_A \alpha(c_2)$.
  \item $\gamma \circ \alpha$ is an \emph{extensive} closure: $c \leq_C \gamma(\alpha(c))$ for all $c$.
  \item $\alpha \circ \gamma$ is \emph{reductive}: $\alpha(\gamma(a)) \leq_A a$ for all $a$.
  \item $\alpha \circ \gamma \circ \alpha = \alpha$ and $\gamma \circ \alpha \circ \gamma = \gamma$.
\end{itemize}

\begin{definition}[Galois Insertion]\label{def:galois-insertion}
A \textbf{Galois insertion} is a Galois connection where $\alpha \circ \gamma = \mathit{id}_A$ (i.e., $\alpha(\gamma(a)) = a$ for all $a \in A$). This means every abstract element is the best abstraction of some concrete set---no abstract element is ``redundant.''
\end{definition}

\begin{example}[Sign Galois Connection]\label{ex:sign-galois}
For the sign domain:
\begin{align*}
  \alpha(S) &= \begin{cases}
    \bot & \text{if } S = \emptyset \\
    - & \text{if } S \subseteq \{n < 0\} \text{ and } S \neq \emptyset \\
    0 & \text{if } S = \{0\} \\
    + & \text{if } S \subseteq \{n > 0\} \text{ and } S \neq \emptyset \\
    \top & \text{otherwise}
  \end{cases} \\
  \gamma(\bot) &= \emptyset \\
  \gamma(-) &= \{n \in \mathbb{Z} \mid n < 0\} \\
  \gamma(0) &= \{0\} \\
  \gamma(+) &= \{n \in \mathbb{Z} \mid n > 0\} \\
  \gamma(\top) &= \mathbb{Z}
\end{align*}
\end{example}

