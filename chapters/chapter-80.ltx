\section{Branch Prediction and Code Layout}\label{sec:branch-pred-layout}

\begin{definition}[Branch Prediction and Layout]\label{def:branch-pred-layout}
Modern processors predict branch directions based on history. Code layout affects prediction accuracy:
\begin{itemize}
  \item \textbf{Fall-through prediction}: Most processors predict conditional branches as \emph{not taken} (fall through). Placing the likely target as the fall-through improves prediction.
  \item \textbf{Branch target buffer} (BTB): The BTB stores the targets of recently taken branches. Placing targets at predictable addresses improves BTB hit rates.
  \item \textbf{Return address stack}: Function returns are predicted using a stack. Proper call/return structure ensures accurate prediction.
\end{itemize}
\end{definition}

\begin{definition}[Forward vs.\ Backward Branch Heuristic]\label{def:forward-backward}
The \textbf{forward/backward branch heuristic} predicts:
\begin{itemize}
  \item \textbf{Backward branches} (loop back-edges): Taken
  \item \textbf{Forward branches}: Not taken
\end{itemize}
Code layout should align with this heuristic: loop back-edges should be backward in the layout, and unlikely exits should branch forward.
\end{definition}

\section{Function Ordering}\label{sec:function-ordering}

\begin{definition}[Function Layout Optimization]\label{def:func-layout}
\textbf{Function layout optimization} determines the order of functions in the executable. Functions that call each other frequently should be placed close together to improve I-cache locality and reduce branch target distances.
\end{definition}

\begin{algorithm}[H]
\caption{Function Ordering by Call Graph Clustering}
\label{alg:func-ordering}
\begin{algorithmic}[1]
\Require Call graph $G$ with edge weights (call frequencies)
\ensure Ordered function list
\State Compute connected components of $G$ weighted by call frequency
\State Order components by total execution frequency (hottest first)
\ForAll{components $C$}
  \State Order functions within $C$ by call frequency (caller before callee)
\EndFor
\State Place functions in computed order
\end{algorithmic}
\end{algorithm}

