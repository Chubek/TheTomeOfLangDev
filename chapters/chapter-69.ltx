\section{Introduction}\label{sec:abstract-domains-intro}

The precision of an abstract interpretation is determined primarily by the choice of \emph{abstract domain}. The abstract domain defines what properties of the program state can be expressed and tracked. A coarse domain (e.g., the sign domain) is fast but imprecise; a fine domain (e.g., the polyhedra domain) is precise but expensive. This chapter surveys the major abstract domains used in practice, from simple non-relational domains to sophisticated relational domains, and presents the domain combinators that allow building complex domains from simpler ones.

\section{Sign Domain}\label{sec:sign-domain}

The sign domain is the simplest non-trivial abstract domain for integer variables.

\begin{definition}[Sign Domain]\label{def:sign-domain}
The \textbf{sign domain} is the lattice:
\[
\mathcal{A}_{\mathit{sign}} = \{\bot, -, 0, +, \top\}
\]
with the ordering:
\begin{itemize}
  \item $\bot \sqsubseteq x$ for all $x$
  \item $x \sqsubseteq \top$ for all $x$
  \item $-, 0, +$ are pairwise incomparable
\end{itemize}
\end{definition}

\subsection{Abstract Operations}\label{sec:sign-ops}

The abstract operations for the sign domain are defined to be the best correct approximation of the concrete operations:

\begin{table}[htbp]
\centering
\begin{tabular}{c|ccccc}
$+^\sharp$ & $\bot$ & $-$ & $0$ & $+$ & $\top$ \\
\hline
$\bot$ & $\bot$ & $\bot$ & $\bot$ & $\bot$ & $\bot$ \\
$-$ & $\bot$ & $-$ & $-$ & $\top$ & $\top$ \\
$0$ & $\bot$ & $-$ & $0$ & $+$ & $\top$ \\
$+$ & $\bot$ & $\top$ & $+$ & $+$ & $\top$ \\
$\top$ & $\bot$ & $\top$ & $\top$ & $\top$ & $\top$ \\
\end{tabular}
\caption{Addition in the sign domain.}
\label{tab:sign-add}
\end{table}

\begin{table}[htbp]
\centering
\begin{tabular}{c|ccccc}
$\times^\sharp$ & $\bot$ & $-$ & $0$ & $+$ & $\top$ \\
\hline
$\bot$ & $\bot$ & $\bot$ & $\bot$ & $\bot$ & $\bot$ \\
$-$ & $\bot$ & $+$ & $0$ & $-$ & $\top$ \\
$0$ & $\bot$ & $0$ & $0$ & $0$ & $\top$ \\
$+$ & $\bot$ & $-$ & $0$ & $+$ & $\top$ \\
$\top$ & $\bot$ & $\top$ & $\top$ & $\top$ & $\top$ \\
\end{tabular}
\caption{Multiplication in the sign domain.}
\label{tab:sign-mul}
\end{table}

\section{Interval Domain}\label{sec:interval-domain}

The interval domain tracks the range of possible values for each variable.

\begin{definition}[Interval Domain]\label{def:interval-domain}
The \textbf{interval domain} is the lattice:
\[
\mathcal{A}_{\mathit{intv}} = \{[a, b] \mid a, b \in \mathbb{Z} \cup \{-\infty, +\infty\}, a \leq b\} \cup \{\bot\}
\]
with the ordering:
\[
[a_1, b_1] \sqsubseteq [a_2, b_2] \iff a_2 \leq a_1 \text{ and } b_1 \leq b_2
\]
(Note: smaller intervals are more precise, hence ``higher'' in the lattice.)
\end{definition}

\subsection{Abstract Operations}\label{sec:interval-ops}

\begin{definition}[Interval Arithmetic]\label{def:interval-arithmetic}
\begin{align*}
  [a_1, b_1] +^\sharp [a_2, b_2] &= [\max(-\infty, a_1 + a_2), \min(+\infty, b_1 + b_2)] \\
  [a_1, b_1] -^\sharp [a_2, b_2] &= [\max(-\infty, a_1 - b_2), \min(+\infty, b_1 - a_2)] \\
  [a_1, b_1] \sqcup [a_2, b_2] &= [\min(a_1, a_2), \max(b_1, b_2)] \\
  [a_1, b_1] \sqcap [a_2, b_2] &= [\max(a_1, a_2), \min(b_1, b_2)] \text{ (if valid, else } \bot)
\end{align*}
\end{definition}

\begin{example}[Interval Analysis]\label{ex:interval}
Consider:
\begin{verbatim}
  x = input();     // x ∈ [-∞, +∞]
  if (x > 0) {     // x ∈ [1, +∞]
    y = x + 1;     // y ∈ [2, +∞]
  } else {         // x ∈ [-∞, 0]
    y = x - 1;     // y ∈ [-∞, -1]
  }
  // y ∈ [-∞, +∞] (join of [2,+∞] and [-∞,-1])
\end{verbatim}
The interval domain captures the range of $x$ after the conditional but loses the correlation between $x$ and $y$.
\end{example}

\section{Powerset Domain}\label{sec:powerset-domain}

The powerset domain lifts any abstract domain to a domain of sets, enabling may-analysis (union) or must-analysis (intersection).

\begin{definition}[Powerset Domain]\label{def:powerset-domain}
Given an abstract domain $(A, \sqsubseteq)$, the \textbf{powerset domain} is $(\mathcal{P}(A), \sqsubseteq_{\mathcal{P}})$ where:
\begin{itemize}
  \item For may-analysis: $S_1 \sqsubseteq_{\mathcal{P}} S_2 \iff \forall x \in S_1, \exists y \in S_2: x \sqsubseteq y$
  \item For must-analysis: $S_1 \sqsubseteq_{\mathcal{P}} S_2 \iff \forall x \in S_2, \exists y \in S_1: y \sqsubseteq x$
\end{itemize}
\end{definition}

The powerset domain is used for set-based analyses like reaching definitions (where the abstract domain is the set of all definitions) and available expressions.

\section{Relational Domains}\label{sec:relational-domains}

Non-relational domains (sign, interval) track properties of individual variables independently. \emph{Relational domains} track relationships \emph{between} variables, enabling more precise analysis.

\subsection{Octagon Domain}\label{sec:octagon-domain}

\begin{definition}[Octagon Domain]\label{def:octagon-domain}
The \textbf{octagon domain} represents constraints of the form $\pm x_i \pm x_j \leq c$, where $x_i, x_j$ are program variables and $c$ is a constant. An octagon is a conjunction of such constraints.
\end{definition}

The name ``octagon'' comes from the geometric shape of the feasible region in two dimensions: the constraints $\pm x \pm y \leq c$ define an octagonal region.

\begin{example}[Octagon]\label{ex:octagon}
The constraint $x - y \leq 5$ means that $x$ is at most 5 more than $y$. Combined with $y - x \leq 3$, we get $-3 \leq x - y \leq 5$, meaning the difference between $x$ and $y$ is bounded.
\end{example}

\begin{definition}[Octagon Closure]\label{def:octagon-closure}
An octagon is \textbf{closed} (or \textbf{strongly closed}) if it contains all constraints that are implied by its existing constraints. Closure can be computed in $O(n^3)$ time using a shortest-path algorithm on the associated graph.
\end{definition}

\subsection{Polyhedra Domain}\label{sec:polyhedra-domain}

\begin{definition}[Polyhedra Domain]\label{def:polyhedra-domain}
The \textbf{polyhedra domain} represents arbitrary linear inequalities over program variables:
\[
\{a_1 x_1 + a_2 x_2 + \cdots + a_n x_n \leq c \mid a_i, c \in \mathbb{Q}\}
\]
An abstract element is a conjunction of such constraints, defining a convex polyhedron in $\mathbb{Q}^n$.
\end{definition}

The polyhedra domain, introduced by Cousot and Halbwachs~\cite{cousot1978automatic}, is the most expressive practical relational domain. It can express arbitrary linear relationships between variables.

\begin{example}[Polyhedra]\label{ex:polyhedra}
Consider:
\begin{verbatim}
  for (i = 0; i < n; i++) {
    j = n - i;
    // At this point: i >= 0, i < n, j = n - i, j > 0
  }
\end{verbatim}
The polyhedra domain can capture the invariant $i + j = n \wedge 0 \leq i < n \wedge 0 < j \leq n$, which the interval domain cannot express (it would give $i \in [0, n-1], j \in [1, n]$ independently).
\end{example}

\begin{definition}[Polyhedra Operations]\label{def:polyhedra-ops}
The key operations on polyhedra are:
\begin{itemize}
  \item \textbf{Intersection} (meet): Combine two polyhedra by conjoining their constraints.
  \item \textbf{Convex hull} (join): Compute the smallest polyhedron containing both.
  \item \textbf{Projection} (existential quantification): Eliminate a variable by Fourier--Motzkin elimination.
  \item \textbf{Widening}: Approximate an infinite ascending chain to ensure termination.
\end{itemize}
\end{definition}

\subsection{Complexity Comparison}\label{sec:domain-complexity}

\begin{table}[htbp]
\centering
\begin{tabular}{lccc}
\hline
\textbf{Domain} & \textbf{Precision} & \textbf{Join Cost} & \textbf{Space} \\
\hline
Sign & Low & $O(1)$ & $O(n)$ \\
Interval & Medium & $O(n)$ & $O(n)$ \\
Octagon & Medium-High & $O(n^3)$ & $O(n^2)$ \\
Polyhedra & High & $O(2^n)$ worst case & $O(n^2)$ constraints \\
\hline
\end{tabular}
\caption{Complexity comparison of abstract domains.}
\label{tab:domain-complexity}
\end{table}

\section{Heap Abstractions}\label{sec:heap-abstractions}

Analyzing programs with dynamic memory allocation requires abstracting the heap---the potentially unbounded collection of dynamically allocated objects.

\subsection{Shape Abstraction}\label{sec:shape-abstraction}

\begin{definition}[Shape Graph]\label{def:shape-graph}
A \textbf{shape graph} is an abstract representation of the heap where:
\begin{itemize}
  \item Nodes represent sets of concrete heap objects (summary nodes).
  \item Edges represent pointer fields.
  \item A distinguished ``shared'' flag indicates whether a node may be shared by multiple pointers.
\end{itemize}
\end{definition}

\subsection{Three-Valued Logic}\label{sec:three-valued}

TVLA (Three-Valued Logic Analyzer) uses \emph{three-valued logical structures} to represent heap configurations. Each predicate (e.g., ``$x$ points to $y$'') can be true, false, or \emph{unknown}, allowing the analysis to express uncertainty about the heap structure.

\subsection{Canonical Abstraction}\label{sec:canonical-abstraction}

\begin{definition}[Canonical Abstraction]\label{def:canonical-abs}
\textbf{Canonical abstraction} maps a concrete heap (a first-order structure) to an abstract structure by merging individuals that have the same values for a set of \emph{abstraction predicates}. The result is a bounded abstract structure that represents a potentially unbounded set of concrete heaps.
\end{definition}

\section{Domain Combiners}\label{sec:domain-combiners}

Complex abstract domains can be built by combining simpler ones using domain combinators.

\subsection{Reduced Product}\label{sec:reduced-product-comb}

\begin{definition}[Reduced Product]\label{def:reduced-product-comb}
The \textbf{reduced product} $A_1 \times_r A_2$ of two domains combines their information while performing \emph{reduction} to propagate information between components:
\[
\gamma(a_1, a_2) = \gamma_1(a_1) \cap \gamma_2(a_2)
\]
The reduction function $\rho : A_1 \times A_2 \to A_1 \times A_2$ tightens each component using information from the other.
\end{definition}

\begin{example}[Interval $\times$ Sign]\label{ex:interval-sign-product}
The reduced product of the interval and sign domains can represent both range and sign information. For example, the interval $[0, 5]$ combined with the sign $+$ gives the refined information: $x \in [1, 5]$ (since $x \geq 0$ and $x > 0$ implies $x \geq 1$ for integers).
\end{example}

\subsection{Tensor Product}\label{sec:tensor-product}

\begin{definition}[Tensor Product]\label{def:tensor-product}
The \textbf{tensor product} $A_1 \otimes A_2$ of two domains represents their \emph{independent combination}: each element is a pair $(a_1, a_2)$ with no reduction between components. It is less precise but cheaper than the reduced product.
\end{definition}

\subsection{Cardinal Product}\label{sec:cardinal-product}

\begin{definition}[Cardinal Product]\label{def:cardinal-product}
The \textbf{cardinal product} $A_1 \times_c A_2$ keeps pairs $(a_1, a_2)$ that represent the same concrete set: $\gamma_1(a_1) = \gamma_2(a_2)$. This is the most precise combination but may be difficult to compute.
\end{definition}

\begin{insight}
The choice of abstract domain is the most important design decision in building a static analyzer. Non-relational domains (sign, interval) are fast and sufficient for many applications. Relational domains (octagons, polyhedra) capture variable relationships essential for verifying numerical properties. Heap abstractions are needed for programs with dynamic data structures. Domain combinators allow building precisely the right level of precision for each application.
\end{insight}

\begin{historical}
The development of abstract domains has paralleled the growth of abstract interpretation itself. The sign and interval domains are among the earliest. The polyhedra domain was introduced by Cousot and Halbwachs in 1978~\cite{cousot1978automatic} for verifying timing properties of real-time programs. The octagon domain was introduced by Min\'e~\cite{mine2006octagon} (2006) as a practical compromise between intervals and polyhedra. The field continues to evolve with new domains for specific application areas: template polyhedra (Sankaranarayanan et al.), weighted polyhedra for cost analysis, and symbolic abstraction for combining with SMT solvers.
\end{historical}

\section{Template Polyhedra}\label{sec:template-polyhedra}

\emph{Template polyhedra} provide a practical compromise between octagons and full polyhedra.

\begin{definition}[Template Polyhedra]\label{def:template-polyhedra}
A \textbf{template polyhedron} is a polyhedron whose constraint normals are drawn from a fixed set (the ``template''). For example, the template $\{(1,0), (0,1), (1,1), (1,-1)\}$ gives the octagon domain.
\end{definition}

The advantage of template polyhedra is that join and widening can be computed efficiently (in time linear in the number of template directions), while still capturing important variable relationships.

\begin{definition}[Zones]\label{def:zones}
\textbf{Zones} are constraints of the form $x_i - x_j \leq c$. The zone domain is equivalent to the octagon domain restricted to difference constraints. Zones can be represented efficiently using difference-bound matrices (DBMs) and closed in $O(n^3)$ time.
\end{definition}

\section{Numerical Domains with Congruences}\label{sec:congruences}

\begin{definition}[Congruence Domain]\label{def:congruence}
The \textbf{congruence domain} tracks modular arithmetic properties: $x \equiv a \pmod{m}$. Combined with intervals, this gives the \emph{interval $+$ congruence} domain that can express properties like ``$x$ is even and $x \in [0, 100]$.''
\end{definition}

\section{Choosing the Right Domain}\label{sec:choosing-domain}

The choice of abstract domain depends on the analysis goals:

\begin{table}[htbp]
\centering
\begin{tabular}{lll}
\hline
\textbf{Application} & \textbf{Recommended Domain} & \textbf{Reason} \\
\hline
Buffer overflow detection & Interval & Range checking \\
Array bound checking & Octagon & Index relationships \\
Numerical verification & Polyhedra & Arbitrary linear invariants \\
Memory safety & Heap abstraction & Shape properties \\
Type checking & Sign/Interval & Simple value properties \\
Cost analysis & Affine + Congruence & Precise counting \\
\hline
\end{tabular}
\caption{Domain selection guide.}
\label{tab:domain-selection}
\end{table}

\section{Summary}\label{sec:abstract-domains-summary}

Abstract domains are the building blocks of static analysis. The sign and interval domains provide simple, efficient approximations for individual variables. Relational domains (octagons, polyhedra) capture relationships between variables at higher computational cost. Template polyhedra offer a practical compromise. Heap abstractions handle dynamic data structures. Domain combinators (reduced product, tensor product) allow building complex domains from simpler ones. Congruence domains capture modular arithmetic properties. The choice of domain is the primary determinant of an analysis's precision and cost, and should be guided by the specific properties being verified.

\section{Relational Domains in Depth}\label{sec:relational-domains-depth}

Relational domains capture relationships between variables, providing higher precision than non-relational domains at increased computational cost.

\subsection{The Octagon Domain}\label{sec:octagon-detail}

The \emph{octagon} domain tracks constraints of the form $\pm x_i \pm x_j \leq c$, providing a good balance between precision and efficiency.

\begin{definition}[Octagon Constraint]\label{def:octagon-constraint}
An \textbf{octagon constraint} is an inequality of the form $\pm x_i \pm x_j \leq c$ where $c \in \mathbb{Q} \cup \{+\infty\}$. The four forms are:
\begin{itemize}
  \item $x_i + x_j \leq c$
  \item $x_i - x_j \leq c$
  \item $-x_i + x_j \leq c$
  \item $-x_i - x_j \leq c$
\end{itemize}
\end{definition}

\begin{definition}[Difference-Bound Matrix]\label{def:dbm}
An octagon is represented by a \textbf{difference-bound matrix} (DBM) $m$ of size $2n \times 2n$, where variables $x_1, \ldots, x_n$ are represented as $x_1^{+}, x_1^{-}, \ldots, x_n^{+}, x_n^{-}$:
\[
m_{2i, 2j+1} \text{ represents } x_i - x_j \leq c
\]
The DBM must be \emph{consistent} (no negative cycles) and \emph{closed} (all shortest paths computed).
\end{definition}

\begin{algorithm}[H]
\caption{Octagon Strong Closure (Floyd-Warshall)}
\label{alg:octagon-closure}
\begin{algorithmic}[1]
\Require DBM $m$ of size $2n \times 2n$
\Ensure Closed DBM $m^*$
\For{$k = 0$ to $2n-1$}
  \For{$i = 0$ to $2n-1$}
    \For{$j = 0$ to $2n-1$}
      \State $m_{i,j} \gets \min(m_{i,j}, m_{i,k} + m_{k,j})$
    \EndFor
  \EndFor
\EndFor
\State \textbf{// Strengthening step for octagon consistency:}
\For{$i = 0$ to $2n-1$}
  \For{$j = 0$ to $2n-1$}
    \State $m_{i,j} \gets \min(m_{i,j}, \frac{m_{i,\bar{i}} + m_{\bar{j},j}}{2})$
  \EndFor
\EndFor
\end{algorithmic}
\end{algorithm}

\begin{theorem}[Octagon Complexity]\label{thm:octagon-complexity}
The strong closure of an octagon with $n$ variables takes $O(n^3)$ time. Join, meet, inclusion, and assignment operations are all $O(n^2)$ or $O(n^3)$. This makes octagons practical for programs with up to several hundred variables.
\end{theorem}

\subsection{The Polyhedra Domain}\label{sec:polyhedra-detail}

The \emph{polyhedra} domain represents arbitrary linear inequalities, providing maximum precision among linear relational domains.

\begin{definition}[Convex Polyhedron]\label{def:convex-polyhedron}
A \textbf{convex polyhedron} in $\mathbb{R}^n$ is the intersection of a finite number of half-spaces:
\[
P = \{\vec{x} \in \mathbb{R}^n \mid A\vec{x} \leq \vec{b}\}
\]
where $A$ is an $m \times n$ matrix and $\vec{b} \in \mathbb{R}^m$.
\end{definition}

\begin{definition}[Dual Representation]\label{def:dual-rep}
A polyhedron has two equivalent representations:
\begin{itemize}
  \item \textbf{H-representation} (half-spaces): $P = \{\vec{x} \mid A\vec{x} \leq \vec{b}\}$
  \item \textbf{V-representation} (vertices + rays): $P = \text{conv}(V) + \text{cone}(R)$
\end{itemize}
Converting between representations (vertex enumeration / facet enumeration) is computationally expensive.
\end{definition}

\begin{table}[htbp]
\centering
\begin{tabular}{lccc}
\hline
\textbf{Operation} & \textbf{H-rep} & \textbf{V-rep} & \textbf{Dual Conv.} \\
\hline
Intersection & $O(m_1 + m_2)$ & Expensive & -- \\
Convex hull & Expensive & $O(|V_1| + |V_2|)$ & -- \\
Projection & Fourier-Motzkin $O(2^n)$ & Vertex removal $O(|V|)$ & -- \\
Emptiness & Simplex $O(m^2 n)$ & $|V| = 0$? & -- \\
Widening & Constraint removal & Vertex removal & -- \\
\hline
\end{tabular}
\caption{Complexity of polyhedra operations in different representations.}
\label{tab:polyhedra-ops}
\end{table}

\section{Domain Combinators}\label{sec:domain-combinators}

Domain combinators build complex domains from simpler ones, enabling modular construction of analyses.

\subsection{Reduced Product}\label{sec:reduced-product-detail}

The \emph{reduced product} combines two domains while allowing information exchange between them.

\begin{definition}[Reduced Product]\label{def:reduced-product}
Given domains $(A_1, \sqsubseteq_1)$ and $(A_2, \sqsubseteq_2)$ with concretizations $\gamma_1, \gamma_2$, the \textbf{reduced product} is:
\[
A_1 \times_\rho A_2 = \{(a_1, a_2) \mid \gamma_1(a_1) \cap \gamma_2(a_2) = \gamma_1(a_1') \cap \gamma_2(a_2') \text{ for no } (a_1', a_2') < (a_1, a_2)\}
\]
The \emph{reduction} operator $\rho$ exchanges information between components to improve precision.
\end{definition}

\begin{example}[Interval $\times$ Congruence Reduction]\label{ex:interval-congruence}
Consider the reduced product of intervals and congruences:
\begin{verbatim}
  Interval: x ∈ [3, 7]
  Congruence: x ≡ 0 (mod 2)
  
  After reduction:
  Interval: x ∈ [4, 6]  (narrowed by congruence)
  Congruence: x ≡ 0 (mod 2)  (unchanged)
  
  The reduction function ρ improves the interval by removing
  values inconsistent with the congruence.
\end{verbatim}
\end{example}

\begin{algorithm}[H]
\caption{Reduced Product with Information Exchange}
\label{alg:reduced-product}
\begin{algorithmic}[1]
\Require Domains $A_1, A_2$ with reduction $\rho : A_1 \times A_2 \to A_1 \times A_2$
\Ensure Combined abstract state $(a_1^*, a_2^*)$
\State $(a_1, a_2) \gets$ initial state
\Repeat
  \State $(a_1', a_2') \gets \rho(a_1, a_2)$
  \If{$(a_1', a_2') = (a_1, a_2)$}
    \State \Return $(a_1, a_2)$
  \EndIf
  \State $(a_1, a_2) \gets (a_1', a_2')$
\Until{fixpoint}
\end{algorithmic}
\end{algorithm}

\subsection{Tensor Product}\label{sec:tensor-product}

\begin{definition}[Tensor Product]\label{def:tensor-product}
The \textbf{tensor product} $A_1 \otimes A_2$ is the domain of conjunctions of properties expressible in $A_1$ and $A_2$ independently:
\[
\gamma(a_1 \otimes a_2) = \gamma_1(a_1) \cap \gamma_2(a_2)
\]
Unlike the reduced product, the tensor product does not exchange information between components.
\end{definition}

\subsection{Cardinality Product}\label{sec:cardinality-product}

\begin{definition}[Cardinality Product]\label{def:cardinality-product}
The \textbf{cardinality product} combines a base domain with a cardinality domain that tracks the number of concrete elements. This enables reasoning about both value properties and set sizes.
\end{definition}

% Annotated walkthrough
\subsection{Intersecting Two Strided Intervals}

The interval--congruence reduction above tightens one interval with one stride. A meet, such as the one used to combine two independent assumptions about an index, must reconcile \emph{both} strides. Taking the larger modulus or the least common multiple without first checking residues can miss valid values or represent an intersection that is actually empty.

\textbf{Inputs and assumptions.} The inputs are finite integer bounds $[l_i,h_i]$ and residues $a_i$ modulo positive integers $m_i$, for $i=1,2$. The modulus 1 represents no stride restriction. Use Euclidean remainder, which is nonnegative for a positive modulus, and exact integer arithmetic. The result represents the exact intersection in the same domain or is bottom.

\begin{sudocode}[Exact meet in one dimension]
\Require $(l_i,h_i,a_i,m_i)$ for $i=1,2$
\Ensure Reduced intersection or bottom
\Let{L,H}{\max(l_1,l_2),\min(h_1,h_2)}
\If{$L>H$}
  \State \Return $\bot$
\EndIf
\Let{g,u,v}{\Call{ExtendedGCD}{m_1,m_2}}
\Let{d}{a_2-a_1}
\If{$g\nmid d$}
  \State \Return $\bot$ \Comment{Residues disagree modulo $g$}
\EndIf
\Let{m}{(m_1/g)m_2}
\Let{a}{(a_1+m_1u(d/g))\bmod m}
\Let{L'}{L+((a-L)\bmod m)}
\Let{H'}{H-((H-a)\bmod m)}
\If{$L'>H'$}
  \State \Return $\bot$ \Comment{Compatible, but outside the bounds}
\EndIf
\State \Return $(L',H',a,m)$
\end{sudocode}

\textbf{Example.} Meet $[0,26]$ with residue 2 modulo 6 and $[5,22]$ with residue 5 modulo 9. The merged bounds are $[5,22]$. The gcd is 3, which divides the residue difference 3. The common residue is 14 modulo 18. Both rounded endpoints are 14, so the result is the singleton $\{14\}$. Changing the second residue to 4 makes the meet bottom before any rounding.

\textbf{Invariant.} Extended Euclid supplies coefficients $u,v$ with $u m_1+v m_2=g$. Multiplying this equation by $d/g$ constructs a correction that keeps the first residue and also reaches the second. Any two common solutions differ by a multiple of both moduli, so rounding the endpoints loses no solutions. The algorithm uses logarithmically many Euclidean divisions and a constant number of additional integer operations. Fixed-width implementations need a checked fallback when the combined modulus does not fit.

\section{Numeric Abstract Domains}\label{sec:numeric-domains}

\subsection{Affine Forms (Zonotopes)}\label{sec:zonotopes}

\emph{Zonotopes} use \emph{affine forms} to track linear expressions with noise symbols, providing an efficient alternative to polyhedra for some analyses.

\begin{definition}[Affine Form]\label{def:affine-form}
An \textbf{affine form} for a variable $x$ is:
\[
\hat{x} = a_0 + \sum_{i=1}^{n} a_i \epsilon_i
\]
where $a_0$ is the center, $a_i$ are coefficients, and $\epsilon_i \in [-1, 1]$ are noise symbols representing uncertainty.
\end{definition}

\begin{example}[Zonotope Arithmetic]\label{ex:zonotope-arith}
\begin{verbatim}
  x = 3 + 1·ε₁     (x ∈ [2, 4])
  y = 5 + 2·ε₂     (y ∈ [3, 7])
  
  x + y = 8 + 1·ε₁ + 2·ε₂   (x+y ∈ [5, 11])
  2·x   = 6 + 2·ε₁           (2x ∈ [4, 8])
  x * y = requires linearization (introduces over-approximation)
\end{verbatim}
\end{example}

\begin{theorem}[Zonotope vs.\ Polyhedra]\label{thm:zonotope-polyhedra}
Zonotopes and polyhedra are incomparable: some properties expressible by zonotopes are not expressible by polyhedra, and vice versa. However, zonotope operations are generally faster ($O(n)$ vs.\ $O(n^3)$ for polyhedra).
\end{theorem}

\subsection{Decision Tree Domains}\label{sec:decision-tree-domains}

\begin{definition}[Decision Tree Domain]\label{def:decision-tree}
A \textbf{decision tree domain} represents abstract values as decision trees that branch on variable comparisons. Each leaf contains a base abstract value (e.g., an interval). This enables efficient representation of disjunctive information.
\end{definition}

\begin{example}[Decision Tree Domain]\label{ex:decision-tree}
\begin{verbatim}
  if (x > 0) {
    // Decision tree: x > 0 → y ∈ [0, 10]
    //                x ≤ 0 → y ∈ [-5, 5]
  }
  This disjunctive information cannot be expressed in a single interval domain.
\end{verbatim}
\end{example}

\section{Heap Abstraction Strategies}\label{sec:heap-abstraction-strategies}

\subsection{Shape Analysis}\label{sec:shape-analysis}

\emph{Shape analysis} tracks the topological structure of heap-allocated data structures using \emph{summary nodes} that represent unbounded collections of concrete objects.

\begin{definition}[3-Valued Logic Shape Analysis]\label{def:3vl-shape}
\textbf{3-valued logic shape analysis} represents the heap as a graph where edges are labeled with truth values from $\{true, false, maybe\}$. Summary nodes (drawn with double circles) represent potentially unbounded sets of concrete nodes.
\end{definition}

\begin{definition}[Canonical Abstraction]\label{def:canonical-abstraction}
\textbf{Canonical abstraction} maps a concrete heap graph to an abstract 3-valued graph by merging nodes that have the same values for a set of \emph{abstraction predicates}. Merged nodes become summary nodes.
\end{definition}

