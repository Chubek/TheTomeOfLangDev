    0/{\texttt{sample\_rate}}/{global wins}/{\texttt{tuned.o}: 48000},
    -1.1/{\texttt{optional\_cal}}/{weak, missing}/{zero},
    -2.2/{\texttt{tag}}/{local identity}/{\texttt{survey.o}: \texttt{0x11}}} {
    \node[tome box,minimum width=3.6cm] (ref) at (1.8,\lev) {\src};
    \node[tome box,minimum width=4.25cm] (dest) at (8.525,\lev) {\dst};
    \draw[tome arrow] (ref) -- node[above] {\why} (dest);
  }
\end{tikzpicture}
