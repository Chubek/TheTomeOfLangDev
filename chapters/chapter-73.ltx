\subsection{Address Computation Peephole Rules}\label{sec:addr-peephole}

Modern processors support complex addressing modes that can fold multiple operations into a single memory access:

\begin{definition}[Address Mode Folding]\label{def:addr-folding}
\textbf{Address mode folding} combines address computation instructions into the addressing mode of a load or store instruction. For example, on x86-64:
\[
\texttt{lea rax, [rbx + rcx*4 + 8]} \text{; } \texttt{mov rdx, [rax]} \implies \texttt{mov rdx, [rbx + rcx*4 + 8]}
\]
\end{definition}

\begin{algorithm}[H]
\caption{Address Mode Folding}
\label{alg:addr-folding}
\begin{algorithmic}[1]
\Require Instruction sequence with address computation followed by load/store
\Ensure Optimized instruction sequence
\ForAll{load/store instructions $m$ with base address $a$}
  \State Trace definition chain of $a$ backward
  \If{$a$ is computed by \texttt{add}/\texttt{lea} from base + index*scale + offset}
    \If{target supports this addressing mode}
      \State Replace $m$ with single instruction using complex addressing mode
      \State Delete address computation instructions
    \EndIf
  \EndIf
\EndFor
\end{algorithmic}
\end{algorithm}

\section{Branch Optimization Peephole Rules}\label{sec:branch-peephole}

\subsection{Branch Shortening}\label{sec:branch-shortening}

\begin{definition}[Branch Shortening]\label{def:branch-shortening}
\textbf{Branch shortening} replaces long conditional branches with short branches when the target is within the short branch range. This saves code space and may improve instruction fetch performance.
\end{definition}

\begin{algorithm}[H]
\caption{Branch Shortening}
\label{alg:branch-shortening}
\begin{algorithmic}[1]
\Require Instruction sequence with branches, target offsets
\Ensure Optimized branch instructions
\State Compute initial layout and branch offsets
\Repeat
  \State changed $\gets$ false
  \ForAll{conditional branches $b$}
    \If{$b$ is long-form and target is within short range}
      \State Replace $b$ with short-form branch
      \State changed $\gets$ true
      \State Recompute offsets (code shrinks)
    \EndIf
  \EndFor
\Until{$\neg$ changed}
\end{algorithmic}
\end{algorithm}

\subsection{Branch Elimination}\label{sec:branch-elimination}

\begin{verbatim}
  // Pattern: conditional branch to next instruction
  CMP r1, r2
  JE  L1       ; branch to next instruction
  L1: ...
  
  // Optimized: remove the branch
  CMP r1, r2
  L1: ...
\end{verbatim}

\subsection{Branch Inversion for Fall-Through}\label{sec:branch-inversion}

\begin{definition}[Branch Inversion]\label{def:branch-inversion}
\textbf{Branch inversion} swaps the taken and not-taken targets of a conditional branch when the not-taken path is more likely. This exploits the processor's branch prediction heuristic that predicts forward branches as not taken.
\end{definition}

\section{Sequence Optimization Peephole Rules}\label{sec:sequence-peephole}

\subsection{Redundant Load/Store Elimination}\label{sec:redundant-load-store}

\begin{verbatim}
  // Pattern: store followed by load of same address
  MOV [rbx], rax    ; store rax to [rbx]
  MOV rcx, [rbx]    ; load from [rbx] into rcx
  
  // Optimized: replace load with register copy
  MOV [rbx], rax
  MOV rcx, rax      ; rcx already has the value
\end{verbatim}

\subsection{Instruction Combination}\label{sec:instruction-combine}

\begin{definition}[Instruction Combination]\label{def:instruction-combine}
\textbf{Instruction combination} merges multiple instructions into a single instruction that performs the same computation. Examples include:
\begin{itemize}
  \item Combining \texttt{add} + \texttt{mov} into a single \texttt{lea}
  \item Combining \texttt{shift} + \texttt{add} into \texttt{lea} with scale
  \item Combining \texttt{load} + \texttt{sign-extend} into \texttt{movsx}
\end{itemize}
\end{definition}

\begin{table}[htbp]
\centering
\begin{tabular}{lll}
\hline
\textbf{Instruction Sequence} & \textbf{Combined} & \textbf{Savings} \\
\hline
\texttt{mov rax, [mem]; movsx rax, eax} & \texttt{movsxd rax, [mem]} & 1 instruction \\
\texttt{shl rax, 2; add rax, rbx} & \texttt{lea rax, [rbx + rax*4]} & 1 instruction \\
\texttt{mov rax, imm32} & \texttt{mov eax, imm32} & 1 byte (zero-extends) \\
\texttt{nop; nop; nop} & \texttt{nop (3-byte)} & 0 bytes, 1 instruction \\
\hline
\end{tabular}
\caption{Instruction combination examples.}
\label{tab:instruction-combine}
\end{table}

\section{Peephole Optimization Frameworks}\label{sec:peephole-frameworks}

\subsection{DAG-Based Pattern Matching}\label{sec:dag-pattern}

\begin{definition}[DAG Pattern Matching]\label{def:dag-pattern}
\textbf{DAG pattern matching} represents both the instruction sequence and the peephole rules as directed acyclic graphs. Pattern matching is performed by tree/DAG matching algorithms that find subgraph isomorphisms.
\end{definition}

\begin{algorithm}[H]
\caption{DAG-Based Peephole Optimization}
\label{alg:dag-peephole}
\begin{algorithmic}[1]
\Require Instruction DAG $D$, pattern rules $R$
\Ensure Optimized instruction DAG
\ForAll{rules $r \in R$}
  \State Find all matches of $r.pattern$ in $D$
  \ForAll{matches $m$}
    \State Compute cost difference: $\Delta = cost(r.pattern) - cost(r.replacement)$
    \If{$\Delta > 0$}
      \State Replace matched subgraph with $r.replacement$
    \EndIf
  \EndFor
\EndFor
\end{algorithmic}
\end{algorithm}

\subsection{Combinatorial Peephole Optimization}\label{sec:combinatorial-peephole}

When peephole rules interact (one rule creates a pattern for another), the optimization problem becomes combinatorial:

\begin{definition}[Combinatorial Peephole]\label{def:combinatorial-peephole}
\textbf{Combinatorial peephole optimization} considers all possible orderings of rule applications and selects the sequence that produces the minimum-cost code. This is equivalent to finding the shortest derivation in a term rewriting system.
\end{definition}

\begin{theorem}[Peephole Termination]\label{thm:peephole-termination}
If all peephole rules are \emph{cost-reducing} (each replacement produces code with equal or lower cost), and the set of possible code sequences is finite (bounded by code size), then repeated application of peephole rules terminates.
\end{theorem}
