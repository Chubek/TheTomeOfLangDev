\section{Introduction}\label{sec:widening-narrowing-intro}

When the abstract domain has infinite ascending chains---as do the interval and polyhedra domains---naive iteration may never terminate. Consider a loop that increments a counter: the interval for the counter grows by 1 at each iteration, producing an infinite ascending chain $[0,0] \sqsubseteq [0,1] \sqsubseteq [0,2] \sqsubseteq \cdots$. \emph{Widening} is the key technique for ensuring termination on such domains: it forces convergence by jumping to an over-approximation of the limit. \emph{Narrowing} then recovers precision lost by widening.

The theory of widening and narrowing was introduced by Cousot and Cousot~\cite{cousot1979constructive} in 1979 and remains one of the most important practical tools in abstract interpretation.

\section{The Problem of Infinite Ascending Chains}\label{sec:infinite-chains}

\begin{definition}[Ascending Chain Condition]\label{def:acc}
A lattice $L$ satisfies the \textbf{ascending chain condition} (ACC) if every ascending chain $x_1 \sqsubseteq x_2 \sqsubseteq \cdots$ is eventually stationary: there exists $N$ such that $x_n = x_N$ for all $n \geq N$.
\end{definition}

Many useful abstract domains do \emph{not} satisfy ACC:

\begin{itemize}
  \item The interval domain: $[0,0] \sqsubset [0,1] \sqsubset [0,2] \sqsubset \cdots$
  \item The polyhedra domain: infinitely many increasingly precise polyhedra
  \item The domain of finite sets of integers under subset ordering
\end{itemize}

For these domains, Kleene iteration may produce an infinite ascending chain that never reaches a fixedpoint. Widening solves this problem by artificially forcing convergence.

\section{Widening Operators: Definition and Examples}\label{sec:widening-operators}

\begin{definition}[Widening Operator]\label{def:widening}
A \textbf{widening operator} on a lattice $L$ is a function $\nabla : L \times L \to L$ satisfying:
\begin{enumerate}
  \item $x \sqsubseteq x \nabla y$ (extensiveness: widening only increases)
  \item $y \sqsubseteq x \nabla y$ (upper bound: widening is an upper bound)
  \item For any ascending chain $x_0 \sqsubseteq x_1 \sqsubseteq \cdots$, the sequence defined by $y_0 = x_0$, $y_{n+1} = y_n \nabla x_{n+1}$ is eventually stationary.
\end{enumerate}
\end{definition}

The third condition is the crucial one: it ensures that widening forces any ascending chain to converge in finitely many steps.

\subsection{Widening for Intervals}\label{sec:interval-widening}

\begin{definition}[Interval Widening]\label{def:interval-widening}
The standard widening for the interval domain is:
\[
[a_1, b_1] \nabla [a_2, b_2] = [a, b]
\]
where:
\[
a = \begin{cases} a_1 & \text{if } a_2 \geq a_1 \\ -\infty & \text{if } a_2 < a_1 \end{cases}
\qquad
b = \begin{cases} b_1 & \text{if } b_2 \leq b_1 \\ +\infty & \text{if } b_2 > b_1 \end{cases}
\]
\end{definition}

\begin{example}[Interval Widening]\label{ex:interval-widen}
Consider the loop:
\begin{verbatim}
  i = 0;
  while (i < 100) {
    i = i + 1;
  }
\end{verbatim}
The iteration produces:
\begin{align*}
  y_0 &= [0, 0] \\
  y_1 &= y_0 \nabla [0, 1] = [0, 1] \quad \text{(upper bound increased, so } +\infty) \\
  \text{Actually: } y_1 &= [0, +\infty] \quad \text{(since } 1 > 0, \text{ upper bound goes to } +\infty)
\end{align*}
Wait, let me be precise: $y_0 = [0,0]$, after one iteration the body gives $[0,1]$. Since $1 > 0$ (the upper bound increased), widening gives $[0, +\infty]$. The next iteration gives $[0, +\infty] \nabla [0, +\infty] = [0, +\infty]$ (stable). The loop condition $i < 100$ refines this to $[0, 99]$.
\end{example}

\subsection{Widening for Polyhedra}\label{sec:polyhedra-widening}

\begin{definition}[Polyhedra Widening]\label{def:polyhedra-widening}
The standard widening for polyhedra is \textbf{constraint removal}:
\[
P_1 \nabla P_2 = \text{the largest face of } P_2 \text{ that contains all constraints of } P_1 \text{ that are satisfied by all of } P_2
\]
In practice: a constraint of $P_2$ is kept only if it is also a constraint of $P_1$ (or is implied by the kept constraints).
\end{definition}

\begin{example}[Polyhedra Widening]\label{ex:polyhedra-widen}
Consider:
\begin{verbatim}
  i = 0; j = 0;
  while (i < n) {
    i = i + 1;
    j = j + 2;
  }
\end{verbatim}
After $k$ iterations, the polyhedron is $\{i = k, j = 2k, i \geq 0, j \geq 0\}$. Widening removes the constraints $i = k$ and $j = 2k$ (since they change between iterations) but keeps $i \geq 0$ and $j \geq 0$. The result is $\{i \geq 0, j \geq 0\}$, which is then refined by the loop guard to $\{0 \leq i < n, j = 2i\}$.
\end{example}

\section{Narrowing for Precision Recovery}\label{sec:narrowing-precision}

Widening often loses significant precision. \emph{Narrowing} is a post-processing step that iteratively refines the widened solution.

\begin{definition}[Narrowing Operator]\label{def:narrowing}
A \textbf{narrowing operator} $\triangle : L \times L \to L$ satisfies:
\begin{enumerate}
  \item If $y \sqsubseteq x$, then $y \sqsubseteq x \triangle y \sqsubseteq x$
  \item For any descending chain $x_0 \sqsupseteq x_1 \sqsupseteq \cdots$, the sequence $y_0 = x_0$, $y_{n+1} = y_n \triangle x_{n+1}$ is eventually stationary.
\end{enumerate}
\end{definition}

\subsection{Narrowing for Intervals}\label{sec:interval-narrowing}

\begin{definition}[Interval Narrowing]\label{def:interval-narrowing}
The standard narrowing for intervals replaces $-\infty$ and $+\infty$ bounds with finite values when possible:
\[
[a_1, b_1] \triangle [a_2, b_2] = [a, b]
\]
where:
\[
a = \begin{cases} a_2 & \text{if } a_1 = -\infty \\ a_1 & \text{otherwise} \end{cases}
\qquad
b = \begin{cases} b_2 & \text{if } b_1 = +\infty \\ b_1 & \text{otherwise} \end{cases}
\]
\end{definition}

\begin{example}[Interval Narrowing]\label{ex:interval-narrow}
After widening, we have $i \in [0, +\infty]$. The loop guard $i < 100$ gives $i \in [0, 99]$. Narrowing: $[0, +\infty] \triangle [0, 99] = [0, 99]$. The infinite upper bound is replaced by the finite bound from the guard.
\end{example}

