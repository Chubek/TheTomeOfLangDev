%% chapter-4.ltx — Order Theory and Lattices
%%

Order theory is the mathematical study of ``less than or equal to''---a deceptively simple concept that turns out to have extraordinary depth and applicability. For the programming language scientist, order theory is indispensable: it provides the mathematical framework for abstract interpretation~\cite{cousot1977abstract}, dataflow analysis~\cite{muchnick1997advanced}, domain theory~\cite{winskel1993semantics}, and type inference.

This chapter develops the theory of partial orders, lattices, complete lattices, Galois connections, and closure operators. We pay particular attention to the applications to abstract interpretation, where Galois connections provide the rigorous foundation for relating concrete and abstract semantics.

\section{Partial Orders Revisited}\label{sec:order-posets}

\subsection{Posets and Their Properties}

\begin{definition}[Poset]\label{def:poset}
A \emph{partially ordered set} (poset) is a pair $(P, \leq)$ where $P$ is a set and $\leq$ is a binary relation on $P$ that is reflexive, antisymmetric, and transitive.
\end{definition}

\begin{definition}[Special Elements of Posets]\label{def:poset-special}
Let $(P, \leq)$ be a poset.
\begin{itemize}
  \item $a \in P$ is \emph{maximal} if there is no $b \in P$ with $a < b$.
  \item $a \in P$ is \emph{minimal} if there is no $b \in P$ with $b < a$.
  \item $a \in P$ is the \emph{greatest element} (top, $\top$) if $x \leq a$ for all $x \in P$.
  \item $a \in P$ is the \emph{least element} (bottom, $\bot$) if $a \leq x$ for all $x \in P$.
\end{itemize}
\end{definition}

\begin{remark}
A greatest element is unique (if it exists), but there may be multiple maximal elements. For example, in the poset $\{a, b, c\}$ with $a \leq c$ and $b \leq c$ (and no other non-trivial relations), $c$ is the greatest element. But in $\{a, b\}$ with no non-trivial relations, both $a$ and $b$ are maximal.
\end{remark}

\subsection{Chains and Antichains}

\begin{definition}[Chain]\label{def:chain}
A \emph{chain} (or \emph{totally ordered subset}) in a poset $(P, \leq)$ is a subset $C \subseteq P$ such that for all $a, b \in C$, either $a \leq b$ or $b \leq a$.
\end{definition}

\begin{definition}[Antichain]\label{def:antichain}
An \emph{antichain} in a poset $(P, \leq)$ is a subset $A \subseteq P$ such that for all distinct $a, b \in A$, neither $a \leq b$ nor $b \leq a$.
\end{definition}

\begin{definition}[Chain Conditions]\label{def:chain-conditions}
A poset $(P, \leq)$ satisfies:
\begin{itemize}
  \item The \emph{ascending chain condition} (ACC) if every ascending chain $a_1 \leq a_2 \leq a_3 \leq \cdots$ eventually stabilizes (i.e., there exists $N$ such that $a_n = a_N$ for all $n \geq N$).
  \item The \emph{descending chain condition} (DCC) if every descending chain stabilizes.
\end{itemize}
\end{definition}

\begin{theorem}[ACC and Finite Height]\label{thm:acc-height}
A poset satisfies the ACC if and only if every non-empty subset has a maximal element.
\end{theorem}

\section{Lattices}\label{sec:order-lattices}

\begin{definition}[Lattice]\label{def:lattice}
A \emph{lattice} is a poset $(L, \leq)$ in which every pair of elements has a least upper bound (join, $a \sqcup b$) and a greatest lower bound (meet, $a \sqcap b$).
\end{definition}

\begin{definition}[Bounded Lattice]\label{def:bounded-lattice}
A lattice is \emph{bounded} if it has a least element $\bot$ and a greatest element $\top$.
\end{definition}

\begin{lemma}[Algebraic Characterization of Lattices]\label{lem:lattice-algebraic}
A lattice $(L, \sqcup, \sqcap)$ can be characterized algebraically as a set $L$ with two binary operations satisfying:
\begin{align*}
  a \sqcup b &= b \sqcup a & a \sqcap b &= b \sqcap a && \text{(commutativity)} \\
  a \sqcup (b \sqcup c) &= (a \sqcup b) \sqcup c & a \sqcap (b \sqcap c) &= (a \sqcap b) \sqcap c && \text{(associativity)} \\
  a \sqcup (a \sqcap b) &= a & a \sqcap (a \sqcup b) &= a && \text{(absorption)}
\end{align*}
\end{lemma}

\subsection{Examples of Lattices}

\begin{example}[Powerset Lattice]\label{ex:powerset-lattice}
For any set $S$, the powerset $(\mathcal{P}(S), \subseteq)$ is a lattice with:
\begin{align*}
  A \sqcup B &= A \cup B \\
  A \sqcap B &= A \cap B \\
  \bot &= \emptyset \\
  \top &= S
\end{align*}
\end{example}

\begin{example}[Divisibility Lattice]\label{ex:divisibility-lattice}
The positive integers under divisibility form a lattice with:
\begin{align*}
  a \sqcup b &= \mathrm{lcm}(a, b) \\
  a \sqcap b &= \gcd(a, b) \\
  \bot &= 1
\end{align*}
This lattice is not bounded above (there is no integer divisible by all integers).
\end{example}

\begin{example}[Sign Lattice]\label{ex:sign-lattice}
The \emph{sign lattice} is used in abstract interpretation to track the sign of integer variables:

