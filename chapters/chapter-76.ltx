\section{The Pluto Algorithm}\label{sec:pluto-algorithm}

\emph{Pluto}~\cite{bondhugula2009pluto} is an algorithm for automatically finding optimal affine schedules for loop nests. It formulates schedule finding as a linear programming problem.

\subsection{The Scheduling Theorem}\label{sec:scheduling-theorem}

\begin{theorem}[Feautrier's Scheduling Theorem]\label{thm:scheduling}
For a SCoP with dependences, an affine schedule exists that respects all dependences if and only if the dependence polyhedra satisfy the \emph{Farkas lemma} conditions: for each dependence $(\vec{i}, \vec{j})$, the schedule satisfies $\sigma_{S'}(\vec{j}) - \sigma_S(\vec{i}) \geq_{\mathit{lex}} \vec{1}$.
\end{theorem}

\subsection{The Pluto Algorithm}\label{sec:pluto-detail}

\begin{algorithm}[H]
\caption{Pluto Algorithm}
\label{alg:pluto}
\begin{algorithmic}[1]
\Require SCoP with statements and dependences
\Ensure Affine schedules for all statements
\ForAll{pairs of statements $(S, S')$ with dependences}
  \State Generate dependence constraints
\EndFor
\State Find hyperplanes $\vec{c}$ such that $\vec{c} \cdot (\vec{j} - \vec{i}) \geq 0$ for all dependences
\State Solve ILP to maximize tile size (parallelism)
\State Construct schedule matrix $T$ from hyperplanes
\State Generate tiled code from schedule
\end{algorithmic}
\end{algorithm}

\section{Tiling, Skewing, Reversal}\label{sec:tiling-skewing}

\subsection{Loop Tiling}\label{sec:loop-tiling-detail}

\begin{definition}[Loop Tiling]\label{def:loop-tiling}
\textbf{Loop tiling} (or \textbf{loop blocking}) partitions the iteration space into rectangular \emph{tiles}. Each tile is executed atomically, improving data locality. For a 2D loop nest with tile size $(b_1, b_2)$:
\begin{verbatim}
  for (t1 = 0; t1 < N; t1 += b1)
    for (t2 = 0; t2 < N; t2 += b2)
      for (i = t1; i < min(t1+b1, N); i++)
        for (j = t2; j < min(t2+b2, N); j++)
          S(i, j);
\end{verbatim}
\end{definition}

Tiling is valid only if the tile boundaries respect all dependences: no dependence crosses a tile boundary in the ``wrong'' direction.

\subsection{Loop Skewing}\label{sec:loop-skewing-detail}

\begin{definition}[Loop Skewing]\label{def:loop-skewing}
\textbf{Loop skewing} applies a shear transformation to the iteration space:
\[
\begin{pmatrix} i' \\ j' \end{pmatrix} = \begin{pmatrix} 1 & c \\ 0 & 1 \end{pmatrix} \begin{pmatrix} i \\ j \end{pmatrix}
\]
This makes the iteration space suitable for tiling when the original dependences prevent it.
\end{definition}

\subsection{Loop Reversal}\label{sec:loop-reversal-detail}

\begin{definition}[Loop Reversal]\label{def:loop-reversal}
\textbf{Loop reversal} negates a loop index: $i' = N - 1 - i$. This reverses the iteration order and can change dependence directions to enable other transformations.
\end{definition}

\section{Code Generation from Polyhedra}\label{sec:code-generation}

\subsection{The CLooG Approach}\label{sec:cloog}

\emph{CLooG} (Chunky Loop Generator)~\cite{cederberg2007cloog} generates loop nests from polyhedral descriptions. Given a schedule and iteration domains, CLooG produces code that iterates over the integer points in the correct order.

\subsection{The ISC Approach}\label{sec:isc}

\emph{Iterative Set Construction} (ISC) is an alternative code generation method that builds the loop nest by iteratively constructing the set of iterations at each level.

\begin{definition}[Code Generation Problem]\label{def:code-gen}
Given:
\begin{itemize}
  \item Iteration domains $\mathcal{D}_S$ for each statement $S$.
  \item Affine schedules $\sigma_S$ for each statement $S$.
\end{itemize}
Generate a loop nest that:
\begin{itemize}
  \item Executes each statement at each point in its iteration domain.
  \item Executes statements in the order determined by the schedules.
  \item Minimizes loop overhead and control flow complexity.
\end{itemize}
\end{definition}

\begin{historical}
The polyhedral model was pioneered by Quiller\'e and Rajopadhye~\cite{quillere1991optimal} (1991) and Feautrier~\cite{feautrier1992dataflow} (1992). The Pluto algorithm of Bondhugula et al.~\cite{bondhugula2009pluto} (2009) brought automatic polyhedral optimization to practical compilers. Tools like CLooG (Cedercracken, 2007), ISL (Verdonck et al.), and Polly (Grosser et al.) have integrated polyhedral optimization into LLVM and GCC. The polyhedral model is now a standard component of high-performance compilers for scientific computing.
\end{historical}

