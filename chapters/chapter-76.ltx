\section{Introduction}\label{sec:polyhedral-model-intro}

The \emph{polyhedral model} is a mathematical framework for analyzing and transforming loop nests with affine control flow and access patterns. It represents loops, array accesses, and dependence relations as polyhedra and affine transformations, enabling powerful loop transformations---tiling, skewing, fusion, fission, reordering---to be expressed as operations on geometric objects.

The polyhedral model goes far beyond the classical loop transformations of Chapter~\ref{sec:loop-optimization}. While classical techniques operate on individual loops and use syntactic patterns, the polyhedral model operates on the entire loop nest simultaneously, using algebraic and geometric reasoning to find optimal transformations.

\section{Affine Schedules and Dependence Analysis}\label{sec:affine-schedules}

\subsection{Static Control Parts (SCoPs)}\label{sec:scops}

\begin{definition}[Static Control Part]\label{def:scopt}
A \textbf{static control part} (SCoP) is a maximal set of statements such that:
\begin{itemize}
  \item All loop bounds are affine expressions of surrounding loop indices and parameters.
  \item All array access indices are affine expressions of surrounding loop indices and parameters.
  \item All conditional tests are affine comparisons.
\end{itemize}
\end{definition}

\begin{example}[SCoP]\label{ex:scopt}
\begin{verbatim}
  for (i = 0; i < N; i++)
    for (j = i; j < N; j++)
      A[i][j] = A[i-1][j] + B[i][j-1];
\end{verbatim}
This is a SCoP: loop bounds ($0$, $N$, $i$, $N$) and array indices ($i$, $j$, $i-1$, $j-1$) are all affine.
\end{example}

\subsection{Iteration Domain}\label{sec:iteration-domain}

\begin{definition}[Iteration Domain]\label{def:iteration-domain}
The \textbf{iteration domain} of a statement $S$ in a SCoP is the set of all iteration vectors $\vec{i} = (i_1, i_2, \ldots, i_d)$ for which $S$ executes. This is a polyhedron defined by the loop bounds:
\[
\mathcal{D}_S = \{\vec{i} \in \mathbb{Z}^d \mid A\vec{i} + B\vec{p} + \vec{c} \geq 0\}
\]
where $\vec{p}$ is the vector of parameters.
\end{definition}

\begin{example}[Iteration Domain]\label{ex:iteration-domain}
For the statement in the nested loop above:
\[
\mathcal{D}_S = \{(i, j) \mid 0 \leq i \leq N-1, i \leq j \leq N-1\}
\]
This is a triangular polyhedron in 2D.
\end{example}

\subsection{Access Relation}\label{sec:access-relation}

\begin{definition}[Access Relation]\label{def:access-relation}
The \textbf{access relation} for an array reference in statement $S$ maps each iteration vector to the array element accessed:
\[
\mathcal{R}_S : \mathcal{D}_S \to \mathbb{Z}^k, \quad \vec{i} \mapsto M\vec{i} + \vec{c}
\]
where $M$ is the access matrix and $\vec{c}$ is a constant offset.
\end{definition}

\subsection{Dependence Polyhedra}\label{sec:dependence-polyhedra}

\begin{definition}[Dependence Polyhedron]\label{def:dependence-polyhedron}
A \textbf{dependence} exists between statement $S_1$ at iteration $\vec{i}$ and statement $S_2$ at iteration $\vec{j}$ if:
\begin{itemize}
  \item They access the same array element: $\mathcal{R}_{S_1}(\vec{i}) = \mathcal{R}_{S_2}(\vec{j})$.
  \item At least one is a write.
  \item $\vec{i}$ executes before $\vec{j}$ in the original schedule.
\end{itemize}
The set of all dependent iteration pairs forms a \textbf{dependence polyhedron}.
\end{definition}

\section{Polyhedral Scanning}\label{sec:polyhedral-scanning}

\emph{Polyhedral scanning} is the problem of generating code that iterates over all integer points in a polyhedron. This is needed to generate code from the transformed polyhedral representation.

\begin{definition}[Polyhedron Scanning]\label{def:scanning}
Given a polyhedron $\mathcal{P} = \{\vec{x} \in \mathbb{Z}^n \mid A\vec{x} + \vec{b} \geq 0\}$, \textbf{scanning} generates a loop nest that iterates over all integer points in $\mathcal{P}$.
\end{definition}

The scanning algorithm uses Fourier--Motzkin elimination to project the polyhedron onto each dimension, generating loop bounds for each level of the loop nest.

\section{Loop Transformations as Affine Maps}\label{sec:affine-transforms}

The key insight of the polyhedral model is that loop transformations can be represented as \emph{affine transformations} of the iteration domain.

\begin{definition}[Affine Schedule]\label{def:affine-schedule}
An \textbf{affine schedule} for a statement $S$ is an affine function $\sigma_S : \mathcal{D}_S \to \mathbb{Z}^m$ that maps each iteration vector to a \emph{schedule vector} representing the execution time:
\[
\sigma_S(\vec{i}) = T_S \vec{i} + \vec{c}_S
\]
The schedule vectors determine the execution order: $\sigma_S(\vec{i}) <_{\mathit{lex}} \sigma_{S'}(\vec{j})$ means $S(\vec{i})$ executes before $S'(\vec{j})$.
\end{definition}

\subsection{Examples of Transformations}\label{sec:transform-examples}

\begin{itemize}
  \item \textbf{Loop interchange}: Swap two loop indices. Transformation matrix: $\begin{pmatrix} 0 & 1 \\ 1 & 0 \end{pmatrix}$.
  \item \textbf{Loop reversal}: Reverse the direction of a loop. Transformation: $i \mapsto N - 1 - i$.
  \item \textbf{Loop skewing}: Add a multiple of one index to another. Transformation: $\begin{pmatrix} 1 & c \\ 0 & 1 \end{pmatrix}$.
  \item \textbf{Loop tiling}: Split a loop into outer (tile) and inner (within-tile) loops.
\end{itemize}

