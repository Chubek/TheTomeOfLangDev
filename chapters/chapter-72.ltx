\section{Predicate Discovery Strategies}\label{sec:predicate-discovery}

The effectiveness of CEGAR depends critically on the ability to discover useful predicates automatically.

\subsection{Weakest Precondition Analysis}\label{sec:wp-analysis}

\begin{definition}[Weakest Precondition for Refinement]\label{def:wp-refine}
Given a spurious counterexample path $\pi = s_0 \xrightarrow{t_1} s_1 \xrightarrow{t_2} \cdots \xrightarrow{t_n} s_n$ where the postcondition $\varphi$ is violated, the \textbf{weakest precondition} $wp(\pi, \varphi)$ is computed by backward substitution:
\[
wp(\pi, \varphi) = wp(t_1, wp(t_2, \ldots wp(t_n, \varphi)\ldots))
\]
The predicates appearing in $wp(\pi, \varphi)$ are candidates for refinement.
\end{definition}

\subsection{Predicate Abstraction Precision}\label{sec:pred-precision}

\begin{definition}[Cartesian Abstraction]\label{def:cartesian-abs}
\textbf{Cartesian abstraction} computes the strongest boolean combination of predicates that holds at each program point. For predicates $\{p_1, \ldots, p_k\}$, the abstract state is:
\[
\alpha_{cart}(S) = (b_1, \ldots, b_k) \text{ where } b_i = \begin{cases} true & \text{if } S \subseteq \llbracket p_i \rrbracket \\ false & \text{if } S \cap \llbracket p_i \rrbracket = \emptyset \\ \top & \text{otherwise} \end{cases}
\]
\end{definition}

\begin{theorem}[CEGAR Termination]\label{thm:cegar-termination}
CEGAR with a finite set of reachable predicates terminates: either the property is proved safe, or a real counterexample is found. This follows from the fact that each refinement step strictly strengthens the abstraction, and there are finitely many abstract states.
\end{theorem}
