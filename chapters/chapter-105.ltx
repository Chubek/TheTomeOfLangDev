% Hoare Logic for Verification
% ============================================================
\section{Hoare Logic for Verification}\label{sec:deductive-hoare}

\subsection{Hoare Triples}\label{sec:hoare-triples}

The fundamental construct of Hoare logic is the \emph{Hoare triple}, which
asserts a relationship between a precondition, a program, and a postcondition.

\begin{definition}[Hoare Triple]\label{def:hoare-triple}
A \emph{Hoare triple} $\{P\}\; c\; \{Q\}$ asserts that if the precondition $P$
holds before execution of command $c$, and if $c$ terminates, then the
postcondition $Q$ holds after execution.  Formally:
\[
\{P\}\; c\; \{Q\} \iff \forall \sigma, \sigma'.\; P(\sigma) \land \SemBrack{c}(\sigma) = \sigma' \implies Q(\sigma')
\]
This is called \emph{partial correctness}.  \emph{Total correctness}, written
$[P]\; c\; [Q]$, additionally requires that $c$ terminates whenever $P$ holds.
\end{definition}

\begin{example}[Simple Hoare Triple]\label{ex:hoare-simple}
The triple
\[
\{x = X \land y = Y\}\; z := x;\; x := y;\; y := z\; \{x = Y \land y = X\}
\]
asserts that the three-assignment swap correctly exchanges the values of $x$
and $y$.  Here $X$ and $Y$ are \emph{logical variables} (rigid constants) that
record the initial values.
\end{example}

\subsection{Hoare Logic Proof Rules}\label{sec:hoare-rules}

Hoare logic provides a set of inference rules for deriving Hoare triples.

\begin{semrules}{Hoare Logic}
  \frac{}{\{P[e/x]\}\; x := e\; \{P\}}
  \quad \textsc{Assign} \\[12pt]
  \frac{\{P \land b\}\; c_1\; \{Q\} \quad \{P \land \neg b\}\; c_2\; \{Q\}}{\{P\}\; \mathbf{if}\ b\ \mathbf{then}\ c_1\ \mathbf{else}\ c_2\; \{Q\}}
  \quad \textsc{If} \\[12pt]
  \frac{\{P \land b\}\; c\; \{P\}}{\{P\}\; \mathbf{while}\ b\ \mathbf{do}\ c\; \{P \land \neg b\}}
  \quad \textsc{While} \\[12pt]
  \frac{\{P\}\; c_1\; \{R\} \quad \{R\}\; c_2\; \{Q\}}{\{P\}\; c_1;\; c_2\; \{Q\}}
  \quad \textsc{Seq} \\[12pt]
  \frac{P' \implies P \quad \{P\}\; c\; \{Q\} \quad Q \implies Q'}{\{P'\}\; c\; \{Q'\}}
  \quad \textsc{Conseq}
\end{semrules}

The \textsc{Assign} rule is notable for its backward character: to find the
precondition for an assignment $x := e$ with desired postcondition $P$, we
\emph{substitute} $e$ for $x$ in $P$.  This is the basis of \emph{weakest
precondition} computation.

\subsection{Weakest Preconditions}\label{sec:hoare-wp}

\begin{definition}[Weakest Precondition]\label{def:wp}
The \emph{weakest precondition} $\mathit{wp}(c, Q)$ of a command $c$ with
respect to a postcondition $Q$ is the weakest predicate $P$ such that
$\{P\}\; c\; \{Q\}$ holds (in the sense of total correctness).
\end{definition}

The weakest precondition is computed recursively:
\begin{align*}
  \mathit{wp}(x := e, Q) &= Q[e/x] \\
  \mathit{wp}(c_1; c_2, Q) &= \mathit{wp}(c_1, \mathit{wp}(c_2, Q)) \\
  \mathit{wp}(\mathbf{if}\ b\ \mathbf{then}\ c_1\ \mathbf{else}\ c_2, Q) &= (b \implies \mathit{wp}(c_1, Q)) \land (\neg b \implies \mathit{wp}(c_2, Q)) \\
  \mathit{wp}(\mathbf{while}\ b\ \mathbf{do}\ c, Q) &= \exists k.\; H_k
\end{align*}
where the $H_k$ are defined by:
\begin{align*}
  H_0 &= \neg b \land Q \\
  H_{k+1} &= H_k \lor \mathit{wp}(c, H_k) \land b
\end{align*}

\begin{theorem}[Weakest Precondition Characterization]\label{thm:wp-char}
For any $P$, $c$, and $Q$:
\[
\{P\}\; c\; \{Q\} \iff P \implies \mathit{wp}(c, Q)
\]
\end{theorem}

\subsection{Loop Invariants}\label{sec:hoare-invariants}

The while rule in Hoare logic requires the user to supply a \emph{loop
invariant}---a predicate that holds at the beginning of every iteration.

\begin{definition}[Loop Invariant]\label{def:loop-invariant}
A predicate $I$ is a \emph{loop invariant} for $\mathbf{while}\ b\ \mathbf{do}\ c$
if:
\begin{enumerate}
\item $I$ holds before the loop begins.
\item $\{I \land b\}\; c\; \{I\}$ (the body preserves $I$).
\end{enumerate}
\end{definition}

Finding loop invariants is the central challenge in deductive verification.
For simple loops, invariants can often be guessed from the loop structure.
For complex loops, invariant discovery requires sophisticated techniques
(see \cref{sec:deductive-invariants}).

