\section{Advanced Algebraic Effects and Inference}\label{sec:algebraic-effects-advanced}

\subsection{Effect Handlers and Continuations}\label{sec:handlers-continuations}

The semantics of algebraic effects is given by \emph{effect handlers}, which interpret effect operations by transforming the computation into a continuation-passing style.

\begin{definition}[Effect Handler Semantics]\label{def:handler-semantics}
An effect handler $\mathrm{handle}\; M\; \mathrm{with}\; H$ evaluates the computation $M$ as follows:
\begin{itemize}
  \item If $M$ returns a value $v$, the return clause of $H$ is applied to $v$.
  \item If $M$ performs an operation $\mathtt{op}(a, k)$ where $a$ is the argument and $k$ is the continuation, the operation clause of $H$ for $\mathtt{op}$ is applied to $a$ and $k$.
\end{itemize}
\end{definition}

\begin{example}[State handler in detail]\label{ex:state-handler-detail}
\begin{verbatim}
  -- State effect:
  effect State(S) {
    get : () -> S
    set : S -> ()
  }

  -- Handler:
  handle_state : (State(S) => A) -> S -> (A * S)
  handle_state m s0 = handle m with
    | get() -> k -> \s -> handle_state (k(s)) s
    | set(s') -> k -> \s -> handle_state (k()) s'
    | return v -> \s -> (v, s)

  -- Example:
  -- handle_state (fun () -> let x = get() in set(x + 1); get()) 0
  -- = (1, 1)
\end{verbatim}
\end{example}

\subsection{Effect Inference Algorithm}\label{sec:effect-inference-alg}

Effect inference extends Hindley--Milner type inference with effect variables and effect constraints.

\begin{algorithm}[H]
\caption{Effect Inference with Effect Variables}\label{alg:effect-inference-adv}
\begin{algorithmic}[1]
\Function{InferEffect}{$\Gamma, e$}
  \State \textbf{case} $e$ \textbf{of}
  \State \quad $x$: \Return $\Gamma(x).\tau, \Gamma(x).\epsilon, \{\}$
  \State \quad $\lambda x.\, e'$:
    \State \quad $\alpha \gets \mathrm{fresh\_type}()$; $\epsilon_f \gets \mathrm{fresh\_effect}()$; $\tau' \gets \mathrm{fresh\_type}()$
    \State \quad $\Gamma' = \Gamma[x : \alpha \xrightarrow{\epsilon_f} \tau']$
    \State \quad $\tau'', \epsilon', C \gets \mathrm{InferEffect}(\Gamma', e')$
    \State \quad \Return $\alpha \xrightarrow{\epsilon_f} \tau', \emptyset, C \cup \{\epsilon' \subseteq \epsilon_f\}$
  \State \quad $e_1\; e_2$:
    \State \quad $\tau_1 \xrightarrow{\epsilon_1} \tau_1', \epsilon_1', C_1 \gets \mathrm{InferEffect}(\Gamma, e_1)$
    \State \quad $\tau_2, \epsilon_2, C_2 \gets \mathrm{InferEffect}(\Gamma, e_2)$
    \State \quad $\epsilon_f \gets \mathrm{fresh\_effect}()$
    \State \quad \Return $\tau_1', \epsilon_1 \cup \epsilon_1' \cup \epsilon_2, C_1 \cup C_2 \cup \{\tau_2 = \tau_1\}$
  \State \quad $\mathtt{handle}\; e'\; \mathrm{with}\; H$:
    \State \quad $\tau', \epsilon', C \gets \mathrm{InferEffect}(\Gamma, e')$
    \State \quad $\epsilon_H \gets \mathrm{effects\_of\_handler}(H)$
    \State \quad \Return $\mathrm{result\_type}(H), \epsilon_H, C \cup \{\epsilon' \subseteq \mathrm{handled}(H)\}$
\EndFunction
\end{algorithmic}
\end{algorithm}

\subsection{Effect Rows and Row Polymorphism}\label{sec:effect-rows}

Effect rows provide a way to represent effect sets that supports row polymorphism:

\begin{definition}[Effect Row]\label{def:effect-row}
An \emph{effect row} is a sequence of effect labels terminated by a row variable:
\[
  \langle \epsilon_1, \epsilon_2, \ldots, \epsilon_n \mid \rho \rangle
\]
where $\rho$ is a row variable representing the remaining effects. Row polymorphism allows functions to be polymorphic over the remaining effects.
\end{definition}

\begin{example}[Effect row polymorphism]\label{ex:effect-row-poly}
\begin{verbatim}
  -- Effect row polymorphic function:
  map : forall <r | Row>. (a -> b <r>) -> [a] -> [b] <r>
  -- The function works for any effect row r
  -- If f is pure (r = empty), map is pure
  -- If f has IO, map has IO
\end{verbatim}
\end{example}

\subsection{Scoped Effects and Lexical Handlers}\label{sec:scoped-effects}

\emph{Scoped effects} restrict the scope of effect handlers, enabling more efficient compilation.

\begin{verbatim}
  -- Scoped effect:
  with_resource r {
    -- r is available only in this block
    use(r)
  }
  -- r is no longer available here

  -- Lexical handler: the handler's scope is determined by lexical scope
  -- This enables stack-based allocation of effect handlers
\end{verbatim}

