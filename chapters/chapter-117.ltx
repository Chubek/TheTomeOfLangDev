\centering
\begin{tikzpicture}
  \node[draw, circle, fill=TomeInk, minimum size=0.4cm] (dyn) at (0, 1.5) {};
  \node[draw, circle, fill=TomeGold, minimum size=0.4cm] (stat) at (0, 0) {};
