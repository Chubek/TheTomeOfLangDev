\section{Dependence Graph Construction}\label{sec:dep-graph-construction}

\begin{definition}[Dependence Types]\label{def:dep-types}
Instruction scheduling must respect three types of dependences:
\begin{itemize}
  \item \textbf{True (flow) dependence} (RAW): Instruction $j$ reads a value written by instruction $i$.
  \item \textbf{Anti-dependence} (WAR): Instruction $j$ writes a value read by instruction $i$.
  \item \textbf{Output dependence} (WAW): Both instructions $i$ and $j$ write the same location.
\end{itemize}
Only true dependences are mandatory; anti- and output dependences can be eliminated by register renaming.
\end{definition}

\begin{definition}[Dependence Latency]\label{def:dep-latency}
Each dependence edge carries a \emph{latency}: the minimum number of cycles between the issue of the source instruction and the availability of its result for the destination instruction.
\end{definition}

\begin{algorithm}[H]
\caption{Dependence Graph Construction}
\label{alg:dep-graph}
\begin{algorithmic}[1]
\Require Basic block with instructions $I_1, \ldots, I_n$
\ensure Dependence DAG $D = (V, E)$
\State $V \gets \{I_1, \ldots, I_n\}$; $E \gets \emptyset$
\ForAll{pairs $(I_i, I_j)$ with $i < j$}
  \If{$I_i$ writes a register/location read by $I_j$}
    \State Add edge $(I_i, I_j)$ with latency = result latency of $I_i$
  \EndIf
  \If{$I_i$ reads a register/location written by $I_j$}
    \State Add edge $(I_j, I_i)$ with latency 0 (anti-dependence)
  \EndIf
  \If{$I_i$ and $I_j$ write the same register/location}
    \State Add edge $(I_i, I_j)$ with latency 0 (output dependence)
  \EndIf
\EndFor
\end{algorithmic}
\end{algorithm}

\section{List Scheduling Priority Functions}\label{sec:list-sched-priority}

\begin{definition}[Height-Based Priority]\label{def:height-priority}
The \textbf{height} of a node in the dependence DAG is the length of the longest path from that node to any sink. Scheduling by decreasing height ensures that instructions on the critical path are scheduled first.
\end{definition}

\begin{definition}[Successors-Count Priority]\label{def:successors-priority}
The \textbf{successors count} priority schedules instructions with the most (transitive) successors first. This maximizes the number of instructions that become available for scheduling in subsequent cycles.
\end{definition}

\begin{table}[htbp]
\centering
\begin{tabular}{lcc}
\hline
\textbf{Scheduling Direction} & \textbf{Best For} & \textbf{Priority} \\
\hline
Top-down & Minimizing schedule length & Height (from source) \\
Bottom-up & Register pressure reduction & Depth (from sink) \\
Bidirectional & Balanced approach & Both, alternating \\
\hline
\end{tabular}
\caption{List scheduling directions and their characteristics.}
\label{tab:list-sched-directions}
\end{table}
